    <ProjectReference Include="..\NurMarketKassa.Ui.Shared\NurMarketKassa.Ui.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\NurMarketKassa\Services\SyncService.cs" Link="Services\SyncService.cs" />
