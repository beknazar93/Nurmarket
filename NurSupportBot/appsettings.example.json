{
  // Скопируйте этот файл в appsettings.json и заполните.
  // Токен бота от @BotFather (не токен бота кассы).
  "BotToken": "123456789:AA...",
  // Telegram ID администраторов через запятую. Свой ID бот покажет по команде /id.
  "AdminIds": [ 123456789 ],
  // Папка для базы (обращения, статистика, инструкции) и ключа шифрования.
  "DataDir": "data",
  "NurCrmBaseUrl": "https://app.nurcrm.kg/"
}
