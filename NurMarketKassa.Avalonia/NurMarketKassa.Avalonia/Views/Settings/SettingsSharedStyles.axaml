<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 2026-09-29, владелец: «настройки таб меню сделай» — ширина колонки страниц настроек
       (была 860 в каждой странице). Меню разделов теперь вкладками сверху, левой колонки 240 px
       нет — страница занимает ширину окна, но не шире этого: на 1920 строки полей не
       растягиваются через весь экран. Этой же ширины ряд вкладок в PosSettingsWindow. -->
  <Styles.Resources>
    <x:Double x:Key="SettingsPageMaxWidth">1280</x:Double>
  </Styles.Resources>

  <Style Selector="Border.SettingsCard">
    <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="0 4 12 0 #1A000000"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.SettingsHeaderCard">
    <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="0 4 12 0 #1A000000"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.SettingsContentHost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Margin" Value="8,8,12,12"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.SettingsCardList">
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Spacing" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="ScrollViewer.SettingsPageScroll">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="TextBlock.SettingsPageTitle">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
  </Style>

  <!-- Подзаголовок страницы переносится по словам и не тянется во всю ширину окна: у
       «Сотрудников» он в одну строку уходил за 170 символов, а читаемая строка — это
       примерно 60–80. -->
  <Style Selector="TextBlock.SettingsPageSubtitle">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MaxWidth" Value="620"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="TextBlock.SettingsCardTitle">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
  </Style>

  <Style Selector="TextBlock.SettingsCardBody">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TextBlock.FieldLabel">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <Style Selector="CheckBox.ToggleSwitch">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Border x:Name="track" Width="46" Height="26" CornerRadius="13"
                  Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,10,0"/>
          <Ellipse x:Name="dot" Width="20" Height="20" Fill="#FFFFFF"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
          <!-- Content обязательно пробрасывать вручную: у безымянного ContentPresenter
               в Avalonia нет автоматической привязки, и подписи тумблеров, заданные через
               Content, не выводились вовсе — например «Применять к экрану кассира» в
               «Кастомизации» выглядел голым переключателем без единого слова. -->
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                            VerticalAlignment="Center" Margin="4,0,0,0"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Включённый переключатель — акцентный цвет темы, а не BrushWarning: жёлто-оранжевый цвет
       предупреждения означает «осторожно», и каждая ВКЛЮЧЁННАЯ настройка выглядела как проблема.
       Здесь акцент уместен — это фон, а не текст (см. BrushMoney в AppTheme.axaml). -->
  <Style Selector="CheckBox.ToggleSwitch:checked /template/ Border#track">
    <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
  </Style>

  <Style Selector="CheckBox.ToggleSwitch:checked /template/ Ellipse#dot">
    <Setter Property="Margin" Value="23,0,0,0"/>
  </Style>

  <!-- 2026-10-19, этап О7: «выбрано» во всех Настройках — одним видом, как sec-seg/modal-seg: тёмно-синяя заливка
       (цвет текста темы) и надпись цветом панели; невыбранное — белое с обводкой (было серое залитое / бледно-жёлтое). -->
  <Style Selector="RadioButton.DatePill">
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource SettingsButtonRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.DatePill:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
  </Style>
  <Style Selector="RadioButton.DatePill:checked">
    <Setter Property="Background" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- 2026-10-19, этап О7: поля ввода и списки — фон поля темы (BrushInput) с заметной рамкой, а не серые залитые плашки. -->
  <Style Selector="TextBox.ModernTextBox">
    <Setter Property="Height" Value="42"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource BrushText}"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="ComboBox.TouchComboBox">
    <Setter Property="Height" Value="42"/>
    <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <!-- 2026-10-19, этап О7: второстепенные кнопки Настроек — обводкой, как sec-outline (были серые залитые). Главная
       («Сохранить» и т.п.) остаётся жёлтой — одна на странице. -->
  <Style Selector="Button.SettingsFlatButton">
    <Setter Property="Height" Value="42"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.SettingsFlatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
  </Style>
  <Style Selector="Button.SettingsFlatButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
  </Style>
  <Style Selector="Button.SettingsFlatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
  </Style>

  <!-- 2026-10-19, этап О7: кнопки без своего стиля в страницах Настроек (btn-secondary, SecondaryButton) были серыми
       кнопками Fluent («+ Добавить роль», «Загрузить с сайта», «Удалить» у ролей) — теперь обводкой, как sec-outline.
       Страница со своим стилем этих классов (Маркетплейс, Экран) задаёт его ниже include и перекрывает этот. -->
  <Style Selector="Button.btn-secondary, Button.SecondaryButton">
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.SecondaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
  </Style>
  <Style Selector="Button.btn-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.SecondaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
  </Style>
  <Style Selector="Button.btn-secondary:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.SecondaryButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
  </Style>

  <Style Selector="Border.AlertBlock">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="0,12,0,0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <!-- Сворачиваемая группа настроек (2026-09-07) — длинные плоские списки тумблеров/полей в
       одну карточку тяжело сканировать глазами; та же идея, что уже используется для бокового
       меню (свёрнутые разделы, сворачиваются по клику на заголовок), теперь и в самих страницах
       настроек. ToggleButton вместо Avalonia Expander — не тянет его нестандартный
       ControlTemplate, повторяет уже устоявшийся в проекте приём "кнопка + видимость по
       IsChecked" (см. HotkeyOptionsPanel в ProductEditDialog). -->
  <!-- 2026-10-19, этап О7: шапка группы — белая (цвет панели) с рамкой, как карточка; наведение — мягкий фон (была серая). -->
  <Style Selector="ToggleButton.SettingsGroupHeader">
    <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleButton">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.SettingsGroupHeader:checked">
    <Setter Property="CornerRadius" Value="10,10,0,0"/>
  </Style>
  <Style Selector="ToggleButton.SettingsGroupHeader:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
  </Style>
  <Style Selector="TextBlock.SettingsGroupChevron">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.SettingsGroupBody">
    <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="1,0,1,1"/>
    <Setter Property="CornerRadius" Value="0,0,10,10"/>
    <Setter Property="Padding" Value="14,12"/>
  </Style>

</Styles>
