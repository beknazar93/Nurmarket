<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NurMarketKassa.AvaloniaHost.Views.Settings"
             xmlns:customer="using:NurMarketKassa.AvaloniaHost.Views.Customer"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.MarketplaceView"
             x:CompileBindings="False"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>

    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
    </Style>

    <!-- 2026-10-19, этап О7: второстепенные — обводкой цветом текста (были серые с бледным текстом). -->
    <Style Selector="Button.btn-secondary">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <!-- 2026-10-19, этап О7: кнопки внутри карточек доп. функций («Скачать модель», «Настроить»…) — обводкой: жёлтая на
         вкладке одна («Редактор тем» / «Редактор экрана покупателя»), а в «Доп. функциях» их было 4–5. -->
    <Style Selector="Border.SettingsCard Border.SettingsCard Button.btn-primary">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.SettingsCard Border.SettingsCard Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <!-- Название карточки переносится и не налезает на бейдж «Платно / Разблокировано» справа. -->
    <Style Selector="Border.SettingsCard Border.SettingsCard TextBlock.SettingsCardTitle">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="Border.SettingsCard Border.SettingsCard Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 2026-10-23: витрина как в Play Market — плитка (mp-tile), чип-фильтр (mp-chip).
         2026-10-23, ТЗ «Маркетплейс — редизайн» (П-2): плитка — кнопка-обёртка (без фона) с карточкой mp-tile-card внутри
         (фон/рамка/наведение/фокус — у карточки), метка «НОВОЕ» (mp-badge-new), ‹ › у рядов (mp-row-nav), «Все N ›» (mp-row-all),
         кнопка и точки баннера (mp-hero-btn / mp-hero-nav / mp-hero-dot; баннер тёмный всегда — цвета фиксированные). -->
    <Style Selector="Button.mp-tile">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- Рамку фокуса при Tab рисует карточка (mp-tile-card), стандартный чёрный прямоугольник не нужен. -->
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.mp-tile /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.mp-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.mp-tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.mp-tile-card">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Button.mp-tile:pointerover Border.mp-tile-card">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="Button.mp-tile:pressed Border.mp-tile-card">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="RenderTransform" Value="translate(0px, 1px)"/>
    </Style>
    <Style Selector="Button.mp-tile:focus-visible Border.mp-tile-card">
      <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="11"/>
    </Style>
    <Style Selector="Border.mp-badge-new">
      <Setter Property="Background" Value="#F9D919"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="Border.mp-badge-new > TextBlock">
      <Setter Property="Foreground" Value="#191919"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.mp-row-nav">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mp-row-nav PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.mp-row-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="Button.mp-row-all">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.mp-row-all:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.mp-hero-btn">
      <Setter Property="Background" Value="#FFB208"/>
      <Setter Property="Foreground" Value="#191919"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mp-hero-btn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFB208"/>
      <Setter Property="Foreground" Value="#191919"/>
    </Style>
    <Style Selector="Button.mp-hero-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFC43D"/>
      <Setter Property="Foreground" Value="#191919"/>
    </Style>
    <Style Selector="Button.mp-hero-nav">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mp-hero-nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.mp-hero-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#59FFFFFF"/>
    </Style>
    <Style Selector="Button.mp-hero-nav PathIcon">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.mp-hero-dot">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mp-hero-dot /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66FFFFFF"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.mp-hero-dot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#99FFFFFF"/>
    </Style>
    <Style Selector="Button.mp-hero-dot.active">
      <Setter Property="Width" Value="22"/>
    </Style>
    <Style Selector="Button.mp-hero-dot.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.mp-chip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.mp-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.mp-chip.active">
      <Setter Property="Background" Value="{DynamicResource BrushText}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.mp-chip.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushText}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost" Padding="14,12">
    <Grid RowDefinitions="Auto,*" MaxWidth="{DynamicResource SettingsPageMaxWidth}" HorizontalAlignment="Stretch">

      <!-- Баннер обновления (2026-09-05, по просьбе пользователя: "при нажатии на маркетплейс обновлял список, чтобы клиенты
           видели новые функции и темы") — новые темы/доп. услуги реально попадают в кассу только через обновление версии
           (Velopack/GitHub Releases), отдельного каталога на сервере нет. Проверка запускается автоматически при каждом
           открытии этого окна. -->
      <Border x:Name="UpdateBanner" IsVisible="False" Margin="0,0,0,10"
              Background="{DynamicResource BrushAccentSoft}"
              BorderBrush="{DynamicResource BrushAccent}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock x:Name="UpdateBannerTitle" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushAccentStrong}"/>
              <TextBlock x:Name="UpdateBannerNotes" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" MaxLines="4"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="UpdateNowButton" Content="{DynamicResource marketplace.updateNowButton}"
                    Classes="btn-primary" Click="UpdateNow_Click" VerticalAlignment="Top"/>
          </Grid>
          <ProgressBar x:Name="UpdateProgressBar" IsVisible="False" Height="6" Minimum="0" Maximum="100"/>
        </StackPanel>
      </Border>

      <!-- 2026-10-23: вместо вкладок «Темы / Доп. функции / Виды кассы» — единая витрина (MarketplaceStoreView) по каталогу
           MarketplaceCatalog: поиск, чипы, ряды плиток и страница «подробно». Прежние карточки доп. функций собираются в коде
           как раньше (хранилище состояния и блок голосовых моделей), но на экране показывается только витрина. -->
      <local:MarketplaceStoreView x:Name="Store" Grid.Row="1"/>
    </Grid>
  </Border>
</UserControl>
