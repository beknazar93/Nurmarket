<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NurMarketKassa.AvaloniaHost.Views.Settings"
             xmlns:customer="using:NurMarketKassa.AvaloniaHost.Views.Customer"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.MarketplaceView"
             x:CompileBindings="False"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>

    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
    </Style>

    <!-- 2026-10-19, этап О7: второстепенные — обводкой цветом текста (были серые с бледным текстом). -->
    <Style Selector="Button.btn-secondary">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <!-- 2026-10-19, этап О7: кнопки внутри карточек доп. функций («Скачать модель», «Настроить»…) — обводкой: жёлтая на
         вкладке одна («Редактор тем» / «Редактор экрана покупателя»), а в «Доп. функциях» их было 4–5. -->
    <Style Selector="Border.SettingsCard Border.SettingsCard Button.btn-primary">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.SettingsCard Border.SettingsCard Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <!-- Название карточки переносится и не налезает на бейдж «Платно / Разблокировано» справа. -->
    <Style Selector="Border.SettingsCard Border.SettingsCard TextBlock.SettingsCardTitle">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="Border.SettingsCard Border.SettingsCard Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost" Padding="16">
    <ScrollViewer Classes="SettingsPageScroll">
      <!-- 2026-10-19, этап О7: ширина колонки — как у страниц Настроек (было 860 — справа на 1366 пустое поле). -->
      <StackPanel Classes="SettingsCardList" Spacing="10" MaxWidth="{DynamicResource SettingsPageMaxWidth}" HorizontalAlignment="Stretch">

        <!-- Хедер-карточки «Маркетплейс» здесь больше нет (2026-09-27, «дублируется»): название
             уже есть в шапке окна кассы и в заголовке раздела программы владельца. -->

        <!-- Баннер обновления (2026-09-05, по просьбе пользователя: "при нажатии на
             маркетплейс обновлял список, чтобы клиенты видели новые функции и темы") —
             новые темы/доп. услуги реально попадают в кассу только через обновление версии
             (Velopack/GitHub Releases), отдельного каталога на сервере нет. Проверка
             запускается автоматически при каждом открытии этого окна. -->
        <Border x:Name="UpdateBanner" IsVisible="False"
                Background="{DynamicResource BrushAccentSoft}"
                BorderBrush="{DynamicResource BrushAccent}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="UpdateBannerTitle" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushAccentStrong}"/>
                <TextBlock x:Name="UpdateBannerNotes" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" MaxLines="4"/>
              </StackPanel>
              <Button Grid.Column="1" x:Name="UpdateNowButton" Content="{DynamicResource marketplace.updateNowButton}"
                      Classes="btn-primary" Click="UpdateNow_Click" VerticalAlignment="Top"/>
            </Grid>
            <ProgressBar x:Name="UpdateProgressBar" IsVisible="False" Height="6" Minimum="0" Maximum="100"/>
          </StackPanel>
        </Border>

        <!-- Переключатель вкладок. 2026-10-19, этап О7: сегменты sec-seg (выбранная тёмно-синяя, как modal-seg), слева —
             как вкладки разделов; была жёлтая кнопка и серые. -->
        <Border Classes="sec-segment" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="ThemesTabButton" Classes="sec-seg active"
                    Content="{DynamicResource marketplace.themesTab}" Click="ThemesTab_Click"/>
            <Button x:Name="ExtrasTabButton" Classes="sec-seg"
                    Content="{DynamicResource marketplace.extrasTab}" Click="ExtrasTab_Click"/>
            <!-- 2026-09-28, «виды касс в маркетплейс добавь» -->
            <Button x:Name="LayoutsTabButton" Classes="sec-seg"
                    Content="{DynamicResource marketplace.layoutsTab}" Click="LayoutsTab_Click"/>
          </StackPanel>
        </Border>

        <!-- Темы. Карточки собираются в коде (BuildThemeGallery): у каждой свой живой
             предпросмотр, нарисованный цветами самой темы, — по описанию словами разницу
             между шестью оформлениями не передать. -->
        <Border x:Name="ThemesPanel" Classes="SettingsCard" Padding="14">
          <StackPanel Spacing="8">
            <!-- Редактор своих тем (2026-09-28): своя тема на основе любой встроенной. -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource marketplace.themeTitle}" Classes="SettingsCardTitle" FontSize="14" VerticalAlignment="Center"/>
              <Button x:Name="ThemeEditorButton" Grid.Column="1" Classes="btn-primary" Height="36" Padding="14,4"
                      Click="OpenThemeEditor_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconPalette}" Width="16" Height="16"/>
                  <TextBlock Text="{DynamicResource marketplace.themeEditorButton}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="{DynamicResource marketplace.themeDesc}"
                       Classes="SettingsCardBody" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSoft}"/>
            <ItemsControl x:Name="ThemeGalleryPanel" Margin="0,8,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>


        <!-- Виды кассы (2026-09-28): те же шесть карточек с миниатюрами, что в Настройки → Экран
             (общий KassaLayoutPicker), и экран покупателя, который меняется вместе с видом кассы. -->
        <StackPanel x:Name="LayoutsPanel" Spacing="10" IsVisible="False">
          <Border Classes="SettingsCard" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource marketplace.layoutsTitle}" Classes="SettingsCardTitle" FontSize="14"/>
              <TextBlock Text="{DynamicResource marketplace.layoutsDesc}"
                         Classes="SettingsCardBody" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushTextSoft}"/>
              <local:KassaLayoutPicker x:Name="LayoutPicker" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard" Padding="14">
            <Grid ColumnDefinitions="Auto,16,*">
              <!-- Живой предпросмотр экрана покупателя в нынешнем виде -->
              <Border Width="320" Height="180" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top"
                      BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1">
                <Viewbox Stretch="Uniform">
                  <customer:CustomerDisplayView x:Name="CustomerPreviewView" Width="1280" Height="720"/>
                </Viewbox>
              </Border>
              <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconMonitor}" Width="18" Height="18" Foreground="{DynamicResource BrushText}"/>
                  <TextBlock Text="{DynamicResource marketplace.customerDisplayTitle}" Classes="SettingsCardTitle" FontSize="14"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="CustomerDisplayModeText" Classes="SettingsCardBody" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSoft}"/>
                <Button x:Name="CustomerDisplayEditorButton" Classes="btn-primary" Height="36" Padding="14,4"
                        HorizontalAlignment="Left" Click="OpenCustomerDisplayEditor_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconPencil}" Width="15" Height="15"/>
                    <TextBlock Text="{DynamicResource marketplace.customerDisplayEditorButton}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Доп. функции -->
        <Border x:Name="ExtrasPanel" Classes="SettingsCard" Padding="14" IsVisible="False">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource marketplace.extrasIntro}"
                       Classes="SettingsCardBody" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>

            <WrapPanel x:Name="ExtrasWrapPanel">
              <Border Classes="SettingsCard" Width="390" Padding="14" Margin="0,0,10,10">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource marketplace.extra2Title}" Classes="SettingsCardTitle" FontSize="14" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource BrushWarningSoft}" BorderBrush="{DynamicResource BrushWarning}"
                            BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource marketplace.comingSoonBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}"/>
                    </Border>
                  </Grid>
                  <TextBlock Text="{DynamicResource marketplace.extra2Desc}" Classes="SettingsCardBody" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>
              </Border>

            </WrapPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
