<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.ScreenSettingsView"
             x:CompileBindings="False"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>

    <Style Selector="RadioButton.ClickPill">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.ClickPill:checked">
      <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.SecondaryButton">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.SecondaryButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost" Padding="16">
    <ScrollViewer Classes="SettingsPageScroll">
      <!-- Колонка настроек: одна и та же ширина на всех вкладках, иначе при
           переключении карточки прыгали от края к краю вслед за содержимым. -->
      <StackPanel Classes="SettingsCardList" Spacing="10" MaxWidth="860" HorizontalAlignment="Stretch">

        <!-- Заголовок страницы и главный переключатель прижаты влево -->
        <Border Classes="SettingsHeaderCard" Padding="12">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource BrushAccentSoft}"
                    BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                         Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource posSettings.screen.title}" Classes="SettingsPageTitle" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
              <TextBlock Text="{DynamicResource posSettings.screen.subtitle}" Classes="SettingsPageSubtitle" FontSize="12" HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Блок 1: Поведение кассы и экрана -->
        <!-- Блок 1 (2026-09-07, было одной длинной картой на ~12 полей подряд — по просьбе
             пользователя разбито на 4 сворачиваемые группы, тот же приём, что уже используется
             для бокового меню кассы. Первая группа открыта по умолчанию, остальные свёрнуты —
             страница перестаёт быть "длинным списком вниз". -->

        <!-- Значки групп — глифы Segoe MDL2. Цветные эмодзи (🖥 ⚡ 🏪 🔍) в ровном списке
             заголовков светились каждый своим цветом и читались как наклейки. -->
        <StackPanel Spacing="0">
          <ToggleButton x:Name="DisplayGroupToggle" Classes="SettingsGroupHeader" IsChecked="True">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSoft}"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource posSettings.screen.groupDisplay}"
                         FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25BE;" IsVisible="{Binding #DisplayGroupToggle.IsChecked}"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25B8;" IsVisible="{Binding !#DisplayGroupToggle.IsChecked}"/>
            </Grid>
          </ToggleButton>
          <Border Classes="SettingsGroupBody" IsVisible="{Binding #DisplayGroupToggle.IsChecked}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource posSettings.screen.fullscreen}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                <CheckBox Grid.Column="1" x:Name="FullscreenCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource posSettings.screen.trueFullscreen}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <TextBlock Text="{DynamicResource posSettings.screen.trueFullscreenDesc}"
                             FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="TrueFullscreenCheck" x:FieldModifier="public" Classes="ToggleSwitch" VerticalAlignment="Top"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource posSettings.screen.autostart}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                <CheckBox Grid.Column="1" x:Name="AutostartCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="0">
          <ToggleButton x:Name="PerfGroupToggle" Classes="SettingsGroupHeader" IsChecked="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSoft}"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource posSettings.screen.groupPerformance}"
                         FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25BE;" IsVisible="{Binding #PerfGroupToggle.IsChecked}"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25B8;" IsVisible="{Binding !#PerfGroupToggle.IsChecked}"/>
            </Grid>
          </ToggleButton>
          <Border Classes="SettingsGroupBody" IsVisible="{Binding #PerfGroupToggle.IsChecked}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource posSettings.screen.lowPerfMode}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <TextBlock Text="{DynamicResource posSettings.screen.lowPerfModeDesc}"
                             FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="LowPerformanceModeCheck" x:FieldModifier="public" Classes="ToggleSwitch" VerticalAlignment="Top"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource posSettings.screen.voiceControl}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <TextBlock Text="{DynamicResource posSettings.screen.voiceControlMovedDesc}"
                             FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="VoiceControlOpenMarketplaceButton" x:FieldModifier="public" Classes="SecondaryButton"
                        Content="{DynamicResource posSettings.screen.voiceControlOpenMarketplace}"
                        FontSize="12" Padding="10,4" VerticalAlignment="Top"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource posSettings.screen.autoTouchKeyboard}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                <CheckBox Grid.Column="1" x:Name="AutoTouchKeyboardCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource posSettings.screen.showCatalogPhotos}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <TextBlock Text="{DynamicResource posSettings.screen.showCatalogPhotosDesc}"
                             FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="ShowCatalogPhotosCheck" x:FieldModifier="public" Classes="ToggleSwitch" VerticalAlignment="Top"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="0">
          <ToggleButton x:Name="CashierGroupToggle" Classes="SettingsGroupHeader" IsChecked="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSoft}"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource posSettings.screen.groupCashierLang}"
                         FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25BE;" IsVisible="{Binding #CashierGroupToggle.IsChecked}"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25B8;" IsVisible="{Binding !#CashierGroupToggle.IsChecked}"/>
            </Grid>
          </ToggleButton>
          <Border Classes="SettingsGroupBody" IsVisible="{Binding #CashierGroupToggle.IsChecked}">
            <StackPanel Spacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource posSettings.screen.cashbox}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="{DynamicResource posSettings.screen.cashboxDesc}"
                           FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" Margin="0,0,0,6"/>
                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox x:Name="CashboxCombo" x:FieldModifier="public" Grid.Column="0" HorizontalAlignment="Stretch"/>
                  <Button x:Name="RefreshCashboxesButton" x:FieldModifier="public" Grid.Column="1" Content="↻"
                          Margin="6,0,0,0" Click="RefreshCashboxes_Click" ToolTip.Tip="{DynamicResource posSettings.screen.refreshCashboxesTooltip}"/>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource posSettings.screen.cashierLanguage}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="{DynamicResource posSettings.screen.appliesImmediately}"
                           FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"/>
                <!-- WrapPanel вместо фиксированной сетки колонок — легко добавлять языки дальше,
                     не переверстывая раскладку (было только 2 языка, теперь 5). -->
                <WrapPanel Orientation="Horizontal">
                  <RadioButton x:Name="LanguageRussianRadio" x:FieldModifier="public" Margin="0,0,8,8"
                               Content="{DynamicResource posSettings.screen.langRussian}" Classes="ClickPill" GroupName="CashierLanguage"/>
                  <RadioButton x:Name="LanguageKyrgyzRadio" x:FieldModifier="public" Margin="0,0,8,8"
                               Content="{DynamicResource posSettings.screen.langKyrgyz}" Classes="ClickPill" GroupName="CashierLanguage"/>
                  <RadioButton x:Name="LanguageTurkishRadio" x:FieldModifier="public" Margin="0,0,8,8"
                               Content="{DynamicResource posSettings.screen.langTurkish}" Classes="ClickPill" GroupName="CashierLanguage"/>
                  <RadioButton x:Name="LanguageUzbekRadio" x:FieldModifier="public" Margin="0,0,8,8"
                               Content="{DynamicResource posSettings.screen.langUzbek}" Classes="ClickPill" GroupName="CashierLanguage"/>
                  <RadioButton x:Name="LanguageEnglishRadio" x:FieldModifier="public" Margin="0,0,8,8"
                               Content="{DynamicResource posSettings.screen.langEnglish}" Classes="ClickPill" GroupName="CashierLanguage"/>
                </WrapPanel>
                <TextBlock x:Name="LanguagePackHint" x:FieldModifier="public" IsVisible="False" Margin="0,4,0,0"
                           Text="{DynamicResource posSettings.screen.languagePackHint}"
                           FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="0">
          <ToggleButton x:Name="LayoutGroupToggle" Classes="SettingsGroupHeader" IsChecked="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSoft}"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource posSettings.screen.groupScaleLayout}"
                         FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25BE;" IsVisible="{Binding #LayoutGroupToggle.IsChecked}"/>
              <TextBlock Grid.Column="2" Classes="SettingsGroupChevron" Text="&#x25B8;" IsVisible="{Binding !#LayoutGroupToggle.IsChecked}"/>
            </Grid>
          </ToggleButton>
          <Border Classes="SettingsGroupBody" IsVisible="{Binding #LayoutGroupToggle.IsChecked}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource posSettings.screen.uiScale}" Classes="SettingsCardTitle" FontSize="14"/>
                  <TextBlock x:Name="UiScaleValueText" Grid.Column="1" FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{DynamicResource posSettings.screen.uiScaleDesc}"
                           FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>
                <Slider x:Name="UiScaleSlider" x:FieldModifier="public" Minimum="50" Maximum="200"
                        TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                        ValueChanged="UiScaleSlider_ValueChanged"/>
              </StackPanel>

              <Separator Background="{DynamicResource BrushPanelSoft}" Height="1"/>

              <!-- Размер карточек каталога (2026-09-24): отдельно от общего масштаба. -->
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource posSettings.screen.tileSize}" Classes="SettingsCardTitle" FontSize="14"/>
                  <TextBlock x:Name="TileSizeValueText" Grid.Column="1" FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{DynamicResource posSettings.screen.tileSizeDesc}"
                           FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>
                <Slider x:Name="TileSizeSlider" Minimum="70" Maximum="160"
                        TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                        ValueChanged="TileSizeSlider_ValueChanged"/>
              </StackPanel>

              <Separator Background="{DynamicResource BrushPanelSoft}" Height="1"/>

              <!-- Макет главного экрана (2026-09-06) -->
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource posSettings.screen.layoutMode}" Classes="FieldLabel"/>
                <TextBlock Text="{DynamicResource posSettings.screen.layoutModeDesc}"
                           FontSize="11" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"/>
                <Grid ColumnDefinitions="*,8,*">
                  <RadioButton Grid.Column="0" x:Name="StandardLayoutRadio" x:FieldModifier="public"
                               Content="{DynamicResource posSettings.screen.layoutStandard}" Classes="ClickPill"
                               GroupName="MainLayoutMode"/>
                  <RadioButton Grid.Column="2" x:Name="OneCLayoutRadio" x:FieldModifier="public"
                               Content="{DynamicResource posSettings.screen.layoutOneC}" Classes="ClickPill"
                               GroupName="MainLayoutMode"/>
                </Grid>
              </StackPanel>

              <Separator Background="{DynamicResource BrushPanelSoft}" Height="1"/>

              <!-- Добавление в чек -->
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource posSettings.screen.addToCheckTitle}" Classes="FieldLabel"/>
                <Grid ColumnDefinitions="*,16,*">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{DynamicResource posSettings.screen.clickOnProduct}" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                    <Grid ColumnDefinitions="*,8,*">
                      <RadioButton Grid.Column="0" x:Name="DoubleClickToCartRadio" x:FieldModifier="public"
                                   Content="{DynamicResource posSettings.screen.doubleClick}" Classes="ClickPill"/>
                      <RadioButton Grid.Column="2" x:Name="SingleClickToCartRadio" x:FieldModifier="public"
                                   Content="{DynamicResource posSettings.screen.singleClick}" Classes="ClickPill"/>
                    </Grid>
                  </StackPanel>

                  <StackPanel Grid.Column="2" VerticalAlignment="Bottom" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource posSettings.screen.resetQtyAfterInput}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
                      <CheckBox Grid.Column="1" x:Name="ResetManualAddQtyCheck" x:FieldModifier="public" Classes="ToggleSwitch" IsChecked="True" IsEnabled="False"/>
                    </Grid>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Блок 2: Данные магазина в чеке -->
        <Border Classes="SettingsCard" Padding="14">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource posSettings.screen.receiptDataTitle}" Classes="SettingsCardTitle" FontSize="14"/>

            <Grid ColumnDefinitions="*,16,*">
              <!-- Название магазина -->
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{DynamicResource posSettings.screen.storeName}" Classes="FieldLabel"/>
                <TextBox x:Name="StoreNameBox" x:FieldModifier="public"
                         Classes="ModernTextBox" Height="36"
                         Watermark="{DynamicResource posSettings.screen.storeNameWatermark}"
                         ToolTip.Tip="{DynamicResource posSettings.screen.storeNameTooltip}"/>
              </StackPanel>

              <!-- Адрес магазина -->
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="{DynamicResource posSettings.screen.storeAddress}" Classes="FieldLabel"/>
                <TextBox x:Name="StoreAddressBox" x:FieldModifier="public"
                         Classes="ModernTextBox" Height="36"
                         Watermark="{DynamicResource posSettings.screen.storeAddressWatermark}"
                         ToolTip.Tip="{DynamicResource posSettings.screen.storeAddressTooltip}"/>
              </StackPanel>
            </Grid>

            <!-- ИНН в чеке -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource posSettings.screen.showInn}" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="{DynamicResource posSettings.screen.showInnDesc}" FontSize="11" Foreground="{DynamicResource BrushTextSoft}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="ShowInnCheck" x:FieldModifier="public"
                        Classes="ToggleSwitch" VerticalAlignment="Center"
                        ToolTip.Tip="{DynamicResource posSettings.screen.showInnDesc}"/>
            </Grid>

          </StackPanel>
        </Border>

        <StackPanel Spacing="8" Margin="0,4,0,0" HorizontalAlignment="Stretch">
          <TextBlock x:Name="SaveStatusText" x:FieldModifier="public"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushSuccess}"
                     FontSize="12"/>
          <Button Content="{DynamicResource common.save}"
                  Classes="btn-primary"
                  MinWidth="150"
                  HorizontalAlignment="Center"
                  Click="Save_Click"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
