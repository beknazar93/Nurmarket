<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.EmployeesSettingsView"
             x:CompileBindings="False"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>
    <Style Selector="TextBlock.EmployeeFieldLabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="TextBox.EmployeeCodeBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    </Style>
    <!-- 2026-10-19, этап О7: карточка сотрудника и кнопка «Доступы» — белые с рамкой (были тёмно-серые кнопки Fluent),
         наведение — мягкий фон. -->
    <Style Selector="Button.SettingsCard">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}"/>
      <Setter Property="MinHeight" Value="56"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.SettingsCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.SettingsCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost">
    <ScrollViewer Classes="SettingsPageScroll">
      <!-- 2026-10-21 (пакет 6, п. 64): справа 14 px под полосу прокрутки — кнопки «Доступы» уходили под неё (за край). -->
      <StackPanel Classes="SettingsCardList" MaxWidth="{DynamicResource SettingsPageMaxWidth}" HorizontalAlignment="Stretch" Margin="0,16,14,16">

        <Border Classes="SettingsHeaderCard" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" VerticalAlignment="Center">
              <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/> <!-- 2026-09-28: было Left — значок прилипал к краю плашки -->
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource posSettings.navEmployees}" Classes="SettingsPageTitle"/>
              <TextBlock Text="{DynamicResource employees.subtitle}" Classes="SettingsPageSubtitle" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 2026-10-19, этап О7: сначала сотрудники — «+ Добавить сотрудника» и «Загрузить с сайта» над списком (были под ним,
             а сверху — роли с девятью «Удалить»). Роли — внизу, свёрнуты. -->
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="AddEmployeeButton" Classes="btn-secondary" HorizontalAlignment="Left"
                  Content="{DynamicResource employees.addButton}" Click="AddEmployee_Click"/>
          <Button x:Name="LoadFromWebButton" Classes="btn-secondary" HorizontalAlignment="Left"
                  Content="{DynamicResource employees.loadFromWeb}" Click="LoadFromWeb_Click"/>
        </StackPanel>

        <!-- 2026-10-28: поиск по имени, почте и телефону (при десятках сотрудников список не пролистать). -->
        <TextBox x:Name="EmployeeSearchBox" MinHeight="40" TextChanged="EmployeeSearch_TextChanged"/>
        <StackPanel x:Name="EmployeeListPanel" Spacing="8"/>
        <!-- Подложка обязательна. Этот текст — единственный на странице, кто висел прямо на
             фоне страницы, а он прозрачный (Border.SettingsContentHost), и под ним видны обои
             рабочего стола. Цвет обоев произвольный, поэтому ни один цвет текста не может
             гарантировать читаемость: на скриншоте владельца сообщение «Добавлено сотрудников»
             легло на серый #6D6D6D и дало контраст 1.14:1. Остальной текст страницы лежит на
             карточках с непрозрачным BrushPanel и читается всегда — теперь и этот тоже. -->
        <Border x:Name="LoadStatusPanel" IsVisible="False"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource SettingsCardRadius}"
                Padding="14,10" HorizontalAlignment="Stretch">
          <TextBlock x:Name="LoadStatusText" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <Border Classes="SettingsCard" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource employees.saveHint}" FontSize="12"
                       Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
            <Button x:Name="SaveButton" Classes="btn-primary" HorizontalAlignment="Left"
                    Content="{DynamicResource common.save}" Click="Save_Click"/>
            <TextBlock x:Name="SavedNote" Text="{DynamicResource employees.saved}"
                       Foreground="{DynamicResource BrushSuccess}" FontSize="12" IsVisible="False"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="RolesCard" Spacing="0">
          <ToggleButton x:Name="RolesToggle" Classes="SettingsGroupHeader" IsChecked="False">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="RolesHeaderText" Text="{DynamicResource employees.rolesTitle}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="SettingsGroupChevron" Text="&#x25BE;" IsVisible="{Binding #RolesToggle.IsChecked}"/>
              <TextBlock Grid.Column="1" Classes="SettingsGroupChevron" Text="&#x25B8;" IsVisible="{Binding !#RolesToggle.IsChecked}"/>
            </Grid>
          </ToggleButton>
          <Border Classes="SettingsGroupBody" IsVisible="{Binding #RolesToggle.IsChecked}">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource employees.rolesSubtitle}" FontSize="12"
                         Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
              <StackPanel x:Name="RolesListPanel" Spacing="0"/>
              <Button x:Name="AddRoleButton" Classes="btn-secondary" HorizontalAlignment="Left"
                      Content="{DynamicResource employees.addRoleButton}" Click="AddRole_Click"/>
              <TextBlock x:Name="RolesStatusText" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
