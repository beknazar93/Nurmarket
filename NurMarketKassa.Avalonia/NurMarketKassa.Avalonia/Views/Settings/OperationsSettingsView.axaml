<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:NurMarketKassa.Models"
             xmlns:conv="using:NurMarketKassa.Converters"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.OperationsSettingsView"
             x:CompileBindings="False"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Resources>
    <!-- Объявляем конвертер -->
    <conv:PathToImageConverter x:Key="PathToImageConverter"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost">
    <ScrollViewer Classes="SettingsPageScroll">

      <StackPanel Classes="SettingsCardList" MaxWidth="{DynamicResource SettingsPageMaxWidth}" HorizontalAlignment="Stretch" Margin="0,16">

        <!-- Шапка -->
        <Border Classes="SettingsHeaderCard" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" VerticalAlignment="Center">
              <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource posSettings.navOperations}" Classes="SettingsPageTitle"/>
              <TextBlock Text="{DynamicResource operations.bankQrDesc}" Classes="SettingsPageSubtitle"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Сфера магазина (2026-09-25): продуктовый — как было, одежда — консультант при оплате,
             услуги — каталог открывается на услугах. Тексты — в коде (RefreshSphereUi). -->
        <Border Classes="SettingsCard" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock x:Name="SphereTitle" Classes="SettingsCardTitle" FontSize="14"/>
            <TextBlock x:Name="SphereHint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
            <WrapPanel Orientation="Horizontal">
              <RadioButton x:Name="SphereGroceryRadio" GroupName="MarketSphere" Classes="DatePill" Margin="0,0,8,8" Click="Sphere_Click"/>
              <RadioButton x:Name="SphereClothingRadio" GroupName="MarketSphere" Classes="DatePill" Margin="0,0,8,8" Click="Sphere_Click"/>
              <RadioButton x:Name="SphereServicesRadio" GroupName="MarketSphere" Classes="DatePill" Margin="0,0,8,8" Click="Sphere_Click"/>
            </WrapPanel>
            <TextBlock x:Name="SphereDescription" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
            <!-- 2026-09-28: итог сохранения вида магазина на сервере (market_sphere, BE-18). Текст — в коде. -->
            <TextBlock x:Name="SphereServerStatus" FontSize="12" TextWrapping="Wrap" IsVisible="False"
                       Foreground="{DynamicResource BrushTextSoft}"/>
          </StackPanel>
        </Border>

        <!-- Телеграм-бот владельца. 2026-10-05: на «Старте» — только если куплен в Маркетплейсе (TelegramCard, код). -->
        <Border x:Name="TelegramCard" Classes="SettingsCard" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource loc.settings.telegram.title}" Classes="SettingsCardTitle" FontSize="14"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.telegram.desc}"/>

            <!-- Главная кнопка блока: мастер ведёт по шагам и сам включает всё нужное.
                 Поля ниже остаются для тех, кто уже знает, что делает. -->
            <Button x:Name="TelegramWizardButton" Classes="PrimaryButton"
                    Content="{DynamicResource loc.settings.telegram.wizardButton}"
                    HorizontalAlignment="Left"
                    Click="TelegramWizard_Click"/>

            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.telegram.manualHint}"/>

            <TextBlock Text="{DynamicResource loc.settings.telegram.tokenLabel}" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
            <TextBox x:Name="TelegramTokenBox" x:FieldModifier="public"
                     PasswordChar="•" Watermark="123456789:AA..."/>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="TelegramDetectButton" Content="{DynamicResource loc.settings.telegram.detectRecipient}" Click="TelegramDetect_Click"/>
              <Button x:Name="TelegramTestButton" Content="{DynamicResource loc.settings.telegram.sendTest}" Click="TelegramTest_Click"/>
            </StackPanel>

            <TextBlock x:Name="TelegramStatusText" x:FieldModifier="public" FontSize="12"
                       TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>

            <CheckBox x:Name="TelegramSummaryCheck" x:FieldModifier="public" Classes="ToggleSwitch"
                      Content="{DynamicResource loc.settings.telegram.summaryOnClose}"
                      IsCheckedChanged="TelegramSummary_Changed"/>

            <CheckBox x:Name="TelegramCommandsCheck" x:FieldModifier="public" Classes="ToggleSwitch"
                      Content="{DynamicResource loc.settings.telegram.answerCommands}"
                      IsCheckedChanged="TelegramCommands_Changed"/>

            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.telegram.commandsHelp}"/>

            <Button x:Name="TelegramDebtRemindersButton" Content="{DynamicResource loc.settings.telegram.debtReminders}"
                    Click="TelegramDebtReminders_Click"/>

            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.telegram.debtRemindersHint}"/>

            <TextBlock Text="{DynamicResource loc.settings.telegram.ownerPhone}"
                       FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
            <TextBox x:Name="OwnerPhoneBox" x:FieldModifier="public" Watermark="+996 700 000000"
                     LostFocus="OwnerPhone_LostFocus"/>

            <!-- 2026-09-30, «добавь ИИ, чтобы бот отвечал и общался»: бесплатный ключ Google Gemini.
                 Есть ключ — на разговорные вопросы отвечает нейросеть (TelegramAiChat). -->
            <!-- 2026-10-05: ключи ИИ — только на «Стандарте» (TariffGate.CanUseAi), на «Старте» — строка о тарифе. -->
            <TextBlock x:Name="AiTariffLockText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}" IsVisible="False" Margin="0,8,0,0"/>
            <StackPanel x:Name="AiKeysPanel" Spacing="10">
            <TextBlock Text="{DynamicResource loc.settings.telegram.aiTitle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.telegram.aiHint}"/>
            <TextBox x:Name="TelegramAiKeyBox" x:FieldModifier="public" PasswordChar="•" Watermark="AIza..."
                     LostFocus="TelegramAiKey_LostFocus"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="{DynamicResource loc.settings.telegram.aiGetKey}" Click="TelegramAiGetKey_Click"/>
              <Button x:Name="TelegramAiTestButton" Content="{DynamicResource loc.settings.telegram.aiTest}" Click="TelegramAiTest_Click"/>
            </StackPanel>
            <TextBlock x:Name="TelegramAiStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>

            <!-- 2026-10-05, владелец: «где вставить ключ ИИ? тут нету» — ключи Groq (поиск в интернете, запасная модель)
                 и OpenRouter (запасные модели) рядом с ключом Gemini, так же: поле, «Получить бесплатный ключ», «Проверить». -->
            <TextBlock Text="{DynamicResource loc.settings.telegram.groqTitle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.telegram.groqHint}"/>
            <TextBox x:Name="GroqKeyBox" x:FieldModifier="public" PasswordChar="•" Watermark="gsk_..."
                     LostFocus="GroqKey_LostFocus"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="{DynamicResource loc.settings.telegram.aiGetKey}" Click="GroqGetKey_Click"/>
              <Button x:Name="GroqTestButton" Content="{DynamicResource loc.settings.telegram.groqTest}" Click="GroqTest_Click"/>
            </StackPanel>
            <TextBlock x:Name="GroqStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>

            <TextBlock Text="{DynamicResource loc.settings.telegram.routerTitle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.telegram.routerHint}"/>
            <TextBox x:Name="OpenRouterKeyBox" x:FieldModifier="public" PasswordChar="•" Watermark="sk-or-..."
                     LostFocus="OpenRouterKey_LostFocus"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="{DynamicResource loc.settings.telegram.aiGetKey}" Click="OpenRouterGetKey_Click"/>
              <Button x:Name="OpenRouterTestButton" Content="{DynamicResource loc.settings.telegram.aiTest}" Click="OpenRouterTest_Click"/>
            </StackPanel>
            <TextBlock x:Name="OpenRouterStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Работа без интернета (2026-09-27): обмен продажами между кассами по локальной сети
             и внутри одного компьютера. Тексты — в коде (RefreshLanUi). -->
        <Border Classes="SettingsCard" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock x:Name="LanTitle" Classes="SettingsCardTitle" FontSize="14"/>
            <TextBlock x:Name="LanDesc" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
            <CheckBox x:Name="LanEnabledCheck" Classes="ToggleSwitch" IsCheckedChanged="LanEnabled_Changed"/>
            <TextBlock x:Name="LanCodeLabel" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox x:Name="LanCodeBox" Grid.Column="0" MaxLength="40"/>
              <Button x:Name="LanSaveCodeButton" Grid.Column="1" Margin="8,0,0,0" Classes="btn-primary"
                      Click="LanSaveCode_Click"/>
              <Button x:Name="LanNewCodeButton" Grid.Column="2" Margin="8,0,0,0"
                      Click="LanNewCode_Click"/>
            </Grid>
            <TextBlock x:Name="LanFirewallHint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushWarning}"/>
            <TextBlock x:Name="LanStatusText" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
          </StackPanel>
        </Border>

        <!-- QR с суммой чека -->
        <Border Classes="SettingsCard" Padding="16">
          <StackPanel Spacing="8">
            <CheckBox x:Name="DynamicQrCheck" x:FieldModifier="public"
                      Classes="ToggleSwitch"
                      Content="{DynamicResource loc.settings.dynamicQr.toggle}"
                      IsCheckedChanged="DynamicQr_Changed"/>
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSoft}"
                       Text="{DynamicResource loc.settings.dynamicQr.desc}"/>
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushWarning}"
                       Text="{DynamicResource loc.settings.dynamicQr.warning}"/>
          </StackPanel>
        </Border>

        <!-- Список банков -->
        <ItemsControl x:Name="BankQrItemsControl" x:FieldModifier="public"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Classes="SettingsCardList" Spacing="10"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:BankQrSetting">
              <Border Classes="SettingsCard" Padding="16,14" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto">

                  <!-- Логотип банка: своя картинка (встроенная или загруженная кассиром) либо
                       общая иконка-заглушка, если ни того ни другого нет. Клик по логотипу —
                       загрузить/заменить его. -->
                  <Button Grid.Column="0" Tag="{Binding}" Click="ChangeLogo_Click"
                          Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,14,0"
                          ToolTip.Tip="{DynamicResource posSettings.operations.addBank}">
                    <Border Width="48" Height="48" CornerRadius="10"
                            Background="{DynamicResource BrushPanelSoft}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                      <Panel>
                        <Image Source="{Binding LogoPath, Converter={StaticResource PathToImageConverter}}"
                               Width="40" Height="40" Stretch="Uniform" Margin="4"
                               IsVisible="{Binding HasLogo}"/>
                        <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource BrushTextSoft}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding HasNoLogo}"/>
                      </Panel>
                    </Border>
                  </Button>

                  <!-- Название и статус QR -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding BankName}"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>

                    <!-- Банков в списке больше двух десятков, а магазин обычно работает с
                         одним-двумя. Кассиру в очереди показываем только отмеченные. -->
                    <CheckBox Content="{DynamicResource loc.settings.bank.showAtCheckout}"
                              IsChecked="{Binding ShowAtCheckout, Mode=TwoWay}"
                              FontSize="12"
                              Margin="0,2,0,2"
                              MinHeight="0"/>

                    <TextBlock Text="{DynamicResource operations.qrNotLoaded}"
                               FontSize="12" Foreground="{DynamicResource BrushTextSoft}"
                               IsVisible="{Binding !HasQrCode}"/>

                    <!-- Превью QR-кода -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding HasQrCode}">
                      <Image Source="{Binding QrCodePath, Converter={StaticResource PathToImageConverter}}"
                             Width="48" Height="48" Stretch="Uniform"/>
                      <TextBlock Text="{DynamicResource operations.qrLoaded}" FontSize="12" Foreground="{DynamicResource BrushUiStatusOk}" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Загрузка, обрезка и удаление QR-кода -->
                  <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Center">
                    <Button Content="{DynamicResource posSettings.operations.uploadQr}"
                            Classes="SettingsFlatButton"
                            Height="36" Padding="16,6"
                            Tag="{Binding}"
                            Click="LoadQrCode_Click"/>

                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding HasQrCode}">
                      <Button Grid.Column="0"
                              Content="{DynamicResource posSettings.operations.crop}"
                              Classes="SettingsFlatButton"
                              Height="34" Padding="10,5"
                              Tag="{Binding}"
                              Click="EditQrCode_Click"/>
                      <Button Grid.Column="2"
                              Content="{DynamicResource posSettings.operations.removeQr}"
                              Classes="SettingsFlatButton"
                              Foreground="{DynamicResource BrushDanger}"
                              Height="34" Padding="10,5"
                              Tag="{Binding}"
                              Click="RemoveQrCode_Click"/>
                    </Grid>

                    <Button Content="{DynamicResource posSettings.operations.removeBank}"
                            Classes="SettingsFlatButton"
                            Foreground="{DynamicResource BrushDanger}"
                            Height="34" Padding="10,5"
                            Tag="{Binding}"
                            IsVisible="{Binding IsCustom}"
                            Click="RemoveBank_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{DynamicResource posSettings.operations.addBank}"
                Classes="SettingsFlatButton"
                HorizontalAlignment="Center"
                Height="38" Padding="18,8" Margin="0,4,0,0"
                Click="AddBank_Click"/>

        <!-- Программа лояльности переехала в Маркетплейс → Доп. функции как платная доп. услуга
             (2026-09-05) — раньше была бесплатным переключателем прямо здесь; теперь включается
             только покупкой (см. MarketplaceView.BuildLoyaltyCard), без отдельного тумблера.
             Но вместе с тумблером тогда исчез и ПРОЦЕНТ начисления: изменить его стало негде,
             и он навсегда оставался равным 5 (UserPreferences.LoyaltyEarnPercent). Карточка
             ниже возвращает только процент и видна лишь после покупки. -->
        <Border Classes="SettingsCard" Padding="14" Margin="0,6,0,0"
                x:Name="LoyaltyCard" x:FieldModifier="public">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource posSettings.operations.loyaltyTitle}" Classes="SettingsCardTitle" FontSize="14"/>
            <Grid ColumnDefinitions="Auto,12,110">
              <TextBlock Grid.Column="0"
                         Text="{DynamicResource posSettings.operations.loyaltyEarnPercent}"
                         Classes="FieldLabel" VerticalAlignment="Center"/>
              <TextBox Grid.Column="2" x:Name="LoyaltyEarnPercentBox" x:FieldModifier="public"
                       Classes="ModernTextBox" Height="36"/>
            </Grid>
            <TextBlock Text="{DynamicResource posSettings.operations.loyaltyHint}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSoft}"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
