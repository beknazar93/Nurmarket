<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppTheme.axaml"/>
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="BrushAccent" Color="#2563EB" />
  <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB" />
  <SolidColorBrush x:Key="BrushAccentStrong" Color="#1D4ED8" />
  <!-- 2026-10-18: нажатые кнопки и красный текст на мягком красном (до применения темы; дальше их считает AccentThemeService). -->
  <SolidColorBrush x:Key="BrushAccentPressed" Color="#1841CD" />
  <SolidColorBrush x:Key="BrushPanelPressed" Color="#3E3E3E" />
  <SolidColorBrush x:Key="BrushDangerOnSoft" Color="#F58282" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="#1E3A8A" />
  <SolidColorBrush x:Key="BrushAccentForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrushLoginHeroTitle" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrushLoginHeroSubtitle" Color="#E2E8F0" />
  <!-- 2026-10-27, жалоба «в тёмной теме у кнопок не видно надписей»: кнопки без своего стиля (и состояния, которых в стилях нет) берут цвета Fluent:
       нажатая — серая заливка #7A7A7A под белым/серым текстом (4,3:1, у кнопок с серым текстом «▾» — 1,9:1), выключенная — #959595 на #4E4E4E (2,8:1).
       Здесь тёмные значения: нажатая — #3A3A3A (белый 11,5:1, серый #AAA 4,9:1), выключенная — #333333 с текстом #A8A8A8 (5,3:1; у кнопок с Opacity 0,6 ≈3,4:1). Светлая тема не меняется. -->
  <!-- Текст на кнопке с фоном BrushWarning (золотой #D7BA7D): тёмный, 9,9:1 (белый был 1,9:1). -->
  <SolidColorBrush x:Key="BrushOnWarning" Color="#191919" />
  <!-- Красная ЗАЛИВКА под белым текстом (наведение «Выйти», «Расход», «Закрыть смену» красная): BrushDanger #F14C4C с белым — 3,6:1; #DC2626 — 4,8:1. В светлой теме = BrushDanger. -->
  <SolidColorBrush x:Key="BrushDangerFill" Color="#DC2626" />
  <!-- Акцент как ТЕКСТ/значок на панели: BrushAccentStrong в тёмной «Классической» — #1D4ED8 (1,9:1 на #3A3A3B, цена и значок не видны). До применения темы; дальше считает AccentThemeService. -->
  <SolidColorBrush x:Key="BrushAccentText" Color="#7FA6F5" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#333333" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#A8A8A8" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#333333" />
  <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#A8A8A8" />
</ResourceDictionary>
