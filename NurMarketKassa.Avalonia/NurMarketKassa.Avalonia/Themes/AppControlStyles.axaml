<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Плавность интерфейса (по просьбе пользователя, 2026-09-19): "максимально плавный
       интерфейс, везде где можно". Этот файл уже подключён глобально через App.axaml
       (StyleInclude), поэтому Transitions отсюда сразу применяются во всём приложении без
       правки каждого окна по отдельности.

       Поле ввода при фокусе не переопределяется здесь заново — цвет рамки на фокусе уже
       задаётся локально в каждом окне (селектор "TextBox:focus /template/
       Border#PART_BorderElement", ~14 мест). Здесь добавлены только Transitions на ТОТ ЖЕ
       элемент — любая такая смена цвета начинает анимироваться плавно (0.5-0.6с) вместо
       мгновенного скачка, плюс лёгкое увеличение самого поля при фокусе. -->
  <Style Selector="TextBox">
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- 2026-10-23: было scale(1.015) — у широкого поля (приём товара, ~1080 px) это +8 px с каждой стороны: поле наезжало на соседнюю
       кнопку («Товары поставщика»). 1.004 — те же плавность и отклик, но не больше 2–3 px у самых широких полей. -->
  <Style Selector="TextBox:focus">
    <Setter Property="RenderTransform" Value="scale(1.004)"/>
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.55"/>
        <BrushTransition Property="Background" Duration="0:0:0.55"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- Кнопки: лёгкая обратная связь при наведении/нажатии вместо мгновенной смены —
       не трогает существующие шаблоны кнопок (main-ghost/main-primary/PrimaryActionButton
       и т.п.), только добавляет RenderTransform поверх того, что уже нарисовано. -->
  <Style Selector="Button">
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.012)"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
  <!-- 2026-11-06, А-12: кнопки в плотных рядах (вкладки чеков и настроек, чипы категорий, плитки каталога, строки таблиц) при наведении
       не растут на 1,2 % и не наползают на соседей; нажатие (0,98) оставлено — оно нужно для отклика и идёт позже наведения. -->
  <Style Selector="Button.receipt-tab:pointerover, Button.new-receipt-tab:pointerover, Button.SettingsTab:pointerover, Button.header-menu:pointerover, Button.header-more:pointerover, Button.header-secondary:pointerover, Button.header-tool:pointerover, Button.top-tool:pointerover, Button.main-ghost:pointerover, Button.lx-chip:pointerover, Button.lx-tile:pointerover, Button.lx-btn:pointerover, Button.mn-tab:pointerover, Button.pr-tab:pointerover, Button.onec-tab:pointerover, Button.row-act:pointerover, Button.row-more:pointerover, Button.foot-pay:pointerover, Button.pay-quick:pointerover, Button.PrimaryButton:pointerover, Button.HamburgerMenuItem:pointerover, Button.catalog-pager:pointerover, Button.kbItem:pointerover">
    <Setter Property="RenderTransform" Value="scale(1)"/>
  </Style>
  <Style Selector="Button.receipt-tab:pressed, Button.new-receipt-tab:pressed, Button.SettingsTab:pressed, Button.header-menu:pressed, Button.header-more:pressed, Button.header-secondary:pressed, Button.header-tool:pressed, Button.top-tool:pressed, Button.main-ghost:pressed, Button.lx-chip:pressed, Button.lx-tile:pressed, Button.lx-btn:pressed, Button.mn-tab:pressed, Button.pr-tab:pressed, Button.onec-tab:pressed, Button.row-act:pressed, Button.row-more:pressed, Button.foot-pay:pressed, Button.pay-quick:pressed, Button.PrimaryButton:pressed, Button.HamburgerMenuItem:pressed, Button.catalog-pager:pressed, Button.kbItem:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>

  <!-- 2026-10-27, жалоба «в тёмной теме у кнопок не видно надписей»: значок PathIcon внутри кнопки НЕ наследует цвет кнопки —
       Fluent красит его в цвет темы (в тёмной белый). Белый значок «карточки» на жёлтой «Оплатить» (#FFB208) — 1,8:1, то же у кнопок
       «Распечатать», «Сохранить», «Добавить», красные значки на красных/светлых плашках. Теперь значок берёт цвет надписи кнопки
       (Foreground её ContentPresenter — он же меняется при наведении/нажатии/отключении). Явный Foreground значка и стили ниже по
       дереву (стили окон, Button.cart-qty PathIcon и т. п.) по-прежнему главнее. В светлой теме цвет значков тот же, что был
       (тёмная надпись), меняются только значки на цветных кнопках. -->
  <Style Selector="Button PathIcon, ToggleButton PathIcon, RadioButton PathIcon" x:CompileBindings="False">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}"/>
  </Style>

  <!-- CheckBox/ToggleSwitch/ComboBox — та же плавная смена фона/рамки. -->
  <Style Selector="ComboBox /template/ Border#PART_Border">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.4"/>
      </Transitions>
    </Setter>
  </Style>
</Styles>
