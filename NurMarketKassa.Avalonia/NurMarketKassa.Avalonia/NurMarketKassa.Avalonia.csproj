<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia UI host only. Business logic comes from shared projects. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>NurMarketKassa.AvaloniaHost</RootNamespace>
    <AssemblyName>NurMarketKassa.Avalonia</AssemblyName>
    <!-- ВАЖНО: держать в точности как версию, переданную vpk pack (packVersion) — иначе
         внутренняя версия exe отстаёт от версии пакета навсегда, и автообновление в самом
         приложении вечно видит "доступна новая версия", даже сразу после обновления (баг,
         живьём пойманный 2026 09 16: exe молча оставался на 1.16.20.0 ещё три релиза подряд,
         1.16.21, 1.16.22, 1.16.23, потому что здесь никто не поднимал версию). -->
    <Version>1.17.5</Version>
    <AssemblyVersion>1.17.5</AssemblyVersion>
    <FileVersion>1.17.5</FileVersion>
    <!-- Меньше JIT-компиляции при старте — заметно на слабых CPU (моноблоки, старые ноутбуки). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\*.bak;**\*.wpfbak;**\*.shellbak;**\*.Thin.cs;**\*.Legacy.cs;**\_wpf_port_backup\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Windows" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.5" />
    <!-- Needed by the AvaloniaVS previewer: its force-include resolution fails for net*-windows TFMs (AvaloniaVS#640) -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.5" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.2.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\NurMarketKassa\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\NurMarketKassa\Assets')" />
    <AvaloniaResource Include="..\NurMarketKassa.Assets\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\NurMarketKassa.Assets\Assets')" />
  </ItemGroup>

	<!-- Подключаем все файлы из локальной папки Assets как ресурсы Avalonia -->
	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="..\NurMarketKassa\Assets\Login1.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared application code — single source of truth for models/services/VMs -->
    <ProjectReference Include="..\NurMarketKassa.ViewModels\NurMarketKassa.ViewModels.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Infrastructure\NurMarketKassa.Infrastructure.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Core\NurMarketKassa.Core.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Ui.Shared\NurMarketKassa.Ui.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="publish-defaults.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Always" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="AnyDesk\AnyDesk.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <!-- Офлайн-модель распознавания речи (Vosk, ~88 МБ) БОЛЬШЕ НЕ входит в базовую установку
         (2026-09-04) — голосовое управление стало платной доп. услугой (MarketplaceView,
         "Доп. функции" → VoiceModelDownloadService), пакет скачивается отдельно после
         разблокировки, чтобы не утяжелять установщик всем кассирам. Папка остаётся в
         репозитории как источник для сборки voice-model-ru.zip, который заливается в релиз. -->
  </ItemGroup>
</Project>
