<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
             x:Class="NurMarketKassa.AvaloniaHost.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <conv:BoolToIsVisibleConverter x:Key="BoolToVis"/>
      <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
      <conv:PriceAmountConverter x:Key="PriceAmountConverter"/>

      <!-- Форма элементов (радиус скругления карточек/кнопок) — базовые значения "как всегда
           было"; тема из Маркетплейса переопределяет их через Application.Resources так же,
           как переопределяет цвет (см. AccentThemeService). -->
      <CornerRadius x:Key="SettingsCardRadius">12</CornerRadius>
      <CornerRadius x:Key="SettingsButtonRadius">10</CornerRadius>

      <!-- 2026-11-13 (Д-8, согласие владельца 13.11): ЕДИНАЯ ШКАЛА РАЗМЕРОВ. Новые и переделанные экраны берут только эти ключи
           (DynamicResource), а не свои числа. Шрифт — 5 размеров, радиус — 3, высота элемента — 3, отступ — 5 шагов.
           Размеры не зависят от светлой/тёмной темы, поэтому лежат здесь, а не в AppTheme*.axaml (там только цвета).
           NurRadiusControl / NurRadiusCard переехали из PosDialogStyles.axaml: тема из Маркетплейса пишет в них те же значения,
           что в SettingsButtonRadius / SettingsCardRadius (AccentThemeService), — радиус кнопки и поля один на всю программу. -->
      <x:Double x:Key="NurFontCaption">12.5</x:Double>
      <x:Double x:Key="NurFontBody">14</x:Double>
      <x:Double x:Key="NurFontSubtitle">16</x:Double>
      <x:Double x:Key="NurFontTitle">20</x:Double>
      <x:Double x:Key="NurFontDisplay">26</x:Double>
      <!-- Радиусы: плашка/значок — кнопка/поле — карточка/окно. -->
      <CornerRadius x:Key="NurRadiusSmall">6</CornerRadius>
      <CornerRadius x:Key="NurRadiusControl">10</CornerRadius>
      <CornerRadius x:Key="NurRadiusCard">12</CornerRadius>
      <!-- Высоты: плотный ряд (чип, кнопка в строке таблицы) — кнопка/поле/сегмент (обычная и сенсорная цель ≥ 44) — главное действие экрана. -->
      <x:Double x:Key="NurHeightCompact">36</x:Double>
      <x:Double x:Key="NurHeightControl">44</x:Double>
      <x:Double x:Key="NurHeightLarge">52</x:Double>
      <!-- Отступы: шаги 4 / 8 / 12 / 16 / 24 и готовые поля кнопки, карточки, содержимого окна. -->
      <x:Double x:Key="NurSpace1">4</x:Double>
      <x:Double x:Key="NurSpace2">8</x:Double>
      <x:Double x:Key="NurSpace3">12</x:Double>
      <x:Double x:Key="NurSpace4">16</x:Double>
      <x:Double x:Key="NurSpace5">24</x:Double>
      <!-- 2026-11-21 (жалоба владельца «отступов не хватает»): единая шкала 4/8/12/16/24 подтянута в общих стилях. Плотные значения AccentThemeService
           подставляет в тему «Плотная» (высота элемента ≤ 34) — там остаются прежние, тесные отступы.
           Было → стало: NurPadButton 16,0 → 18,0; NurPadWindow 24,18 → 24,20; новые: NurPadButtonMain (кнопки main-*) 18,8; NurPadChip 16,0;
           NurPadField (поле в модалке) 12,5. -->
      <Thickness x:Key="NurPadButton">18,0</Thickness>
      <Thickness x:Key="NurPadButtonMain">18,8</Thickness>
      <Thickness x:Key="NurPadChip">16,0</Thickness>
      <Thickness x:Key="NurPadField">12,5</Thickness>
      <Thickness x:Key="NurPadCard">16</Thickness>
      <Thickness x:Key="NurPadWindow">24,20</Thickness>

      <!-- Шрифт приложения — базовые значения "как всегда было"; настраивается в модалке
           "⚙ Настройка темы" (см. AccentThemeService.ApplyFontResources). Noto Sans встроен
           шрифтом ресурсом приложения (Assets/Fonts, 2026-09-04) и стоит первым в списке —
           гарантированно содержит кыргызские буквы ө/ү/ң (в отличие от Segoe UI, которая на
           некоторых POS-терминалах оказывается урезанной сборкой без кириллических расширений
           и рисует эти буквы квадратами); Segoe UI оставлена вторым вариантом на случай, если в
           Noto Sans не найдётся какой-то другой символ. -->
      <!-- 2026-10-22, брендбук NUR CRM: основной шрифт Montserrat (вшит), Noto Sans — запасной для глифов. -->
      <FontFamily x:Key="AppFontFamily">avares://NurMarketKassa.Avalonia/Assets/Fonts#Montserrat, Noto Sans, Segoe UI</FontFamily>
      <!-- 2026-10-22, брендбук NUR CRM: шрифт заголовков и крупных чисел — Onest Bold (OFL, вшит), ближайший бесплатный к TT Firs Neue Bold;
           класс TextBlock.brand-h; когда появится TT Firs Neue — заменить только эту строку. -->
      <!-- 2026-11-01 (контрольный аудит, Д-17): у Onest нет запасного и нет символа ʻ (U+02BB, узбекское oʻ) — запас Montserrat, Noto Sans, как у AppFontFamily. -->
      <FontFamily x:Key="AppHeadingFontFamily">avares://NurMarketKassa.Avalonia/Assets/Fonts#Onest Heading, Montserrat, Noto Sans, Segoe UI</FontFamily>
      <x:Double x:Key="AppFontSize">14</x:Double>

      <!-- Раскладка каталога и элементов — базовые значения «как всегда было». Тема из
           Маркетплейса переопределяет их вместе с цветом (см. AccentThemeService.Apply):
           «Сенсорная» увеличивает плитку и кнопки, «Плотная» уменьшает. -->
      <x:Double x:Key="CatalogTileWidth">190</x:Double>
      <x:Double x:Key="CatalogTileHeight">204</x:Double>
      <x:Double x:Key="CatalogTilePhotoHeight">64</x:Double>
      <x:Double x:Key="CatalogTileNameSize">14</x:Double>
      <x:Double x:Key="CatalogTilePriceSize">24</x:Double>
      <x:Double x:Key="CatalogTileStockSize">13</x:Double>
      <x:Double x:Key="AppControlHeight">36</x:Double>
      <Thickness x:Key="AppBorderThickness">1</Thickness>
      <!-- 2026-09-30: полоса орнамента под шапкой — видна только у темы «Кыргыз»
           (AccentThemeService.ApplyOrnament задаёт высоту и узор). -->
      <x:Double x:Key="OrnamentBandHeight">0</x:Double>
      <SolidColorBrush x:Key="BrushOrnamentBand" Color="Transparent"/>
      <!-- Основная кнопка диалогов и настроек (btn-primary, PosDialogStyles) — синяя во всех
           темах, кроме «Кыргыз» (там акцент темы). -->
      <!-- 2026-10-23 (аудит Б-9): по умолчанию — брендовый жёлтый (как sec-primary / UiKit.Primary), было синее #2563EB;
           у каждой темы AccentThemeService.ApplyCore подставляет акцент темы. -->
      <SolidColorBrush x:Key="BrushPrimaryAction" Color="#FFB208"/>
      <SolidColorBrush x:Key="BrushPrimaryActionHover" Color="#E69F00"/>
      <SolidColorBrush x:Key="BrushPrimaryActionPressed" Color="#CC8800"/>
      <SolidColorBrush x:Key="BrushPrimaryActionForeground" Color="#191919"/>
      <!-- 2026-10-16, редизайн: рамка поля в фокусе в модалках (ModalShell); тема задаёт свою
           (AccentThemeService.ApplyCore — цвет фокуса темы, если он заметен на поле, иначе цвет текста). -->
      <SolidColorBrush x:Key="BrushFocusRing" Color="#2563EB"/>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppThemeDark.axaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppThemeLight.axaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/KeyboardIcons.axaml"/>
        <!-- Векторные значки кассы (редизайн 2026-09-28): один набор на все раскладки и окна. -->
        <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppIcons.axaml"/>
        <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Dialogs/PosDialogTheme.axaml"/>
        <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Dialogs/NurMarketDialogTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppControlStyles.axaml"/>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Themes/MobileInputStyles.axaml"/>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Dialogs/PosDialogStyles.axaml"/>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Shared/ShiftHistoryResources.axaml"/>
    <!-- Шрифт темы. Одного Setter'а на Window мало: FluentTheme задаёт начертание своим
         шаблонам, и наследование от окна до текста не доходит — тема со своим шрифтом
         («Терминал») не меняла на экране ничего. Селектор исключает значки: у них своё
         начертание Segoe MDL2, и без исключения вместо иконок были бы квадраты. Поля ввода и
         кнопки перечислены отдельно — у них шрифт тоже приходит из шаблона Fluent. -->
    <Style Selector="TextBlock:not(.mdl2)">
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <!-- Суммы и цены: цифры одинаковой ширины (редизайн 2026-09-28, см. AccentThemeService). -->
    <!-- 2026-10-22: заголовки разделов и крупные числа — Onest Bold (класс brand-h); цифры остаются табличными (num). -->
    <Style Selector="TextBlock.brand-h">
      <Setter Property="FontFamily" Value="{DynamicResource AppHeadingFontFamily}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontFeatures" Value="{DynamicResource TabularNumbers}"/>
    </Style>
    <!-- 2026-11-11 (аудит «Закупки», БП-3): у полей-чисел (класс num — ячейки приёмки) цифры тоже одинаковой ширины: разряды не «скачут» по строкам. -->
    <Style Selector="TextBox.num">
      <Setter Property="FontFeatures" Value="{DynamicResource TabularNumbers}"/>
    </Style>

    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://NurMarketKassa.Avalonia/Assets/app-icon.ico"/>
      <!-- 2026-09-30: фон окон — BrushWindowBackdrop (узор у темы «Кыргыз», у остальных = BrushWindow). -->
      <Setter Property="Background" Value="{DynamicResource BrushWindowBackdrop}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
      <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
    </Style>
    <!-- 2026-11-01 (контрольный аудит, Д2-01): рамка полей ввода — BrushInputBorder (≥ 3:1 к фону поля в любой теме; BrushBorder был 1,4–1,7:1, WCAG 1.4.11). -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrushText}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
    </Style>
    <Style Selector="DatePicker">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
    </Style>
    <!-- Календарь. Раньше не оформлялся вообще: выпадающая панель приходила из темы Fluent
         со своим фоном и своими цветами, поэтому в окне ABC-анализа она выглядела чужеродной
         белой таблицей поверх тёмного интерфейса, а выбранный день терялся. Стили общие для
         всей программы, а не только для одного окна: CalendarDatePicker используется и в
         других местах, и разнобой был бы заметнее самой проблемы. -->
    <Style Selector="CalendarDatePicker">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource NurRadiusControl}"/>
      <Setter Property="MinHeight" Value="{DynamicResource NurHeightControl}"/>
    </Style>
    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- 2026-10-20 (живой аудит кассы, К18): значок календаря Fluent в полях дат рисовался без рамки — оставались точка и
         число «•20» (Прокат, долг, Табель). Вместо него — обычный значок календаря в цветах темы; кнопка та же (PART_Button). -->
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Width="28" Padding="4,0,6,0" VerticalAlignment="Stretch">
            <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Stroke="{DynamicResource BrushTextSoft}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M8,2 V6 M16,2 V6 M3,10 H21 M5,4 H19 A2,2 0 0 1 21,6 V20 A2,2 0 0 1 19,22 H5 A2,2 0 0 1 3,20 V6 A2,2 0 0 1 5,4 Z"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Calendar">
      <Setter Property="Background" Value="{DynamicResource BrushPanelElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource NurRadiusControl}"/>
    </Style>

    <!-- Сетка дней лежит на собственном фоне CalendarItem из темы Fluent. Без этого правила
         она остаётся серо-голубой плашкой поверх белой карточки диалога (и наоборот в тёмной
         теме) — сам Calendar.Background до неё не доходит. -->
    <Style Selector="CalendarItem">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Сетку дней рисует Grid внутри шаблона CalendarItem, и у него свой фон из темы
         Fluent: ни Calendar.Background, ни CalendarItem.Background до него не доходят. -->
    <Style Selector="CalendarItem /template/ Grid">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    </Style>
    <Style Selector="Calendar /template/ CalendarItem">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Шапка «август 2026 г.» и стрелки переключения месяца. -->
    <Style Selector="Calendar /template/ Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Подписи дней недели: приглушённые, чтобы не спорили с числами. -->
    <Style Selector="Calendar /template/ Grid#PART_MonthView > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="CalendarDayButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="{DynamicResource NurRadiusSmall}"/>
    </Style>
    <!-- Дни соседних месяцев — бледные: это подсказка, а не выбор. -->
    <Style Selector="CalendarDayButton:inactive">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="CalendarDayButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="CalendarDayButton:selected">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextInverted}"/>
    </Style>
    <!-- Сегодняшний день: обводкой, а не заливкой, иначе спорит с выбранным. -->
    <Style Selector="CalendarDayButton:today">
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="CalendarButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="{DynamicResource NurRadiusSmall}"/>
    </Style>
    <Style Selector="CalendarButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="CalendarButton:selected">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextInverted}"/>
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 2026-10-04, редизайн под Android-телефон: вкладки разделов (Склад: Товары, Приёмка, Ревизия, Списание…)
         переносились в 4 строки и съедали пол-экрана. На узком экране — одной строкой, листаются пальцем. Класс
         android-narrow ставит окнам Android-оболочка (WindowLayerHost) только на узком экране; в Windows его нет.
         Вкладки каталога кассы уже в своей прокрутке — их не трогаем. -->
    <Style Selector=".android-narrow TabControl[TabStripPlacement=Top]:not(.catalog-tabs)">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}"
                  HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalAlignment}">
            <DockPanel>
              <ScrollViewer DockPanel.Dock="Top"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </ScrollViewer>
              <ContentPresenter Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
