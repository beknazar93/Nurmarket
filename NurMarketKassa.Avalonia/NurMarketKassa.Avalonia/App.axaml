<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
             x:Class="NurMarketKassa.AvaloniaHost.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <conv:BoolToIsVisibleConverter x:Key="BoolToVis"/>
      <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
      <conv:PriceAmountConverter x:Key="PriceAmountConverter"/>

      <!-- Форма элементов (радиус скругления карточек/кнопок) — базовые значения "как всегда
           было"; тема из Маркетплейса переопределяет их через Application.Resources так же,
           как переопределяет цвет (см. AccentThemeService). -->
      <CornerRadius x:Key="SettingsCardRadius">12</CornerRadius>
      <CornerRadius x:Key="SettingsButtonRadius">10</CornerRadius>

      <!-- Шрифт приложения — базовые значения "как всегда было"; настраивается в модалке
           "⚙ Настройка темы" (см. AccentThemeService.ApplyFontResources). Noto Sans встроен
           шрифтом ресурсом приложения (Assets/Fonts, 2026-09-04) и стоит первым в списке —
           гарантированно содержит кыргызские буквы ө/ү/ң (в отличие от Segoe UI, которая на
           некоторых POS-терминалах оказывается урезанной сборкой без кириллических расширений
           и рисует эти буквы квадратами); Segoe UI оставлена вторым вариантом на случай, если в
           Noto Sans не найдётся какой-то другой символ. -->
      <FontFamily x:Key="AppFontFamily">avares://NurMarketKassa.Avalonia/Assets/Fonts#Noto Sans, Segoe UI</FontFamily>
      <x:Double x:Key="AppFontSize">14</x:Double>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppThemeDark.axaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppThemeLight.axaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/KeyboardIcons.axaml"/>
        <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Dialogs/PosDialogTheme.axaml"/>
        <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Dialogs/NurMarketDialogTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppControlStyles.axaml"/>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Dialogs/PosDialogStyles.axaml"/>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Shared/ShiftHistoryResources.axaml"/>
    <!-- Шрифт темы. Одного Setter'а на Window мало: FluentTheme задаёт начертание своим
         шаблонам, и наследование от окна до текста не доходит — тема со своим шрифтом
         («Терминал») не меняла на экране ничего. Селектор исключает значки: у них своё
         начертание Segoe MDL2, и без исключения вместо иконок были бы квадраты. Поля ввода и
         кнопки перечислены отдельно — у них шрифт тоже приходит из шаблона Fluent. -->
    <Style Selector="TextBlock:not(.mdl2)">
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://NurMarketKassa.Avalonia/Assets/app-icon.ico"/>
      <Setter Property="Background" Value="{DynamicResource BrushWindow}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
      <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrushText}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>
    <Style Selector="DatePicker">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>
    <!-- Календарь. Раньше не оформлялся вообще: выпадающая панель приходила из темы Fluent
         со своим фоном и своими цветами, поэтому в окне ABC-анализа она выглядела чужеродной
         белой таблицей поверх тёмного интерфейса, а выбранный день терялся. Стили общие для
         всей программы, а не только для одного окна: CalendarDatePicker используется и в
         других местах, и разнобой был бы заметнее самой проблемы. -->
    <Style Selector="CalendarDatePicker">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Calendar">
      <Setter Property="Background" Value="{DynamicResource BrushPanelElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Сетка дней лежит на собственном фоне CalendarItem из темы Fluent. Без этого правила
         она остаётся серо-голубой плашкой поверх белой карточки диалога (и наоборот в тёмной
         теме) — сам Calendar.Background до неё не доходит. -->
    <Style Selector="CalendarItem">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Сетку дней рисует Grid внутри шаблона CalendarItem, и у него свой фон из темы
         Fluent: ни Calendar.Background, ни CalendarItem.Background до него не доходят. -->
    <Style Selector="CalendarItem /template/ Grid">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    </Style>
    <Style Selector="Calendar /template/ CalendarItem">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Шапка «август 2026 г.» и стрелки переключения месяца. -->
    <Style Selector="Calendar /template/ Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Подписи дней недели: приглушённые, чтобы не спорили с числами. -->
    <Style Selector="Calendar /template/ Grid#PART_MonthView > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="CalendarDayButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <!-- Дни соседних месяцев — бледные: это подсказка, а не выбор. -->
    <Style Selector="CalendarDayButton:inactive">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="CalendarDayButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="CalendarDayButton:selected">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextInverted}"/>
    </Style>
    <!-- Сегодняшний день: обводкой, а не заливкой, иначе спорит с выбранным. -->
    <Style Selector="CalendarDayButton:today">
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="CalendarButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="CalendarButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="CalendarButton:selected">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextInverted}"/>
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Application.Styles>
</Application>
