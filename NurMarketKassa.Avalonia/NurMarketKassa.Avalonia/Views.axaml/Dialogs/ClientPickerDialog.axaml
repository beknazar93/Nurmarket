<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NurMarketKassa.ViewModels"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ClientPickerDialog"
        x:DataType="vm:CheckoutViewModel"
        x:CompileBindings="False"
        Title="{DynamicResource csh.checkout.chooseClient}"
        Width="512" Height="720" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        FontFamily="Segoe UI"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <Style Selector="Button.ClientRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Button.ClientRow:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 (окно 512 × 600, не выше 85 %
         экрана) — заголовок и ✕ сверху, «Закрыть» (обводка, Esc — как прежний ✕) внизу справа. Список клиентов
         прокручивается сам (ContentScroll="Disabled"), поиск над ним на месте. Клиент выбирается касанием строки. -->
    <dlg:ModalShell Margin="16"
                    Title="{DynamicResource csh.checkout.chooseClient}"
                    ContentScroll="Disabled">
        <dlg:ModalShell.Footer>
            <Button IsCancel="True"
                    Classes="modal-cancel" MaxWidth="200"
                    Content="{DynamicResource common.close}"
                    Click="Close_Click"/>
        </dlg:ModalShell.Footer>

            <!-- 2026-09-24, редизайн по просьбе владельца: вместо плашек с переносом — обычный
                 список. Слева кружок с инициалами, имя крупно, телефон под ним; поиск прижат
                 сверху, «Новый клиент» раскрывается отдельно внизу и не отнимает место у списка. -->
            <Grid x:Name="PickerGrid" RowDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBox Grid.Row="0" Text="{Binding ClientSearchText}"
                         Watermark="{DynamicResource csh.checkout.clientSearchWatermark}"
                         Height="46" FontSize="15" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="{DynamicResource csh.checkout.loadingClients}"
                           IsVisible="{Binding IsLoadingClients}"
                           FontSize="12" Margin="2,0,0,8"
                           Foreground="{DynamicResource BrushTextSoft}"/>

                <!-- 2026-10-21 (пакет 6, п. 26): окно 720 (было 600 — видно 4 строки), раскрытый «Новый клиент» больше не сжимает
                     список в полоску — пока форма открыта, список скрыт (ClientPickerDialog.OnNewClientExpanded); пустой поиск — «не найдено» (NotFoundText, текст в коде). -->
                <Border x:Name="ClientListBorder" Grid.Row="2" CornerRadius="10" MinHeight="112"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                    <TextBlock x:Name="NotFoundText" IsVisible="False" Margin="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="13.5"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="ClientRow"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="12,9" MinHeight="56"
                                            CornerRadius="0"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="0,0,0,1"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                    Background="{DynamicResource BrushAccentSoft}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{ReflectionBinding Initials}"
                                                           FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushText}"/>
                                                <!-- 2026-10-17: буквы цветом текста — жёлтые по светло-жёлтому кружку у «NurMarket» не читались. -->
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{ReflectionBinding Name}"
                                                           FontSize="14.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource BrushText}"/>
                                                <TextBlock Text="{ReflectionBinding Phone}"
                                                           IsVisible="{ReflectionBinding HasPhone}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource BrushTextSoft}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="›" FontSize="20"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextMuted}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 2026-10-04: имена — для скана QR клиента NurCRM: окно открывается сразу на «Новом клиенте»
                     с подставленным телефоном и курсором в имени (ClientPickerDialog.OpenForNewClient). -->
                <Expander x:Name="NewClientExpander" Grid.Row="3" Margin="0,12,0,0"
                          Header="{DynamicResource csh.checkout.newClient}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBox x:Name="NewClientNameBox" Text="{Binding NewClientName}" Watermark="{DynamicResource csh.checkout.newClientNameWatermark}" Height="40"/>
                        <TextBox Text="{Binding NewClientPhone}" Watermark="{DynamicResource csh.checkout.newClientPhoneWatermark}" Height="40"/>
                        <!-- Адрес необязателен, но при продаже в долг он и нужен: телефон
                             должника может не отвечать. -->
                        <TextBox Text="{Binding NewClientAddress}" Watermark="{DynamicResource clients.addressOptionalWatermark}" Height="40"/>
                        <Button Classes="PrimaryButton"
                                Content="{DynamicResource csh.checkout.addClient}"
                                Command="{Binding AddClientCommand}"
                                IsEnabled="{Binding !IsAddingClient}"
                                HorizontalAlignment="Left"
                                Padding="16,9"/>
                    </StackPanel>
                </Expander>

                <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource BrushDanger}"
                           FontSize="13"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           IsVisible="{Binding !!ErrorMessage}"/>
            </Grid>
    </dlg:ModalShell>
</Window>
