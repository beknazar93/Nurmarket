<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PrinterNotConnectedDialog"
        Title="{DynamicResource printerDialog.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок (текст — в коде) и ✕
       сверху, кнопки снизу справа. Режим «при оплате»: «Отмена» (обводка, Esc) и «Отключить печать и
       продолжить» (акцент темы, Enter); режим «сообщение»: одна «ОК» (Enter; ✕ — то же закрытие). -->
  <dlg:ModalShell x:Name="Shell" Margin="16">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- Панель из двух кнопок -->
        <StackPanel x:Name="TwoButtonRow" Orientation="Horizontal" Spacing="10">
          <Button IsCancel="True" x:Name="CancelButton"
                  Classes="modal-cancel" MaxWidth="200"
                  Content="{DynamicResource common.cancel}"
                  Click="CancelButton_Click"/>
          <Button x:Name="ProceedButton"
                  Classes="modal-primary" MaxWidth="220"
                  Content="{DynamicResource printerDialog.proceedWithoutPrint}"
                  IsDefault="True"
                  Click="ProceedButton_Click"/>
        </StackPanel>

        <!-- Кнопка ОК (когда режим одной кнопки) -->
        <Button x:Name="OkButton"
                Classes="modal-primary" MaxWidth="200"
                Content="{DynamicResource common.ok}"
                IsVisible="False"
                IsDefault="True"
                Click="OkButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <TextBlock x:Name="MessageText"
               FontSize="14" TextWrapping="Wrap"
               Foreground="{DynamicResource BrushTextSoft}"/>
  </dlg:ModalShell>
</Window>
