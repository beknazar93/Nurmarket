<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PasswordPromptDialog"
        Title="{DynamicResource dialog.confirmTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <Border Margin="16" CornerRadius="{DynamicResource SettingsCardRadius}"
          Background="{DynamicResource BrushDialogPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">
    <StackPanel>
      <TextBlock x:Name="TitleText"
                 FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"
                 Margin="0,0,0,12"/>
      <TextBlock x:Name="MessageText"
                 FontSize="14" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"
                 Margin="0,0,0,16"/>
      <TextBox x:Name="PasswordBox"
               PasswordChar="•"
               Height="42"
               FontSize="16"
               Margin="0,0,0,10"
               KeyDown="PasswordBox_KeyDown"/>
      <TextBlock x:Name="ErrorText"
                 FontSize="12"
                 Foreground="{DynamicResource BrushDanger}"
                 TextWrapping="Wrap"
                 IsVisible="False"
                 Margin="0,0,0,10"/>
      <Grid ColumnDefinitions="*,12,*">
        <Button IsCancel="True" x:Name="CancelButton"
                Grid.Column="0"
                Content="{DynamicResource common.no}"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource BrushPanel}"
                Foreground="{DynamicResource BrushText}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1.5"
                FontWeight="SemiBold"
                CornerRadius="10"
                Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton"
                Grid.Column="2"
                Content="{DynamicResource common.yes}"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource BrushAccent}"
                Foreground="{DynamicResource BrushAccentForeground}"
                FontWeight="SemiBold"
                CornerRadius="10"
                IsDefault="True"
                Click="ConfirmButton_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
