<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sec="using:NurMarketKassa.AvaloniaHost.Views.Controls"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PasswordPromptDialog"
        Title="{DynamicResource dialog.confirmTitle}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок (текст — в коде)
       и ✕ сверху (✕ = Esc = «Нет»), «Нет» (обводка) и «Да» (акцент темы, Enter) снизу справа. -->
  <dlg:ModalShell x:Name="Shell" Margin="16"
                  Hint="{DynamicResource modal.hintEnter}">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- 2026-10-22 (модалки, пакет 2): глаголы «Отмена» / «Подтвердить» вместо «Нет» / «Да». -->
        <Button IsCancel="True" x:Name="CancelButton"
                Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.cancel}"
                Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton"
                Classes="modal-primary" MaxWidth="200"
                Content="{DynamicResource common.confirm}"
                IsDefault="True"
                Click="ConfirmButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="12">
      <TextBlock x:Name="MessageText"
                 FontSize="14" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"/>
      <sec:SecretTextBox x:Name="PasswordBox"
               PasswordChar="•"
               Height="46"
               FontSize="16"
               VerticalContentAlignment="Center"
               KeyDown="PasswordBox_KeyDown"/>
      <TextBlock x:Name="ErrorText"
                 FontSize="13"
                 Foreground="{DynamicResource BrushDangerOnSoft}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
