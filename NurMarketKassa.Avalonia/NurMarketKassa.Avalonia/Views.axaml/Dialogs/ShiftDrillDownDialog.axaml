<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ShiftDrillDownDialog"
        x:CompileBindings="False"
        Title="{DynamicResource loc.owner.shift.reportTitle}"
        Width="672" SizeToContent="Height" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- Подробный отчёт по плитке «Деталей смены» (2026-09-24): что стоит за цифрой — чеки с
       товарами или записи журнала смены. -->
  <!-- 2026-10-22 (модалки, пакет 2): общая оболочка ModalShell 672 вместо своей рамки 640×680 с «Закрыть» в шапке:
       ✕ и «Закрыть» (Esc) — на своих местах, итог — слева в подвале, список прокручивается сам на всю высоту. -->
  <dlg:ModalShell x:Name="Shell" Margin="16" ContentScroll="Disabled">
    <dlg:ModalShell.Hint>
      <TextBlock x:Name="FooterText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushText}"/>
    </dlg:ModalShell.Hint>
    <dlg:ModalShell.Footer>
      <Button IsCancel="True" Classes="modal-cancel" MaxWidth="220"
              Content="{DynamicResource common.close}" Click="Close_Click"/>
    </dlg:ModalShell.Footer>

    <Grid RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="6">
        <TextBlock x:Name="SummaryText" FontSize="13" FontWeight="SemiBold"
                   TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
        <ProgressBar x:Name="LoadingBar" IsVisible="False" IsIndeterminate="True" Height="3" MinHeight="3" CornerRadius="2" IsHitTestVisible="False" Foreground="{DynamicResource BrushAccent}" Background="{DynamicResource BrushAccentSoft}"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="RowsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="10"
                      Background="{DynamicResource BrushPanelSoft}"
                      BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Header}" FontSize="12.5"
                               TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="14.5" FontWeight="Bold"
                               Margin="12,0,0,0" Foreground="{DynamicResource BrushText}"/>
                  </Grid>
                  <TextBlock Text="{Binding Details}" IsVisible="{Binding HasDetails}"
                             FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>
  </dlg:ModalShell>
</Window>
