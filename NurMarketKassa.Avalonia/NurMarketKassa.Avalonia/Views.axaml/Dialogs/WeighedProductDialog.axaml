<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.WeighedProductDialog"
        Title="{DynamicResource weigh.title}"
        Width="672" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI, Inter, sans-serif"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <!-- Базовый стиль кнопок нумпада и предустановок -->
        <Style Selector="Button.NumBtn">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.NumBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>

        <!-- Серые кнопки (Отмена, Подставить с весов) -->
        <Style Selector="Button.btn-light">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>

        <!-- Поле ввода веса -->
        <Style Selector="TextBox.WeightInput">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Переключатель "По весу"/"По сумме" -->
        <Style Selector="Button.ModeTab">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 2026-09-15, живой баг ("текст не виден") — раньше здесь стоял BrushText
             (тёмный), совпадавший по цвету с фоном BrushAccent при тёмной теме "Профессиональная"
             (тёмно-синий #1E3A5F): тёмный текст на тёмном фоне. BrushAccentForeground — это
             специально предназначенный для текста НА фоне BrushAccent токен, который меняется
             вместе с темой (белый для тёмно-синей/синей/зелёной тем, чёрный для жёлтой) — та же
             пара, что уже используется в PrimaryButton по всему приложению. -->
        <!-- 2026-10-17, этап 3: выбранный режим — как сегменты модалок: заливка цветом текста темы (у «NurMarket»
             светлой — тёмно-синяя), надпись цветом карточки — контраст в любой теме. -->
        <Style Selector="Button.ModeTab.Active">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
        </Style>
        <Style Selector="Button.ModeTab.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 640 (было 620 со своей шапкой) —
         товар и цена за кг в шапке (тексты — в коде), ✕ = Esc = «Отмена»; «Отмена» (обводка) и «В чек»
         (акцент темы, Enter) снизу справа. Своя цифровая клавиатура окна — как была (не новая).
         ActionButtonsGrid оставлен пустым и скрытым: его переносит ApplyNarrowLayout (Android). -->
    <dlg:ModalShell x:Name="Shell" Margin="16">
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CancelButton"
                        Classes="modal-cancel" MaxWidth="200"
                        IsCancel="True"
                        Content="{DynamicResource common.cancel}"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Classes="modal-primary" MaxWidth="220"
                        Content="{DynamicResource weigh.addToReceipt}"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

            <!-- 2. Основной контент -->
            <StackPanel x:Name="ContentPanel" Spacing="16">

                <!-- Блок отображения текущих весов: только когда реально подключены весы -->
                <Border x:Name="LiveScaleBlock"
                        Background="{DynamicResource BrushPanel}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LiveScaleLabel" Text="{DynamicResource weigh.currentScaleLabel}" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" FontWeight="Medium"/>
                        <TextBlock x:Name="LiveScaleText" Text="0.00 кг" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                    </StackPanel>
                </Border>

                <!-- Сетка: Левая часть (Ввод) и Правая часть (Кнопки быстрых значений + Нумпад) -->
                <Grid x:Name="BodyGrid" Classes="no-reflow" ColumnDefinitions="*,24,310">

                    <!-- ЛЕВАЯ КОЛОНКА -->
                    <StackPanel x:Name="InputColumn" Grid.Column="0" VerticalAlignment="Top" Spacing="16">
                        <!-- Переключатель "По весу" / "По сумме" — виден только когда известна
                             числовая цена за кг (иначе вес из суммы посчитать нечем). -->
                        <Grid x:Name="ModeTabsRow" ColumnDefinitions="*,6,*" IsVisible="False">
                            <Button x:Name="ByWeightTab" Grid.Column="0" Classes="ModeTab Active"
                                    Content="{DynamicResource weigh.byWeightTab}"
                                    HorizontalAlignment="Stretch"
                                    Click="ByWeightTab_Click"/>
                            <Button x:Name="ByAmountTab" Grid.Column="2" Classes="ModeTab"
                                    Content="{DynamicResource weigh.byAmountTab}"
                                    HorizontalAlignment="Stretch"
                                    Click="ByAmountTab_Click"/>
                        </Grid>

                        <!-- Ручной ввод веса (или суммы — то же поле, перепрофилируется по режиму) -->
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="WeightLabel" Text="{DynamicResource weigh.weightKgLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBox x:Name="WeightBox"
                                     Text="0.00"
                                     Classes="WeightInput"
                                     KeyDown="WeightBox_KeyDown"
                                     TextChanged="WeightBox_TextChanged"/>
                            <TextBlock x:Name="ComputedPreviewText"
                                       IsVisible="False"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushMoney}"/>
                            <!-- 2026-10-17: расчёт цветом денег — жёлтый акцент по белому у «NurMarket» не читался. -->
                            <!-- 2026-10-22 (модалки, пакет 1): ошибка ввода — под полем (было 6 всплывающих окон поверх). -->
                            <TextBlock x:Name="WeightErrorText"
                                       IsVisible="False"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushDanger}"/>
                        </StackPanel>

                        <!-- Кнопка "Подставить с весов" -->
                        <Button x:Name="FromScaleButton"
                                Classes="btn-light"
                                Content="{DynamicResource weigh.fromScaleButton}"
                                Height="50"
                                HorizontalAlignment="Stretch"
                                Click="FromScale_Click"/>

                        <!-- Кнопки — внизу окна (ModalShell.Footer); пустая сетка нужна ApplyNarrowLayout. -->
                        <Grid x:Name="ActionButtonsGrid" IsVisible="False"/>
                    </StackPanel>

                    <!-- ПРАВАЯ КОЛОНКА (Кнопки быстрых весов + Цифровая клавиатура) -->
                    <StackPanel x:Name="KeypadColumn" Grid.Column="2" Spacing="12">

                        <!-- Быстрые кнопки выбора веса (скрыты в режиме "По сумме" — пресеты веса
                             там не имеют смысла) -->
                        <!-- 2026-10-22 (модалки, пакет 1): быстрые веса — 44 px под палец (было 40). -->
                        <Grid x:Name="QuickWeightRow" ColumnDefinitions="*,*,*,*,*" Height="48">
                            <Button Grid.Column="0" Classes="NumBtn" Content="{DynamicResource loc.kassa.weigh.quick01}" Tag="0,1" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="1" Classes="NumBtn" Content="{DynamicResource loc.kassa.weigh.quick05}" Tag="0,5" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="2" Classes="NumBtn" Content="{DynamicResource loc.kassa.weigh.quick1}" Tag="1" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="3" Classes="NumBtn" Content="{DynamicResource loc.kassa.weigh.quick2}" Tag="2" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="4" Classes="NumBtn" Content="{DynamicResource loc.kassa.weigh.quick5}" Tag="5" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                        </Grid>

                        <!-- Цифровая клавиатура (Numpad) -->
                        <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*">
                            <Grid.Styles>
                                <Style Selector="Button.NumBtn">
                                    <Setter Property="Height" Value="54"/>
                                    <Setter Property="Margin" Value="4"/>
                                </Style>
                            </Grid.Styles>

                            <Button Grid.Row="0" Grid.Column="0" Classes="NumBtn" Content="1" Tag="1" Click="OnNumKey_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Classes="NumBtn" Content="2" Tag="2" Click="OnNumKey_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Classes="NumBtn" Content="3" Tag="3" Click="OnNumKey_Click"/>

                            <Button Grid.Row="1" Grid.Column="0" Classes="NumBtn" Content="4" Tag="4" Click="OnNumKey_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Classes="NumBtn" Content="5" Tag="5" Click="OnNumKey_Click"/>
                            <Button Grid.Row="1" Grid.Column="2" Classes="NumBtn" Content="6" Tag="6" Click="OnNumKey_Click"/>

                            <Button Grid.Row="2" Grid.Column="0" Classes="NumBtn" Content="7" Tag="7" Click="OnNumKey_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Classes="NumBtn" Content="8" Tag="8" Click="OnNumKey_Click"/>
                            <Button Grid.Row="2" Grid.Column="2" Classes="NumBtn" Content="9" Tag="9" Click="OnNumKey_Click"/>

                            <Button Grid.Row="3" Grid.Column="0" Classes="NumBtn" Content="," Tag="," Click="OnNumKey_Click"/>
                            <Button Grid.Row="3" Grid.Column="1" Classes="NumBtn" Content="0" Tag="0" Click="OnNumKey_Click"/>

                            <!-- Кнопка стереть (Backspace) -->
                            <Button Grid.Row="3" Grid.Column="2" Classes="NumBtn"
                                    Background="{DynamicResource BrushDangerSoft}"
                                    BorderBrush="{DynamicResource BrushDanger}"
                                    Click="OnBackspace_Click">
                                <PathIcon Data="M22,3H7C6.31,3 5.77,3.35 5.41,3.88L0,12L5.41,20.11C5.77,20.64 6.31,21 7,21H22A2,2 0 0,0 24,19V5A2,2 0 0,0 22,3M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12L19,15.59Z"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource BrushDanger}"/>
                            </Button>
                        </Grid>

                    </StackPanel>

                </Grid>
            </StackPanel>
    </dlg:ModalShell>
</Window>
