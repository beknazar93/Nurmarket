<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ExitConfirmationDialog"
        Title="{DynamicResource exitConfirm.title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <Style Selector="Button.DialogPrimary">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="46" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SettingsButtonRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.DialogPrimary:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        </Style>

        <Style Selector="Button.DialogSecondary">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="46" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SettingsButtonRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.DialogSecondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}" />
        </Style>
    </Window.Styles>

    <Border Margin="16" CornerRadius="{DynamicResource SettingsCardRadius}"
            Background="{DynamicResource BrushDialogPanel}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
            BoxShadow="0 12 32 0 #33101828"
            Padding="28,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource BrushWarningSoft}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource BrushWarning}" />
                </Border>
                <TextBlock Text="{DynamicResource exitConfirm.title}"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushText}" />
            </StackPanel>

            <TextBlock Text="{DynamicResource exitConfirm.message}"
                       FontSize="14" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSoft}"
                       Margin="0,0,0,22" />

            <Grid ColumnDefinitions="*,12,*">
                <Button Grid.Column="0"
                        Classes="DialogSecondary"
                        Content="{DynamicResource common.no}"
                        IsCancel="True"
                        Click="NoButton_Click" />
                <Button Grid.Column="2"
                        Classes="DialogPrimary"
                        Content="{DynamicResource common.yes}"
                        IsDefault="True"
                        Click="YesButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
