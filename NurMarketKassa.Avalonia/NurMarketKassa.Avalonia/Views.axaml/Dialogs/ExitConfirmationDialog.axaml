<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ExitConfirmationDialog"
        Title="{DynamicResource exitConfirm.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок и ✕ сверху
         (✕ = Esc = «Нет»), «Нет» (обводка) и «Да» (акцент темы, Enter) снизу справа. Значок-предупреждение
         (шрифт Segoe MDL2, только Windows) убран — заголовок и так говорит, о чём окно. -->
    <dlg:ModalShell Margin="16"
                    Title="{DynamicResource exitConfirm.title}"
                    Hint="{DynamicResource modal.hintEnter}">
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- 2026-10-22 (модалки, пакет 0): глаголы «Остаться» / «Выйти» вместо «Нет» / «Да» — текст ставит код (5 языков). -->
                <Button x:Name="StayButton" Classes="modal-cancel" MaxWidth="200"
                        IsCancel="True"
                        Click="NoButton_Click" />
                <Button x:Name="ExitButton" Classes="modal-primary" MaxWidth="200"
                        IsDefault="True"
                        Click="YesButton_Click" />
            </StackPanel>
        </dlg:ModalShell.Footer>

        <TextBlock Text="{DynamicResource exitConfirm.message}"
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextSoft}" />
    </dlg:ModalShell>
</Window>
