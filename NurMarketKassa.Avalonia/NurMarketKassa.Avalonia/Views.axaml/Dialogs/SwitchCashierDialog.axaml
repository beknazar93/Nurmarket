<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.SwitchCashierDialog"
        Title="{DynamicResource switchCashier.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок, пояснение и ✕
       сверху, «Отмена» (обводка, Esc; во время проверки выключена — ✕ тогда тоже ничего не делает) и
       «Сменить» (акцент темы, Enter) снизу справа. -->
  <dlg:ModalShell Margin="16"
                  Title="{DynamicResource switchCashier.title}"
                  Subtitle="{DynamicResource switchCashier.message}"
                  Hint="{DynamicResource modal.hintEnter}">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button IsCancel="True" x:Name="CancelButton"
                Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.cancel}"
                Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton"
                Classes="modal-primary" MaxWidth="200"
                Content="{DynamicResource switchCashier.confirmButton}"
                IsDefault="True"
                Click="ConfirmButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="10">
      <TextBox x:Name="EmailBox"
               Watermark="{DynamicResource switchCashier.emailWatermark}"
               Height="46" FontSize="15"
               VerticalContentAlignment="Center"
               KeyDown="InputBox_KeyDown"/>
      <TextBox x:Name="PasswordBox"
               PasswordChar="•"
               Watermark="{DynamicResource switchCashier.passwordWatermark}"
               Height="46" FontSize="15"
               VerticalContentAlignment="Center"
               KeyDown="InputBox_KeyDown"/>

      <TextBlock x:Name="ErrorText"
                 FontSize="12.5"
                 Foreground="{DynamicResource BrushDanger}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
