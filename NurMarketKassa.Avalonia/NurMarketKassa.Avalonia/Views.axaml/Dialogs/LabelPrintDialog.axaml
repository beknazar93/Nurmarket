<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.LabelPrintDialog"
        x:DataType="dialogs:LabelPrintDialog"
        x:CompileBindings="True"
        Title="{DynamicResource labelPrint.title}"
        Width="592" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Noto Sans"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-20, этап О9б (редизайн этикеток): общая оболочка ModalShell — заголовок и ✕ сверху, «Редактор этикетки»
         (обводкой) слева внизу, «Закрыть» и «Печать» справа. Предпросмотр (что напечатается) — не менялся. Привязки и
         обработчики — прежние. -->
    <Window.Styles>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
    </Window.Styles>

    <dialogs:ModalShell Margin="16"
                        Title="{DynamicResource labelPrint.header}"
                        Subtitle="{DynamicResource labelPrint.subtitle}">
        <dialogs:ModalShell.Hint>
            <Button Content="{DynamicResource labelPrint.editTemplate}" Classes="modal-secondary" MinWidth="120" Click="EditTemplateButton_Click"/>
        </dialogs:ModalShell.Hint>
        <dialogs:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" Content="{DynamicResource common.close}" Classes="modal-cancel" Click="CloseButton_Click"/>
                <Button Content="{DynamicResource labelPrint.printButton}" Classes="modal-primary" Click="PrintButton_Click"
                        IsEnabled="{Binding HasBarcode}" IsVisible="{Binding !IsBusy}"/>
                <Button Content="{DynamicResource labelPrint.printing}" Classes="modal-primary" IsVisible="{Binding IsBusy}" IsEnabled="False"/>
            </StackPanel>
        </dialogs:ModalShell.Footer>

        <StackPanel Spacing="12">
            <TextBlock Text="{Binding ProductName}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>

            <Border Background="White" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="8" Height="190">
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform" IsVisible="{Binding HasBarcode}"/>
                    <TextBlock IsVisible="{Binding !HasBarcode}"
                               Text="{DynamicResource labelPrint.noBarcode}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#64748B"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,12,160">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="field-label" Text="{DynamicResource common.printer}"/>
                    <ComboBox ItemsSource="{Binding Printers}"
                              SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="field-label" Text="{DynamicResource labelPrint.copiesLabel}" TextWrapping="Wrap"/>
                    <NumericUpDown Value="{Binding Copies, Mode=TwoWay}" Minimum="1" Maximum="99" Increment="1" FormatString="0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5"
                       Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
        </StackPanel>
    </dialogs:ModalShell>
</Window>
