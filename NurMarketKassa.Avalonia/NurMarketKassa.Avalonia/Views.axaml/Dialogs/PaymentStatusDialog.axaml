<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PaymentStatusDialog"
        Title="{DynamicResource paymentStatus.title}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="{DynamicResource BrushPanel}">

  <Border Padding="34,30"
          Background="{DynamicResource BrushPanel}"
          BorderBrush="{DynamicResource BrushBorder}"
          BorderThickness="1"
          CornerRadius="18">
    <StackPanel HorizontalAlignment="Center">
      <Grid x:Name="LoadingPanel"
            Width="104"
            Height="104"
            Margin="0,0,0,20">
        <Ellipse Width="88"
                 Height="88"
                 Stroke="{DynamicResource BrushAccentSoft}"
                 StrokeThickness="8"/>
        <Path x:Name="SpinnerPath"
              Data="M 52,8 A 44,44 0 0 1 96,52"
              Stroke="{DynamicResource BrushAccent}"
              StrokeThickness="8"
              StrokeLineCap="Round"
              RenderTransformOrigin="50%,50%">
          <Path.RenderTransform>
            <RotateTransform/>
          </Path.RenderTransform>
        </Path>
      </Grid>

      <Border x:Name="ResultCircle"
              Width="104"
              Height="104"
              CornerRadius="52"
              Background="{DynamicResource BrushSuccessSoft}"
              IsVisible="False"
              Margin="0,0,0,20">
        <TextBlock x:Name="ResultIcon"
                   Text="✓"
                   FontSize="58"
                   FontWeight="Bold"
                   Foreground="{DynamicResource BrushUiStatusOk}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <TextBlock x:Name="StatusTitle"
                 Text="{DynamicResource paymentStatus.processing}"
                 FontSize="22"
                 FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"/>

      <TextBlock x:Name="AmountText"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushAccent}"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 Margin="0,8,0,0"/>

      <TextBlock x:Name="StatusMessage"
                 Text="{DynamicResource paymentStatus.pleaseWait}"
                 FontSize="14"
                 Foreground="{DynamicResource BrushTextSoft}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="350"
                 HorizontalAlignment="Center"
                 Margin="0,10,0,0"/>

      <Button x:Name="CloseButton"
              Content="{DynamicResource common.gotIt}"
              Width="280"
              Height="48"
              HorizontalContentAlignment="Center"
              Background="#DC2626"
              Foreground="#FFFFFF"
              FontWeight="Bold"
              CornerRadius="10"
              IsVisible="False"
              Margin="0,22,0,0"
              Click="CloseButton_Click"/>
    </StackPanel>
  </Border>
</Window>
