<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PaymentStatusDialog"
        Title="{DynamicResource paymentStatus.title}"
        Width="512"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        FontFamily="Segoe UI"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-22 (модалки, пакет 1): общая оболочка ModalShell 512 (тень, прозрачный фон окна темы) вместо своей
       Border 440 без тени на квадратном фоне BrushPanel. ✕ нет: пока оплата идёт, окно закрывать нельзя (как раньше —
       кнопка и Esc появляются через 20 с или при ошибке). Кнопка — в закреплённом подвале: при ошибке красная
       «Понятно» (modal-primary danger вместо #DC2626/#FFFFFF), при долгом ожидании — обводкой «Закрыть окно» (код);
       Enter и Esc нажимают её, только когда она видна. -->
  <dlg:ModalShell x:Name="Shell" Margin="16" ShowClose="False" Title="{DynamicResource paymentStatus.title}">
    <dlg:ModalShell.Footer>
      <Button x:Name="CloseButton"
              Classes="modal-primary danger"
              MinWidth="200" MaxWidth="280"
              IsDefault="True"
              IsVisible="False"
              Click="CloseButton_Click"/>
    </dlg:ModalShell.Footer>

    <StackPanel HorizontalAlignment="Center">
      <Grid x:Name="LoadingPanel"
            Width="104"
            Height="104"
            Margin="0,0,0,20">
        <Ellipse Width="88"
                 Height="88"
                 Stroke="{DynamicResource BrushAccentSoft}"
                 StrokeThickness="8"/>
        <Path x:Name="SpinnerPath"
              Data="M 52,8 A 44,44 0 0 1 96,52"
              Stroke="{DynamicResource BrushAccent}"
              StrokeThickness="8"
              StrokeLineCap="Round"
              RenderTransformOrigin="50%,50%">
          <Path.RenderTransform>
            <RotateTransform/>
          </Path.RenderTransform>
        </Path>
      </Grid>

      <Border x:Name="ResultCircle"
              Width="104"
              Height="104"
              CornerRadius="52"
              Background="{DynamicResource BrushSuccessSoft}"
              IsVisible="False"
              Margin="0,0,0,20">
        <TextBlock x:Name="ResultIcon"
                   Text="✓"
                   FontSize="58"
                   FontWeight="Bold"
                   Foreground="{DynamicResource BrushUiStatusOk}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <TextBlock x:Name="StatusTitle"
                 Text="{DynamicResource paymentStatus.processing}"
                 FontSize="22"
                 FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"/>

      <TextBlock x:Name="AmountText"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushAccentStrong}"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 Margin="0,8,0,0"/>

      <TextBlock x:Name="StatusMessage"
                 Text="{DynamicResource paymentStatus.pleaseWait}"
                 FontSize="14"
                 Foreground="{DynamicResource BrushTextSoft}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="400"
                 HorizontalAlignment="Center"
                 Margin="0,10,0,0"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
