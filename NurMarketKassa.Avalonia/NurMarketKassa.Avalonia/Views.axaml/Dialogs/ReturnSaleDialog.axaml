<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        xmlns:pos="using:NurMarketKassa.Models.Pos"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ReturnSaleDialog"
        x:DataType="dialogs:ReturnSaleDialog"
        x:CompileBindings="True"
        Title="{DynamicResource returnSale.title}"
        WindowState="Maximized"
        MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <Window.Styles>
    <!-- Главные кнопки действий (Жёлтый акцент) -->
    <!-- 2026-10-23 (аудит): выбранная строка списка чеков — мягкий фон темы вместо бирюзовой подсветки Fluent. -->
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource BrushSurfaceSubtle}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>

    <!-- Вторичные кнопки (Светлый контур) -->
    <Style Selector="Button.btn-secondary">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>

    <!-- Кнопка внутри строки DataGrid.
         2026-10-19, К1 (аудит 19.10, проблема 4: восемь бледно-жёлтых «Выбрать», текст почти не виден) — обводкой,
         текст цветом текста; выбрать чек можно и двойным щелчком по строке (SalesDataGrid_DoubleTapped). -->
    <Style Selector="Button.btn-table">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-table:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
    </Style>
    <!-- 2026-10-19, К1: выключенная главная («Вернуть выбранные», пока ничего не отмечено) — бледная, не жёлтая. -->
    <Style Selector="Button.btn-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <!-- 2026-10-27: прозрачность выключенной 0.5 → 0,7: в тёмной теме надпись выключенной кнопки была 1,5–2,5:1 (нужно ≥3:1). -->
    <Style Selector="Button.btn-secondary:disabled">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="Button.btn-secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>

    <!-- Поле ввода поиска. 2026-10-22 (модалки, пакет 1): 44 px под палец (было 38). -->
    <Style Selector="TextBox.ModernInput">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.ModernInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    </Style>
  </Window.Styles>

  <Border x:Name="RootCard" Margin="12" CornerRadius="{DynamicResource SettingsCardRadius}"
          Background="{DynamicResource BrushDialogPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="24">
    <Grid RowDefinitions="Auto,*,Auto,Auto">

      <!-- Шапка диалога -->
      <StackPanel Grid.Row="0">
        <TextBlock Text="{DynamicResource returnSale.header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}" FontSize="14"
                   Text="{DynamicResource returnSale.instructions}"/>
      </StackPanel>

      <!-- Основная область с 2 колонками -->
      <Grid x:Name="MainAreaGrid" Classes="no-reflow" Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="*,16,*">

        <!-- БЛОК 1: Чеки продаж -->
        <DockPanel Grid.Column="0" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource returnSale.step1}"
                     FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"/>

          <!-- Поиск и фильтры -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <TextBox x:Name="SearchReceiptBox" Classes="ModernInput" Width="180" Watermark="{DynamicResource common.searchWatermark}"
                     TextChanged="SearchReceiptBox_TextChanged"/>
            <!-- 2026-10-22 (модалки, пакет 1): кнопки рядом с поиском — 44 px, как поле (было 38). -->
            <Button Content="{DynamicResource common.refresh}" Classes="btn-secondary" Padding="12,0" Height="44" Click="RefreshSales_Click"/>
            <Button x:Name="MoreSalesButton" Classes="btn-secondary" Content="{DynamicResource csh.cart.more}" Padding="12,0" Height="44" Click="MoreSales_Click"/>
          </StackPanel>

          <!-- Таблица чеков -->
          <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
              <DataGrid x:Name="SalesDataGrid"
                        x:CompileBindings="False"
                        DoubleTapped="SalesDataGrid_DoubleTapped"
                        ItemsSource="{Binding FilteredSales}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <!-- 2026-10-19, К1: сумма шире (126) — «1 382,50 сом» целиком; № и кнопка уже, дата получает остальное (на 1024 — «20.10.26 01:41»). -->
                  <DataGridTextColumn Header="{DynamicResource returnSale.colReceiptNo}" Binding="{ReflectionBinding DisplayNumber}" Width="88"/>
                  <!-- 2026-10-21 (пакет 6, п. 35): под датой — пометка «↩ возвращён» / «↩ частично» (в одну строку на 1024 не помещалась). -->
                  <DataGridTemplateColumn Header="{DynamicResource common.date}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Margin="12,2">
                          <TextBlock Text="{ReflectionBinding SaleDateDisplay}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{ReflectionBinding ReturnMark}" IsVisible="{ReflectionBinding HasReturnMark}"
                                     FontSize="11.5" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource common.amount}" Binding="{ReflectionBinding TotalAmountDisplay}" Width="126" FontWeight="SemiBold"/>
                  <DataGridTemplateColumn Header="" Width="94">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <!-- 2026-10-22 (модалки, пакет 1): «Выбрать» 44 px (было 34) — касание пальцем. -->
                        <Button Content="{DynamicResource common.select}" Tag="{ReflectionBinding SaleId}" Click="SelectSale_Click"
                                Classes="btn-table" Height="44" Margin="4,2"
                                HorizontalAlignment="Stretch"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                           IsVisible="{Binding IsBusy}"/>
              <!-- 2026-10-19, К1: пустой список — подсказка, что делать (а не пустая таблица). -->
              <StackPanel IsVisible="{Binding HasNoSales}" IsHitTestVisible="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,48,16,16" Spacing="6" MaxWidth="360">
                <TextBlock Text="{Binding NoSalesTitle}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="{Binding NoSalesHint}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSoft}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DockPanel>

        <!-- БЛОК 2: Содержимое выбранного чека -->
        <DockPanel x:Name="LinesBlock" Grid.Column="2" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource returnSale.step2}"
                     FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"/>

          <!-- Выбранная покупка -->
          <Border x:Name="SelectedChequeBar" DockPanel.Dock="Top"
                  Margin="0,0,0,10" Padding="12,10"
                  Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                  IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock x:Name="SelectedSaleText" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushText}" FontSize="13" FontWeight="Medium"/>
              <!-- 2026-10-06 (О-31, магазин одежды): дата чека, сколько дней прошло и предупреждение о сроке обмена. Текст — в коде. -->
              <TextBlock x:Name="ReturnTermText" TextWrapping="Wrap" FontSize="12.5" IsVisible="False"
                         Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
          </Border>

          <!-- Панель быстрых кнопок -->
          <!-- 2026-10-04, редизайн под маленькие экраны: четыре кнопки в одну строку не помещались в
               половину окна на 1024×768 — «Вернуть весь чек» (по-кыргызски «Бүт чекти кайтаруу») уходила
               за правый край. Выбор строк — первым рядом, обе кнопки возврата — вторым рядом поровну
               на всю ширину; высота 44 — под палец. -->
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource common.all}" Classes="btn-secondary" Height="44" MinWidth="70"
                      Click="SelectAllReturnable_Click"/>
              <Button Content="{DynamicResource returnSale.clearSelection}" Classes="btn-secondary" Height="44" MinWidth="70"
                      Click="ClearReturnSelection_Click"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,8,*">
              <!-- 2026-10-19, К1 (аудит 19.10, проблема 4): «Вернуть выбранные» — главная и активна, только когда что-то
                   отмечено (CanReturnSelected); «Вернуть весь чек» — обводкой. Обработчики прежние. -->
              <Button x:Name="ReturnSelectedButton" Grid.Column="0"
                      Classes="btn-primary" Content="{DynamicResource returnSale.returnSelected}"
                      Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      IsEnabled="{Binding CanReturnSelected}"
                      Click="ReturnSelected_Click"/>
              <Button x:Name="ReturnWholeReceiptButton" Grid.Column="2"
                      Classes="btn-secondary" Content="{DynamicResource returnSale.returnWholeReceipt}"
                      Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      IsEnabled="{Binding !IsBusy}"
                      Click="ReturnWholeReceipt_Click"/>
            </Grid>
            <!-- 2026-10-06 (О-30, магазин одежды): обмен — вернуть отмеченное и выдать другой товар одним документом.
                 Видна в сфере «Одежда»; подпись — в коде. -->
            <Button x:Name="ExchangeSelectedButton" Classes="btn-secondary" Height="44" IsVisible="False"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsEnabled="{Binding !IsBusy}"
                    Click="ExchangeSelected_Click"/>
          </StackPanel>

          <TextBlock x:Name="LinesPlaceholder" DockPanel.Dock="Top"
                     Margin="0,8,0,12" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{DynamicResource BrushTextSoft}" FontSize="14"/>

          <!-- Список позиций в чеке -->
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pos:ReturnSaleLineVm">
                  <!-- 2026-10-19, К1: строка — белая карточка, сумма к возврату крупно справа цветом текста. -->
                  <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                          Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                IsEnabled="{Binding CanReturn}"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Text="{Binding Title}"/>
                        <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"
                                   Text="{Binding SubLine}"/>
                        <!-- 2026-10-27 (приёмка 1.17.63, Д-5): сколько вернуть из строки «клей × 2»: −/+ (штучный шаг 1, весовой 0,1) или число руками. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding CanEditQuantity}">
                          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushTextSoft}" Text="{Binding ReturnQtyLabel}"/>
                          <Button Classes="btn-secondary" Width="44" Height="44" Padding="0" Content="−"
                                  AutomationProperties.Name="{Binding ReturnQtyLessName}" Click="ReturnQtyLess_Click"/>
                          <TextBox Classes="ModernInput" Width="84" TextAlignment="Center" Text="{Binding ReturnQuantityText, Mode=OneWay}"
                                   AutomationProperties.Name="{Binding ReturnQtyBoxName}"
                                   LostFocus="ReturnQtyBox_LostFocus" KeyDown="ReturnQtyBox_KeyDown"/>
                          <Button Classes="btn-secondary" Width="44" Height="44" Padding="0" Content="+"
                                  AutomationProperties.Name="{Binding ReturnQtyMoreName}" Click="ReturnQtyMore_Click"/>
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Classes="num"
                                 FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}"
                                 Text="{Binding ReturnSumText}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

      </Grid>

      <!-- Ошибки -->
      <!-- 2026-10-22 (модалки, пакет 1): сюда же — ошибки ввода («отметьте позицию», «выберите чек»), вместо всплывающих окон. -->
      <TextBlock x:Name="ErrorText" Grid.Row="2" TextWrapping="Wrap"
                 Margin="0,10,0,0" Foreground="{DynamicResource BrushDanger}"
                 FontWeight="SemiBold" FontSize="13"
                 HorizontalAlignment="Center" TextAlignment="Center"
                 IsVisible="False"/>

      <!-- Нижняя панель управления -->
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <Expander Header="{DynamicResource returnSale.manualIdHeader}" Foreground="{DynamicResource BrushTextSoft}" FontSize="13">
          <StackPanel Margin="0,10,0,0" Spacing="10" Orientation="Horizontal">
            <TextBox x:Name="SaleIdBox" Classes="ModernInput" Width="220" Watermark="{DynamicResource returnSale.saleIdWatermark}"/>
            <Button Content="{DynamicResource returnSale.loadReceipt}" Classes="btn-secondary" Height="44" Padding="16,0" Click="LoadById_Click"/>
          </StackPanel>
        </Expander>

        <!-- 2026-10-22 (модалки, пакет 1): «Оконный режим» и «Закрыть» — 44 px (было 42). -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
          <Button x:Name="WindowModeButton" Content="{DynamicResource common.windowedMode}" Classes="btn-secondary"
                  Height="44" MinWidth="120"
                  Click="ToggleFullscreen_Click"/>
          <Button IsCancel="True" Content="{DynamicResource common.close}" Classes="btn-secondary"
                  Height="44" MinWidth="120"
                  Click="Close_Click"/>
        </StackPanel>
      </StackPanel>

    </Grid>
  </Border>
</Window>