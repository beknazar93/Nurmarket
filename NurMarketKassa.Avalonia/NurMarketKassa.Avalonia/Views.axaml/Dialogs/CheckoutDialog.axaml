<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NurMarketKassa.ViewModels"
        xmlns:conv="using:NurMarketKassa.Converters"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CheckoutDialog"
        x:DataType="vm:CheckoutViewModel"
        x:CompileBindings="True"
        Title="{DynamicResource csh.checkout.title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        Background="{DynamicResource BrushDialogPanel}">
    <!-- 2026-10-17, редизайн (этап 2): оплата — панелью у правого края главного окна во всю его высоту
         (макет Pay). Место и размер панели ставит CheckoutDialog.DockTo (до показа и при движении/размере
         главного окна): если справа чек кассы (Классика, Карточки, Минимал, Профи) — панель встаёт сразу
         слева от чека, чек остаётся виден. Без главного окна (или на Android) — как раньше, по центру.
         Окно непрозрачное: прозрачный фон на ПК без композиции рисовался чёрной рамкой.
         Логика оплаты не менялась: те же привязки к CheckoutViewModel, имена элементов и клавиши.
         Своей цифровой клавиатуры нет — правило владельца (только osk.exe по касанию поля). -->

    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImageConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Способ оплаты — плитка 2×2 (стрелки ←/→/↑/↓ обходят её так же, как раньше). -->
        <Style Selector="RadioButton.PayTypeOption">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Фокус с клавиатуры рисует стиль :focus-visible ниже; рамка Fluent легла бы второй. -->
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 2026-10-19, К1 (правило 2): выбранный способ оплаты — тёмно-синим (цвет текста темы, надпись цветом панели),
             как выбранные сегменты; жёлтая в панели одна — «Оплатить». -->
        <Style Selector="RadioButton.PayTypeOption:checked">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Способ оплаты, выбранный стрелками: рамка толще и ярче, чтобы кассир видел, где
             клавиатура. Отступ меньше ровно на столько, на сколько толще рамка, — кнопка не прыгает. -->
        <Style Selector="RadioButton.PayTypeOption:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocusRing}"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Padding" Value="11,0"/>
        </Style>

        <Style Selector="RadioButton.PayTypeOption Border.pay-icon">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="RadioButton.PayTypeOption:checked Border.pay-icon">
            <Setter Property="Background" Value="{DynamicResource BrushDialogPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDialogPanel}"/>
        </Style>
        <Style Selector="RadioButton.PayTypeOption Path.pay-icon-glyph">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}"/>
        </Style>
        <Style Selector="RadioButton.PayTypeOption:checked Path.pay-icon-glyph">
            <Setter Property="Fill" Value="{DynamicResource BrushText}"/>
        </Style>

        <!-- Быстрые суммы («Без сдачи», круглые купюры): цель касания 44+. 2026-10-17, ревью этапа 2: кнопки сумм
             Focusable=False — иначе после щелчка Enter нажимал их снова вместо оплаты. -->
        <Style Selector="Button.pay-quick">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pay-quick /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pay-quick.last">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- 2026-10-20, владелец (долг Д2): сроки долга «7 / 14 / 30 дней» — сегменты (обводка), выбранный — тёмно-синий,
             как выбранный способ оплаты. -->
        <Style Selector="Button.due-seg">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.due-seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.due-seg.selected">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.due-seg.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
        </Style>

        <!-- Подписи разделов. 2026-10-19, К1 (аудит 19.10, проблема 7): обычным регистром, 13 полужирным. -->
        <Style Selector="TextBlock.pay-label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Поля сумм. Рамка в фокусе — как в модалках этапа 1 (BrushFocusRing, 2 px). -->
        <Style Selector="TextBox.pay-amount">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocusRing}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Отступы панели; на низкой панели (класс compact, ставит CheckoutDialog.DockTo — высота < 760)
             всё чуть плотнее, чтобы в режиме наличных на 1024×768 и 1366×768 не было прокрутки. -->
        <Style Selector="Border.pay-header">
            <Setter Property="Padding" Value="20,14,14,12"/>
        </Style>
        <Style Selector="StackPanel.pay-body">
            <Setter Property="Margin" Value="20,16,20,16"/>
            <Setter Property="Spacing" Value="14"/>
        </Style>
        <Style Selector="Border.pay-footer">
            <Setter Property="Padding" Value="20,12"/>
        </Style>
        <Style Selector="Border.pay-summary">
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style Selector="TextBlock.pay-sum">
            <Setter Property="FontSize" Value="32"/>
        </Style>
        <Style Selector="TextBox.pay-cash">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <Style Selector=".compact Border.pay-header">
            <Setter Property="Padding" Value="18,10,12,10"/>
        </Style>
        <Style Selector=".compact StackPanel.pay-body">
            <Setter Property="Margin" Value="18,12,18,12"/>
            <Setter Property="Spacing" Value="10"/>
        </Style>
        <Style Selector=".compact Border.pay-footer">
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style Selector=".compact Border.pay-summary">
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style Selector=".compact TextBlock.pay-sum">
            <Setter Property="FontSize" Value="28"/>
        </Style>
        <Style Selector=".compact RadioButton.PayTypeOption">
            <Setter Property="Height" Value="46"/>
        </Style>
        <Style Selector=".compact TextBox.pay-cash">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Подсказка клавиши на главной кнопке («Enter»). -->
        <Style Selector="Border.key-badge">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="CheckBox.Switch">
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <!-- Фон и рамка тумблера (трек) -->
                        <Border x:Name="PART_SwitchTrack"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource BrushBorderStrong}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>

                            <!-- Ползунок -->
                            <Border x:Name="PART_SwitchThumb"
                                    Width="18" Height="18"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="9"
                                    Background="{DynamicResource BrushPanel}">
                                <Border.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin"
                                                             Duration="0:0:0.2"
                                                             Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Border>
                        <!-- Текст рядом с тумблером -->
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Состояние ВКЛЮЧЕНО (Checked) -->
        <Style Selector="CheckBox.Switch:checked /template/ Border#PART_SwitchTrack">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/> <!-- Цвет включенного состояния -->
        </Style>
        <Style Selector="CheckBox.Switch:checked /template/ Border#PART_SwitchThumb">
            <Setter Property="Margin" Value="23,0,0,0"/> <!-- Смещение ползунка вправо -->
        </Style>

        <!-- Состояние Наведение (Hover) -->
        <Style Selector="CheckBox.Switch:pointerover /template/ Border#PART_SwitchTrack">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- Состояние Отключено (Disabled) -->
        <Style Selector="CheckBox.Switch:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Styles>

    <!-- Панель: слева тонкая граница — отделяет панель от чека главного окна. -->
    <Border Background="{DynamicResource BrushDialogPanel}"
            BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1">

        <!-- 2026-10-21 (пакет 6, п. 27): низ окна был пустым, а «Напечатать чек», ошибка и консультант уходили под
             прокрутку. Теперь над кнопками закреплён блок: почему «Оплатить» неактивна, ошибка, строка консультанта
             (касание — к его блоку) и «Напечатать чек» — как в макете Pay. -->
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- 1. Шапка: заголовок, сколько позиций в чеке, ✕ (= «Отмена», = Esc). -->
            <Border Grid.Row="0" Classes="pay-header"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource csh.checkout.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SubtitleText" Text="{DynamicResource csh.checkout.subtitle}" FontSize="13"
                                   Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <!-- «3 позиции» — ставит CheckoutDialog.DockTo по строкам чека главного окна. -->
                        <TextBlock x:Name="LinesText" IsVisible="False" FontSize="13"
                                   Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="modal-close" Width="44" Height="44" VerticalAlignment="Top"
                            Click="Cancel_Click" IsTabStop="False" Focusable="False">
                        <PathIcon Data="{DynamicResource IconClose}" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Содержимое прокручивается; шапка и кнопки на месте. -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AllowAutoHide="True">
                <StackPanel Classes="pay-body">

                    <!-- Итог: тёмно-синяя карточка, сумма жёлтым, справа сдача (только наличные).
                         Цвета фирменные и одинаковые во всех темах: жёлтый по #0B2A3C — 11:1. -->
                    <Border Classes="pay-summary" CornerRadius="12" Background="#0B2A3C">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Text="{DynamicResource csh.checkout.totalDue}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#C9D6DF" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="{Binding PayableDisplay}" Classes="pay-sum"
                                       FontWeight="Bold" Foreground="#FFD600" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="12,0,0,0"
                                        VerticalAlignment="Bottom" IsVisible="{Binding IsCashMode}">
                                <TextBlock Text="{DynamicResource csh.checkout.change}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#C9D6DF" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ChangeAmountDisplay}" FontSize="22" FontWeight="Bold"
                                           Foreground="#FFFFFF" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                            </StackPanel>
                            <!-- Скидка (если есть) -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                        Margin="0,4,0,0" IsVisible="{Binding HasDiscount}">
                                <TextBlock Text="{DynamicResource discount.title}" FontSize="13" Foreground="#C9D6DF"/>
                                <TextBlock Text="{Binding DiscountSummaryDisplay}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#FCA5A5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Способ оплаты: прежние четыре (видимость и порядок — как были). -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource csh.checkout.paymentMethod}" Classes="pay-label"/>
                        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto">
                            <RadioButton x:Name="PayCashOption"
                                         Grid.Column="0" Grid.Row="0"
                                         GroupName="Pay"
                                         Classes="PayTypeOption"
                                         IsChecked="{Binding IsCash, Mode=TwoWay}">
                                <!-- значок + подпись сеткой — длинная подпись (кыргызский) переносится
                                     на вторую строку внутри кнопки, а не обрезается её краем. -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="pay-icon">
                                        <Path Classes="pay-icon-glyph" Data="M3,6H21V18H3V6M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M7,8A2,2 0 0,1 5,10V14A2,2 0 0,1 7,16H17A2,2 0 0,1 19,14V10A2,2 0 0,1 17,8H7Z"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.cash}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="PayTransferOption"
                                         Grid.Column="2" Grid.Row="0"
                                         GroupName="Pay"
                                         Classes="PayTypeOption"
                                         IsChecked="{Binding IsTransfer, Mode=TwoWay}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="pay-icon">
                                        <Path Classes="pay-icon-glyph" Data="M20,8H4V6H20M20,18H4V12H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.transfer}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="PayDebtOption"
                                         Grid.Column="0" Grid.Row="2"
                                         GroupName="Pay"
                                         Classes="PayTypeOption"
                                         IsChecked="{Binding IsDebt, Mode=TwoWay}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="pay-icon">
                                        <Path Classes="pay-icon-glyph" Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.debt}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="PayMixedOption"
                                         Grid.Column="2" Grid.Row="2"
                                         GroupName="Pay"
                                         Classes="PayTypeOption"
                                         IsChecked="{Binding IsMixed, Mode=TwoWay}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="pay-icon">
                                        <Path Classes="pay-icon-glyph" Data="M21,9L17,5V8H10V10H17V13M7,11L3,15L7,19V16H14V14H7V11Z"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.mixed}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </RadioButton>
                        </Grid>
                    </StackPanel>

                    <!-- 2026-10-02, владелец: «добавь сюда аренду / прокат». Одежда и услуги. -->
                    <Button Classes="pay-quick last" IsVisible="{Binding ShowRentalButton}" Command="{Binding RentalCommand}"
                            HorizontalAlignment="Stretch" Height="46">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource BrushAccentStrong}" VerticalAlignment="Center"
                                  Data="M12,4A3,3 0 0,1 15,7C15,8.27 14.21,9.36 13.1,9.79C12.91,9.9 12.71,10 12.5,10.1V11.3L21,17.5C21.88,18.13 21.43,19.5 20.35,19.5H3.65C2.57,19.5 2.12,18.13 3,17.5L11.5,11.3V9.14C11.5,8.76 11.73,8.43 12.07,8.28C12.67,8 13,7.54 13,7A1,1 0 0,0 12,6A1,1 0 0,0 11,7H9A3,3 0 0,1 12,4M12,13.04L6.37,17.5H17.63L12,13.04Z"/>
                            <TextBlock Text="{DynamicResource csh.checkout.rental}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- Наличные: получено, быстрые суммы, «недостаточно» (показывается только при IsCashMode) -->
                    <StackPanel IsVisible="{Binding IsCashMode}" Spacing="8">
                        <TextBlock Text="{DynamicResource csh.checkout.cashReceived}" Classes="pay-label"/>

                        <TextBox x:Name="CashReceivedBox"
                                 Classes="pay-amount pay-cash"
                                 Text="{Binding CashReceived}"
                                 KeyDown="CashReceivedBox_KeyDown"/>

                        <!-- «Без сдачи» (ExactCashCommand) и подсказки круглых сумм (2026-09-17: ближайшие 3 круглые
                             суммы не меньше итога) — одной строкой, ширина делится поровну между видимыми. -->
                        <UniformGrid Rows="1" Margin="0,0,-8,0">
                            <Button Classes="pay-quick" Focusable="False"
                                    Content="{DynamicResource csh.checkout.exact}"
                                    Command="{Binding ExactCashCommand}"/>
                            <Button Classes="pay-quick" Focusable="False"
                                    Content="{Binding CashSuggestion1Display}"
                                    Command="{Binding ApplyCashSuggestion1Command}"
                                    IsVisible="{Binding HasCashSuggestion1}"/>
                            <Button Classes="pay-quick" Focusable="False"
                                    Content="{Binding CashSuggestion2Display}"
                                    Command="{Binding ApplyCashSuggestion2Command}"
                                    IsVisible="{Binding HasCashSuggestion2}"/>
                            <Button Classes="pay-quick" Focusable="False"
                                    Content="{Binding CashSuggestion3Display}"
                                    Command="{Binding ApplyCashSuggestion3Command}"
                                    IsVisible="{Binding HasCashSuggestion3}"/>
                        </UniformGrid>

                        <TextBlock Text="{Binding ChangeStatusText}" IsVisible="{Binding ChangeStatusIsWarn}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushDanger}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Смешанная оплата: наличная + безналичная часть рядом -->
                    <StackPanel IsVisible="{Binding IsMixedMode}" Spacing="8">
                        <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,6,Auto">
                            <TextBlock Grid.Column="0" Text="{DynamicResource csh.checkout.mixedCash}" Classes="pay-label"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource csh.checkout.mixedNonCash}" Classes="pay-label"
                                       VerticalAlignment="Bottom"/>
                            <TextBox x:Name="MixedCashBox" Grid.Column="0" Grid.Row="2" Classes="pay-amount" Text="{Binding MixedCashAmount}"/>
                            <TextBox x:Name="MixedNonCashBox" Grid.Column="2" Grid.Row="2" Classes="pay-amount" Text="{Binding MixedNonCashAmount}"/>
                        </Grid>

                        <TextBlock Text="{Binding MixedRemainingText}"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushUiStatusOk}"
                                   IsVisible="{Binding MixedAmountsMatch}"/>
                        <TextBlock Text="{Binding MixedRemainingText}"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushDanger}"
                                   IsVisible="{Binding !MixedAmountsMatch}"/>
                    </StackPanel>

                    <!-- Банк и QR-код для безналичной оплаты: банк слева, QR справа (так QR виден без прокрутки). -->
                    <Grid IsVisible="{Binding IsBankSelectionVisible}" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource csh.checkout.selectBank}" Classes="pay-label"/>

                            <ComboBox x:Name="BankComboBox"
                                      ItemsSource="{Binding Banks}"
                                      SelectedItem="{Binding SelectedBank, Mode=TwoWay}"
                                      Height="44"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BankAccount">
                                        <TextBlock Text="{Binding BankName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- QR не загружен — подсказка, где его поставить. -->
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasQrCode}">
                                <TextBlock Text="📱" FontSize="20" VerticalAlignment="Top"/>
                                <TextBlock Text="{DynamicResource csh.checkout.noQrCode}"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="320"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Margin="12,0,0,0"
                                Background="White"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8"
                                VerticalAlignment="Top"
                                IsVisible="{Binding HasQrCode}">
                            <Image Source="{Binding QrCodePath, Converter={StaticResource PathToImageConverter}}"
                                   Width="150"
                                   Height="150"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>

                    <!-- Клиент: для продажи в долг ИЛИ для бонусной программы (AI-фичи 2026-09-04) —
                         блок теперь показывается в обоих случаях, а не только в режиме "долг". -->
                    <StackPanel x:CompileBindings="False"
                                IsVisible="{Binding ShowClientSection}"
                                Spacing="8">
                        <TextBlock Text="{DynamicResource csh.checkout.client}" Classes="pay-label"/>

                        <!-- Поиск/список клиентов и форма нового клиента — отдельное окно ClientPickerDialog
                             поверх того же CheckoutViewModel (2026-09-05). -->
                        <!-- 2026-10-19, К1: выбранный клиент — нейтральной плашкой (бледно-жёлтая была «вторым акцентом»). -->
                        <Border Background="{DynamicResource BrushPanelSoft}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,2"
                                MinHeight="44"
                                IsVisible="{Binding HasSelectedClient}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedClientName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{DynamicResource csh.checkout.changeClient}"
                                        Click="ChooseClient_Click"
                                        Padding="10,0" MinHeight="40" FontSize="13"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        Foreground="{DynamicResource BrushText}"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                                <!-- Отмена ошибочно выбранного клиента (2026-09-05). -->
                                <Button Grid.Column="2" Content="{DynamicResource csh.checkout.clearClient}"
                                        Command="{Binding ClearClientCommand}"
                                        Padding="10,0" MinHeight="40" MinWidth="40" FontSize="14"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        Foreground="{DynamicResource BrushDanger}"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <Button Content="{DynamicResource csh.checkout.chooseClient}"
                                Click="ChooseClient_Click"
                                IsVisible="{Binding !HasSelectedClient}"
                                Classes="sec-outline"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Height="44"
                                Cursor="Hand"/>

                        <!-- Бонусная программа — только когда включена в Настройки → Операции и клиент выбран. -->
                        <Border IsVisible="{Binding ShowLoyaltyBlock}" Background="{DynamicResource BrushPanelSoft}"
                                CornerRadius="8" Padding="10,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding ClientLoyaltyBalanceDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushText}"/>
                                <TextBox Text="{Binding PointsToRedeemInput}"
                                         Watermark="{DynamicResource csh.checkout.loyaltyRedeemWatermark}"
                                         Height="40"/>
                                <TextBlock Text="{Binding EarnedPointsPreviewDisplay}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextSoft}"/>
                            </StackPanel>
                        </Border>
                        <!-- 2026-10-17: долг — после выбора клиента: без клиента «в долг» не оплатить, он виден первым. -->
                        <!-- 2026-10-20, владелец (долг Д2): блок долга — те же подписи (pay-label) и отступы, что в остальном окне;
                             срок — сегменты «7 / 14 / 30 дней», выбранный тёмно-синим (Button.due-seg.selected). -->
                        <StackPanel IsVisible="{Binding IsDebtMode}" Spacing="8" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DebtPaidNowLabel}" Classes="pay-label"/>
                            <TextBox Text="{Binding DebtCashReceived}" Classes="pay-amount"/>
                            <!-- 2026-10-03: как внесена предоплата долга (включается в настройках кассы). -->
                            <WrapPanel Orientation="Horizontal" IsVisible="{Binding ShowDebtPrepaymentMethod}">
                                <TextBlock Text="{DynamicResource csh.checkout.prepayMethod}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,12,0"/>
                                <RadioButton GroupName="DebtPrepay" IsChecked="{Binding IsDebtPrepaymentCash, Mode=TwoWay}"
                                             Content="{DynamicResource csh.checkout.prepayCash}" FontSize="14" Margin="0,0,12,0"/>
                                <RadioButton GroupName="DebtPrepay" IsChecked="{Binding IsDebtPrepaymentNonCash, Mode=TwoWay}"
                                             Content="{DynamicResource csh.checkout.prepayNonCash}" FontSize="14"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding DebtRemainingText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushDanger}"/>
                            <!-- 2026-10-06, владелец: срок долга — одним платежом (дата, названная клиентом) или рассрочка по галочке,
                                 как «Отсрочка» сайта: по дням / по месяцам, число платежей, интервал, дата первого платежа, таблица. -->
                            <StackPanel IsVisible="{Binding IsSinglePayment}" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="{Binding DebtDueLabel}" Classes="pay-label"/>
                                <Grid ColumnDefinitions="*,6,Auto,6,Auto,6,Auto">
                                    <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding DebtDueDate, Mode=TwoWay}" Watermark="{Binding DebtDateWatermark}"
                                                        Height="40" MinWidth="140" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" Classes="due-seg" Classes.selected="{Binding IsDue7Selected}" Content="{Binding DebtDue7Text}"
                                            Command="{Binding SetDebtDueDaysCommand}" CommandParameter="7"/>
                                    <Button Grid.Column="4" Classes="due-seg" Classes.selected="{Binding IsDue14Selected}" Content="{Binding DebtDue14Text}"
                                            Command="{Binding SetDebtDueDaysCommand}" CommandParameter="14"/>
                                    <Button Grid.Column="6" Classes="due-seg" Classes.selected="{Binding IsDue30Selected}" Content="{Binding DebtDue30Text}"
                                            Command="{Binding SetDebtDueDaysCommand}" CommandParameter="30"/>
                                </Grid>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding IsInstallment, Mode=TwoWay}" Content="{Binding InstallmentCheckText}" FontSize="14"/>
                            <StackPanel IsVisible="{Binding IsInstallment}" Spacing="8">
                                <WrapPanel Orientation="Horizontal">
                                    <RadioButton GroupName="InstallmentUnit" IsChecked="{Binding IsInstallmentByDays, Mode=TwoWay}" Content="{Binding InstallmentByDaysText}" FontSize="14" Margin="0,0,16,0"/>
                                    <RadioButton GroupName="InstallmentUnit" IsChecked="{Binding IsInstallmentByMonths, Mode=TwoWay}" Content="{Binding InstallmentByMonthsText}" FontSize="14"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding InstallmentCountLabel}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}"/>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding InstallmentCountText}" Width="70" Height="38" Margin="0,0,8,6" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <WrapPanel IsVisible="{Binding IsInstallmentByDays}">
                                        <Button Classes="SecondaryButton" Content="2" Command="{Binding SetInstallmentCountCommand}" CommandParameter="2" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="3" Command="{Binding SetInstallmentCountCommand}" CommandParameter="3" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="7" Command="{Binding SetInstallmentCountCommand}" CommandParameter="7" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="10" Command="{Binding SetInstallmentCountCommand}" CommandParameter="10" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="14" Command="{Binding SetInstallmentCountCommand}" CommandParameter="14" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="30" Command="{Binding SetInstallmentCountCommand}" CommandParameter="30" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="90" Command="{Binding SetInstallmentCountCommand}" CommandParameter="90" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <WrapPanel IsVisible="{Binding IsInstallmentByMonths}">
                                        <Button Classes="SecondaryButton" Content="2" Command="{Binding SetInstallmentCountCommand}" CommandParameter="2" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="3" Command="{Binding SetInstallmentCountCommand}" CommandParameter="3" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="6" Command="{Binding SetInstallmentCountCommand}" CommandParameter="6" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="{Binding Months12Text}" Command="{Binding SetInstallmentCountCommand}" CommandParameter="12" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="{Binding Months24Text}" Command="{Binding SetInstallmentCountCommand}" CommandParameter="24" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding InstallmentIntervalLabel}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}"/>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding InstallmentIntervalText}" Width="70" Height="38" Margin="0,0,8,6" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <WrapPanel IsVisible="{Binding IsInstallmentByDays}">
                                        <Button Classes="SecondaryButton" Content="{Binding IntervalEveryDayText}" Command="{Binding SetInstallmentIntervalCommand}" CommandParameter="1" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="{Binding IntervalEveryOtherDayText}" Command="{Binding SetInstallmentIntervalCommand}" CommandParameter="2" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="{Binding IntervalEvery3DaysText}" Command="{Binding SetInstallmentIntervalCommand}" CommandParameter="3" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="{Binding IntervalWeeklyText}" Command="{Binding SetInstallmentIntervalCommand}" CommandParameter="7" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <WrapPanel IsVisible="{Binding IsInstallmentByMonths}">
                                        <Button Classes="SecondaryButton" Content="{Binding IntervalMonthlyText}" Command="{Binding SetInstallmentIntervalCommand}" CommandParameter="1" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="{Binding IntervalEvery2MonthsText}" Command="{Binding SetInstallmentIntervalCommand}" CommandParameter="2" Margin="0,0,6,6"/>
                                        <Button Classes="SecondaryButton" Content="{Binding IntervalQuarterlyText}" Command="{Binding SetInstallmentIntervalCommand}" CommandParameter="3" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding InstallmentFirstDateLabel}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}"/>
                                <CalendarDatePicker SelectedDate="{Binding InstallmentFirstDate, Mode=TwoWay}" Watermark="{Binding DebtDateWatermark}" Height="40" MinWidth="170" HorizontalAlignment="Left"/>
                                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <ItemsControl ItemsSource="{Binding InstallmentRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DebtInstallmentRow">
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="13" Margin="12,0" Foreground="{DynamicResource BrushTextSoft}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="13" FontWeight="SemiBold" MinWidth="80" TextAlignment="Right" Foreground="{DynamicResource BrushText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DebtDueHint}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Консультант (2026-09-25, сфера «Одежда» в Настройки → Операции) — как блок
                         «КОНСУЛЬТАНТ» на сайте: кто помог покупателю и процент ему с продажи. -->
                    <StackPanel x:Name="ConsultantSection" IsVisible="{Binding ShowConsultantSection}" Spacing="8">
                        <TextBlock Text="{Binding ConsultantTitleText}" Classes="pay-label"/>
                        <CheckBox Classes="Switch"
                                  Content="{Binding ConsultantToggleText}"
                                  IsChecked="{Binding IsConsultantEnabled}"/>
                        <StackPanel IsVisible="{Binding IsConsultantEnabled}" Spacing="8">
                            <TextBlock Text="{Binding ConsultantHintText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                            <!-- Выбранный сотрудник -->
                            <Border Background="{DynamicResource BrushAccentSoft}"
                                    BorderBrush="{DynamicResource BrushAccent}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,2" MinHeight="44"
                                    IsVisible="{Binding HasSelectedConsultant}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedConsultant.Name, FallbackValue=''}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{Binding ConsultantChangeText}"
                                            Command="{Binding ChangeConsultantCommand}"
                                            Padding="10,0" MinHeight="40" FontSize="13" FontWeight="SemiBold"
                                            VerticalContentAlignment="Center" Background="Transparent"
                                            Foreground="{DynamicResource BrushText}" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                            <!-- Поиск и список сотрудников -->
                            <StackPanel IsVisible="{Binding ShowConsultantPicker}" Spacing="6">
                                <TextBox Text="{Binding ConsultantSearch}"
                                         Watermark="{Binding ConsultantSearchWatermark}"
                                         Height="40" Padding="10,6" CornerRadius="8"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="{Binding ConsultantListStatus}" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           IsVisible="{Binding HasConsultantListStatus}"/>
                                <ListBox ItemsSource="{Binding ConsultantMatches}"
                                         SelectedItem="{Binding SelectedConsultant, Mode=TwoWay}"
                                         MaxHeight="180"
                                         BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                                         Background="{DynamicResource BrushPanel}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConsultantOption">
                                            <TextBlock Text="{Binding Name}" Padding="2,4" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BrushText}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <CheckBox Classes="Switch"
                                      Content="{Binding ConsultantCommissionToggleText}"
                                      IsChecked="{Binding IsConsultantCommissionEnabled}"
                                      IsEnabled="{Binding HasSelectedConsultant}"/>
                            <Grid ColumnDefinitions="130,12,*" IsVisible="{Binding IsConsultantCommissionEnabled}">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding ConsultantPercentLabel}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBox Text="{Binding ConsultantPercentInput}"
                                             Watermark="{Binding ConsultantPercentWatermark}"
                                             IsEnabled="{Binding HasSelectedConsultant}"
                                             Height="40" Padding="10,6" CornerRadius="8" FontWeight="Bold"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ConsultantCommissionPreview}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushUiStatusOk}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,9" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="{Binding ConsultantNoCommissionText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSoft}"
                                       IsVisible="{Binding ShowConsultantNoCommissionNote}"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- 2а. Закреплено над кнопками (2026-10-21, пакет 6, п. 27 и п. 15). -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,10,20,4">
                <StackPanel Spacing="6">
                    <!-- Почему «Оплатить» неактивна (в долг — нужен клиент и срок). -->
                    <TextBlock Text="{Binding PayBlockedHint}"
                               IsVisible="{Binding HasPayBlockedHint}"
                               Foreground="{DynamicResource BrushText}"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <!-- Ошибка -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource BrushDanger}"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !!ErrorMessage}"/>
                    <!-- Консультант одной строкой: касание — прокрутка к его блоку. -->
                    <Button x:Name="ConsultantSummaryButton" Classes="main-ghost"
                            IsVisible="{Binding ShowConsultantSection}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            MinHeight="36" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="ConsultantSummary_Click">
                        <TextBlock x:Name="ConsultantSummaryText" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushText}"/>
                    </Button>
                    <!-- Печать чека: выбор кассира запоминается (UserPreferences.CheckoutPrintReceipt). -->
                    <!-- 2026-10-20 (живой аудит кассы, К7): без «Печатать чек после оплаты» в Настройках переключатель неактивен;
                         подпись — что выбор запоминается и где главный выключатель. -->
                    <StackPanel Spacing="2">
                        <CheckBox Classes="Switch" MinHeight="32"
                                  Content="{DynamicResource csh.checkout.printReceipt}"
                                  IsEnabled="{Binding IsPrintReceiptAvailable}"
                                  IsChecked="{Binding IsPrintReceiptEnabled}"/>
                        <TextBlock Text="{Binding PrintReceiptHint}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Кнопки: «Отмена» (обводка, Esc) слева, жёлтая «Оплатить …» (Enter) справа. -->
            <Border Grid.Row="3" Classes="pay-footer"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <Button IsCancel="True" Grid.Column="0" Content="{DynamicResource csh.checkout.cancel}"
                            Click="Cancel_Click"
                            Classes="modal-cancel"
                            MinHeight="52" MinWidth="96" MaxWidth="140"/>

                    <Button Grid.Column="1"
                            Classes="modal-primary"
                            Command="{Binding PayCommand}"
                            IsEnabled="{Binding CanPay}"
                            MinHeight="52"
                            Margin="10,0,0,0"
                            Padding="14,4"
                            HorizontalAlignment="Stretch"
                            FontSize="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Classes="key-badge" Margin="10,0,0,0">
                                <TextBlock Text="Enter" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushAccentForeground}"/>
                            </Border>
                            <TextBlock Text="{Binding PayButtonText}" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" FontWeight="Bold"/>
                        </DockPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
