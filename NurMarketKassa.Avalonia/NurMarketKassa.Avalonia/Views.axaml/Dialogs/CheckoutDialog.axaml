<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NurMarketKassa.ViewModels"
        xmlns:conv="using:NurMarketKassa.Converters"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CheckoutDialog"
        x:DataType="vm:CheckoutViewModel"
        x:CompileBindings="True"
        Title="{DynamicResource csh.checkout.title}"
        Width="880" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImageConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Стиль для переключателей способа оплаты в виде кнопок -->
        <Style Selector="RadioButton.PayTypeOption">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Фокус с клавиатуры рисует стиль :focus-visible ниже; рамка Fluent легла бы второй. -->
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.PayTypeOption:checked">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Способ оплаты, выбранный стрелками: рамка толще и ярче, чтобы кассир видел, где
             клавиатура. Отступ меньше ровно на столько, на сколько толще рамка, — кнопка не прыгает. -->
        <Style Selector="RadioButton.PayTypeOption:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Padding" Value="13,0"/>
        </Style>

        <!-- 2026-10-02, владелец: «сделай редизайн, иконки, кнопки нормальные». -->
        <Style Selector="RadioButton.PayTypeOption Border.pay-icon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="RadioButton.PayTypeOption:checked Border.pay-icon">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
        </Style>
        <Style Selector="RadioButton.PayTypeOption Path.pay-icon-glyph">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}"/>
        </Style>
        <Style Selector="RadioButton.PayTypeOption:checked Path.pay-icon-glyph">
            <Setter Property="Fill" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="Button.pay-quick">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 2026-10-04, редизайн под Android-телефон: в окне 431 точка поля 16 + 32 оставляли содержимому ~320 —
             «Наличн/ые», «Оплатить 50.0». Обычные значения (раньше стояли прямо на элементах) и узкий вид:
             класс narrow ставит CheckoutDialog.axaml.cs только на Android, когда окно уже 560. -->
        <Style Selector="Border.checkout-shell">
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Padding" Value="32,28"/>
        </Style>
        <Style Selector="StackPanel.checkout-header">
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
        <Style Selector="Grid.checkout-columns">
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
        <Style Selector="Border.checkout-total-card">
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style Selector="TextBlock.checkout-big-total">
            <Setter Property="FontSize" Value="44"/>
        </Style>
        <Style Selector="Button.checkout-cancel">
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style Selector=".narrow Border.checkout-shell">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="14,14"/>
        </Style>
        <Style Selector=".narrow StackPanel.checkout-header">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector=".narrow Grid.checkout-columns">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector=".narrow Border.checkout-total-card">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector=".narrow Border.checkout-total-icon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".narrow StackPanel.checkout-total-stack">
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector=".narrow TextBlock.checkout-big-total">
            <Setter Property="FontSize" Value="34"/>
        </Style>
        <Style Selector=".narrow Button.checkout-cancel">
            <Setter Property="Width" Value="104"/>
        </Style>
        <Style Selector=".narrow RadioButton.PayTypeOption">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector=".narrow RadioButton.PayTypeOption:focus-visible">
            <Setter Property="Padding" Value="7,0"/>
        </Style>
        <Style Selector=".narrow RadioButton.PayTypeOption Border.pay-icon">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style Selector="CheckBox.Switch">
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <!-- Фон и рамка тумблера (трек) -->
                        <Border x:Name="PART_SwitchTrack"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource BrushBorderStrong}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>

                            <!-- Ползунок -->
                            <Border x:Name="PART_SwitchThumb"
                                    Width="18" Height="18"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="9"
                                    Background="{DynamicResource BrushPanel}">
                                <Border.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin"
                                                             Duration="0:0:0.2"
                                                             Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Border>
                        <!-- Текст рядом с тумблером -->
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Состояние ВКЛЮЧЕНО (Checked) -->
        <Style Selector="CheckBox.Switch:checked /template/ Border#PART_SwitchTrack">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/> <!-- Цвет включенного состояния -->
        </Style>
        <Style Selector="CheckBox.Switch:checked /template/ Border#PART_SwitchThumb">
            <Setter Property="Margin" Value="23,0,0,0"/> <!-- Смещение ползунка вправо -->
        </Style>

        <!-- Состояние Наведение (Hover) -->
        <Style Selector="CheckBox.Switch:pointerover /template/ Border#PART_SwitchTrack">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- Состояние Отключено (Disabled) -->
        <Style Selector="CheckBox.Switch:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Styles>

    <!-- Кастомное модальное окно -->
    <Border Classes="checkout-shell" CornerRadius="{DynamicResource SettingsCardRadius}"
            Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
            BoxShadow="0 20 48 0 #40101828">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 1. Заголовок диалога -->
            <StackPanel Grid.Row="0" Spacing="4" Classes="checkout-header">
                <TextBlock Text="{DynamicResource csh.checkout.title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="{DynamicResource csh.checkout.subtitle}" FontSize="14" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 2. Основной контент: Итог слева, Оплата справа -->
            <Grid x:Name="CheckoutColumnsGrid" Grid.Row="1" ColumnDefinitions="*,32,*" Classes="checkout-columns">

                <!-- Левая колонка: Итоговая сумма -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushPanelSoft}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Classes="checkout-total-card">
                    <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="checkout-total-stack">
                        <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Classes="checkout-total-icon"
                                Background="{DynamicResource BrushAccentSoft}">
                            <Path Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource BrushAccentStrong}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M3,22V3H21V22L18,20L15,22L12,20L9,22L6,20L3,22M17,9V7H15V9H17M13,9V7H7V9H13M13,11H7V13H13V11M15,13H17V11H15V13Z"/>
                        </Border>
                        <TextBlock Text="{DynamicResource csh.checkout.totalDue}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextSoft}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <TextBlock Text="{Binding BigTotalDisplay}"
                                   Classes="checkout-big-total" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <TextBlock Text="{Binding PayableDisplay}" FontSize="16" Foreground="{DynamicResource BrushTextMuted}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- Скидка (если есть) -->
                        <Border Background="{DynamicResource BrushDangerSoft}"
                                CornerRadius="8"
                                Padding="10,6"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasDiscount}">
                            <TextBlock Text="{Binding DiscountSummaryDisplay}"
                                       Foreground="{DynamicResource BrushDanger}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Правая колонка: Способы оплаты и ввод (со скроллом — панель клиента для «в долг» может не уместиться на невысоком экране) -->
                <!-- 2026-10-04: без жёсткого MaxHeight="540". Высоту окна ограничивает экран
                     (ClampToScreenHeight / DialogScreenFit), правая колонка — строка «*» между шапкой и
                     кнопками: на низком экране она прокручивается, а «Оплатить» всегда видна внизу; на
                     высоком (1920×1080) блок клиента и консультанта помещается целиком, без лишней прокрутки. -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="True">
                <StackPanel Spacing="16" Margin="0,0,14,0">

                    <TextBlock Text="{DynamicResource csh.checkout.paymentMethod}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextSoft}"/>

                    <!-- Переключение Наличные / Безналичные -->
                    <Grid ColumnDefinitions="*,10,*">
                        <RadioButton x:Name="PayCashOption"
                                     Grid.Column="0"
                                     GroupName="Pay"
                                     Classes="PayTypeOption"
                                     IsChecked="{Binding IsCash, Mode=TwoWay}">
                            <!-- 2026-10-04: значок + подпись сеткой — длинная подпись (кыргызский) переносится
                                 на вторую строку внутри кнопки, а не обрезается её краем. -->
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="pay-icon">
                                    <Path Classes="pay-icon-glyph" Data="M3,6H21V18H3V6M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M7,8A2,2 0 0,1 5,10V14A2,2 0 0,1 7,16H17A2,2 0 0,1 19,14V10A2,2 0 0,1 17,8H7Z"/>
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.cash}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="PayTransferOption"
                                     Grid.Column="2"
                                     GroupName="Pay"
                                     Classes="PayTypeOption"
                                     IsChecked="{Binding IsTransfer, Mode=TwoWay}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="pay-icon">
                                    <Path Classes="pay-icon-glyph" Data="M20,8H4V6H20M20,18H4V12H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"/>
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.transfer}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </RadioButton>
                    </Grid>

                    <!-- Долг / Смешанная — отдельная строка, чтобы не сжимать длинный текст "Накталай эмес" в первой -->
                    <Grid ColumnDefinitions="*,10,*" Margin="0,-6,0,0">
                        <RadioButton x:Name="PayDebtOption"
                                     Grid.Column="0"
                                     GroupName="Pay"
                                     Classes="PayTypeOption"
                                     IsChecked="{Binding IsDebt, Mode=TwoWay}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="pay-icon">
                                    <Path Classes="pay-icon-glyph" Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.debt}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="PayMixedOption"
                                     Grid.Column="2"
                                     GroupName="Pay"
                                     Classes="PayTypeOption"
                                     IsChecked="{Binding IsMixed, Mode=TwoWay}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="pay-icon">
                                    <Path Classes="pay-icon-glyph" Data="M21,9L17,5V8H10V10H17V13M7,11L3,15L7,19V16H14V14H7V11Z"/>
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource csh.checkout.mixed}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </RadioButton>
                    </Grid>

                    <!-- 2026-10-02, владелец: «добавь сюда аренду / прокат». Одежда и услуги. -->
                    <Button Classes="pay-quick" IsVisible="{Binding ShowRentalButton}" Command="{Binding RentalCommand}"
                            HorizontalAlignment="Stretch" Height="46" CornerRadius="12" Margin="0,-6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource BrushAccentStrong}" VerticalAlignment="Center"
                                  Data="M12,4A3,3 0 0,1 15,7C15,8.27 14.21,9.36 13.1,9.79C12.91,9.9 12.71,10 12.5,10.1V11.3L21,17.5C21.88,18.13 21.43,19.5 20.35,19.5H3.65C2.57,19.5 2.12,18.13 3,17.5L11.5,11.3V9.14C11.5,8.76 11.73,8.43 12.07,8.28C12.67,8 13,7.54 13,7A1,1 0 0,0 12,6A1,1 0 0,0 11,7H9A3,3 0 0,1 12,4M12,13.04L6.37,17.5H17.63L12,13.04Z"/>
                            <TextBlock Text="{DynamicResource csh.checkout.rental}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Поле ввода наличных (показывается только при IsCashMode) -->
                    <StackPanel IsVisible="{Binding IsCashMode}" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource csh.checkout.cashReceived}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}"/>

                        <TextBox x:Name="CashReceivedBox"
                                 Text="{Binding CashReceived}"
                                 Height="46"
                                 Padding="12,8"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 CornerRadius="10"
                                 BorderBrush="{DynamicResource BrushBorder}"
                                 BorderThickness="1.5"
                                 Background="{DynamicResource BrushPanel}"
                                 VerticalContentAlignment="Center"
                                 KeyDown="CashReceivedBox_KeyDown"/>

                        <!-- 2026-09-17, по просьбе пользователя: подсказки круглых сумм, которые
                             мог дать клиент (как на сайте) — вместо ручного набора суммы. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasCashSuggestion1}">
                            <Button Content="{Binding CashSuggestion1Display}"
                                    Command="{Binding ApplyCashSuggestion1Command}"
                                    IsVisible="{Binding HasCashSuggestion1}"
                                    Classes="pay-quick"/>
                            <Button Content="{Binding CashSuggestion2Display}"
                                    Command="{Binding ApplyCashSuggestion2Command}"
                                    IsVisible="{Binding HasCashSuggestion2}"
                                    Classes="pay-quick"/>
                            <Button Content="{Binding CashSuggestion3Display}"
                                    Command="{Binding ApplyCashSuggestion3Command}"
                                    IsVisible="{Binding HasCashSuggestion3}"
                                    Classes="pay-quick"/>
                        </StackPanel>

                        <!-- Сдача -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource csh.checkout.change}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChangeAmountDisplay}" Foreground="{DynamicResource BrushUiStatusOk}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Смешанная оплата: наличная + безналичная часть -->
                    <StackPanel IsVisible="{Binding IsMixedMode}" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource csh.checkout.mixedCash}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBox Text="{Binding MixedCashAmount}"
                                 Height="44" Padding="12,8" FontSize="16" FontWeight="Bold"
                                 CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                                 Background="{DynamicResource BrushPanel}" VerticalContentAlignment="Center"/>

                        <TextBlock Text="{DynamicResource csh.checkout.mixedNonCash}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding MixedNonCashAmount}"
                                 Height="44" Padding="12,8" FontSize="16" FontWeight="Bold"
                                 CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                                 Background="{DynamicResource BrushPanel}" VerticalContentAlignment="Center"/>

                        <TextBlock Text="{Binding MixedRemainingText}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushUiStatusOk}"
                                   IsVisible="{Binding MixedAmountsMatch}"/>
                        <TextBlock Text="{Binding MixedRemainingText}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushDanger}"
                                   IsVisible="{Binding !MixedAmountsMatch}"/>
                    </StackPanel>

                    <!-- Чекбокс печати чека в виде Switch -->
                    <!-- Банк и QR-код для безналичной оплаты -->
                    <StackPanel IsVisible="{Binding IsBankSelectionVisible}"
                                Spacing="10"
                                Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource csh.checkout.selectBank}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextMuted}"/>

                        <ComboBox x:Name="BankComboBox"
                                  ItemsSource="{Binding Banks}"
                                  SelectedItem="{Binding SelectedBank, Mode=TwoWay}"
                                  Height="42"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BankAccount">
                                    <TextBlock Text="{Binding BankName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Background="White"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasQrCode}">
                            <Image Source="{Binding QrCodePath, Converter={StaticResource PathToImageConverter}}"
                                   Width="180"
                                   Height="180"
                                   Stretch="Uniform"/>
                        </Border>

                        <Border Background="{DynamicResource BrushPanelSoft}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Width="180"
                                Height="180"
                                Padding="14"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding !HasQrCode}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <TextBlock Text="📱" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource csh.checkout.noQrCode}"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Клиент: для продажи в долг ИЛИ для бонусной программы (AI-фичи 2026-09-04) —
                         блок теперь показывается в обоих случаях, а не только в режиме "долг". -->
                    <StackPanel x:CompileBindings="False"
                                IsVisible="{Binding ShowClientSection}"
                                Spacing="10"
                                Margin="0,4,0,0">
                        <StackPanel IsVisible="{Binding IsDebtMode}" Spacing="10">
                            <TextBlock Text="{DynamicResource csh.checkout.paidNow}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBox Text="{Binding DebtCashReceived}"
                                     Height="44" Padding="12,8" FontSize="16" FontWeight="Bold"
                                     CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                                     Background="{DynamicResource BrushPanel}" VerticalContentAlignment="Center"/>
                            <!-- 2026-10-03: как внесена предоплата долга (включается в настройках кассы). -->
                            <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding ShowDebtPrepaymentMethod}">
                                <TextBlock Text="{DynamicResource csh.checkout.prepayMethod}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <RadioButton GroupName="DebtPrepay" IsChecked="{Binding IsDebtPrepaymentCash, Mode=TwoWay}"
                                             Content="{DynamicResource csh.checkout.prepayCash}" FontSize="14"/>
                                <RadioButton GroupName="DebtPrepay" IsChecked="{Binding IsDebtPrepaymentNonCash, Mode=TwoWay}"
                                             Content="{DynamicResource csh.checkout.prepayNonCash}" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DebtRemainingText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushDanger}"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource csh.checkout.client}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}" Margin="0,6,0,0"/>

                        <!-- Поиск/список клиентов и форма нового клиента раньше были встроены
                             прямо сюда и обрезались на невысоких экранах (2026-09-05, по
                             просьбе пользователя: "клиентов сделай отдельное модальное окно
                             выбора, а то он не помещается") — теперь отдельное окно
                             ClientPickerDialog поверх того же CheckoutViewModel. -->
                        <Border Background="{DynamicResource BrushAccentSoft}"
                                BorderBrush="{DynamicResource BrushAccent}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                IsVisible="{Binding HasSelectedClient}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedClientName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{DynamicResource csh.checkout.changeClient}"
                                        Click="ChooseClient_Click"
                                        Padding="8,4" FontSize="12"
                                        Background="Transparent"
                                        Foreground="{DynamicResource BrushAccentStrong}"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                                <!-- Отмена ошибочно выбранного клиента (2026-09-05, по просьбе
                                     пользователя: "если по ошибке выбрали клиента добавь
                                     возможность отмены") — раньше после выбора отменить было
                                     нельзя вообще. -->
                                <Button Grid.Column="2" Content="{DynamicResource csh.checkout.clearClient}"
                                        Command="{Binding ClearClientCommand}"
                                        Padding="8,4" FontSize="12"
                                        Background="Transparent"
                                        Foreground="{DynamicResource BrushDanger}"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <Button Content="{DynamicResource csh.checkout.chooseClient}"
                                Click="ChooseClient_Click"
                                IsVisible="{Binding !HasSelectedClient}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="42"
                                Background="{DynamicResource BrushPanelSoft}"
                                Foreground="{DynamicResource BrushText}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"/>

                        <!-- Бонусная программа (локально на этой кассе, см. ClientLoyaltyStore) —
                             только когда включена в Настройки → Операции и клиент выбран. -->
                        <StackPanel IsVisible="{Binding ShowLoyaltyBlock}" Spacing="6"
                                    Background="{DynamicResource BrushPanelSoft}"
                                    Margin="0,2,0,0">
                            <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="8" Padding="10,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding ClientLoyaltyBalanceDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentStrong}"/>
                                    <TextBox Text="{Binding PointsToRedeemInput}"
                                             Watermark="{DynamicResource csh.checkout.loyaltyRedeemWatermark}"
                                             Height="38"/>
                                    <TextBlock Text="{Binding EarnedPointsPreviewDisplay}" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Консультант (2026-09-25, сфера «Одежда» в Настройки → Операции) — как блок
                         «КОНСУЛЬТАНТ» на сайте: кто помог покупателю и процент ему с продажи. -->
                    <StackPanel IsVisible="{Binding ShowConsultantSection}" Spacing="10" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ConsultantTitleText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextSoft}"/>
                        <CheckBox Classes="Switch"
                                  Content="{Binding ConsultantToggleText}"
                                  IsChecked="{Binding IsConsultantEnabled}"/>
                        <StackPanel IsVisible="{Binding IsConsultantEnabled}" Spacing="8">
                            <TextBlock Text="{Binding ConsultantHintText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                            <!-- Выбранный сотрудник -->
                            <Border Background="{DynamicResource BrushAccentSoft}"
                                    BorderBrush="{DynamicResource BrushAccent}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8"
                                    IsVisible="{Binding HasSelectedConsultant}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedConsultant.Name, FallbackValue=''}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{Binding ConsultantChangeText}"
                                            Command="{Binding ChangeConsultantCommand}"
                                            Padding="8,4" FontSize="12" Background="Transparent"
                                            Foreground="{DynamicResource BrushAccentStrong}" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                            <!-- Поиск и список сотрудников -->
                            <StackPanel IsVisible="{Binding ShowConsultantPicker}" Spacing="6">
                                <TextBox Text="{Binding ConsultantSearch}"
                                         Watermark="{Binding ConsultantSearchWatermark}"
                                         Height="40" Padding="10,6" CornerRadius="8"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="{Binding ConsultantListStatus}" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           IsVisible="{Binding HasConsultantListStatus}"/>
                                <ListBox ItemsSource="{Binding ConsultantMatches}"
                                         SelectedItem="{Binding SelectedConsultant, Mode=TwoWay}"
                                         MaxHeight="180"
                                         BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                                         Background="{DynamicResource BrushPanel}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConsultantOption">
                                            <TextBlock Text="{Binding Name}" Padding="2,4" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BrushText}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <CheckBox Classes="Switch"
                                      Content="{Binding ConsultantCommissionToggleText}"
                                      IsChecked="{Binding IsConsultantCommissionEnabled}"
                                      IsEnabled="{Binding HasSelectedConsultant}"/>
                            <Grid ColumnDefinitions="140,12,*" IsVisible="{Binding IsConsultantCommissionEnabled}">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding ConsultantPercentLabel}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBox Text="{Binding ConsultantPercentInput}"
                                             Watermark="{Binding ConsultantPercentWatermark}"
                                             IsEnabled="{Binding HasSelectedConsultant}"
                                             Height="40" Padding="10,6" CornerRadius="8" FontWeight="Bold"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ConsultantCommissionPreview}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushUiStatusOk}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,9" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="{Binding ConsultantNoCommissionText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSoft}"
                                       IsVisible="{Binding ShowConsultantNoCommissionNote}"/>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox Classes="Switch"
                              Content="{DynamicResource csh.checkout.printReceipt}"
                              IsChecked="{Binding IsPrintReceiptEnabled}"
                              Margin="0,4,0,0"/>

                    <!-- Ошибка -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource BrushDanger}"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !!ErrorMessage}"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3. Кнопки действий -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                <Button IsCancel="True" Grid.Column="0" Content="{DynamicResource csh.checkout.cancel}"
                        Click="Cancel_Click"
                        Classes="checkout-cancel"
                        Height="56"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource BrushPanel}"
                        Foreground="{DynamicResource BrushTextMuted}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1.5"
                        FontWeight="SemiBold"
                        CornerRadius="12"
                        Cursor="Hand"/>

                <Button Grid.Column="1"
                        Command="{Binding PayCommand}"
                        IsEnabled="{Binding CanPay}"
                        Height="56"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource BrushAccent}"
                        Foreground="{DynamicResource BrushAccentForeground}"
                        FontSize="17"
                        FontWeight="Bold"
                        CornerRadius="12"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource BrushAccentForeground}"
                              Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                        <TextBlock Text="{Binding PayButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
