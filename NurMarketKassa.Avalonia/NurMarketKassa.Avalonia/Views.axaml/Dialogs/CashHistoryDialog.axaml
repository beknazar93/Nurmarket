<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CashHistoryDialog"
        x:DataType="dialogs:CashHistoryDialog"
        xmlns:dialogs="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        xmlns:views="using:NurMarketKassa.AvaloniaHost.Views"
        x:CompileBindings="True"
        Title="{DynamicResource cashHistory.title}"
        Width="880" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <Window.Styles>
  <!-- 2026-11-12 (Д-4): заголовки таблицы — не меньше 12,5 (были 12). -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
  </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <!-- 2026-11-12 (Д-4): линии строк — цвет темы (был жёсткий #E2E8F0, в тёмной теме светлые полосы). -->
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="RowHeight" Value="40"/>
    </Style>
  </Window.Styles>

  <!-- 2026-11-12 (Д-4): общая рамка ModalShell (заголовок, пояснение, ✕, «Закрыть» внизу); свои стили кнопки (btn-secondary) и
       ручная карточка убраны. Пустая таблица — пояснение по центру вместо пустой серой рамки. -->
  <dialogs:ModalShell x:Name="Shell" Margin="16"
                      Title="{DynamicResource cashHistory.title}"
                      Subtitle="{DynamicResource cashHistory.subtitle}"
                      ContentScroll="Disabled">
    <dialogs:ModalShell.Footer>
      <Button Classes="modal-cancel" Content="{DynamicResource common.close}" MaxWidth="200"
              IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </dialogs:ModalShell.Footer>

    <Grid>
      <DataGrid x:CompileBindings="False"
                ItemsSource="{Binding HistoryItems}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{DynamicResource common.dateTime}"
                              Width="180"
                              Binding="{ReflectionBinding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"/>
          <DataGridTextColumn Header="{DynamicResource common.type}"
                              Width="120"
                              Binding="{ReflectionBinding Type}"/>
          <DataGridTextColumn Header="{DynamicResource common.amountSom}"
                              Width="120"
                              Binding="{ReflectionBinding Amount, StringFormat={}{0:N2}}"/>
          <DataGridTextColumn Header="{DynamicResource common.user}"
                              Width="180"
                              Binding="{ReflectionBinding UserId}"/>
          <DataGridTextColumn Header="{DynamicResource common.comment}"
                              Width="*" MinWidth="180"
                              Binding="{ReflectionBinding Comment}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyHint"
                 Text="{DynamicResource cashHistory.empty}"
                 FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                 Foreground="{DynamicResource BrushTextSoft}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="False"/>
    </Grid>
  </dialogs:ModalShell>
</Window>
