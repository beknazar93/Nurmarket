<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.BulkPriceTagPrintDialog"
        x:DataType="dialogs:BulkPriceTagPrintDialog"
        x:CompileBindings="False"
        Title="{DynamicResource priceTagBulk.title}"
        Width="912" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI, Inter, Noto Sans"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-20, этап О9б (редизайн ценников): общая оболочка ModalShell — заголовок и ✕ сверху, «Выбрано товаров» и
         кнопки снизу на месте, список товаров занимает оставшуюся высоту и прокручивается сам. «Выбрать всё / Снять всё» —
         обводкой (были серые заливки), «Куда печатать» — сегменты, шапка таблицы — без чёрной полосы в тёмной теме,
         пустой поиск — подсказкой. Имена элементов и обработчики — прежние. -->
    <Window.Styles>
        <Style Selector="ComboBox, NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="DataGrid#ProductsGrid DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <!-- 2026-10-20, этап О9б: длинное название — в две строки, а не обрезается (колонка уже из-за панели настроек справа). -->
        <Style Selector="DataGrid#ProductsGrid DataGridCell TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="DataGrid#ProductsGrid">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
        </Style>
    </Window.Styles>

    <dialogs:ModalShell Margin="16"
                        Title="{DynamicResource priceTagBulk.header}"
                        Subtitle="{DynamicResource priceTagBulk.subtitle}"
                        ContentScroll="Disabled">
        <dialogs:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" Content="{DynamicResource common.close}" Classes="modal-cancel" Click="CloseButton_Click"/>
                <Button x:Name="PrintButton" Content="{DynamicResource priceTagBulk.printButton}" Classes="modal-primary" Click="PrintButton_Click"/>
            </StackPanel>
        </dialogs:ModalShell.Footer>
        <!-- 2026-10-20, этап О9б: «Выбрано товаров» и «Выбрать всё / Снять всё» — слева на строке кнопок (поиск над списком —
             во всю ширину, на кыргызском кнопки не сжимают его). -->
        <dialogs:ModalShell.Hint>
            <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="460">
                <TextBlock x:Name="SelectionCountText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource BrushText}"/>
                <Button Classes="sec-outline" Content="{DynamicResource priceTagBulk.selectAll}" Click="SelectAll_Click"/>
                <Button Classes="sec-outline" Content="{DynamicResource priceTagBulk.selectNone}" Click="SelectNone_Click"/>
            </StackPanel>
        </dialogs:ModalShell.Hint>

        <!-- 2026-10-20, этап О9б: слева список товаров на всю высоту окна, справа настройки печати (раньше настройки под
             списком оставляли ему 4 строки). -->
        <Grid ColumnDefinitions="*,20,280">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBox Grid.Row="0" x:Name="SearchBox" Watermark="{DynamicResource warehouse.productSearchWatermark}"
                         TextChanged="SearchBox_TextChanged" Margin="0,0,0,10" MinHeight="40" CornerRadius="10"/>

                <!-- MinHeight (не "*") — на маленьком/квадратном экране список товаров ужимается сам
                     через собственный скролл DataGrid, а не выталкивает нижние кнопки печати за
                     пределы окна (см. фикс "кнопка проваливается вниз", 2026-09-04). -->
                <Border Grid.Row="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="10" MinHeight="150" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="False" RowHeight="46" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource common.name}" Width="*" Binding="{Binding Title}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource csh.catalog.colBarcode}" Width="150" Binding="{Binding Barcode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource csh.catalog.colPrice}" Width="118" Binding="{Binding PriceLine}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 2026-10-20, этап О9б: пустой список — подсказка поверх таблицы (что сделать). -->
                        <TextBlock x:Name="EmptyListText" IsVisible="False" IsHitTestVisible="False" Margin="24,64,24,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="420" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource BrushTextSoft}"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource priceTag.templateLabel}"/>
                        <ComboBox x:Name="KindCombo" HorizontalAlignment="Stretch" SelectionChanged="KindCombo_SelectionChanged"/>
                        <Button x:Name="EditTemplateButton" Content="{DynamicResource priceTag.editTemplate}" Classes="sec-outline"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                IsVisible="False" Click="EditTemplateButton_Click"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="field-label" Text="{DynamicResource labelEditor.widthLabel}" TextWrapping="Wrap"/>
                            <NumericUpDown x:Name="WidthBox" Minimum="15" Maximum="150" Increment="1" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="field-label" Text="{DynamicResource labelEditor.heightLabel}" TextWrapping="Wrap"/>
                            <NumericUpDown x:Name="HeightBox" Minimum="10" Maximum="150" Increment="1" FormatString="0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource priceTag.targetLabel}"/>
                        <Border Classes="sec-segment" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="2">
                                <RadioButton x:Name="TargetThermalRadio" GroupName="BulkPriceTagTarget" Classes="sec-seg" HorizontalAlignment="Stretch"
                                             Content="{DynamicResource priceTag.targetThermal}" IsChecked="True" Click="Target_Changed"/>
                                <RadioButton x:Name="TargetA4Radio" GroupName="BulkPriceTagTarget" Classes="sec-seg" HorizontalAlignment="Stretch"
                                             Content="{DynamicResource priceTag.targetA4}" Click="Target_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource priceTagBulk.copiesEachLabel}"/>
                        <NumericUpDown x:Name="CopiesBox" Value="1" Minimum="1" Maximum="20" Increment="1" FormatString="0"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource common.printer}"/>
                        <ComboBox x:Name="PrinterCombo" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" FontSize="12.5"
                               Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </dialogs:ModalShell>
</Window>
