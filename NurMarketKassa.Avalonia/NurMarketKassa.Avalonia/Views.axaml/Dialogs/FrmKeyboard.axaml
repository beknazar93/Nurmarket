<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.FrmKeyboard"
        Title="{DynamicResource keyboard.title}"
        Width="920" Height="360"
        WindowStartupLocation="Manual"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <!-- Общий стиль для стандартных клавиш -->
        <Style Selector="Button.Key">
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.Key:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="Button.Key:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>

        <!-- Стиль для функциональных клавиш (Backspace, Shift, Enter, Caps) -->
        <Style Selector="Button.FuncKey">
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.FuncKey:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>

        <!-- Акцентная кнопка (Enter / Применить) -->
        <Style Selector="Button.AccentKey">
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Styles>

    <Border Margin="12" CornerRadius="{DynamicResource SettingsCardRadius}"
            Background="{DynamicResource BrushPanelSoft}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
            BoxShadow="0 16 36 0 #33101828"
            Padding="12">

        <Grid RowDefinitions="Auto,*">

            <!-- Шапка: панель и закрытие -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource csh.toolbar.keyboard}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock x:Name="LayoutLabel" Text="[RU]" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="32" Height="32"
                        Background="Transparent" Foreground="{DynamicResource BrushTextSoft}"
                        FontSize="16" FontWeight="Bold" CornerRadius="6"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Cursor="Hand" Focusable="False" Click="Close_Click"/>
            </Grid>

            <!-- Основные ряды клавиш -->
            <StackPanel Grid.Row="1" Spacing="4">

                <!-- Цифровой ряд -->
                <UniformGrid Columns="13">
                    <Button Content="1" Classes="Key" Click="Key_Click"/>
                    <Button Content="2" Classes="Key" Click="Key_Click"/>
                    <Button Content="3" Classes="Key" Click="Key_Click"/>
                    <Button Content="4" Classes="Key" Click="Key_Click"/>
                    <Button Content="5" Classes="Key" Click="Key_Click"/>
                    <Button Content="6" Classes="Key" Click="Key_Click"/>
                    <Button Content="7" Classes="Key" Click="Key_Click"/>
                    <Button Content="8" Classes="Key" Click="Key_Click"/>
                    <Button Content="9" Classes="Key" Click="Key_Click"/>
                    <Button Content="0" Classes="Key" Click="Key_Click"/>
                    <Button Content="-" Classes="Key" Click="Key_Click"/>
                    <Button Content="." Classes="Key" Click="Key_Click"/>
                    <Button Content="⌫" Classes="FuncKey" Click="Backspace_Click"/>
                </UniformGrid>

                <!-- Ряд 1 (ЙЦУКЕН / QWERTY) -->
                <Grid x:Name="Row1Grid" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,1.2*">
                    <Button Grid.Column="0" Content="Й" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="1" Content="Ц" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="2" Content="У" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="3" Content="К" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="4" Content="Е" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="5" Content="Н" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="6" Content="Г" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="7" Content="Ш" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="8" Content="Щ" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="9" Content="З" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="10" Content="Х" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="11" Content="Ъ" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="12" Content="{DynamicResource keyboard.clear}" Classes="FuncKey" Click="Clear_Click"/>
                </Grid>

                <!-- Ряд 2 (ФЫВАПРОЛДЖЭ) -->
                <Grid x:Name="Row2Grid" ColumnDefinitions="1.2*,*,*,*,*,*,*,*,*,*,*,*,1.2*">
                    <Button Grid.Column="0" Content="Caps" Classes="FuncKey" Click="Caps_Click"/>
                    <Button Grid.Column="1" Content="Ф" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="2" Content="Ы" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="3" Content="В" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="4" Content="А" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="5" Content="П" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="6" Content="Р" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="7" Content="О" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="8" Content="Л" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="9" Content="Д" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="10" Content="Ж" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="11" Content="Э" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="12" Content="{DynamicResource keyboard.enter}" Classes="AccentKey" Click="Enter_Click"/>
                </Grid>

                <!-- Ряд 3 (ЯЧСМИТЬБЮ) -->
                <Grid x:Name="Row3Grid" ColumnDefinitions="1.5*,*,*,*,*,*,*,*,*,*,*,*,1.5*">
                    <Button Grid.Column="0" x:Name="LangButton" Content="RU / EN" Classes="FuncKey" Click="ToggleLang_Click"/>
                    <Button Grid.Column="1" Content="Я" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="2" Content="Ч" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="3" Content="С" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="4" Content="М" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="5" Content="И" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="6" Content="Т" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="7" Content="Ь" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="8" Content="Б" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="9" Content="Ю" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="10" Content="," Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="11" Content="?" Classes="Key" Click="Key_Click"/>
                    <Button Grid.Column="12" Content="{DynamicResource keyboard.space}" Classes="FuncKey" Click="Space_Click"/>
                </Grid>

            </StackPanel>

        </Grid>
    </Border>
</Window>