<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.WriteOffDialog"
        x:CompileBindings="False"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <Style Selector="Button.pick">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 (было 600) — заголовок,
         пояснение и ✕ сверху, «Отмена» (обводка, Esc) и «Списать» (акцент темы) снизу справа; причины —
         сегментами 44 px (modal-seg), товары чека — чипами (modal-chip). Заголовок и тексты — в коде. -->
    <dlg:ModalShell x:Name="Shell" Margin="16">
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CancelButton" IsCancel="True"
                        Classes="modal-cancel" MaxWidth="200"
                        Click="Cancel_Click"/>
                <!-- 2026-10-22 (модалки, пакет 3): списание уменьшает остаток — опасное действие красной кнопкой. -->
                <Button x:Name="WriteOffButton"
                        Classes="modal-primary danger" MaxWidth="200"
                        Click="WriteOff_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <StackPanel Spacing="10">
            <!-- Товары текущего чека: чаще всего испорченный товар кассир уже отсканировал. -->
            <StackPanel x:Name="CartPanel" Spacing="6">
                <TextBlock x:Name="CartLabel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
                <WrapPanel x:Name="CartItemsPanel"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Height="44" Padding="12,9" FontSize="14" CornerRadius="10"
                     VerticalContentAlignment="Center"
                     Text="{Binding WriteOffSearchText, Mode=TwoWay}"
                     KeyDown="SearchBox_KeyDown"/>
            <ItemsControl x:Name="ResultsList" ItemsSource="{Binding WriteOffSearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="pick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,4" Click="Result_Click">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding StockInfo}" Margin="12,0,0,0" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Padding="12,10" CornerRadius="10" Background="{DynamicResource BrushPanelSoft}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SelectedLabel" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                    <TextBlock x:Name="SelectedName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="SelectedStock" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="QtyLabel" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="pick" Width="44" Height="44" Margin="0" Padding="0" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" Content="−" FontSize="18" Click="Minus_Click"/>
                    <TextBox x:Name="QtyBox" Width="90" Height="44" FontSize="15" CornerRadius="8"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="1"/>
                    <Button Classes="pick" Width="44" Height="44" Margin="0" Padding="0" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" Content="+" FontSize="18" Click="Plus_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ReasonLabel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
            <WrapPanel x:Name="ReasonsPanel"/>

            <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap" IsVisible="False"
                       Foreground="{DynamicResource BrushDanger}"/>
        </StackPanel>
    </dlg:ModalShell>
</Window>
