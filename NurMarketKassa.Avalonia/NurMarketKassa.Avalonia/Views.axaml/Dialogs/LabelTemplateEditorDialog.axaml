<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.LabelTemplateEditorDialog"
        x:DataType="dialogs:LabelTemplateEditorDialog"
        x:CompileBindings="False"
        Title="{DynamicResource labelEditor.title}"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        FontFamily="Segoe UI, Inter, Noto Sans"
        Background="{DynamicResource BrushInputAlt}">

    <!-- Редактор этикетки (2026-09-07, визуальный проход по замечанию "дизайн не удобен и не
         красивый"): было — три колонки без карточек прямо на сером фоне окна, инструменты и
         свойства визуально не отделены друг от друга, холст того же белого цвета, что и рамка
         вокруг него, поэтому границы этикетки терялись. Теперь — фон окна чуть темнее (как в
         остальной кассе), каждая колонка своя карточка (BrushPanel + рамка + скругление, тот же
         язык, что и в Настройках), холст на контрастной серой подложке с тенью — этикетка
         читается как отдельный лист. НИЧЕГО в логике/координатах не менялось: EditorCanvas,
         ToolsPanel, PropertiesPanel — те же элементы с теми же именами, код-behind их не видит
         по-другому. -->
    <!-- 2026-10-20, этап О9б (редизайн окна вокруг этикетки; сам макет и холст — прежние):
         • средняя колонка — «*», а не Auto: на экране 1024 правая колонка (предпросмотр, свойства) и «Сохранить» больше
           не уезжают за край окна;
         • калибровка принтера (зазор, сдвиги, печать без драйвера) — под кнопкой «Настройка принтера» внизу холста, а не
           над ним: холст на экране 768 виден целиком (раньше обрезался снизу);
         • «Отмена» и «Сохранить» — отдельной строкой внизу окна справа, слева — подсказка, как двигать блоки;
         • кнопки — обводкой (были серые заливки), одна жёлтая «Сохранить»; выбранный инструмент — тёмно-синий (был
           бледно-жёлтый); значок в заголовке — без жёлтой рамки. Имена элементов и обработчики — прежние. -->

    <Window.Styles>
        <Style Selector="Button.tool-item">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        </Style>
        <Style Selector="Button.tool-item /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        </Style>
        <Style Selector="Button.tool-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="Button.tool-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
        </Style>
        <Style Selector="Button.tool-item.selected /template/ ContentPresenter#PART_ContentPresenter, Button.tool-item.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.tool-item.selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
        </Style>
        <Style Selector="Border.editor-card">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <!-- «Настройка принтера»: обводкой, открытая — тёмно-синяя (как выбранный сегмент). -->
        <Style Selector="ToggleButton.setup-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.setup-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="ToggleButton.setup-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="ToggleButton.setup-toggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.setup-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="TextBlock.card-header">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
    </Window.Styles>

    <Grid Margin="18" RowDefinitions="Auto,*,Auto">

        <!-- Заголовок окна -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource BrushPanelSoft}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <TextBlock Text="&#x1F3F7;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="168,12,*,12,280">

            <!-- Левая панель: Инструменты -->
            <Border Grid.Column="0" Classes="editor-card" VerticalAlignment="Stretch">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="card-header" Text="{DynamicResource labelEditor.toolsHeader}" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ToolsPanel" Spacing="6"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Средняя колонка: размер + холст + нижняя панель -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

                <!-- Верхняя панель: размер этикетки + пресеты -->
                <Border Grid.Row="0" Classes="editor-card" Margin="0,0,0,12" Padding="14,12">
                    <WrapPanel>
                        <StackPanel Spacing="4" Margin="0,0,14,0" Width="118">
                            <TextBlock Classes="field-label" Text="{DynamicResource labelEditor.widthLabel}" TextWrapping="Wrap"/>
                            <NumericUpDown x:Name="LabelWidthBox" Minimum="15" Maximum="150" Increment="1" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,14,0" Width="118">
                            <TextBlock Classes="field-label" Text="{DynamicResource labelEditor.heightLabel}" TextWrapping="Wrap"/>
                            <NumericUpDown x:Name="LabelHeightBox" Minimum="10" Maximum="150" Increment="1" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Spacing="4" VerticalAlignment="Bottom">
                            <TextBlock Classes="field-label" Text="{DynamicResource labelEditor.presetLabel}"/>
                            <ComboBox x:Name="SizePresetCombo" Width="200"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Холст: контрастная серая подложка, чтобы белый лист этикетки был виден как
                     отдельный физический объект, а не сливался с рамкой вокруг него. -->
                <Grid Grid.Row="1">
                    <Border Background="{DynamicResource BrushInputAlt}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="24" MinHeight="140">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Border Background="White" BoxShadow="0 6 20 0 #26000000" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas x:Name="EditorCanvas" Background="White" ClipToBounds="False"/>
                            </Border>
                        </ScrollViewer>
                    </Border>
                    <!-- 2026-10-20, этап О9б: масштаб — в углу холста (был в нижней панели и переносился на 1024). -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Padding="4"
                            Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="{DynamicResource SettingsCardRadius}">
                        <!-- 2026-10-22 (модалки, пакет 3): кнопки масштаба 44×44 (были 34×32) — касание пальцем; подпись «Масштаб»
                             видна рядом (раньше смысл кнопок был только во всплывающей подсказке). Текст ставит код (Tr.T). -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="ZoomCaption" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="12.5"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                            <Button Content="−" Width="44" MinHeight="44" Height="44" Classes="sec-outline" Padding="0" Click="ZoomOut_Click"
                                    ToolTip.Tip="{DynamicResource labelEditor.zoomOut}" AutomationProperties.Name="{DynamicResource labelEditor.zoomOut}"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Width="46" TextAlignment="Center" FontSize="12.5"
                                       Foreground="{DynamicResource BrushText}"/>
                            <Button Content="+" Width="44" MinHeight="44" Height="44" Classes="sec-outline" Padding="0" Click="ZoomIn_Click"
                                    ToolTip.Tip="{DynamicResource labelEditor.zoomIn}" AutomationProperties.Name="{DynamicResource labelEditor.zoomIn}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Низ холста: тестовая печать, настройка принтера, масштаб -->
                <Border Grid.Row="2" Classes="editor-card" Margin="0,12,0,0" Padding="14,10">
                    <StackPanel Spacing="0">
                        <WrapPanel>
                            <Button x:Name="TestPrintButton" Content="{DynamicResource labelEditor.testPrint}" Classes="sec-outline" Margin="0,0,10,0" Click="TestPrintButton_Click"/>
                            <ToggleButton x:Name="PrinterSetupToggle" Classes="setup-toggle" Content="{DynamicResource labelEditor.printerSetup}"/>
                        </WrapPanel>
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <!-- Предупреждение о штрих-коде (не тот формат/не помещается/кириллица) -->
                        <TextBlock x:Name="BarcodeWarningText" FontSize="12" TextWrapping="Wrap" IsVisible="False" Margin="0,6,0,0"
                                   Foreground="{DynamicResource BrushWarning}"/>
                        <!-- 2026-10-01, «пропускает наклейки и печатает не на том месте»: калибровка принтера
                             (на этом компьютере, для этикеток и ценников). Тексты — в коде (5 языков).
                             2026-10-20, этап О9б: открывается кнопкой «Настройка принтера» (значения те же, сохраняются как раньше). -->
                        <ScrollViewer MaxHeight="220" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding #PrinterSetupToggle.IsChecked}">
                        <StackPanel Spacing="6">
                            <WrapPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,8">
                                    <TextBlock x:Name="LabelGapText" Classes="field-label"/>
                                    <NumericUpDown x:Name="LabelGapBox" Minimum="0" Maximum="20" Increment="0.5" FormatString="0.#" Width="130" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,8">
                                    <TextBlock x:Name="LabelOffsetXText" Classes="field-label"/>
                                    <NumericUpDown x:Name="LabelOffsetXBox" Minimum="-20" Maximum="20" Increment="0.5" FormatString="0.#" Width="130" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,8">
                                    <TextBlock x:Name="LabelOffsetYText" Classes="field-label"/>
                                    <NumericUpDown x:Name="LabelOffsetYBox" Minimum="-20" Maximum="20" Increment="0.5" FormatString="0.#" Width="130" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,8">
                                    <TextBlock x:Name="LabelRawLangText" Classes="field-label"/>
                                    <ComboBox x:Name="LabelRawLangCombo" Width="240"/>
                                </StackPanel>
                                <CheckBox x:Name="LabelPageFromTemplateCheck" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                          Foreground="{DynamicResource BrushText}"/>
                            </WrapPanel>
                            <TextBlock x:Name="LabelCalibHint" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Правая панель: предпросмотр + свойства выбранного элемента -->
            <Border Grid.Column="4" Classes="editor-card">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-header" Text="{DynamicResource labelEditor.previewLabel}"/>
                        <Border Background="{DynamicResource BrushInputAlt}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="8" Height="180">
                            <Border Background="White" BoxShadow="0 4 12 0 #22000000">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            </Border>
                        </Border>
                        <Button Content="{DynamicResource labelEditor.resetDefault}" Classes="sec-outline" HorizontalAlignment="Stretch"
                                Click="ResetButton_Click"/>

                        <Separator Background="{DynamicResource BrushBorder}" Height="1" Margin="0,2"/>

                        <TextBlock x:Name="PropertiesHeader" Classes="card-header" FontSize="14"/>
                        <StackPanel x:Name="PropertiesPanel" Spacing="8"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Низ окна: как работать с холстом — слева, «Отмена» и «Сохранить» — справа -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"
                       Text="{DynamicResource labelEditor.instructions}" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" Content="{DynamicResource common.cancel}" Classes="sec-outline" MinWidth="110" MinHeight="44" Click="CancelButton_Click"/>
                <Button Content="{DynamicResource common.save}" Classes="sec-primary" MinWidth="140" MinHeight="44" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
