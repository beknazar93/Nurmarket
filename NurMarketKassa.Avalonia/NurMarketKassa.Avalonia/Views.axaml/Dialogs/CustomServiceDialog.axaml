<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CustomServiceDialog"
        Title="{DynamicResource customService.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- «Дополнительная услуга» (2026-09-07) — как на сайте NurCRM («Интерфейс кассира» → Корзина →
         «Доп. услуга»: Название / Сумма / Количество), плюс тип «Доход / Расход» по просьбе
         владельца: доход (по умолчанию: доставка, услуга, продажа) прибавляется к чеку,
         расход вычитается из него. Строка попадает в локальный чек без товара, при оплате
         уходит на сервер через POST /pos/carts/{id}/custom-item/ (StagingCartService). -->

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- «Расход» выбран — красным, как и было: кассир сразу видит, что строка уменьшит чек. -->
        <Style Selector="RadioButton.modal-seg.expense:checked">
            <!-- 2026-10-27: белый на BrushDanger (#F14C4C) в тёмной теме — 3,6:1; BrushDangerFill — 4,8:1 (светлая тема без изменений). -->
            <Setter Property="Background" Value="{DynamicResource BrushDangerFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDangerFill}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок и ✕ сверху,
         «Отмена» (обводка, Esc) и «Добавить» (акцент темы, Enter) снизу справа; «Доход / Расход» —
         сегментами 44 px (modal-seg). -->
    <dlg:ModalShell Margin="16"
                    Title="{DynamicResource customService.title}"
                    Hint="{DynamicResource modal.hintEnter}">
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="modal-cancel" MaxWidth="200"
                        Content="{DynamicResource common.cancel}"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="AddButton" Classes="modal-primary" MaxWidth="200"
                        Content="{DynamicResource customService.addButton}"
                        IsDefault="True"
                        Click="Add_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <StackPanel Spacing="14">
            <StackPanel>
                <TextBlock Classes="FieldLabel" Text="{DynamicResource customService.typeLabel}"/>
                <Grid ColumnDefinitions="*,8,*">
                    <RadioButton x:Name="IncomeRadio" Grid.Column="0" Classes="modal-seg" GroupName="ServiceType"
                                 IsChecked="True" Content="{DynamicResource customService.typeIncome}"/>
                    <RadioButton x:Name="ExpenseRadio" Grid.Column="2" Classes="modal-seg expense" GroupName="ServiceType"
                                 Content="{DynamicResource customService.typeExpense}"/>
                </Grid>
                <TextBlock Text="{DynamicResource customService.typeHint}" FontSize="12"
                           Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <!-- 2026-10-21 (пакет 6, п. 43): «Расход» при пустом чеке — это изъятие наличных из кассы; говорим об этом
                     прямо в окне (текст — в коде, CustomServiceDialog.UpdateExpenseNote). -->
                <Border x:Name="ExpenseNoteBorder" IsVisible="False" Margin="0,8,0,0" Padding="10,8" CornerRadius="8"
                        Background="{DynamicResource BrushWarningSoft}">
                    <TextBlock x:Name="ExpenseNoteText" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushText}"/>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="FieldLabel" Text="{DynamicResource customService.nameLabel}"/>
                <TextBox x:Name="NameBox" Watermark="{DynamicResource customService.nameWatermark}"/>
                <!-- 2026-10-03: похожие товары из каталога — чтобы не продавать товар «Доп. услугой» без остатка и себестоимости. -->
                <StackPanel x:Name="SuggestPanel" Spacing="4" Margin="0,6,0,0" IsVisible="False"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,12,120">
                <StackPanel Grid.Column="0">
                    <TextBlock Classes="FieldLabel" Text="{DynamicResource customService.priceLabel}"/>
                    <TextBox x:Name="PriceBox" Watermark="{DynamicResource customService.priceWatermark}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Classes="FieldLabel" Text="{DynamicResource customService.qtyLabel}"/>
                    <TextBox x:Name="QuantityBox" Text="1"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource BrushDanger}"
                       FontSize="13" IsVisible="False" TextWrapping="Wrap"/>
        </StackPanel>
    </dlg:ModalShell>
</Window>
