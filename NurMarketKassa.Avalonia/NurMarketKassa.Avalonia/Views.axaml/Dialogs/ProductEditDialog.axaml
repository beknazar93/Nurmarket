<!-- 2026-10-18, редизайн (этап 5): общая оболочка ModalShell, карточка 640 (окно 672; было 660×860 со своей
     шапкой). Панели поиска фото в этом окне нет — поэтому 640, а не 880. Высоту карточки задаёт код
     (820, но не больше 85 % рабочей области — ModalShell), окно — по содержимому. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ProductEditDialog"
        Title="{Binding HeaderText}"
        Width="672" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI, Inter, Noto Sans"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}"
        x:CompileBindings="False"
        KeyDown="Window_KeyDown">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <!-- 2026-10-18, этап 5: рамка поля в фокусе — общая из PosDialogStyles (BrushFocusRing 2 px); своя жёлтая
             (BrushAccent) у темы «NurMarket» на белом поле не видна (1,4:1). -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocusRing}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <!-- 2026-10-22 (модалки, пакет 3): 44 px — касание пальцем. -->
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <!-- 2026-10-18, этап 5: без нижнего отступа (между подписью и полем и так Spacing панели) — на 768 по высоте
                 цены «Основного» помещаются без прокрутки и в карточке 85 % экрана. -->
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style Selector="Button.PrimaryButton:disabled">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <!-- 2026-10-18, этап 5: второстепенные кнопки — обводкой, как modal-secondary в остальных модалках. -->
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <!-- 2026-10-22 (модалки, пакет 3): 44 px — касание пальцем. -->
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 2026-10-18, этап 5 (снимки): выбранный пункт списков «Горячая клавиша» / «Категория» / «Бренд» — у кнопки оба
             класса (SecondaryButton + PrimaryButton), и SecondaryButton, объявленный ниже PrimaryButton, перекрывал выделение. -->
        <!-- 2026-10-20 (правило 2 docs/owner-redesign-plan.md): выбранное — тёмно-синей заливкой с белым текстом, как modal-seg
             (было жёлтое BrushAccent — вторая «главная» кнопка на экране). Тот же вид у выбранного поставщика. -->
        <Style Selector="Button.SecondaryButton.PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.WindowControlButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <!-- 2026-10-22 (модалки, пакет 3): 44 px — касание пальцем. -->
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowControlButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.KindButton">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style Selector="Button.KindButton.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        </Style>

        <!-- 2026-09-15, по замечанию пользователя ("проблема с дизайном отступом") — без этого
             стиля сворачиваемые секции-карточки (см. ниже) рендерились плоским серым
             прямоугольником без скруглений и без внутренних отступов, выбиваясь из остального
             дизайна диалога (все прочие блоки — скруглённые карточки с рамкой и padding). -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- 2026-09-15, по замечанию пользователя ("он по размеру маленький") — без явного
             Stretch поля внутри карточки (TextBox "Доп. штрихкоды" и т.п.) измерялись под свой
             естественный минимальный размер вместо растягивания на всю ширину карточки, оставляя
             широкий пустой промежуток справа. -->
        <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- 2026-10-02: вкладки карточки товара — подпись и полоса выбранной вкладки в цветах темы. -->
        <!-- 2026-10-18, этап 5 (макет MStock): вкладки — сегменты 44 px, выбранная залита цветом текста темы (у «NurMarket»
             светлой — тёмно-синий, надпись цветом карточки), полосы под выбранной нет. Сама TabControl и её логика прежние. -->
        <!-- Шрифт и поля плотнее прежних: шесть вкладок у существующего товара и на кыргызском (самые длинные надписи)
             встают в одну строку карточки 640 — вторая строка вкладок отнимала бы место у цен. -->
        <Style Selector="TabControl#ProductTabs TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,2,4"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <!-- Полосу под выбранной прячем прозрачностью: её IsVisible и цвет задаёт шаблон темы, стиль окна их не перебивает. -->
        <Style Selector="TabControl#ProductTabs TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="TabControl#ProductTabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="TabControl#ProductTabs TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TabControl#ProductTabs TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TabControl#ProductTabs TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
        </Style>
        <!-- 2026-10-18, этап 5: вид товара (Товар / Услуга / Комплект) — сегменты 44 px с обводкой, как modal-seg; выбранный
             залит цветом текста темы. Кнопки и их обработчики прежние. -->
        <Style Selector="Button.KindButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.KindButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.KindButton.Selected">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.KindButton.Selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDialogPanel}"/>
        </Style>
        <!-- 2026-10-18, этап 5: кнопка экранной клавиатуры Windows (osk.exe) — слева на строке кнопок, 44 px. -->
        <Style Selector="Button.KeyboardButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 2026-10-18, ревью этапа 5: низкое окно (< 600: моноблок 1366×768 при 125 %) — шапка и низ оболочки,
             подписи полей и сегменты плотнее, чтобы цены «Основного» были видны без прокрутки (класс ставит SizeChanged). -->
        <Style Selector=".compact dlg|ModalShell /template/ DockPanel > Border">
            <Setter Property="Padding" Value="24,8,16,8"/>
        </Style>
        <Style Selector=".compact TextBlock.FieldLabel">
            <Setter Property="Margin" Value="0,0,0,-4"/>
        </Style>
        <Style Selector=".compact Button.KindButton">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector=".compact TabControl#ProductTabs TabItem">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-18, этап 5: шапка (заголовок, ✕ = Esc = «Отмена»), низ (клавиатура Windows и статус слева, «Отмена» +
         главная справа) — у ModalShell и не прокручиваются; вкладки прокручиваются сами (ContentScroll="Disabled"). -->
    <dlg:ModalShell x:Name="Shell" Margin="16" Title="{Binding HeaderText}" ContentScroll="Disabled" Padding="24,12,24,10">
        <dlg:ModalShell.Hint>
            <Grid ColumnDefinitions="Auto,*" MinWidth="44">
                <!-- 2026-09-17, по просьбе пользователя: у кассы не всегда есть физическая
                     клавиатура — кнопка вызывает системную экранную клавиатуру Windows (osk.exe),
                     как и в шапке кассы (см. MainWindow.ToggleKeyboard), а не самодельную. -->
                <!-- 2026-09-30: Focusable=False — нажатие не уводит фокус из поля, куда печатает экранная клавиатура. -->
                <!-- 2026-10-18, этап 5: из старой шапки — на строку кнопок слева (в шапке оболочки только ✕). -->
                <Button Grid.Column="0" Classes="KeyboardButton" Click="ToggleKeyboard_Click" Focusable="False"
                        ToolTip.Tip="{DynamicResource mainWindow.onScreenKeyboardTooltip}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE92F;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol, sans-serif" FontSize="16"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}"/>
            </Grid>
        </dlg:ModalShell.Hint>
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- 2026-10-18, этап 5: IsCancel перешёл сюда со старой ✕ шапки — Esc и ✕ оболочки нажимают «Отмену» (Close(Saved)). -->
                <Button IsCancel="True" Classes="modal-cancel" MaxWidth="200"
                        Content="{DynamicResource common.cancel}" Click="CloseButton_Click"/>
                <Button x:Name="SaveButton" Classes="modal-primary" MaxWidth="220"
                        Content="{Binding SaveButtonText}" Click="SaveButton_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 2026-10-02, владелец: «сделай редизайн как таб-меню внутри модалки». Вид товара — сегментный
                 переключатель под заголовком, поля — по вкладкам вместо одной длинной прокрутки. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,8,*,8,*" Margin="0,0,0,10"
                  IsVisible="{Binding !IsQuickAddMode}">
                <Button Grid.Column="0" Classes="KindButton" Classes.Selected="{Binding IsProductKind}"
                        Content="{DynamicResource product.kindProduct}" Click="KindProduct_Click"/>
                <Button Grid.Column="2" Classes="KindButton" Classes.Selected="{Binding IsServiceKind}"
                        Content="{DynamicResource product.kindService}" Click="KindService_Click"/>
                <Button Grid.Column="4" Classes="KindButton" Classes.Selected="{Binding IsBundleKind}"
                        Content="{DynamicResource product.kindBundle}" Click="KindBundle_Click"/>
            </Grid>

            <!-- 2026-10-06, владелец «баг съедает низ»: последнее поле вкладки («Страна производства») уходило под край прокрутки — у содержимого вкладок запас 80 px снизу (вкладки переносятся на вторую строку, и низ области прокрутки уходит под край). -->
            <TabControl x:Name="ProductTabs" Grid.Row="1" Margin="0" Padding="0">
                <TabItem Header="{DynamicResource product.tabMain}">
                    <!-- 2026-10-06, моноблок клиента: поля цены уходили под край, прокрутку пальцем не найти — полоса видна всегда,
                         на невысоком экране поля плотнее (ProductEditDialog.CompactForShortScreen). -->
                    <ScrollViewer x:Name="MainTabScroll" Padding="0,10,16,6" AllowAutoHide="False">
                        <StackPanel x:Name="MainTabStack" Spacing="20" Margin="0,0,0,240">
                            <!-- 2026-10-03, владелец: «изучи веб — при скане, если товар есть в базе готовых наименований,
                                 сразу всё подставляется». Подсказка и результат поиска в базе NurCRM (только новый товар). -->
                            <!-- 2026-10-06: на очень низком окне (< 700) подсказка прячется, чтобы цены были видны (ScanHintHost). -->
                            <Panel IsVisible="{Binding ShowGlobalScanHint}">
                            <Border x:Name="ScanHintHost" CornerRadius="10" Padding="12,10"
                                    Background="{DynamicResource BrushAccentSoft}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource product.globalScanHint}" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource BrushText}"/>
                                    <TextBlock Text="{Binding GlobalStatus}" IsVisible="{Binding HasGlobalStatus}" TextWrapping="Wrap"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                                </StackPanel>
                            </Border>
                            </Panel>
                            <!-- 2026-10-18, этап 5: название и штрихкод — одной строкой (раньше — две строки во всю ширину): в карточке
                                 640 не выше 85 % экрана цены на 1024×768 видны без прокрутки. Порядок полей (и Tab) прежний;
                                 на узком Android строка встаёт столбиком (NarrowStack по NarrowRowMain). -->
                            <!-- 2026-10-26, приёмка (Д-3): штрихкод шире названия (было *,16,*) и у кнопки «Сгенерировать» поля уже: вместе с кнопкой поле было ~110 px, и 13 цифр обрезались. -->
                            <Grid x:Name="NarrowRowMain" ColumnDefinitions="*,16,1.5*">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.nameLabel}"/>
                                    <TextBox x:Name="NameBox" Text="{Binding ProductName}" Watermark="{DynamicResource product.nameWatermark}"/>
                                </StackPanel>
                                <!-- 2026-10-11, тестировщик (склад.md, 2.1.1): артикул — на вкладке «Доп. штрих-коды», штрихкод во всю ширину. -->
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource csh.catalog.colBarcode}"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox x:Name="BarcodeBox" Grid.Column="0" Text="{Binding Barcode}"
                                                 LostFocus="BarcodeBox_LostFocus"
                                                 Watermark="{DynamicResource product.barcodeScanWatermarkShort}"
                                                 ToolTip.Tip="{DynamicResource product.barcodeScanWatermark}"/>
                                        <Button Grid.Column="1" Classes="SecondaryButton" Margin="6,0,0,0" Padding="10,0"
                                                Content="{DynamicResource product.generateBarcode}"
                                                Command="{Binding GenerateBarcodeCommand}"
                                                IsVisible="{Binding !IsQuickAddMode}"/>
                                        <!-- 2026-10-04, Android: камера аппарата как сканер (CameraScan). -->
                                        <Button Grid.Column="2" Classes="SecondaryButton" Margin="6,0,0,0"
                                                IsVisible="{OnPlatform False, Android=True}"
                                                Click="CameraScanButton_Click" Focusable="False"
                                                ToolTip.Tip="{DynamicResource csh.cart.cameraScan}">
                                            <TextBlock Classes="mdl2" Text="&#xE722;" FontSize="18" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <!-- 2026-10-07, владелец: штрихкод по названию из barcode-list.ru — варианты для сверки (ProductEditDialog.BarcodeSuggest). -->
                            <StackPanel x:Name="BarcodeSuggestPanel" Spacing="6" IsVisible="False"/>

                            <!-- 2026-10-04, клиент: «включил весовой — поле PLU выталкивает цену вниз, полстроки не видно».
                                 PLU теперь в той же строке, что и тумблер «Весовой»: высота вкладки не меняется. -->
                            <Grid x:Name="NarrowRowStock" ColumnDefinitions="*,14,Auto,Auto,14,*">
                                <StackPanel Grid.Column="0" Spacing="6" IsVisible="{Binding !IsQuickAddMode}">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.unitLabel}"/>
                                    <TextBox Text="{Binding Unit}"/>
                                </StackPanel>
                                <!-- 2026-10-06 (О-13): в сфере «Одежда» «Весовой» скрыт (ShowWeightToggle). -->
                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Bottom" IsVisible="{Binding ShowWeightToggle}">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.isWeightLabel}"/>
                                    <ToggleSwitch IsChecked="{Binding IsWeight}" OnContent="" OffContent="" Margin="0,0,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" Width="150" Margin="14,0,0,0" VerticalAlignment="Bottom" IsVisible="{Binding IsWeight}">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.pluLabel}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Plu}" Watermark="{DynamicResource product.pluWatermark}"
                                             ToolTip.Tip="{DynamicResource product.pluWatermark}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource csh.catalog.colStock}"/>
                                    <TextBox Text="{Binding Quantity}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2026-10-18, этап 5: на невысоком окне (< 700) заголовок «Цены» прячется (PricesHeader, как ScanHintHost) —
                                 у полей и так подписи «Цена закупки / Наценка / Цена продажи», а цены видны без прокрутки. -->
                            <TextBlock x:Name="PricesHeader" Text="{DynamicResource product.pricesHeader}" FontWeight="Bold" FontSize="13" Margin="0,10,0,0"/>
                            <Grid x:Name="NarrowRowPrices" ColumnDefinitions="*,18,*,18,*">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.purchasePriceLabel}"/>
                                    <TextBox Text="{Binding PurchasePrice}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.markupLabel}"/>
                                    <TextBox Text="{Binding MarkupPercent}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.salePriceLabel}"/>
                                    <TextBox Text="{Binding Price}"/>
                                </StackPanel>
                            </Grid>
                            <!-- 2026-10-11, тестировщик (склад.md, 2.1.1): оптовая цена (и скидка) — на «Основном», рядом с ценами. -->
                            <StackPanel IsVisible="{Binding !IsQuickAddMode}">
                                <Grid ColumnDefinitions="*,18,*">
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.wholesalePriceLabel}"/>
                                        <TextBox Text="{Binding WholesalePrice}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.discountLabel}"/>
                                        <TextBox Text="{Binding DiscountPercent}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- 2026-10-11, тестировщик (склад.md, 2.1.3): минимальный остаток — ниже него товар в «Заканчивается».
                                 2026-10-20, аудит программы владельца: перенесён с «Упаковки» на «Основное» (там его было не найти). -->
                            <StackPanel Spacing="8" Width="220" HorizontalAlignment="Left" IsVisible="{Binding !IsQuickAddMode}">
                                <TextBlock Classes="FieldLabel" x:Name="MinimumQuantityLabel"/>
                                <TextBox Text="{Binding MinimumQuantity}"/>
                            </StackPanel>
                            <!-- 2026-10-05, владелец: закупка дороже продажи — красное предупреждение (ProductEditDialog.PriceWarning). -->
                            <Border IsVisible="{Binding HasPriceWarning}" CornerRadius="8" Padding="12,8" BorderThickness="1"
                                    Background="{DynamicResource BrushDangerSoft}" BorderBrush="{DynamicResource BrushDanger}">
                                <TextBlock Text="{Binding PriceWarning}" Foreground="{DynamicResource BrushDanger}" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <!-- 2026-10-11, тестировщик (склад.md, 2.1.1): горячая клавиша — на «Основном».
                                 2026-10-18, ревью этапа 5: под ценами (раньше — над ними) — на моноблоке 1366×768 при 125 %
                                 цены (главное в окне) видны без прокрутки; горячая клавиша нужна не каждому товару. -->
                            <StackPanel IsVisible="{Binding !IsQuickAddMode}">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.hotkeyLabel}"/>
                                    <!-- Обычный ComboBox не открывался в этом окне — у него
                                         ExtendClientAreaToDecorationsHint="True" (своя рамка без системного
                                         хрома), а всплывающее меню ComboBox в таких окнах у Avalonia иногда
                                         не рендерится/не ловит клики. Разворачиваемая панель без Popup —
                                         тот же приём, что уже применялся в PayDebtDialog для похожей проблемы. -->
                                    <Button x:Name="HotkeyToggleButton" Classes="SecondaryButton"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Click="HotkeyToggleButton_Click">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="HotkeyCurrentText" Grid.Column="0"/>
                                            <TextBlock Grid.Column="1" Text="▾" Foreground="{DynamicResource BrushTextSoft}"/>
                                        </Grid>
                                    </Button>
                                    <Border x:Name="HotkeyOptionsPanel" IsVisible="False"
                                            Background="{DynamicResource BrushPanel}"
                                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="8"
                                            BoxShadow="0 6 16 0 #26000000">
                                        <ItemsControl x:Name="HotkeyOptionsList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AltBarcodesTab" Header="{DynamicResource product.tabCategory}" IsVisible="{Binding !IsQuickAddMode}">
                    <ScrollViewer Padding="0,14,16,6">
                        <StackPanel Spacing="20" Margin="0,0,0,240">
                            <StackPanel Spacing="22" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8" IsVisible="{Binding !IsQuickAddMode}">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.codeLabel}"/>
                                    <TextBox Text="{Binding Code}" Watermark="{DynamicResource product.articleWatermark}"/>
                                </StackPanel>

                                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                    <TextBlock Classes="FieldLabel" Text="{DynamicResource product.altBarcodesLabel}"/>
                                    <TextBlock Text="{DynamicResource product.altBarcodesWatermark}" FontSize="11"
                                               TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>

                                    <Grid ColumnDefinitions="*,12,*,12,Auto" Margin="0,6,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding VariantBarcode}"
                                                 Watermark="{DynamicResource product.variantBarcodeWatermark}"/>
                                        <TextBox Grid.Column="2" Text="{Binding VariantNameSuffix}"
                                                 Watermark="{DynamicResource product.variantNameWatermark}"/>
                                        <StackPanel Grid.Column="4" Spacing="4" Width="90">
                                            <TextBlock Classes="FieldLabel" FontSize="11" Text="{DynamicResource product.variantQuantityLabel}"/>
                                            <TextBox Text="{Binding VariantQuantity}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" IsVisible="{Binding HasVariantPreview}"
                                               Text="{Binding VariantPreviewText}" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSoft}"/>

                                    <Button Classes="SecondaryButton" HorizontalAlignment="Left" Margin="0,4,0,0"
                                            Content="{DynamicResource product.variantAddButton}"
                                            Click="AddVariant_Click"/>

                                    <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding HasVariants}">
                                        <TextBlock Text="{DynamicResource product.variantsListHeader}" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSoft}"/>
                                        <ItemsControl ItemsSource="{Binding Variants}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="8"
                                                            Padding="10,8" Margin="0,0,0,6">
                                                        <!-- 2026-10-11, тестировщик (склад.md, 2.1.2): доп. штрихкод можно поправить после добавления —
                                                             ✎ открывает поля, ✓ сохраняет. -->
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                            <StackPanel Grid.Column="0" IsVisible="{Binding !IsEditing}">
                                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Barcode}" FontSize="11"
                                                                           Foreground="{DynamicResource BrushTextSoft}"/>
                                                            </StackPanel>
                                                            <Grid Grid.Column="0" ColumnDefinitions="*,8,*,8,80" IsVisible="{Binding IsEditing}">
                                                                <TextBox Grid.Column="0" Text="{Binding EditBarcode}" Watermark="{DynamicResource product.variantBarcodeWatermark}"/>
                                                                <TextBox Grid.Column="2" Text="{Binding EditName}" Watermark="{DynamicResource product.variantNameWatermark}"/>
                                                                <TextBox Grid.Column="4" Text="{Binding EditQuantity}"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Margin="10,0" IsVisible="{Binding !IsEditing}"
                                                                       Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="2" Classes="WindowControlButton" Content="{Binding EditGlyph}" Margin="6,0,0,0"
                                                                    Tag="{Binding}" Click="EditVariant_Click"/>
                                                            <Button Grid.Column="3" Classes="WindowControlButton" Content="✕"
                                                                    Tag="{Binding}" Click="RemoveVariant_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource product.tabPackage}" IsVisible="{Binding !IsQuickAddMode}">
                    <ScrollViewer Padding="0,14,16,6">
                        <StackPanel Spacing="20" Margin="0,0,0,240">
                            <StackPanel Spacing="14" IsVisible="{Binding !IsQuickAddMode}">
                                <CheckBox Content="{DynamicResource product.enablePieceSale}" IsChecked="{Binding EnablePieceSale}"/>
                                <Grid x:Name="NarrowRowPackage" ColumnDefinitions="*,18,*" IsVisible="{Binding EnablePieceSale}">
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.packageQtyLabel}"/>
                                        <TextBox Text="{Binding PackageQuantity}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.packagePriceLabel}"/>
                                        <TextBox Text="{Binding PackagePiecePrice}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding IsBundleKind}">
                                <TextBlock Text="{DynamicResource product.bundleItemsHeader}" FontWeight="Bold" FontSize="13"/>
                                <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="8" Padding="14"
                                        IsVisible="{Binding !HasBundleItems}">
                                    <Button Classes="SecondaryButton" HorizontalAlignment="Center"
                                            Content="{DynamicResource product.selectBundleItems}"
                                            Click="SelectBundleItems_Click"/>
                                </Border>
                                <StackPanel Spacing="8" IsVisible="{Binding HasBundleItems}">
                                    <ItemsControl ItemsSource="{Binding BundleItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="8"
                                                        Padding="10,8" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" Margin="10,0"
                                                                   Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Classes="WindowControlButton" Content="✕"
                                                                Tag="{Binding ProductId}" Click="RemoveBundleItem_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="SecondaryButton" HorizontalAlignment="Left"
                                            Content="{DynamicResource product.selectBundleItems}"
                                            Click="SelectBundleItems_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource product.tabVariants}" IsVisible="{Binding !IsQuickAddMode}">
                    <ScrollViewer Padding="0,14,16,6">
                        <StackPanel Spacing="20" Margin="0,0,0,240">
                            <!-- 2026-10-01, магазин одежды: размеры и цвета товара (варианты NurCRM — своя цена,
                                 остаток, штрихкод). На сайте NurCRM редактора вариантов нет — он здесь. -->
                            <Border Padding="14,12" CornerRadius="10" Background="{DynamicResource BrushPanelSoft}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="VariantsTitle" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                                        <TextBlock x:Name="VariantsHint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="VariantsButton" Classes="SecondaryButton" Margin="12,0,0,0"
                                            VerticalAlignment="Center" Click="VariantsButton_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource product.tabMore}" IsVisible="{Binding !IsQuickAddMode}">
                    <ScrollViewer Padding="0,14,16,6">
                        <StackPanel Spacing="20" Margin="0,0,0,240">
                            <StackPanel Spacing="22" HorizontalAlignment="Stretch">

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.descriptionLabel}"/>
                                        <TextBox Text="{Binding Description}" Watermark="{DynamicResource product.descriptionWatermark}" AcceptsReturn="True" Height="150" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/><!-- 2026-10-18, этап 5: многострочное описание — текст сверху, а не по центру поля. -->
                                    </StackPanel>
                                <!-- 2026-10-11 (склад.md, 2.1.5): категория и бренд перенесены сюда с вкладки кодов. -->
                                <!-- Категория и бренд (2026-09-07): раскрывающиеся списки из справочников NurCRM
                                     (GET api/main/categories и api/main/brands) + строка "создать новую" — как
                                     на сайте (там select + "Создать категорию/бренд"), вместо свободного текста,
                                     который плодил дубли ("Напитки"/"напитки"). Без ComboBox/Popup — по той же
                                     причине, что и "Горячая клавиша" ниже (в окне без системного хрома всплывающее
                                     меню не открывается), тот же приём: кнопка + разворачиваемая панель. -->
                                <Grid x:Name="NarrowRowCategory" ColumnDefinitions="*,18,*">
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.categoryLabel}"/>
                                        <Button x:Name="CategoryToggleButton" Classes="SecondaryButton" MinHeight="44"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Click="CategoryToggleButton_Click">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="CategoryCurrentText" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="{DynamicResource BrushTextSoft}"/>
                                            </Grid>
                                        </Button>
                                        <Border x:Name="CategoryOptionsPanel" IsVisible="False"
                                                Background="{DynamicResource BrushPanel}"
                                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                                CornerRadius="8" Padding="8"
                                                BoxShadow="0 6 16 0 #26000000">
                                            <StackPanel Spacing="8">
                                                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="CategoryOptionsList">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <Grid ColumnDefinitions="*,8,Auto">
                                                    <TextBox x:Name="NewCategoryBox" Grid.Column="0" MinHeight="44" Padding="10,6"
                                                             Watermark="{DynamicResource product.newCategoryWatermark}"/>
                                                    <Button Grid.Column="2" Classes="PrimaryButton" Padding="12,6" VerticalAlignment="Center"
                                                            Content="{DynamicResource product.createReferenceButton}"
                                                            Click="CreateCategory_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.brandLabel}"/>
                                        <Button x:Name="BrandToggleButton" Classes="SecondaryButton" MinHeight="44"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Click="BrandToggleButton_Click">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="BrandCurrentText" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="{DynamicResource BrushTextSoft}"/>
                                            </Grid>
                                        </Button>
                                        <Border x:Name="BrandOptionsPanel" IsVisible="False"
                                                Background="{DynamicResource BrushPanel}"
                                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                                CornerRadius="8" Padding="8"
                                                BoxShadow="0 6 16 0 #26000000">
                                            <StackPanel Spacing="8">
                                                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="BrandOptionsList">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <Grid ColumnDefinitions="*,8,Auto">
                                                    <TextBox x:Name="NewBrandBox" Grid.Column="0" MinHeight="44" Padding="10,6"
                                                             Watermark="{DynamicResource product.newBrandWatermark}"/>
                                                    <Button Grid.Column="2" Classes="PrimaryButton" Padding="12,6" VerticalAlignment="Center"
                                                            Content="{DynamicResource product.createReferenceButton}"
                                                            Click="CreateBrand_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 2026-10-20, владелец: «в описание добавить поставщика — выбор и добавление нового». Поле «client» товара
                                     NurCRM (как «Поставщик *» в форме товара сайта): список поставщиков компании с поиском по названию и
                                     телефону, «+ Новый поставщик» — окно ModalShell (имя, телефон), новый сразу выбран. Тот же приём,
                                     что у категории/бренда: кнопка + разворачиваемая панель. Подписи — из кода (Tr.T, 5 языков). -->
                                <StackPanel x:Name="SupplierBlock" Spacing="8">
                                    <TextBlock x:Name="SupplierLabel" Classes="FieldLabel"/>
                                    <Button x:Name="SupplierToggleButton" Classes="SecondaryButton" MinHeight="44"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Click="SupplierToggleButton_Click">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock x:Name="SupplierCurrentText" Grid.Column="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SupplierCurrentPhone" Grid.Column="1" Margin="10,0,10,0" FontWeight="Normal" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextSoft}"/>
                                            <TextBlock Grid.Column="2" Text="▾" Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock x:Name="SupplierHint" IsVisible="False" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextSoft}"/>
                                    <Border x:Name="SupplierOptionsPanel" IsVisible="False"
                                            Background="{DynamicResource BrushPanel}"
                                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="8"
                                            BoxShadow="0 6 16 0 #26000000">
                                        <StackPanel Spacing="8">
                                            <TextBox x:Name="SupplierSearchBox" MinHeight="44" Padding="10,6"/>
                                            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="SupplierOptionsList" Spacing="4"/>
                                            </ScrollViewer>
                                            <Button x:Name="NewSupplierButton" Classes="SecondaryButton" HorizontalAlignment="Left"
                                                    Padding="12,6" Click="NewSupplier_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="22">
                                    <TextBlock Text="{DynamicResource product.characteristicsHeader}" FontWeight="Bold" FontSize="13"/>
                                    <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource product.heightLabel}"/>
                                            <TextBox Text="{Binding HeightCm}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="8">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource product.widthLabel}"/>
                                            <TextBox Text="{Binding WidthCm}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Spacing="8">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource product.depthLabel}"/>
                                            <TextBox Text="{Binding DepthCm}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6" Spacing="8">
                                            <TextBlock Classes="FieldLabel" Text="{DynamicResource product.weightKgLabel}"/>
                                            <TextBox Text="{Binding WeightKg}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="FieldLabel" Text="{DynamicResource product.countryLabel}"/>
                                        <TextBox Text="{Binding Country}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource product.tabHistory}" x:Name="HistoryTab" IsVisible="{Binding #PurchaseHistoryExpander.IsVisible}">
                    <ScrollViewer Padding="0,14,16,6">
                        <StackPanel Spacing="20" Margin="0,0,0,240">
                            <!-- 2026-09-24: история закупок — когда, сколько и почём привозили товар.
                                 Приёмки этой кассы плюс приходы от поставщиков с сайта. Загружается при
                                 первом раскрытии: это запрос к серверу, а карточку открывают часто. -->
                            <Expander x:Name="PurchaseHistoryExpander"
                                      Header="{DynamicResource product.sectionPurchaseHistory}" IsExpanded="False"
                                      FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushText}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsVisible="False">
                                <StackPanel Spacing="6" Margin="0,12,0,0">
                                    <TextBlock x:Name="PurchaseHistoryStatus" FontWeight="Normal" FontSize="12.5"
                                               TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
                                    <ItemsControl x:Name="PurchaseHistoryList" x:CompileBindings="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8" Margin="0,2" CornerRadius="8"
                                                        Background="{DynamicResource BrushPanelSoft}">
                                                    <Grid ColumnDefinitions="120,*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{ReflectionBinding WhenText}"
                                                                   FontWeight="Normal" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource BrushTextSoft}"/>
                                                        <StackPanel Grid.Column="1" Spacing="2" Margin="8,0">
                                                            <TextBlock Text="{ReflectionBinding MainText}" FontWeight="SemiBold"
                                                                       FontSize="13" Foreground="{DynamicResource BrushText}"/>
                                                            <TextBlock Text="{ReflectionBinding DetailText}" FontWeight="Normal"
                                                                       FontSize="11.5" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource BrushTextSoft}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{ReflectionBinding TotalText}"
                                                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource BrushText}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource BrushDanger}" FontSize="13"
                       IsVisible="{Binding !!ErrorMessage}" TextWrapping="Wrap"/>
        </Grid>
    </dlg:ModalShell>
</Window>
