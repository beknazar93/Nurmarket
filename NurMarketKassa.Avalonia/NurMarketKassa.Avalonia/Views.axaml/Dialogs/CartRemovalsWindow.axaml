<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CartRemovalsWindow"
        Width="912" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-17, редизайн (этап 4, макет MCancelled): журнал «Удалено из чека» этой кассы (CartRemovalLogStore).
       Оболочка ModalShell 880: фильтр «Сегодня / Эта смена / 7 дней» сегментами 44 px, шапка колонок, строки 44 px
       (время, кассир, товар, кол-во, сумма, причина) — список прокручивается сам; итог «N позиций · сумма» слева
       на строке кнопок, «Закрыть» (Esc, ✕). Без выгрузок. Тексты и строки — в коде (Tr.T, 5 языков). -->
  <dlg:ModalShell x:Name="Shell" Margin="16" ContentScroll="Disabled">
    <dlg:ModalShell.Footer>
      <Button x:Name="CloseButton" IsCancel="True" IsDefault="True" Classes="modal-cancel" MaxWidth="200"
              Click="Close_Click"/>
    </dlg:ModalShell.Footer>

    <Grid RowDefinitions="Auto,Auto,*">
      <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12" MaxWidth="560" HorizontalAlignment="Left">
        <RadioButton x:Name="TodayRadio" GroupName="RemovalsPeriod" Classes="modal-seg" Margin="0,0,6,0" Focusable="False"
                     IsChecked="True" IsCheckedChanged="Period_Changed"/>
        <RadioButton x:Name="ShiftRadio" GroupName="RemovalsPeriod" Classes="modal-seg" Margin="3,0,3,0" Focusable="False"
                     IsCheckedChanged="Period_Changed"/>
        <RadioButton x:Name="WeekRadio" GroupName="RemovalsPeriod" Classes="modal-seg" Margin="6,0,0,0" Focusable="False"
                     IsCheckedChanged="Period_Changed"/>
      </UniformGrid>

      <!-- Шапка колонок; ширины колонок — те же, что у строк (RowColumns в коде). -->
      <Border Grid.Row="1" x:Name="HeaderRow" Padding="12,0" MinHeight="32" Margin="0,0,14,0"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"/>

      <Panel Grid.Row="2">
        <ScrollViewer x:Name="ListScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <!-- Справа место под полосу прокрутки (она поверх содержимого) — та же поправка у шапки колонок. -->
          <StackPanel x:Name="RowsPanel" Margin="0,0,14,0"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" IsVisible="False" Margin="0,24,0,0" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" FontSize="14"
                   Foreground="{DynamicResource BrushTextSoft}"/>
      </Panel>
    </Grid>
  </dlg:ModalShell>
</Window>
