<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.OrderDiscountDialog"
        Title="{DynamicResource discount.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <!-- Стиль для Чекбокса -->
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок и ✕ сверху,
         «Отмена» (обводка, Esc) и «Применить» (акцент темы, Enter) снизу справа, «Сбросить» — слева внизу.
         Тумблер «Процент / Сумма» заменён сегментами «%» / «сом» у поля (макет MCart); состояние по-прежнему
         хранит DiscountTypeToggle (скрыт) — логика скидки и запоминание режима не менялись. -->
    <dlg:ModalShell x:Name="Shell" Margin="16" Title="{DynamicResource discount.title}">
        <dlg:ModalShell.Hint>
            <Button Classes="modal-secondary" MaxWidth="200" FontSize="14"
                    HorizontalAlignment="Left"
                    Content="{DynamicResource csh.filter.reset}"
                    Click="Clear_Click"/>
        </dlg:ModalShell.Hint>
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True"
                        Classes="modal-cancel" MaxWidth="200"
                        Content="{DynamicResource common.cancel}"
                        Click="Cancel_Click"/>
                <Button Classes="modal-primary" MaxWidth="200"
                        Content="{DynamicResource csh.filter.apply}"
                        IsDefault="True"
                        Click="Apply_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <StackPanel Spacing="12">
            <TextBlock x:Name="ItemTitleLabel" IsVisible="False"
                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushText}"/>

            <!-- Выбор: Чекбокс для применимости к отдельному товару -->
            <StackPanel x:Name="ScopePanel">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource discount.applyToSelected}"
                               FontSize="14" FontWeight="Medium" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushText}"
                               VerticalAlignment="Center"/>

                    <CheckBox x:Name="ScopeCheckBox"
                              Grid.Column="1"
                              IsChecked="False"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Подпись режима и тумблер — скрыты (их текст и состояние по-прежнему ведёт код). -->
            <TextBlock x:Name="DiscountTypeLabel" IsVisible="False"/>
            <ToggleSwitch x:Name="DiscountTypeToggle"
                          IsVisible="False"
                          IsChecked="False"
                          IsCheckedChanged="DiscountType_Changed"/>

            <!-- Ввод значения и режим «%» / «сом» -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="ValueLabel" Text="{DynamicResource discount.enterAmountLabel}"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSoft}"/>
                <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                    <TextBox x:Name="ValueBox"
                             Height="46"
                             Padding="12,0"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalContentAlignment="Center"
                             CornerRadius="10"
                             BorderBrush="{DynamicResource BrushBorder}"
                             BorderThickness="1.5"
                             Background="{DynamicResource BrushInput}"/>
                    <!-- 2026-10-21 (пакет 6, п. 18): поле было серым (BrushPanelSoft), как неактивное, — теперь цвет обычного поля ввода. -->
                    <RadioButton x:Name="PercentSegment" Grid.Column="2" Classes="modal-seg"
                                 GroupName="DiscountMode" MinWidth="64" MinHeight="46" Focusable="False"
                                 Content="%"
                                 IsCheckedChanged="ModeSegment_Changed"/>
                    <RadioButton x:Name="SumSegment" Grid.Column="4" Classes="modal-seg"
                                 GroupName="DiscountMode" MinWidth="64" MinHeight="46" Focusable="False"
                                 Content="{DynamicResource csh.catalog.currency}"
                                 IsCheckedChanged="ModeSegment_Changed"/>
                </Grid>
            </StackPanel>

            <!-- 2026-10-21 (пакет 6, п. 18): предпросмотр — «Было 120,00 → станет 108,00 сом (скидка 12,00)». Текст — в коде. -->
            <TextBlock x:Name="PreviewText" IsVisible="False"
                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushText}"/>

            <!-- Текст ошибки -->
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource BrushDanger}"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>
    </dlg:ModalShell>
</Window>
