<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PaymentStockBlockedDialog"
        Title="{DynamicResource stockBlocked.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <!-- 2026-10-22 (модалки, пакет 1): общая оболочка ModalShell 512 вместо своей Border 520 с MaxHeight 600 — шапка
       с ✕, список нехватки прокручивается, кнопка «Понятно» закреплена в подвале (modal-primary). Enter, Esc и ✕
       закрывают окно так же, как кнопка (раньше Enter не закрывал). -->
  <dlg:ModalShell Margin="16" Title="{DynamicResource stockBlocked.header}">
    <dlg:ModalShell.Footer>
      <Button IsCancel="True" IsDefault="True" Content="{DynamicResource common.gotIt}"
              Classes="modal-primary" MinWidth="160"
              Click="Ok_Click"/>
    </dlg:ModalShell.Footer>
    <TextBlock x:Name="BodyText"
               TextWrapping="Wrap"
               FontSize="14"
               Foreground="{DynamicResource BrushTextSoft}"/>
  </dlg:ModalShell>
</Window>