<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PayDebtDialog"
        Title="{DynamicResource csh.menu.payDebt}"
        Width="860" Height="780" MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Noto Sans"
        Background="{DynamicResource BrushInputAlt}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.WindowControlButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowControlButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Button.WindowCloseButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.PayButton">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.ClientDropdownItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        </Style>

        <Style Selector="Button.TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.TabButton.Active">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="DataGridRow:selected, DataGridRow:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16,12,16,16" x:CompileBindings="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BrushPanel}"
                CornerRadius="14"
                Padding="16,10"
                Margin="0,0,0,14"
                BoxShadow="0 2 8 0 #0F000000">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Classes="WindowControlButton" Click="MinimizeButton_Click">
                        <TextBlock Text="🗕" FontSize="12"/>
                    </Button>
                    <Button x:Name="CloseWindowButton" Classes="WindowControlButton WindowCloseButton" Click="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="13"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushWarningSoft}" CornerRadius="8" Padding="8">
                        <TextBlock Text="📒" FontSize="18"/>
                    </Border>
                    <TextBlock x:Name="HeaderTitleText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource BrushPanel}"
                CornerRadius="14"
                Padding="16"
                Margin="0,0,0,14"
                BoxShadow="0 2 8 0 #0F000000">
            <StackPanel Spacing="10">
                <TextBlock x:Name="ClientLabelText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextSoft}"/>

                <!-- Выбранный клиент: компактная плашка вместо списка — освобождает место под
                     таблицу долгов ниже, чтобы её не приходилось лишний раз прокручивать. -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSelectedClient}">
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushAccentSoft}"
                            BorderBrush="{DynamicResource BrushAccent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <TextBlock Text="{Binding SelectedClientName}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                    </Border>
                    <Button Grid.Column="1" Classes="SecondaryButton" Margin="8,0,0,0"
                            Content="{DynamicResource payDebt.changeClientButton}"
                            Click="ChangeClientButton_Click"/>
                </Grid>

                <!-- Поиск клиента: показывается только пока клиент не выбран. Результаты —
                     выпадающий список под полем поиска (не строка "плиток" — так же удобно
                     листать длинный список, и не занимает лишнюю высоту, когда пуст). -->
                <StackPanel IsVisible="{Binding !HasSelectedClient}" Spacing="6">
                    <TextBox x:Name="ClientSearchBox" Text="{Binding ClientSearchText}"
                             Watermark="{DynamicResource payDebt.clientSearchWatermark}"/>

                    <Border Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsVisible="{Binding HasClientSearchResults}">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="ClientDropdownItem"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="12,9"
                                                Background="Transparent"
                                                Foreground="{DynamicResource BrushText}"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                Cursor="Hand"
                                                Content="{ReflectionBinding DisplayName}"
                                                Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding TotalOwedText}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource BrushDanger}"
                           IsVisible="{Binding HasSelectedClient}"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource BrushDanger}"
                           FontSize="13"
                           IsVisible="{Binding !!ErrorMessage}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource BrushPanel}"
                CornerRadius="14"
                Padding="16"
                BoxShadow="0 2 8 0 #0F000000"
                IsVisible="{Binding HasSelectedClient}">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock x:Name="DebtSalesTitleText" Grid.Row="0" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                    <Button x:Name="UnpaidTabButton" Classes="TabButton"
                            Classes.Active="{Binding ShowUnpaid}"
                            Content="{Binding UnpaidTabLabel}"
                            Click="ShowUnpaidTab_Click"/>
                    <Button x:Name="HistoryTabButton" Classes="TabButton"
                            Classes.Active="{Binding ShowHistory}"
                            Content="{Binding HistoryTabLabel}"
                            Click="ShowHistoryTab_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="2"
                          IsVisible="{Binding ShowUnpaid}"
                          ItemsSource="{Binding DebtSales}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="52">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource common.date}" Width="140" Binding="{ReflectionBinding DateDisplay}"/>
                        <DataGridTextColumn Header="{DynamicResource common.product}" Width="*" Binding="{ReflectionBinding FirstItemName}"/>
                        <DataGridTemplateColumn Header="{DynamicResource payDebt.colAmountDue}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding AmountToPayText, Mode=TwoWay}"
                                             FontWeight="Bold"
                                             MinHeight="34"
                                             Padding="8,4"
                                             Margin="0,4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="PayButton" FontSize="13"
                                            Content="{Binding DataContext.PayButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Click="PayDebt_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid Grid.Row="2"
                          IsVisible="{Binding ShowHistory}"
                          ItemsSource="{Binding DebtHistory}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="52">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource common.date}" Width="140" Binding="{ReflectionBinding DateDisplay}"/>
                        <DataGridTextColumn Header="{DynamicResource common.product}" Width="*" Binding="{ReflectionBinding FirstItemName}"/>
                        <DataGridTemplateColumn Header="{DynamicResource payDebt.colPaid}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="✓" Foreground="{DynamicResource BrushSuccess}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding OriginalAmountDisplay}" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
