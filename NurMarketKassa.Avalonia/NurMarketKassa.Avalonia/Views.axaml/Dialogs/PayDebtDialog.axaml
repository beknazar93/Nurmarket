<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PayDebtDialog"
        Title="{DynamicResource csh.menu.payDebt}"
        Width="912" Height="780" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        FontFamily="Segoe UI, Inter, Noto Sans"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-19, К1 (аудит 19.10, проблема 5: «старый вид окна, 4 жёлтые кнопки, 64500.00 без разрядов, даты обрезаны»):
         общая оболочка ModalShell, как «Принять оплату долга» у владельца и остальные окна кассы — заголовок и ✕ сверху,
         «Закрыть» (обводка, Esc) снизу справа. Жёлтая — одна: «Погасить» одной суммой; «Оплатить» у строки, «Сменить»,
         вкладки — обводкой / тёмно-синим сегментом. ТОЛЬКО ВИД: имена элементов, привязки и обработчики прежние
         (PayDebtDialog.axaml.cs / .Method.cs / .OneSum.cs, DebtPaymentRunner/DebtPaymentFlow не менялись). -->
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <!-- 2026-10-22 (модалки, пакет 2): поля 44 px (было 40). -->
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.ClientDropdownItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <!-- Строка под курсором — мягкий фон, текст цветом текста (был белый текст на светлом фоне). -->
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="DataGridRow:selected, DataGridRow:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Styles>

    <dlg:ModalShell x:Name="Shell" Margin="16" x:CompileBindings="False"
                    Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContentScroll="Disabled">
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" x:Name="CloseWindowButton" Classes="modal-cancel"
                        Content="{DynamicResource common.close}" Click="CloseButton_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <Grid x:Name="RootGrid" Margin="0" x:CompileBindings="False" RowDefinitions="Auto,Auto,*">

            <!-- Прежняя шапка окна: заголовок теперь в ModalShell, «свернуть» не нужна модалке. Элементы оставлены
                 скрытыми — код окна задаёт им тексты и подсказки (PayDebtDialog.axaml.cs). -->
            <Panel Grid.Row="0" IsVisible="False">
                <TextBlock x:Name="HeaderTitleText"/>
                <Button x:Name="MinimizeButton" Click="MinimizeButton_Click"/>
            </Panel>

            <!-- 2026-10-22 (модалки, пакет 2): верхний блок (клиент, «одной суммой», плашки, ошибки) — в своей прокрутке не выше
                 ~45 % окна (TopScroll.MaxHeight в коде): на 910×512 он больше не сжимает таблицу долгов до нуля. -->
            <ScrollViewer x:Name="TopScroll" Grid.Row="1" Margin="0,0,0,14"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="0,0,8,0">
                <TextBlock x:Name="ClientLabelText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>

                <!-- Выбранный клиент: компактная плашка вместо списка — освобождает место под
                     таблицу долгов ниже, чтобы её не приходилось лишний раз прокручивать. -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSelectedClient}">
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushPanelSoft}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <TextBlock Text="{Binding SelectedClientName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
                    </Border>
                    <Button Grid.Column="1" Classes="modal-secondary" Margin="8,0,0,0"
                            Content="{DynamicResource payDebt.changeClientButton}"
                            IsEnabled="{Binding CanChangeClient}"
                            Click="ChangeClientButton_Click"/>
                </Grid>

                <!-- Поиск клиента: показывается только пока клиент не выбран. Результаты —
                     выпадающий список под полем поиска (не строка "плиток" — так же удобно
                     листать длинный список, и не занимает лишнюю высоту, когда пуст). -->
                <StackPanel IsVisible="{Binding !HasSelectedClient}" Spacing="6">
                    <TextBox x:Name="ClientSearchBox" Text="{Binding ClientSearchText}"
                             Watermark="{DynamicResource payDebt.clientSearchWatermark}"/>

                    <Border Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsVisible="{Binding HasClientSearchResults}">
                        <!-- 2026-10-22 (аудит 1.17.59, П-Б): список клиентов выше (было 220 — 5 строк, ниже пусто). -->
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 2026-10-21 (пакет 6, п. 13 аудита кассы): справа — долг клиента (должники — первыми),
                                             кассиру не нужно знать должника заранее. -->
                                        <Button Classes="ClientDropdownItem"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="12,0" MinHeight="44"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                Foreground="{DynamicResource BrushText}"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{ReflectionBinding DisplayName}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{ReflectionBinding DebtText}" Classes="num"
                                                           Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushDanger}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Долг — красным (правило 4: красный — для долга), крупнее. -->
                <TextBlock Text="{Binding TotalOwedText}"
                           FontSize="18" FontWeight="Bold" Classes="num"
                           Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                           IsVisible="{Binding HasSelectedClient}"/>

                <!-- 2026-09-28: погашение одной суммой (POST clients/{id}/pay-debt/, BE-12) — сервер
                     сам раскладывает сумму от старых долгов к новым, одним запросом вместо десятков
                     взносов по одному (~15 с). Тексты — в коде (PayDebtDialog.OneSum.cs). -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowPayAllBlock}">
                    <Grid x:Name="PayAllGrid" ColumnDefinitions="Auto,160,Auto" IsEnabled="{Binding CanEditPayment}">
                        <TextBlock x:Name="PayAllLabelText" Grid.Column="0" Text="{Binding PayAllLabel}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="PayAllAmountBox" Text="{Binding PayAllAmountText, Mode=TwoWay}"
                                 FontWeight="Bold" MinHeight="46"/>
                        <Button Grid.Column="2" x:Name="PayAllButton" Classes="modal-primary" Margin="8,0,0,0"
                                Content="{Binding PayAllButtonLabel}" Click="PayAll_Click"
                                IsEnabled="{Binding CanPayAll}"/>
                    </Grid>
                    <!-- 2026-10-30, владелец: «при оплате долга система зависает» — полоса и секунды, пока сервер гасит взносы одним ответом. -->
                    <Border IsVisible="{Binding ShowPayingBanner}" CornerRadius="10" Padding="12,10" Background="{DynamicResource BrushAccentSoft}">
                        <StackPanel Spacing="8">
                            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" CornerRadius="2" Foreground="{DynamicResource BrushAccent}"/>
                            <TextBlock Text="{Binding PayingBannerText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushText}"/>
                        </StackPanel>
                    </Border>
                    <!-- 2026-10-18, девятый круг: по части чеков точный остаток не получен — «одной суммой» закрыта. -->
                    <TextBlock Text="{Binding RemainingUnknownHint}" FontSize="12.5" TextWrapping="Wrap" FontWeight="SemiBold"
                               IsVisible="{Binding HasRemainingUnknown}" Foreground="{DynamicResource BrushDanger}"/>
                    <TextBlock Text="{Binding PayAllHint}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>

                <!-- 2026-10-18: способ оплаты долга — по общим настройкам «Оплата долга» (PayDebtDialog.Method.cs). Разрешён
                     один способ — выбора нет (по умолчанию только наличные, как раньше). Действует и на «Оплатить» у строки. -->
                <Grid x:Name="MethodGrid" ColumnDefinitions="Auto,*" IsVisible="{Binding ShowMethodChoice}" IsEnabled="{Binding CanEditPayment}">
                    <TextBlock Grid.Column="0" Text="{Binding MethodLabel}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,10,0"/>
                    <Grid Grid.Column="1" ColumnDefinitions="*,*" MaxWidth="460" HorizontalAlignment="Left">
                        <RadioButton Grid.Column="0" x:Name="MethodCashRadio" GroupName="DebtPayMethod" Classes="modal-seg"
                                     Margin="0,0,4,0" Focusable="False" MinWidth="220"
                                     Content="{Binding CashMethodLabel}" IsChecked="{Binding IsCashMethod, Mode=TwoWay}"/>
                        <RadioButton Grid.Column="1" x:Name="MethodTransferRadio" GroupName="DebtPayMethod" Classes="modal-seg"
                                     Margin="4,0,0,0" Focusable="False" MinWidth="220"
                                     Content="{Binding TransferMethodLabel}" IsChecked="{Binding IsTransferMethod, Mode=TwoWay}"/>
                    </Grid>
                </Grid>
                <TextBlock Text="{Binding TransferHint}" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding ShowTransferHint}" Foreground="{DynamicResource BrushTextSoft}"/>

                <!-- 2026-10-18, ревью (деньги): ответ на оплату не дошёл — сумма, способ, чек и смена клиента закрыты; выход —
                     «Повторить» (тот же ключ, сервер не проведёт дважды) или «Оплата есть / нет на сайте» после проверки (пятый круг ревью). -->
                <Border IsVisible="{Binding HasUnknownPayment}" Background="{DynamicResource BrushDangerSoft}"
                        CornerRadius="10" Padding="12,10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding UnknownPaymentText}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushDangerOnSoft}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="RetryUnknownButton" Classes="modal-secondary" Margin="0,0,8,8"
                                    IsEnabled="{Binding CanRetryUnknown}"
                                    Content="{Binding UnknownRetryLabel}" Click="RetryUnknown_Click"/>
                            <!-- 2026-10-18, пятый круг: два решения после проверки на сайте NurCRM (оба — с подтверждением и кодом). -->
                            <Button x:Name="PaidOnSiteButton" Classes="modal-secondary" Margin="0,0,8,8"
                                    IsEnabled="{Binding CanUseUnknownButtons}"
                                    Content="{Binding UnknownPaidOnSiteLabel}" Click="PaidOnSite_Click"/>
                            <Button x:Name="UnlockUnknownButton" Classes="modal-secondary danger" Margin="0,0,0,8"
                                    IsEnabled="{Binding CanUseUnknownButtons}"
                                    Content="{Binding UnknownUnlockLabel}" Click="NotOnSite_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2026-10-18, девятый круг (п.7): предупреждение к успеху (другая смена, не записано в смену) — жёлтая плашка,
                     не стирается следующим действием; закрывает кассир («Понятно») или закрытие окна. -->
                <Border IsVisible="{Binding HasWarning}" Background="{DynamicResource BrushWarningSoft}"
                        BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource BrushText}"/>
                        <Button Grid.Column="1" Classes="modal-secondary" MinHeight="44" Margin="10,0,0,0"
                                Content="{Binding WarningCloseLabel}" Click="CloseWarning_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource BrushDanger}"
                           FontSize="13"
                           IsVisible="{Binding !!ErrorMessage}"
                           TextWrapping="Wrap"/>

                <!-- 2026-09-28: после «Оплатить» строка просто исчезала — кассир не видел, прошла ли оплата. -->
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="{DynamicResource BrushUiStatusOk}"
                           FontSize="13" FontWeight="SemiBold"
                           IsVisible="{Binding !!SuccessMessage}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasSelectedClient}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock x:Name="DebtSalesTitleText" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushText}"/>
                    <!-- Вкладки — сегменты: выбранная тёмно-синяя (правило 2), как у владельца. -->
                    <Border Grid.Column="1" Classes="sec-segment">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="UnpaidTabButton" Classes="sec-seg" MinHeight="44"
                                    Classes.active="{Binding ShowUnpaid}"
                                    Content="{Binding UnpaidTabLabel}"
                                    Click="ShowUnpaidTab_Click"/>
                            <Button x:Name="HistoryTabButton" Classes="sec-seg" MinHeight="44"
                                    Classes.active="{Binding ShowHistory}"
                                    Content="{Binding HistoryTabLabel}"
                                    Click="ShowHistoryTab_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2026-10-18, восьмой круг (п.4): таблица листается и при замке; закрыты только поля суммы и «Оплатить». -->
                <!-- 2026-10-19, К1: дата 160 (было 140 — «18:0(» обрезалось), «Оплатить» у строки — обводкой. -->
                <DataGrid x:Name="UnpaidGrid" Grid.Row="2"
                          IsVisible="{Binding ShowUnpaid}"
                          ItemsSource="{Binding DebtSales}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="54">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource common.date}" Width="160" Binding="{ReflectionBinding DateDisplay}"/>
                        <DataGridTextColumn Header="{DynamicResource common.product}" Width="*" Binding="{ReflectionBinding FirstItemName}"/>
                        <DataGridTemplateColumn Header="{DynamicResource payDebt.colAmountDue}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 2026-10-18, девятый круг: точного остатка нет — «остаток уточняется» вместо суммы, «Оплатить» скрыта. -->
                                    <Panel>
                                    <TextBlock Text="{Binding RemainingUnknownLabel}" IsVisible="{Binding RemainingUnknown}"
                                               VerticalAlignment="Center" FontStyle="Italic" Foreground="{DynamicResource BrushWarning}"/>
                                    <!-- 2026-10-21 (ревью денег, A2): долг без продажи — сумма без поля и без «Оплатить» (только «одной суммой»). -->
                                    <TextBlock Text="{Binding AmountDisplay}" IsVisible="{Binding IsNoSale}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Text="{Binding AmountToPayText, Mode=TwoWay}" IsVisible="{Binding CanPayByReceipt}"
                                             IsEnabled="{Binding DataContext.CanEditPayment, RelativeSource={RelativeSource AncestorType=Window}}"
                                             FontWeight="Bold"
                                             MinHeight="44"
                                             Padding="8,4"
                                             Margin="0,4"/>
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="modal-secondary" FontSize="13" IsVisible="{Binding CanPayByReceipt}"
                                            MinWidth="0" MinHeight="44" Padding="12,0" Margin="6,0"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding DataContext.CanEditPayment, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Content="{Binding DataContext.PayButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Click="PayDebt_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="HistoryGrid" Grid.Row="2"
                          IsVisible="{Binding ShowHistory}"
                          ItemsSource="{Binding DebtHistory}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="54">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource common.date}" Width="160" Binding="{ReflectionBinding DateDisplay}"/>
                        <DataGridTextColumn Header="{DynamicResource common.product}" Width="*" Binding="{ReflectionBinding FirstItemName}"/>
                        <DataGridTemplateColumn Header="{DynamicResource payDebt.colPaid}" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="✓" Foreground="{DynamicResource BrushSuccess}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding OriginalAmountDisplay}" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </dlg:ModalShell>
</Window>
