<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.QrCropDialog"
        x:CompileBindings="False"
        Title="{DynamicResource qrCrop.title}"
        Width="672" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}"
        Foreground="{DynamicResource BrushText}">

  <!-- 2026-10-22 (модалки, пакет 3): окно без рамки ОС в общей оболочке ModalShell (M = 672, было своё окно 760×650
       с MinHeight 600 — на 1024×600 и 150 % «Обрезать и сохранить» уходила за край). Шапка и подвал закреплены, тело
       прокручивается; «Отмена» = Esc = ✕, «Обрезать и сохранить» — Enter. Картинка — фиксированной высоты 280,
       белая подложка — это «бумага» QR (исключение стандарта). -->
  <dlg:ModalShell Margin="16" Title="{DynamicResource qrCrop.header}" Hint="{DynamicResource qrCrop.resultNote}">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button IsCancel="True" Content="{DynamicResource common.cancel}" Classes="modal-cancel" MaxWidth="200"
                Click="Cancel_Click"/>
        <Button IsDefault="True" Content="{DynamicResource qrCrop.saveButton}" Classes="modal-primary" MaxWidth="240"
                Click="Save_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="16">
      <TextBlock x:Name="SubtitleText"
                 Text="{DynamicResource qrCrop.instructions}" FontSize="13"
                 Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>

      <Grid ColumnDefinitions="300,16,*">
        <Border Grid.Column="0" CornerRadius="14" Padding="14" VerticalAlignment="Top"
                Background="{DynamicResource BrushPanelSoft}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto">
            <Border Background="#FFFFFF" CornerRadius="8" Padding="8" ClipToBounds="True" Height="280">
              <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>
            <TextBlock x:Name="SizeText" Grid.Row="1" Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSoft}"/>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Spacing="13" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource qrCrop.cropEdgesLabel}" FontSize="16" FontWeight="SemiBold"/>

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource qrCrop.left}"/>
              <TextBlock x:Name="LeftValueText" Grid.Column="1"/>
            </Grid>
            <Slider x:Name="LeftSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource qrCrop.right}"/>
              <TextBlock x:Name="RightValueText" Grid.Column="1"/>
            </Grid>
            <Slider x:Name="RightSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource qrCrop.top}"/>
              <TextBlock x:Name="TopValueText" Grid.Column="1"/>
            </Grid>
            <Slider x:Name="TopSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource qrCrop.bottom}"/>
              <TextBlock x:Name="BottomValueText" Grid.Column="1"/>
            </Grid>
            <Slider x:Name="BottomSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
          </StackPanel>

          <Button Content="{DynamicResource qrCrop.resetCrop}" Classes="modal-secondary"
                  HorizontalAlignment="Stretch" Click="Reset_Click"/>
          <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BrushDangerOnSoft}" FontSize="13"
                     TextWrapping="Wrap" IsVisible="False"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </dlg:ModalShell>
</Window>
