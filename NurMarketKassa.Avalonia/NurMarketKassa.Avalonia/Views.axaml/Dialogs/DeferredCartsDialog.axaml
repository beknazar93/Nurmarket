<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.DeferredCartsDialog"
        Title="{DynamicResource deferredCarts.title}"
        Width="912" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <Window.Styles>
    <!-- Стили для неактивных кнопок (:disabled) -->
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    </Style>
    <Style Selector="Button:disabled">
      <!-- В Avalonia тип курсора "запрещено" называется 'No' -->
      <Setter Property="Cursor" Value="No"/>
    </Style>
  </Window.Styles>

  <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 880 (было 820 со своей шапкой) — заголовок,
       пояснение и ✕ сверху; внизу справа «Закрыть» (обводка, Esc — как прежний ✕), «Удалить выбранные» (красная
       обводка), «Добавить в текущий чек» (обводка) и главная «Открыть как отдельный чек». Список прокручивается
       сам (ContentScroll="Disabled"). Имена кнопок и их включение кодом — прежние. -->
  <dlg:ModalShell Margin="16"
                  Title="{DynamicResource deferredCarts.title}"
                  Subtitle="{DynamicResource deferredCarts.hint}"
                  ContentScroll="Disabled">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="CloseButton" IsCancel="True" Content="{DynamicResource common.close}"
                Classes="modal-cancel" MaxWidth="200"
                Click="Close_Click"/>
        <Button x:Name="DeleteSelectedButton" Content="{DynamicResource deferredCarts.deleteSelected}"
                Classes="modal-secondary danger" MaxWidth="260"
                Click="DeleteSelected_Click"/>
        <Button x:Name="MergeIntoCurrentButton" Content="{DynamicResource deferredCarts.mergeIntoCurrent}"
                Classes="modal-secondary" MaxWidth="260"
                Click="MergeIntoCurrent_Click"/>
        <Button x:Name="LoadAsSeparateButton" Content="{DynamicResource deferredCarts.loadAsSeparate}"
                Classes="modal-primary" MaxWidth="280"
                Click="LoadAsSeparate_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <Grid RowDefinitions="Auto,*">
      <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"
                 Foreground="{DynamicResource BrushText}"/>

      <!-- Список корзин -->
      <ListBox x:Name="CartListBox" Grid.Row="1"
               SelectionMode="Multiple"/>
    </Grid>
  </dlg:ModalShell>
</Window>
