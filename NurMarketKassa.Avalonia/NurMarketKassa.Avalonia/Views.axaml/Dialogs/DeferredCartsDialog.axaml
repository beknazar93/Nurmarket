<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.DeferredCartsDialog"
        Title="{DynamicResource deferredCarts.title}"
        Width="820" Height="580"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <Window.Styles>
    <!-- 1. Верхний крестик -->
    <Style Selector="Button.CloseIconButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.CloseIconButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.CloseIconButton:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    </Style>

    <!-- 2. Главная ЧИСТО ЖЁЛТАЯ кнопка (Primary) -->
    <Style Selector="Button.YellowPrimary">
      <Setter Property="Background" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.YellowPrimary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.YellowPrimary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- 3. Контурная жёлтая кнопка (Outline) -->
    <Style Selector="Button.YellowOutline">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.YellowOutline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
    </Style>
    <Style Selector="Button.YellowOutline:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>

    <!-- 4. Кнопка удаления (Danger Soft) -->
    <Style Selector="Button.DangerOutline">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.DangerOutline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
    </Style>

    <!-- 5. Нейтральная кнопка "Закрыть" (Secondary Neutral) -->
    <Style Selector="Button.SecondaryNeutral">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Стили для неактивных кнопок (:disabled) -->
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    </Style>
    <Style Selector="Button:disabled">
      <!-- В Avalonia тип курсора "запрещено" называется 'No' -->
      <Setter Property="Cursor" Value="No"/>
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource SettingsCardRadius}"
          Background="{DynamicResource BrushDialogPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          Padding="20">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Шапка -->
      <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{DynamicResource deferredCarts.title}"
                     FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="✕"
                  Classes="CloseIconButton"
                  Click="Close_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,14">
          <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}"/>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,6,0,0"
                     Text="{DynamicResource deferredCarts.hint}"/>
        </StackPanel>
      </Grid>

      <!-- Список корзин -->
      <ListBox x:Name="CartListBox" Grid.Row="1"
               SelectionMode="Multiple"
               Margin="0,0,0,16"/>

      <!-- Подвал -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
        <!-- Кнопка "Закрыть" слева -->
        <Button Grid.Column="0" x:Name="CloseButton" Content="{DynamicResource common.close}"
                Classes="SecondaryNeutral"
                Click="Close_Click"/>

        <!-- Панель основных действий в одну строку -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DeleteSelectedButton" Content="{DynamicResource deferredCarts.deleteSelected}"
                  Classes="DangerOutline"
                  Margin="0,0,8,0" Click="DeleteSelected_Click"/>
          <Button x:Name="MergeIntoCurrentButton" Content="{DynamicResource deferredCarts.mergeIntoCurrent}"
                  Classes="YellowOutline"
                  Margin="0,0,8,0" Click="MergeIntoCurrent_Click"/>
          <Button x:Name="LoadAsSeparateButton" Content="{DynamicResource deferredCarts.loadAsSeparate}"
                  Classes="YellowPrimary"
                  Click="LoadAsSeparate_Click"/>
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>