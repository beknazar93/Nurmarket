<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.FinanceDateRangeDialog"
        Title="{DynamicResource financeRange.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-22 (модалки, пакет 2): общая оболочка ModalShell 512 вместо своей рамки 520 без прокрутки — «Отмена/Применить»
       уходили за нижний край уже на 1366×768 (содержимое ≈ 680 px). Теперь шапка с ✕ и подвал закреплены, тело (быстрые
       периоды, даты, календарь) прокручивается; быстрые периоды — чипы 44 px, поля дат — 44 px, без значка-эмодзи. -->
  <dlg:ModalShell Margin="16"
                  Title="{DynamicResource financeRange.title}"
                  Subtitle="{DynamicResource financeRange.subtitle}"
                  InitialFocus="FromDatePicker">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="modal-cancel" Content="{DynamicResource common.cancel}" MaxWidth="200"
                IsCancel="True" Click="Cancel_Click"/>
        <Button Classes="modal-primary" Content="{DynamicResource csh.filter.apply}" MaxWidth="200"
                IsDefault="True" Click="Apply_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="16">
      <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource financeRange.quickSection}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSoft}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="modal-chip" Content="{DynamicResource common.today}" Tag="Today" Click="Quick_Click"/>
          <Button Classes="modal-chip" Content="{DynamicResource common.week}" Tag="Week" Click="Quick_Click"/>
          <Button Classes="modal-chip" Content="{DynamicResource common.month}" Tag="Month" Click="Quick_Click"/>
        </StackPanel>
      </StackPanel>

      <Grid ColumnDefinitions="*,16,*">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="{DynamicResource common.from}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
          <CalendarDatePicker x:Name="FromDatePicker" Classes="modal-field"
                              CornerRadius="{DynamicResource SettingsButtonRadius}"
                              HorizontalAlignment="Stretch"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock Text="{DynamicResource common.to}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
          <CalendarDatePicker x:Name="ToDatePicker" Classes="modal-field"
                              CornerRadius="{DynamicResource SettingsButtonRadius}"
                              HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Grid>

      <!-- Ошибка — под полями дат, над календарём (видна без прокрутки). -->
      <TextBlock x:Name="ErrorText"
                 FontSize="13"
                 Foreground="{DynamicResource BrushDangerOnSoft}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource financeRange.calendarSection}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSoft}"/>
        <!-- Фон рамки совпадает с карточкой диалога. Раньше стоял BrushPanelSoft — в светлой
           теме это #E2E8F0, и календарь выглядел серо-голубой плашкой, наклеенной на белый
           диалог. -->
        <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="12" Padding="8" HorizontalAlignment="Stretch">
          <Calendar x:Name="RangeCalendar"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    SelectedDatesChanged="RangeCalendar_SelectedDatesChanged"/>
        </Border>
      </StackPanel>
    </StackPanel>
  </dlg:ModalShell>
</Window>
