<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.AddBankDialog"
        Title="{DynamicResource posSettings.operations.addBankTitle}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <!-- 2026-10-22 (модалки, пакет 3): общая оболочка ModalShell (S = 512, была своя карточка 440 без ✕): заголовок и ✕ сверху,
       «Отмена» (Esc = ✕) и «Добавить» (Enter) в подвале, фокус — в поле названия; поля 44 px. -->
  <dlg:ModalShell Margin="16" Title="{DynamicResource posSettings.operations.addBankTitle}" InitialFocus="NameBox">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button IsCancel="True" x:Name="CancelButton" Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.cancel}" Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton" Classes="modal-primary" MaxWidth="200" IsDefault="True"
                Content="{DynamicResource common.add}" Click="ConfirmButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>
    <StackPanel>
      <TextBlock Text="{DynamicResource posSettings.operations.addBankMessage}"
                 FontSize="14" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"
                 Margin="0,0,0,16"/>
      <!-- Готовый список банков Кыргызстана: владельцу не нужно вспоминать точное
           написание, а от написания зависит ключ, по которому хранится QR. Поле ввода
           ниже остаётся для банков, которых в списке нет. -->
      <ComboBox x:Name="KnownBox"
                MinHeight="44"
                FontSize="16"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                PlaceholderText="{DynamicResource loc.kassa.addBank.pickPlaceholder}"
                SelectionChanged="KnownBox_SelectionChanged"/>

      <TextBlock Text="{DynamicResource loc.kassa.addBank.orTypeName}"
                 FontSize="13"
                 Foreground="{DynamicResource BrushTextSoft}"
                 Margin="0,0,0,8"/>

      <TextBox x:Name="NameBox"
               Classes="modal-field"
               FontSize="16"
               Watermark="{DynamicResource posSettings.operations.addBankWatermark}"
               KeyDown="NameBox_KeyDown"/>
      <TextBlock x:Name="ErrorText"
                 FontSize="13"
                 Foreground="{DynamicResource BrushDangerOnSoft}"
                 TextWrapping="Wrap"
                 IsVisible="False"
                 Margin="0,4,0,0"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
