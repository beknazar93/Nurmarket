<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.NoStockDialog"
        Title="{DynamicResource noStock.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок (текст — в коде)
         и ✕ сверху, кнопки снизу справа. BtnCancel по-прежнему и Esc, и Enter: одна — главная «ОК»; если
         можно продать сверх остатка — «Отмена» с обводкой, а главная — «Подтвердить и добавить». -->
    <dlg:ModalShell x:Name="Shell" Margin="16" Title="{DynamicResource noStock.header}">
        <dlg:ModalShell.Footer>
            <StackPanel x:Name="ButtonsRow" Orientation="Horizontal" Spacing="10">
                <Button x:Name="BtnCancel"
                        Content="{DynamicResource common.ok}"
                        Classes.modal-cancel="{Binding #BtnOverride.IsVisible}"
                        Classes.modal-primary="{Binding !#BtnOverride.IsVisible}"
                        MaxWidth="200"
                        IsCancel="True"
                        IsDefault="True"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnOverride"
                        Content="{DynamicResource noStock.confirmAndAdd}"
                        Classes="modal-primary" MaxWidth="220"
                        IsVisible="False"
                        Click="BtnOverride_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <StackPanel Spacing="10">
            <TextBlock x:Name="ProductNameText"
                       TextWrapping="Wrap"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"/>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="14" Foreground="{DynamicResource BrushTextSoft}"/>

            <TextBlock x:Name="AvailableText"
                       FontSize="14" TextWrapping="Wrap"
                       FontWeight="SemiBold" Foreground="{DynamicResource BrushDanger}"/>

            <Button x:Name="BtnAlternatives"
                    Content="{DynamicResource noStock.showAlternatives}"
                    Classes="modal-secondary"
                    HorizontalAlignment="Stretch"
                    Margin="0,4,0,0"
                    IsVisible="False"
                    Click="BtnAlternatives_Click"/>
        </StackPanel>
    </dlg:ModalShell>
</Window>
