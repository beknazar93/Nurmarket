<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.AddStockQuantityDialog"
        Title="{DynamicResource addStock.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок и ✕ сверху,
         «Отмена» (обводка, Esc) и «Подтвердить» (акцент темы, Enter) снизу справа. -->
    <dlg:ModalShell Margin="16"
                    Title="{DynamicResource addStock.header}"
                    Hint="{DynamicResource modal.hintEnter}">
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="BtnCancel"
                        Content="{DynamicResource common.cancel}"
                        Classes="modal-cancel" MaxWidth="200"
                        IsCancel="True"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm"
                        Content="{DynamicResource addStock.confirm}"
                        Classes="modal-primary" MaxWidth="200"
                        IsDefault="True"
                        Click="BtnConfirm_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <StackPanel Spacing="8">
            <TextBlock x:Name="ProductNameText"
                       TextWrapping="Wrap"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"/>

            <TextBlock Text="{DynamicResource addStock.message}"
                       TextWrapping="Wrap"
                       FontSize="13" Foreground="{DynamicResource BrushTextSoft}"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="QuantityBox"
                     Height="48" FontSize="20" FontWeight="Bold"
                     CornerRadius="{DynamicResource SettingsButtonRadius}"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource BrushInput}"
                     Foreground="{DynamicResource BrushText}"
                     BorderBrush="{DynamicResource BrushBorderStrong}"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource BrushDanger}"
                       FontSize="12.5" TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>
    </dlg:ModalShell>
</Window>
