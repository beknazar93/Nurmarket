<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.AddStockQuantityDialog"
        Title="{DynamicResource addStock.title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <Style Selector="Button.btn-ok">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-override">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
        </Style>
    </Window.Styles>

    <Border Margin="16" CornerRadius="{DynamicResource SettingsCardRadius}"
            Background="{DynamicResource BrushDialogPanel}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
            BoxShadow="0 12 32 0 #33101828"
            Padding="28,24">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource addStock.header}"
                       FontWeight="Bold" FontSize="20"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock x:Name="ProductNameText"
                       TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="{DynamicResource addStock.message}"
                       TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource BrushTextSoft}"
                       HorizontalAlignment="Center" Margin="0,0,0,16" MaxWidth="360"/>

            <TextBox x:Name="QuantityBox"
                     Width="180" FontSize="20" FontWeight="Bold"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,6"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource BrushDanger}"
                       FontSize="12" TextAlignment="Center"
                       IsVisible="False" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
                <Button x:Name="BtnCancel"
                        Content="{DynamicResource common.cancel}"
                        Classes="btn-ok"
                        Width="140" Height="40"
                        IsCancel="True"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm"
                        Content="{DynamicResource addStock.confirm}"
                        Classes="btn-override"
                        Width="180" Height="40"
                        IsDefault="True"
                        Click="BtnConfirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
