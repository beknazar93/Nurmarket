<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.BundleItemPickerDialog"
        Title="{DynamicResource product.selectBundleItems}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI, Inter, Noto Sans"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}"
        x:CompileBindings="False">

    <!-- 2026-10-22 (модалки, пакет 3): общая оболочка ModalShell (S = 512, было своё окно 520×620 со своей ✕ 32×30):
         заголовок и ✕ 44 сверху, «Отмена» (Esc = ✕) и «Добавить (N)» в закреплённом подвале, список прокручивается сам,
         поиск над ним на месте и получает фокус при открытии. Enter «Добавить» не нажимает: в поиск сканируют штрихкод. -->
    <dlg:ModalShell x:Name="Shell" Margin="16" Title="{DynamicResource product.selectBundleItems}"
                    ContentScroll="Disabled" InitialFocus="SearchBox">
        <dlg:ModalShell.Hint>
            <TextBlock x:Name="EmptyHintText" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSoft}"/>
        </dlg:ModalShell.Hint>
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" Classes="modal-cancel" MaxWidth="200" Content="{DynamicResource common.cancel}" Click="Close_Click"/>
                <Button x:Name="AddButton" Classes="modal-primary" MaxWidth="220" Content="{DynamicResource product.addSelected}" Click="AddButton_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Classes="modal-field" Watermark="{DynamicResource product.bundleSearchWatermark}" TextChanged="SearchBox_TextChanged"/>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox Grid.Column="0" x:Name="SelectAllCheckBox" MinHeight="44" Content="{DynamicResource product.selectAll}" Click="SelectAllCheckBox_Click"/>
                    <TextBlock Grid.Column="2" x:Name="SelectedCountText" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSoft}" FontSize="13"/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" MinHeight="160" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemsList"/>
            </ScrollViewer>
        </Grid>
    </dlg:ModalShell>
</Window>
