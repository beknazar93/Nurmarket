<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PosAlertDialog"
        Title="{DynamicResource dialog.messageTitle}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <!-- 2026-10-16, редизайн (этап 1): общая оболочка ModalShell — заголовок и ✕ сверху, длинный текст
       прокручивается (не выше 85 % экрана), кнопки внизу справа: «Отложить ошибку» (обводка) и главная.
       Карточка 480 + поля 2×16 под тень. Esc и ✕ — «Закрыть»/«Понятно» (IsCancel), как и раньше. -->
  <dlg:ModalShell x:Name="Shell" Margin="16">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- Надпись переносится на вторую строку: по-кыргызски «Катаны кийинкиге калтыруу» в одну
             строку не помещалась и обрезалась (2026-09-25). -->
        <Button x:Name="DeferButton" Classes="modal-cancel"
                MaxWidth="200" Padding="12,0"
                IsVisible="False"
                Click="DeferButton_Click">
          <TextBlock Text="{DynamicResource dialog.deferError}" TextWrapping="Wrap" TextAlignment="Center"
                     LineHeight="17" VerticalAlignment="Center"/>
        </Button>
        <Button IsCancel="True" x:Name="OkButton" Classes="modal-primary"
                MaxWidth="200"
                Content="{DynamicResource common.gotIt}"
                Click="OkButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <!-- Отступ справа: полоса прокрутки длинного текста («Касса обновлена») не ложится на буквы. -->
    <TextBlock x:Name="MessageText" Margin="0,0,14,0"
               FontSize="14" TextWrapping="Wrap"
               Foreground="{DynamicResource BrushTextSoft}"
               HorizontalAlignment="Stretch"
               TextAlignment="Left"/>
  </dlg:ModalShell>
</Window>
