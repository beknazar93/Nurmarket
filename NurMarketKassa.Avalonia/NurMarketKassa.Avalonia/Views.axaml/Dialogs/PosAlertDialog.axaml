<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PosAlertDialog"
        Title="{DynamicResource dialog.messageTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <Border Margin="16" CornerRadius="{DynamicResource SettingsCardRadius}"
          Background="{DynamicResource BrushDialogPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText"
                 FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Margin="0,0,0,12"/>

      <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,0,22">
        <TextBlock x:Name="MessageText"
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextSoft}"
                   HorizontalAlignment="Stretch"
                   TextAlignment="Left"/>
      </ScrollViewer>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
        <Button IsCancel="True" x:Name="OkButton"
                Content="{DynamicResource common.gotIt}"
                Height="46" Width="165"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BrushAccent}"
                Foreground="{DynamicResource BrushAccentForeground}"
                FontWeight="SemiBold"
                CornerRadius="10"
                Cursor="Hand"
                Click="OkButton_Click"/>
        <!-- Надпись переносится на вторую строку: по-кыргызски «Катаны кийинкиге калтыруу» в одну
             строку не помещалась и обрезалась (2026-09-25). -->
        <Button x:Name="DeferButton"
                Height="46" Width="165" Padding="8,0"
                IsVisible="False"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BrushPanelSoft}"
                Foreground="{DynamicResource BrushText}"
                BorderBrush="{DynamicResource BrushBorderStrong}"
                BorderThickness="1"
                FontWeight="SemiBold"
                CornerRadius="10"
                Cursor="Hand"
                Click="DeferButton_Click">
          <TextBlock Text="{DynamicResource dialog.deferError}" TextWrapping="Wrap" TextAlignment="Center"
                     LineHeight="17" VerticalAlignment="Center"/>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>