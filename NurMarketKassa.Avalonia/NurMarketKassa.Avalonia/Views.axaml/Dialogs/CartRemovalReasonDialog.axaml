<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CartRemovalReasonDialog"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-17, редизайн (этап 4, макет MCancelled): «Убрать из чека?» — причина удаления строки.
       Оболочка ModalShell 480: в шапке «товар · кол-во · сумма», причины 2×2 сегментами 44 px (выбранная —
       тёмная заливка), заметка, «Всю строку / Только 1 шт» (если в строке больше 1 шт), низ «Enter — убрать ·
       Esc — оставить» + «Оставить» (Esc, ✕) и красная «Убрать» (Enter). Тексты — в коде (Tr.T, 5 языков). -->
  <dlg:ModalShell x:Name="Shell" Margin="16">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="KeepButton" IsCancel="True" Classes="modal-cancel" MaxWidth="200"
                Click="Keep_Click"/>
        <Button x:Name="RemoveButton" IsDefault="True" Classes="modal-primary danger" MaxWidth="200"
                Click="Remove_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="10">
      <TextBlock x:Name="ReasonLabel" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"/>
      <!-- Сегменты не берут фокус: Enter после щелчка — «Убрать», а не повторный выбор. -->
      <UniformGrid Columns="2">
        <RadioButton x:Name="Reason1" GroupName="RemovalReason" Classes="modal-seg" Margin="0,0,4,8" Focusable="False" IsCheckedChanged="Reason_Changed"/>
        <RadioButton x:Name="Reason2" GroupName="RemovalReason" Classes="modal-seg" Margin="4,0,0,8" Focusable="False" IsCheckedChanged="Reason_Changed"/>
        <RadioButton x:Name="Reason3" GroupName="RemovalReason" Classes="modal-seg" Margin="0,0,4,0" Focusable="False" IsCheckedChanged="Reason_Changed"/>
        <RadioButton x:Name="Reason4" GroupName="RemovalReason" Classes="modal-seg" Margin="4,0,0,0" Focusable="False" IsCheckedChanged="Reason_Changed"/>
      </UniformGrid>

      <TextBox x:Name="NoteBox" MinHeight="44" MaxLength="200" TextWrapping="NoWrap" VerticalContentAlignment="Center"/>

      <StackPanel x:Name="AmountPanel" Spacing="6" IsVisible="False">
        <TextBlock x:Name="AmountLabel" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextSoft}"/>
        <UniformGrid Columns="2">
          <RadioButton x:Name="WholeLineRadio" GroupName="RemovalAmount" Classes="modal-seg" Margin="0,0,4,0" Focusable="False" IsChecked="True"/>
          <RadioButton x:Name="OnlyOneRadio" GroupName="RemovalAmount" Classes="modal-seg" Margin="4,0,0,0" Focusable="False"/>
        </UniformGrid>
      </StackPanel>

      <TextBlock x:Name="ErrorText" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushDanger}" IsVisible="False"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
