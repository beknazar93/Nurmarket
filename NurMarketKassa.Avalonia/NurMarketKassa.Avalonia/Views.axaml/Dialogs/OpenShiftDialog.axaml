<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.OpenShiftDialog"
        Title="{DynamicResource csh.toolbar.openShift}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-16, редизайн (этап 1): общая оболочка ModalShell — заголовок и ✕ сверху, «Отмена»
         (обводка, Esc) и «Открыть смену» (акцент темы, Enter) снизу справа, подсказка — снизу слева. -->
    <dlg:ModalShell Margin="16"
                    Title="{DynamicResource csh.toolbar.openShift}"
                    Subtitle="{DynamicResource openShift.instructions}"
                    Hint="{DynamicResource modal.hintEnter}">
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" Content="{DynamicResource common.cancel}"
                        Classes="modal-cancel" MaxWidth="200"
                        Click="Cancel_Click"/>

                <Button Content="{DynamicResource csh.toolbar.openShift}"
                        Classes="modal-primary" MaxWidth="200"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <StackPanel>
            <Border Padding="12" CornerRadius="8" Margin="0,0,0,14"
                    Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource shift.systemBalance}" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                    <!-- 2026-10-16: сумма цветом денег, а не акцента — жёлтый по серой карточке не читался (≈1,2:1). -->
                    <TextBlock x:Name="SystemBalanceText" Classes="num" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrushMoney}" Margin="0,4,0,0" Text="—"/>
                    <!-- 2026-10-23: остаток не загрузился — повтор (кнопка «Открыть смену» всё равно доступна). -->
                    <Button x:Name="RetryBalanceButton" Classes="modal-secondary" IsVisible="False" Margin="0,6,0,0"
                            HorizontalAlignment="Left" Padding="12,4" FontSize="12" Click="RetryBalance_Click"
                            Content="{DynamicResource shift.retryBalance}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource openShift.openingAmountLabel}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,6"/>
            <TextBox x:Name="OpeningCashBox" Text="0.00" Height="48" FontSize="18" CornerRadius="8"
                     VerticalContentAlignment="Center"/>
            <!-- 2026-10-22 (модалки, пакет 2): ошибка суммы — текстом под полем (было всплывающее окно). -->
            <TextBlock x:Name="OpeningCashError" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="False"
                       Foreground="{DynamicResource BrushDangerOnSoft}"/>
        </StackPanel>
    </dlg:ModalShell>
</Window>
