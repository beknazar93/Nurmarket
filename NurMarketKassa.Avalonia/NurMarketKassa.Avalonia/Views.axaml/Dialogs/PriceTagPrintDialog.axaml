<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PriceTagPrintDialog"
        x:DataType="dialogs:PriceTagPrintDialog"
        x:CompileBindings="False"
        Title="{DynamicResource priceTag.title}"
        Width="912" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI, Inter, Noto Sans"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-10-20, этап О9б (редизайн ценников): общая оболочка ModalShell — заголовок и ✕ сверху, «Закрыть» и «Печать»
         снизу всегда видны (было окно 560×800: на экране 768 кнопки уходили под край и нужно было листать). Две колонки:
         слева предпросмотр ценника (что напечатается — не менялось) и сообщения, справа настройки. «Куда печатать» —
         сегменты (выбранный тёмно-синий), «Редактировать шаблон» — обводкой. Имена элементов и обработчики — прежние. -->
    <Window.Styles>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
    </Window.Styles>

    <dialogs:ModalShell Margin="16"
                        Title="{DynamicResource priceTag.header}"
                        Subtitle="{DynamicResource priceTag.subtitle}">
        <dialogs:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" Content="{DynamicResource common.close}" Classes="modal-cancel" Click="CloseButton_Click"/>
                <Button x:Name="PrintButton" Content="{DynamicResource labelPrint.printButton}" Classes="modal-primary" Click="PrintButton_Click"/>
            </StackPanel>
        </dialogs:ModalShell.Footer>

        <Grid ColumnDefinitions="380,24,*">
            <!-- Слева: товар, предпросмотр, сообщения -->
            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock x:Name="ProductNameText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
                <Border Background="White" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="10" Height="270">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Справа: шаблон, размер, акция, куда и сколько печатать -->
            <StackPanel Grid.Column="2" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="{DynamicResource priceTag.templateLabel}"/>
                    <ComboBox x:Name="KindCombo" HorizontalAlignment="Stretch" SelectionChanged="KindCombo_SelectionChanged"/>
                    <Button x:Name="EditTemplateButton" Content="{DynamicResource priceTag.editTemplate}" Classes="modal-secondary"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0"
                            IsVisible="False" Click="EditTemplateButton_Click"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource labelEditor.widthLabel}"/>
                        <NumericUpDown x:Name="WidthBox" Minimum="15" Maximum="150" Increment="1" FormatString="0" ValueChanged="Size_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource labelEditor.heightLabel}"/>
                        <NumericUpDown x:Name="HeightBox" Minimum="10" Maximum="150" Increment="1" FormatString="0" ValueChanged="Size_Changed"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PromoFieldsPanel" IsVisible="False" ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource priceTag.oldPriceLabel}" TextWrapping="Wrap"/>
                        <TextBox x:Name="OldPriceBox" TextChanged="PromoFields_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="field-label" Text="{DynamicResource priceTag.discountLabel}" TextWrapping="Wrap"/>
                        <TextBox x:Name="DiscountBox" Watermark="-20%" TextChanged="PromoFields_Changed"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="{DynamicResource priceTag.targetLabel}"/>
                    <Border Classes="sec-segment">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="TargetThermalRadio" GroupName="PriceTagTarget" Classes="sec-seg"
                                         Content="{DynamicResource priceTag.targetThermal}" IsChecked="True" Click="Target_Changed"/>
                            <RadioButton x:Name="TargetA4Radio" GroupName="PriceTagTarget" Classes="sec-seg"
                                         Content="{DynamicResource priceTag.targetA4}" Click="Target_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="{DynamicResource common.printer}"/>
                    <ComboBox x:Name="PrinterCombo" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="{DynamicResource labelPrint.copiesLabel}"/>
                    <NumericUpDown x:Name="CopiesBox" Value="1" Minimum="1" Maximum="200" Increment="1" FormatString="0" HorizontalAlignment="Left" MinWidth="180"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </dialogs:ModalShell>
</Window>
