<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ReturnLineReasonDialog"
        Title="{DynamicResource returnReason.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <Window.Styles>
    <!-- Поле ввода причины -->
    <Style Selector="TextBox.ModernTextArea">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
  </Window.Styles>

  <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок и ✕ сверху,
       «Отмена» (обводка, Esc) и «Вернуть» (акцент темы) снизу справа. Высота — по содержимому (раньше
       окно 520 / 420 задавалось в коде), не выше 85 % экрана. Enter в поле — новая строка, как и раньше. -->
  <dlg:ModalShell Margin="16" Title="{DynamicResource returnReason.header}">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button IsCancel="True"
                Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.cancel}"
                Click="Cancel_Click"/>
        <Button Classes="modal-primary" MaxWidth="200"
                Content="{DynamicResource csh.cart.restore}"
                IsDefault="True"
                Click="Ok_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="12">
      <!-- Подсказка (текст — в коде) -->
      <TextBlock x:Name="HintText"
                 TextWrapping="Wrap"
                 FontSize="13.5"
                 Foreground="{DynamicResource BrushTextSoft}"/>

      <!-- 2026-10-06 (О-33, магазин одежды): частые причины одной кнопкой и отметка «Брак» — бракованный товар
           сервер не возвращает на склад (is_defect). Кнопки и подписи — в коде. -->
      <StackPanel x:Name="QuickReasonsPanel" Spacing="8">
        <WrapPanel x:Name="QuickReasonsWrap" Orientation="Horizontal"/>
        <CheckBox x:Name="DefectCheck" FontSize="13" Foreground="{DynamicResource BrushText}"/>
      </StackPanel>

      <!-- Многострочное поле ввода -->
      <TextBox x:Name="ReasonBox"
               Classes="ModernTextArea"
               MinHeight="110"
               Watermark="{DynamicResource returnReason.watermark}"
               TextWrapping="Wrap"
               AcceptsReturn="True"/>

      <!-- Текст ошибки -->
      <TextBlock x:Name="ErrorText"
                 FontSize="13"
                 FontWeight="Medium"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushDanger}"
                 IsVisible="False"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
