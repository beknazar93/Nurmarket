<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.StockTransferDialog"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:CompileBindings="False"
        Title="{DynamicResource warehouse.transferCardTitle}"
        Width="1012" Height="720"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    </Style>
    <Style Selector="Border.status">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Border.status TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushAccentStrong}"/></Style>
    <!-- Цвет плашки статуса — как в списке документов на складе (2026-09-25: «В пути» здесь была
         синей, а в списке жёлтой). -->
    <Style Selector="Border.status.transit"><Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/></Style>
    <Style Selector="Border.status.transit TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/></Style>
    <Style Selector="Border.status.done"><Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/></Style>
    <Style Selector="Border.status.done TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/></Style>
    <Style Selector="Border.status.cancelled"><Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/></Style>
    <Style Selector="Border.status.cancelled TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/></Style>

    <!-- 2026-11-12 (Д-4): свои стили PrimaryButton/SecondaryButton убраны — кнопки окна теперь общие modal-primary / modal-secondary (PosDialogStyles). -->
    <!-- 2026-11-12 (Д-4): заголовки таблицы — не меньше 12,5 (были 12). -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 2026-10-27: прозрачность выключенной 0.35 → 0,7: в тёмной теме надпись выключенной кнопки была 1,5–2,5:1 (нужно ≥3:1). -->
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
  </Window.Styles>

  <!-- 2026-11-12 (Д-4): общая рамка ModalShell — заголовок «Перемещение товара» и ✕ сверху; номер, статус и выгрузка — первой строкой содержимого;
       внизу слева итог партии, справа «Отменить перемещение» (красная обводка), «Отправить» / «Принять» (главная, видна одна) и «Закрыть». -->
  <dlg:ModalShell x:Name="Shell" Margin="16"
                  Title="{DynamicResource warehouse.transferCardTitle}"
                  ContentScroll="Disabled">
    <dlg:ModalShell.Hint>
      <TextBlock x:Name="SummaryText" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
    </dlg:ModalShell.Hint>
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="CancelTransferButton" Classes="modal-secondary danger" MaxWidth="260"
                Content="{DynamicResource warehouse.transferCancel}" Click="CancelTransfer_Click"/>
        <Button IsCancel="True" Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.close}" Click="Close_Click"/>
        <Button x:Name="ShipButton" Classes="modal-primary" MaxWidth="280"
                Content="{DynamicResource warehouse.transferShip}" Click="Ship_Click"/>
        <Button x:Name="DeliverButton" Classes="modal-primary" MaxWidth="280"
                Content="{DynamicResource warehouse.transferDeliver}" Click="Deliver_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,-4,0,0">

      <!-- Номер, статус, дата и выгрузка списка -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock x:Name="NumberText" FontSize="16" FontWeight="Bold"
                     Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
          <Border x:Name="StatusBadge" Classes="status" VerticalAlignment="Center"
                  IsVisible="{Binding Text, ElementName=StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"> <!-- 2026-11-12 (Д-4): пустая плашка статуса не рисуется -->
            <TextBlock x:Name="StatusText" FontSize="12.5" FontWeight="SemiBold"/>
          </Border>
          <TextBlock x:Name="CreatedText" FontSize="12.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSoft}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="modal-secondary" MinHeight="40" MinWidth="72" Padding="12,0" Content="Excel" Click="ExportExcel_Click"/>
          <Button Classes="modal-secondary" MinHeight="40" MinWidth="72" Padding="12,0" Content="Word" Click="ExportWord_Click"/>
          <Button Classes="modal-secondary" MinHeight="40" MinWidth="72" Padding="12,0" Content="CSV" Click="ExportCsv_Click"/>
        </StackPanel>
      </Grid>

      <!-- Маршрут и сопровождение -->
      <Border Grid.Row="1" Padding="14" Margin="0,0,0,12"
              Background="{DynamicResource BrushPanelSoft}"
              CornerRadius="{DynamicResource SettingsCardRadius}">
        <Grid ColumnDefinitions="*,12,*,12,*" RowDefinitions="Auto,Auto,Auto">
          <!-- 2026-10-06, владелец: «перемещение на филиалы сделай» — «▾» выбирает главный склад или филиал
               (видна, только если у компании есть филиалы); такое перемещение проводит сервер (StockTransferDialog.Branches). -->
          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Classes="field" Text="{DynamicResource warehouse.transferFrom}"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="FromBox" LostFocus="Field_Changed"/>
              <Button x:Name="FromPickButton" Grid.Column="1" Classes="modal-secondary" Content="▾" Tag="from" MinWidth="44"
                      HorizontalContentAlignment="Center" Margin="6,0,0,0" Padding="12,4" IsVisible="False" Click="PickPlace_Click"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Classes="field" Text="{DynamicResource warehouse.transferTo}"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="ToBox" LostFocus="Field_Changed"/>
              <Button x:Name="ToPickButton" Grid.Column="1" Classes="modal-secondary" Content="▾" Tag="to" MinWidth="44"
                      HorizontalContentAlignment="Center" Margin="6,0,0,0" Padding="12,4" IsVisible="False" Click="PickPlace_Click"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="4">
            <TextBlock Classes="field" Text="{DynamicResource warehouse.transferResponsible}"/>
            <TextBox x:Name="ResponsibleBox" LostFocus="Field_Changed"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
            <TextBlock Classes="field" Text="{DynamicResource warehouse.transferCarrier}"/>
            <TextBox x:Name="CarrierBox" LostFocus="Field_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
            <TextBlock Classes="field" Text="{DynamicResource warehouse.transferTracking}"/>
            <TextBox x:Name="TrackingBox" LostFocus="Field_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,10,0,0">
            <TextBlock Classes="field" Text="{DynamicResource warehouse.transferWeight}"/>
            <!-- Вес вписывают руками, с весов или из накладной перевозчика: вес каждой строки
                 в карточке товара почти никогда не заполнен, и автоподсчёт давал ноль. -->
            <TextBox x:Name="WeightBox" LostFocus="Field_Changed" Watermark="{DynamicResource loc.kassa.transfer.weightWatermark}"/>
          </StackPanel>

          <TextBlock x:Name="BranchHint" Grid.Row="2" Grid.ColumnSpan="5" Margin="0,10,0,0" FontSize="12.5"
                     TextWrapping="Wrap" IsVisible="False" Foreground="{DynamicResource BrushTextSoft}"/>
        </Grid>
      </Border>

      <!-- Состав, хронология и документы -->
      <TabControl Grid.Row="2">
        <TabItem Header="{DynamicResource warehouse.transferContent}">
          <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
            <!-- 2026-10-22 (модалки, пакет 3): ряд переносится на узком экране (910 px) вместо обрезки; «Добавить» — обводкой
                 (жёлтая в окне — только кнопка шага внизу). -->
            <WrapPanel x:Name="ItemEditPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
              <WrapPanel.Styles>
                <Style Selector="WrapPanel#ItemEditPanel > :is(Control)"><Setter Property="Margin" Value="0,0,8,6"/></Style>
              </WrapPanel.Styles>
              <!-- Три пути добавить товар, и все нужны: отсканировать (поле принимает скан как
                   обычный ввод и срабатывает по Enter), набрать пару букв названия и выбрать из
                   подсказок, либо открыть весь каталог списком. -->
              <!-- Весь ряд выключается у принятого или отменённого документа (ItemEditPanel). -->
              <TextBox x:Name="ItemSearchBox" Width="320"
                       Watermark="{DynamicResource warehouse.transferAddHint}"
                       TextChanged="ItemSearch_TextChanged"
                       KeyDown="ItemSearch_KeyDown"/>
              <TextBox x:Name="ItemQuantityBox" Width="90" Text="1"/>
              <Button Classes="modal-secondary" Content="{DynamicResource warehouse.transferAddItem}"
                      Click="AddItem_Click"/>
              <Button Classes="modal-secondary" Content="{DynamicResource warehouse.transferPickFromList}"
                      Click="PickFromList_Click"/>
              <Button Classes="modal-secondary" Content="{DynamicResource warehouse.transferRemoveItem}"
                      Click="RemoveItem_Click"/>
            </WrapPanel>

            <!-- Подсказки живого поиска. Показываются только пока в поле что-то набрано:
                 постоянный список занимал бы место у самого состава партии. -->
            <Border Grid.Row="1" x:Name="SuggestionsBox" IsVisible="False"
                    Margin="0,0,0,8" Padding="4"
                    Background="{DynamicResource BrushPanelSoft}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="8">
              <ItemsControl x:Name="SuggestionsPanel">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="modal-secondary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,1"
                            Padding="10,6"
                            MinHeight="44"
                            Tag="{Binding}"
                            Click="Suggestion_Click">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Barcode}" Margin="12,0"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSoft}"/>
                        <TextBlock Grid.Column="2" Text="{Binding StockInfo}"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSoft}"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <DataGrid Grid.Row="2" x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource common.name}" Width="*" Binding="{ReflectionBinding ProductName}"/>
                <DataGridTextColumn Header="{DynamicResource warehouse.colCode}" Width="110" Binding="{ReflectionBinding Article}"/>
                <DataGridTextColumn Header="{DynamicResource csh.catalog.colBarcode}" Width="160" Binding="{ReflectionBinding Barcode}"/>
                <DataGridTextColumn Header="{DynamicResource warehouse.movementsQuantity}" Width="130" Binding="{ReflectionBinding QuantityText}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="{DynamicResource warehouse.transferHistory}">
          <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" Margin="0,10,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource warehouse.movementsWhen}" Width="170" Binding="{ReflectionBinding WhenText}"/>
              <DataGridTextColumn Header="{DynamicResource warehouse.transferStatus}" Width="180" Binding="{ReflectionBinding StatusText}"/>
              <DataGridTextColumn Header="{DynamicResource warehouse.transferEmployee}" Width="220" Binding="{ReflectionBinding EmployeeText}"/>
              <DataGridTextColumn Header="{DynamicResource warehouse.movementsNote}" Width="*" Binding="{ReflectionBinding Note}"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <TabItem Header="{DynamicResource warehouse.transferFiles}">
          <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
            <!-- 2026-10-31: «Создать документ» — касса сама формирует накладную / акт / транспортный документ из данных перемещения
                 (StockTransferDialog.Documents). Подписи кнопок и флажков — из кода (Tr.T на 5 языков). -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
              <WrapPanel Orientation="Horizontal">
                <ComboBox x:Name="FileKindBox" Width="190" Margin="0,0,6,6"/>
                <Button x:Name="CreateDocButton" Classes="modal-primary" Margin="0,0,6,6" Padding="10,8" Click="CreateDoc_Click"/>
                <Button x:Name="AttachButton" Classes="modal-secondary" Margin="0,0,6,6" Padding="10,8" Content="{DynamicResource warehouse.transferAttach}"
                        Click="Attach_Click"/>
                <Button Classes="modal-secondary" Margin="0,0,6,6" Padding="10,8" Content="{DynamicResource warehouse.transferOpenFile}"
                        Click="OpenFile_Click"/>
                <Button x:Name="PrintDocButton" Classes="modal-secondary" Margin="0,0,6,6" Padding="10,8" Click="PrintDoc_Click"/>
                <Button Classes="modal-secondary" Margin="0,0,6,6" Padding="10,8" Content="Word" Click="DocWord_Click"/>
                <Button Classes="modal-secondary" Margin="0,0,6,6" Padding="10,8" Content="Excel" Click="DocExcel_Click"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <CheckBox x:Name="AutoWaybillCheck" Click="AutoDocs_Click"/>
                <CheckBox x:Name="AutoOtherCheck" Click="AutoDocs_Click"/>
              </StackPanel>
              <TextBlock x:Name="DocStatusText" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
            </StackPanel>
            <DataGrid Grid.Row="1" x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource common.name}" Width="*" Binding="{ReflectionBinding FileName}"/>
                <DataGridTextColumn Header="{DynamicResource warehouse.transferFileKind}" Width="220" Binding="{ReflectionBinding KindText}"/>
                <DataGridTextColumn Header="{DynamicResource warehouse.movementsWhen}" Width="170" Binding="{ReflectionBinding WhenText}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>

      <!-- 2026-10-22 (модалки, пакет 3): предупреждения («добавьте товары», «чего не хватает на складе») — текстом над
           кнопками, а не всплывающим окном. -->
      <Border Grid.Row="3" x:Name="WarningBox" IsVisible="False" Margin="0,12,0,0" Padding="12,10"
              CornerRadius="10" Background="{DynamicResource BrushDangerSoft}">
        <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="WarningText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushDangerOnSoft}"/>
        </ScrollViewer>
      </Border>
    </Grid>
  </dlg:ModalShell>
</Window>
