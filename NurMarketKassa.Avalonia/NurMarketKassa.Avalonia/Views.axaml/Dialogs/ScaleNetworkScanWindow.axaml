<!-- 2026-09-28: «Поиск весов в сети» — просьба владельца «анализ ip адресов добавь чтобы узнать ip адрес подключенных весов». Пинг + ARP-таблица + проверка портов весов в локальной подсети этого компьютера. Строки таблицы строятся в коде. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ScaleNetworkScanWindow"
        x:CompileBindings="False"
        Width="1280" Height="760" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource BrushPanel}">

  <Window.Styles>
    <Style Selector="Button.btn-ok">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource BrushDialogPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="TabControl.scaletabs TabItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
  </Window.Styles>

  <!-- 2026-09-28: строка 2 — «чужие» подсети (просьба владельца «проверка всех подсетей при поиске ip адреса весов даже если комп стоит статичный ip адрес»): своя подсеть/диапазон и временный второй адрес ПК. -->
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
      <TextBlock x:Name="IntroText" Classes="hint"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <TextBlock x:Name="SubnetLabel" Classes="label" Margin="0,0,10,0"/>
      <ComboBox Grid.Column="1" x:Name="SubnetBox" HorizontalAlignment="Stretch" MinHeight="34"/>
      <Button Grid.Column="2" x:Name="StartButton" Classes="btn-primary" Margin="10,0,0,0" Click="Start_Click"/>
    </Grid>

    <Border Grid.Row="2" x:Name="ForeignPanel" Classes="card" Padding="12,10" Margin="0,0,0,8" IsVisible="False">
      <StackPanel Spacing="8">
        <TextBlock x:Name="ForeignInfoText" Classes="hint"/>
        <Grid x:Name="CustomRangeRow" ColumnDefinitions="Auto,*" IsVisible="False">
          <TextBlock x:Name="CustomRangeLabel" Classes="label" Margin="0,0,10,0"/>
          <TextBox Grid.Column="1" x:Name="CustomRangeBox" Watermark="192.168.5.0/24 · 192.168.5.10-192.168.5.60"/>
        </Grid>
        <CheckBox x:Name="TempAddressBox"/>
        <Grid x:Name="TempRow" ColumnDefinitions="Auto,*,Auto,190" IsVisible="False">
          <TextBlock x:Name="AdapterLabel" Classes="label" Margin="0,0,10,0"/>
          <ComboBox Grid.Column="1" x:Name="AdapterBox" HorizontalAlignment="Stretch" MinHeight="32"/>
          <TextBlock Grid.Column="2" x:Name="TempIpLabel" Classes="label" Margin="14,0,10,0"/>
          <TextBox Grid.Column="3" x:Name="TempIpBox"/>
        </Grid>
        <TextBlock x:Name="TempNote" Classes="hint" IsVisible="False"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,8">
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="6" IsVisible="False"/>
      <TextBlock x:Name="ProgressText" Classes="hint"/>
      <TextBlock x:Name="SubnetNote" Classes="hint" IsVisible="False"/>
    </StackPanel>

    <Border Grid.Row="4" Classes="card" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <Border x:Name="HeaderHost" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushBorder}"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="RowsPanel" Margin="12,4"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <Border x:Name="ResultBorder" CornerRadius="8" Padding="10,8" BorderThickness="1"
              Background="{DynamicResource BrushSurfaceSubtle}" BorderBrush="{DynamicResource BrushBorder}">
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource BrushText}"/>
      </Border>
      <Button Grid.Column="1" Classes="btn-ok" Margin="10,0,0,0" VerticalAlignment="Center"
              Content="{DynamicResource common.close}" Click="Close_Click"/>
    </Grid>
  </Grid>
</Window>
