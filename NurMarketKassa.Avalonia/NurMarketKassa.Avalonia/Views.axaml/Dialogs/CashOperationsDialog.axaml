<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CashOperationsDialog"
        Title="{DynamicResource cashOps.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-22 (модалки, пакет 2): общая оболочка ModalShell 512 вместо своей рамки 480 с цветами кнопок вручную.
       Доступна только та операция, что подходит к состоянию смены (открыта — «Закрыть смену», закрыта — «Открыть смену»);
       она жёлтая, вторая выключена. Пока идёт открытие/закрытие, второе нажатие ничего не делает, окно не закрывается. -->
  <dlg:ModalShell x:Name="Shell" Margin="16"
                  Title="{DynamicResource cashOps.title}"
                  Subtitle="{DynamicResource cashOps.subtitle}">
    <dlg:ModalShell.Footer>
      <Button IsCancel="True" Content="{DynamicResource common.close}"
              Classes="modal-cancel" MaxWidth="200"
              Click="Close_Click"/>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="10">
      <TextBlock x:Name="StateText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushText}" IsVisible="False"/>
      <Button x:Name="OpenShiftButton" Content="{DynamicResource csh.toolbar.openShift}"
              Classes="modal-primary" HorizontalAlignment="Stretch"
              Click="OpenShift_Click"/>
      <Button x:Name="CloseShiftButton" Content="{DynamicResource csh.toolbar.closeShift}"
              Classes="modal-secondary" HorizontalAlignment="Stretch"
              Click="CloseShift_Click"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
