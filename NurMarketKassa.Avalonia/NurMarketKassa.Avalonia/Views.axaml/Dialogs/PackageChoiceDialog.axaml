<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PackageChoiceDialog"
        Title="Как добавить в корзину?"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI, Inter, sans-serif"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <Style Selector="RadioButton.PackageOption">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 2026-10-17, этап 3: выбранная строка — тёмная рамка (цвет текста темы) и светло-жёлтый фон, как
             строки списков в макетах; рамка толще ровно на столько, на сколько меньше отступ — не прыгает. -->
        <Style Selector="RadioButton.PackageOption:checked">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — товар и остаток в шапке
         (тексты — в коде), ✕ = Esc = «Отмена» на обоих шагах (как прежний ✕). Внизу справа «Отмена» и главная
         («Далее» на шаге 1, «Добавить» на шаге 2), «Назад» — слева внизу на шаге 2. Шаги переключает код
         (Step1Panel/Step2Panel), кнопки следуют за ними привязкой. Enter/стрелки — прежний обработчик окна. -->
    <dlg:ModalShell x:Name="Shell" Margin="16">
        <dlg:ModalShell.Hint>
            <Button x:Name="BackButton" Classes="modal-secondary" MaxWidth="200" FontSize="14"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding #Step2Panel.IsVisible}"
                    Click="Back_Click"/>
        </dlg:ModalShell.Hint>
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CancelButton" IsCancel="True"
                        Classes="modal-cancel" MaxWidth="200"
                        Click="Cancel_Click"/>
                <Button x:Name="NextButton"
                        Classes="modal-primary" MaxWidth="200"
                        IsVisible="{Binding #Step1Panel.IsVisible}"
                        Click="Next_Click"/>
                <Button x:Name="OkButton"
                        Classes="modal-primary" MaxWidth="200"
                        IsVisible="{Binding #Step2Panel.IsVisible}"
                        Click="Ok_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <StackPanel>
            <!-- Шаг 1: выбор способа продажи -->
            <StackPanel x:Name="Step1Panel" Spacing="12">
                <TextBlock x:Name="QuestionText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextMuted}"/>

                <StackPanel Spacing="8">
                    <RadioButton x:Name="WholePackOption" GroupName="PkgMode" Classes="PackageOption" IsChecked="True" Checked="Option_Checked">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="WholePackTitle" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock x:Name="WholePackSubtitle" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="PieceOption" GroupName="PkgMode" Classes="PackageOption" Checked="Option_Checked">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="PieceTitle" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock x:Name="PieceSubtitle" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>

            <!-- Шаг 2: количество и живой расчёт цены -->
            <StackPanel x:Name="Step2Panel" Spacing="10" IsVisible="False">
                <TextBlock x:Name="QuantityLabel" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextMuted}"/>

                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox x:Name="QuantityBox" Grid.Column="0"
                             Height="46"
                             Padding="12,8"
                             FontSize="18"
                             FontWeight="Bold"
                             CornerRadius="10"
                             BorderBrush="{DynamicResource BrushBorder}"
                             BorderThickness="1.5"
                             Background="{DynamicResource BrushPanel}"
                             VerticalContentAlignment="Center"
                             TextChanged="QuantityBox_TextChanged"
                             KeyDown="QuantityBox_KeyDown"/>
                    <TextBlock x:Name="QuantityUnitText" Grid.Column="2" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="PriceCalcText" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}"/>
                <TextBlock x:Name="AvailableText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
        </StackPanel>
    </dlg:ModalShell>
</Window>
