<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PaymentConfirmationDialog"
        Title="{DynamicResource dialog.confirmTitle}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <!-- 2026-10-22 (модалки, пакет 1): общая оболочка ModalShell 512 вместо своей Border 440 без шапки и ✕. Кнопки —
       глаголы: слева «Отмена» (обводка, Esc и ✕), справа одна главная «Провести оплату» (Enter). Тексты — в коде
       (5 языков). Enter сканера (серия быстрых клавиш) оплату не подтверждает — см. OnScannerGuardTunnel. -->
  <dlg:ModalShell x:Name="Shell" Margin="16" Title="{DynamicResource paymentConfirm.message}">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="NoButton" IsCancel="True" Classes="modal-cancel" MaxWidth="200"
                Click="NoButton_Click"/>
        <Button x:Name="YesButton" IsDefault="True" Classes="modal-primary" MaxWidth="240"
                Click="YesButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>
    <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap"
               Foreground="{DynamicResource BrushTextSoft}"/>
  </dlg:ModalShell>
</Window>
