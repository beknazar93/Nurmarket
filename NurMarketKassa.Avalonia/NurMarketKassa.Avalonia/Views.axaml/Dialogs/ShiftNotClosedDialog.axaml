<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ShiftNotClosedDialog"
        Title="{DynamicResource shiftNotClosed.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-17, редизайн (этап 3): общая оболочка ModalShell, карточка 480 — заголовок и ✕ сверху
       (✕ = Esc = «Отмена»), «Отмена» (обводка) и «Закрыть смену» (акцент темы, Enter) снизу справа;
       третье действие «Только выйти» — кнопкой с обводкой под текстом. Результаты окна прежние. -->
  <dlg:ModalShell Margin="16"
                  Title="{DynamicResource shiftNotClosed.title}"
                  Hint="{DynamicResource modal.hintEnter}">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button IsCancel="True"
                Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.cancel}"
                Click="CancelButton_Click"/>
        <!-- Надпись «Закрыть смену» вместо голого «Закрыть» (макет MShift): та же кнопка, тот же результат. -->
        <Button Classes="modal-primary" MaxWidth="200"
                Content="{DynamicResource csh.toolbar.closeShift}"
                IsDefault="True"
                Click="CloseShiftButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="16">
      <TextBlock Text="{DynamicResource shiftNotClosed.message}"
                 FontSize="14" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"/>

      <Button Classes="modal-secondary"
              Content="{DynamicResource shiftNotClosed.logoutOnly}"
              HorizontalAlignment="Stretch"
              Click="LogoutOnlyButton_Click"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
