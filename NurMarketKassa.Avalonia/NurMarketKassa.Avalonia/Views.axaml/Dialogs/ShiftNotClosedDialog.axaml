<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ShiftNotClosedDialog"
        Title="{DynamicResource shiftNotClosed.title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <Border Margin="16" CornerRadius="{DynamicResource SettingsCardRadius}"
          Background="{DynamicResource BrushDialogPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">
    <StackPanel HorizontalAlignment="Stretch">

      <!-- Заголовок отцентрирован -->
      <TextBlock Text="{DynamicResource shiftNotClosed.title}"
                 FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Margin="0,0,0,12"/>

      <!-- Текст предупреждения отцентрирован -->
      <TextBlock Text="{DynamicResource shiftNotClosed.message}"
                 FontSize="14" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Margin="0,0,0,22"/>

      <!-- Кнопки управления -->
      <StackPanel Spacing="10">
        <Button Content="{DynamicResource shiftNotClosed.logoutOnly}"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BrushPanel}"
                Foreground="{DynamicResource BrushText}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1.5"
                FontWeight="SemiBold"
                CornerRadius="10"
                Cursor="Hand"
                Click="LogoutOnlyButton_Click"/>

        <Grid ColumnDefinitions="*,12,*">
          <Button IsCancel="True" Grid.Column="0"
                  Content="{DynamicResource common.cancel}"
                  Height="46"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Background="{DynamicResource BrushPanel}"
                  Foreground="{DynamicResource BrushText}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1.5"
                  FontWeight="SemiBold"
                  CornerRadius="10"
                  Cursor="Hand"
                  Click="CancelButton_Click"/>

          <Button Grid.Column="2"
                  Content="{DynamicResource common.close}"
                  Height="46"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Background="{DynamicResource BrushAccent}"
                  Foreground="{DynamicResource BrushAccentForeground}"
                  FontWeight="SemiBold"
                  CornerRadius="10"
                  IsDefault="True"
                  Cursor="Hand"
                  Click="CloseShiftButton_Click"/>
        </Grid>
      </StackPanel>

    </StackPanel>
  </Border>
</Window>