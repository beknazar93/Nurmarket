<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.MigrateToOfflineDialog"
        Title="{DynamicResource migrateOffline.title}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <!-- 2026-10-22 (модалки, пакет 2): общая оболочка ModalShell 512 (была своя рамка 460 без ✕ и без прокрутки):
       тело прокручивается, подвал закреплён; фокус в поле ключа; поля 46 px; пока идёт перенос — Esc/✕ не закрывают. -->
  <dlg:ModalShell x:Name="Shell" Margin="16"
                  Title="{DynamicResource migrateOffline.title}"
                  Subtitle="{DynamicResource migrateOffline.message}"
                  InitialFocus="KeyBox">
    <dlg:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button IsCancel="True" x:Name="CancelButton"
                Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.cancel}"
                Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton"
                Classes="modal-primary" MaxWidth="220"
                Content="{DynamicResource migrateOffline.startButton}"
                IsDefault="True"
                Click="ConfirmButton_Click"/>
      </StackPanel>
    </dlg:ModalShell.Footer>

    <StackPanel Spacing="8">
      <StackPanel x:Name="FormPanel" Spacing="8">
        <TextBlock Text="{DynamicResource login.autonomous.keyLabel}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSoft}"/>
        <TextBox x:Name="KeyBox"
                 Watermark="{DynamicResource login.autonomous.keyWatermark}"
                 Height="46" FontSize="15" VerticalContentAlignment="Center"/>

        <TextBlock Text="{DynamicResource migrateOffline.newLoginLabel}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSoft}" Margin="0,8,0,0"/>
        <TextBox x:Name="EmailBox"
                 Watermark="{DynamicResource csh.login.email}"
                 Height="46" FontSize="15" VerticalContentAlignment="Center"/>
        <TextBox x:Name="PasswordBox"
                 PasswordChar="•"
                 Watermark="{DynamicResource csh.login.passwordWatermark}"
                 Height="46" FontSize="15" VerticalContentAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 FontSize="13" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"
                 IsVisible="False"/>

      <TextBlock x:Name="ErrorText"
                 FontSize="13"
                 Foreground="{DynamicResource BrushDangerOnSoft}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>
    </StackPanel>
  </dlg:ModalShell>
</Window>
