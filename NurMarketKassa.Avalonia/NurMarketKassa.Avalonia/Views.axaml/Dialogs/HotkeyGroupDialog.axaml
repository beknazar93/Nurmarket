<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.HotkeyGroupDialog"
        x:CompileBindings="False"
        Title="{DynamicResource hotkeyGroup.title}"
        Width="912" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-11-06: В6 (хвост модалок) — общая оболочка ModalShell вместо своей рамки: шапка с ✕ 44 px и «Закрыть» закреплены, тело прокручивается;
       кнопка «Закрыть» — стандартная modal-cancel (была SecondaryButton). Esc и F-клавиши — прежний обработчик OnDialogKeyDown. -->
  <dlg:ModalShell x:Name="Shell" Margin="16" ContentScroll="Disabled">
    <dlg:ModalShell.Footer>
      <Button IsCancel="True" Classes="modal-cancel" Content="{DynamicResource common.close}" Click="Close_Click"/>
    </dlg:ModalShell.Footer>
    <Grid RowDefinitions="Auto,*">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
        <Border Grid.Column="0" CornerRadius="8" Padding="12,5" VerticalAlignment="Center"
                Background="{DynamicResource BrushAccentSoft}">
          <TextBlock x:Name="GroupKeyText" FontSize="17" FontWeight="Bold"
                     Foreground="{DynamicResource BrushAccentStrong}"/>
        </Border>
        <TextBlock Grid.Column="1" x:Name="HintText" Margin="12,0,0,0" VerticalAlignment="Center"
                   FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextSoft}"/>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ProductsPanel">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- Плитка такая же, как в каталоге кассы: фото сверху, название в середине,
                   цена и остаток внизу. Продавец узнаёт товар тем же взглядом, что и слева
                   на экране, — иначе модальное окно пришлось бы «читать» заново. -->
              <Button Width="{DynamicResource CatalogTileWidth}"
                      Height="{DynamicResource CatalogTileHeight}"
                      Margin="6" Padding="12,10"
                      Cursor="Hand"
                      Background="{DynamicResource BrushCatalogTileBg}"
                      BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource SettingsCardRadius}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Tag="{Binding}"
                      Click="Product_Click">
                <Grid RowDefinitions="Auto,*,Auto">
                  <Border Grid.Row="0"
                          Height="{DynamicResource CatalogTilePhotoHeight}"
                          MaxWidth="140"
                          Margin="0,0,0,8"
                          CornerRadius="10"
                          ClipToBounds="True"
                          HorizontalAlignment="Center"
                          IsVisible="{Binding ProductImagePath, Converter={x:Static conv:ShowProductPhotoConverter.Instance}}">
                    <Image Source="{Binding ProductImagePath, Converter={x:Static conv:AssetPathToBitmapConverter.Instance}, ConverterParameter=thumb}"
                           Stretch="UniformToFill"/>
                  </Border>

                  <TextBlock Grid.Row="1"
                             Text="{Binding Title}"
                             FontSize="{DynamicResource CatalogTileNameSize}"
                             FontWeight="SemiBold"
                             TextAlignment="Center"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource BrushText}"/>

                  <StackPanel Grid.Row="2" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}, ConverterParameter=som}"
                               FontSize="{DynamicResource CatalogTilePriceSize}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource BrushCatalogPrice}"/>
                    <TextBlock Text="{Binding StockInfo}"
                               FontSize="{DynamicResource CatalogTileStockSize}"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource BrushCatalogStock}"/>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </dlg:ModalShell>
</Window>
