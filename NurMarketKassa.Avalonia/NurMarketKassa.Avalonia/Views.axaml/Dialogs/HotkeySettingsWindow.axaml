<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.HotkeySettingsWindow"
        x:DataType="local:HotkeySettingsWindow"
        Title="{DynamicResource hotkeys.title}"
        Width="792" Height="650"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        CanResize="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- 2026-10-24 (аудит круга 8, С-7, пакет П-10): окно переведено на общую оболочку ModalShell (карточка 760) —
       шапка «Горячие клавиши кассы» с подзаголовком и ✕ 44 px, внизу «По умолчанию» слева, «Отмена» (Esc, ✕) и
       «Сохранить» (Enter) справа, кнопки 46 px. Свои заголовок/✕/«Свернуть» убраны. Логика назначения клавиш
       (OnGestureKeyDown, Save/Reset) не менялась; список прокручивается сам, поле ошибки — под списком. -->
  <local:ModalShell x:Name="Shell" Margin="16" Title="{DynamicResource hotkeys.header}"
                    Subtitle="{DynamicResource hotkeys.instructions}" ContentScroll="Disabled">
    <local:ModalShell.Hint>
      <Button Classes="modal-secondary" MaxWidth="240" HorizontalAlignment="Left"
              Content="{DynamicResource hotkeys.resetDefault}" Click="Reset_Click"/>
    </local:ModalShell.Hint>
    <local:ModalShell.Footer>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button IsCancel="True" Classes="modal-cancel" MaxWidth="200"
                Content="{DynamicResource common.cancel}" Click="Cancel_Click"/>
        <Button IsDefault="True" Classes="modal-primary" MaxWidth="220"
                Content="{DynamicResource common.save}" Click="Save_Click"/>
      </StackPanel>
    </local:ModalShell.Footer>

    <Grid RowDefinitions="*,Auto">
      <Border Grid.Row="0" Background="{DynamicResource BrushPanel}"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
              CornerRadius="16" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:HotkeyRow">
                <Grid ColumnDefinitions="*,220" Margin="12,8">
                  <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBox Grid.Column="1" Classes="modal-field" Text="{Binding Display, Mode=OneWay}" Tag="{Binding Action}"
                           IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                           FontSize="16" FontWeight="Bold" Watermark="{DynamicResource hotkeys.pressKeysWatermark}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock Grid.Row="1" Text="{Binding ErrorText}" Foreground="{DynamicResource BrushDanger}"
                 TextWrapping="Wrap" Margin="0,10,0,0"
                 IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>
  </local:ModalShell>
</Window>
