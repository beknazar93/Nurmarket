<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PosConfirmDialog"
        Title="{DynamicResource dialog.confirmTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">
  <Border Margin="16" CornerRadius="{DynamicResource SettingsCardRadius}"
          Background="{DynamicResource BrushDialogPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">
    <StackPanel>
      <TextBlock x:Name="TitleText"
                 FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"
                 Margin="0,0,0,12"/>
      <!-- Длинный текст прокручивается, а кнопки остаются на виду. 2026-09-24, живой случай:
           при откате сюда подставляется описание версии целиком, и окно уходило за край экрана
           вместе с кнопками «Да / Нет». -->
      <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,22">
        <TextBlock x:Name="MessageText"
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextSoft}"/>
      </ScrollViewer>
      <Grid ColumnDefinitions="*,12,*">
        <Button IsCancel="True" x:Name="CancelButton"
                Grid.Column="0"
                Content="{DynamicResource common.no}"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource BrushPanel}"
                Foreground="{DynamicResource BrushText}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1.5"
                FontWeight="SemiBold"
                CornerRadius="10"
                Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton"
                Grid.Column="2"
                Content="{DynamicResource common.yes}"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource BrushAccent}"
                Foreground="{DynamicResource BrushAccentForeground}"
                FontWeight="SemiBold"
                CornerRadius="10"
                IsDefault="True"
                Click="ConfirmButton_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
