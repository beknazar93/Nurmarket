<!-- 2026-09-28: «Настройки весов Штрих-ПРИНТ» — по просьбе владельца перенесены в кассу
     настройки тестовой программы Штрих-М («Тест драйвера весов "ШТРИХ-ПРИНТ"»): вкладка
     «Клавиатура» целиком и полезные магазину параметры остальных вкладок. Связь — те же IP,
     порт и пароль, что в Настройки → Весы. Содержимое вкладок строится в коде (однотипные
     строки «подпись — значение»), здесь только каркас окна. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ShtrikhScaleSettingsWindow"
        x:CompileBindings="False"
        Title="{DynamicResource loc.settings.shtrikhSettings.title}"
        Width="820" Height="720" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource BrushPanel}"
        Opened="Window_Opened">

  <Window.Styles>
    <!-- 2026-11-13 (Д-7, согласие владельца 13.11): окна весов — в общий вид. Кнопки — общие nur-primary / nur-secondary (PosDialogStyles.axaml),
         местные описания btn-ok / btn-primary удалены; шрифты, радиусы и высоты — из шкалы Д-8 (App.axaml: NurFont…, NurRadius…, NurHeight…). -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource BrushDialogPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource NurRadiusCard}"/>
      <Setter Property="Padding" Value="{DynamicResource NurPadCard}"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="{DynamicResource NurFontSubtitle}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{DynamicResource NurFontCaption}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource NurFontBody}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource NurRadiusControl}"/>
      <Setter Property="MinHeight" Value="{DynamicResource NurHeightControl}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="{DynamicResource NurHeightControl}"/>
    </Style>
    <Style Selector="TabControl.scaletabs TabItem">
      <Setter Property="FontSize" Value="{DynamicResource NurFontBody}"/>
      <Setter Property="MinHeight" Value="{DynamicResource NurHeightControl}"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
  </Window.Styles>

  <Grid Margin="{DynamicResource NurPadCard}" RowDefinitions="Auto,Auto,*,Auto">
    <!-- Шапка: чьи весы. 2026-11-13 (Н-3): «Проверить связь» — шаг 2 «Быстрой настройки»; подробная проверка — во вкладке «Для мастера». -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{DynamicResource loc.settings.shtrikhSettings.title}" FontSize="{DynamicResource NurFontTitle}" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"/>
      <TextBlock x:Name="ConnectionText" Classes="hint"/>
    </StackPanel>

    <TextBlock Grid.Row="1" x:Name="IntroText" Classes="label" Margin="0,0,0,8"/>

    <!-- 2026-11-13 (Д-7 + Н-3, согласие владельца 13.11): было 9 вкладок — стало 5: «Быстрая настройка» (три шага) / «Этикетка и печать»
         (печать, «Валюта» и «Макет этикетки») / «Штрих-код» (третья) / «Клавиши» / «Для мастера» (состояние, система, товары, тексты).
         Панели и их содержимое те же (строятся в коде) — сменилась только раскладка. -->
    <TabControl Grid.Row="2" x:Name="Tabs" Classes="scaletabs">
      <TabItem x:Name="QuickTab">
        <ScrollViewer x:Name="QuickHost"/>
      </TabItem>
      <TabItem x:Name="PrintTab">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,10,8,10">
            <StackPanel x:Name="PrintPanel" Spacing="12"/>
            <StackPanel x:Name="LabelExtraPanel" Spacing="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="BarcodeTab">
        <ScrollViewer><StackPanel x:Name="BarcodePanel" Spacing="12" Margin="0,10,8,10"/></ScrollViewer>
      </TabItem>
      <TabItem x:Name="KeyboardTab">
        <ScrollViewer><StackPanel x:Name="KeyboardPanel" Spacing="12" Margin="0,10,8,10"/></ScrollViewer>
      </TabItem>
      <TabItem x:Name="MasterTab">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,10,8,10">
            <StackPanel x:Name="StatusPanel" Spacing="12"/>
            <StackPanel x:Name="SystemPanel" Spacing="12"/>
            <StackPanel x:Name="GoodsPanel" Spacing="12"/>
            <StackPanel x:Name="TextsPanel" Spacing="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Строка «Ответ весов» — как «Ошибка» внизу тестовой программы Штрих-М. -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <Border x:Name="ResultBorder" CornerRadius="{DynamicResource NurRadiusControl}" Padding="{DynamicResource NurPadButton}" MinHeight="{DynamicResource NurHeightControl}" BorderThickness="1"
              Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}">
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="{DynamicResource NurFontBody}" Foreground="{DynamicResource BrushText}"/>
      </Border>
      <!-- 2026-10-22 (модалки, пакет 3): Esc = «Закрыть» (IsCancel). -->
      <Button Grid.Column="1" x:Name="CloseButton" Classes="nur-secondary" Margin="10,0,0,0" VerticalAlignment="Center" IsCancel="True"
              Content="{DynamicResource common.close}" Click="Close_Click"/>
    </Grid>
  </Grid>
</Window>
