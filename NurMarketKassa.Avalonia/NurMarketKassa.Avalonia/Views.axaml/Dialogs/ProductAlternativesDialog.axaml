<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ProductAlternativesDialog"
        Title="{DynamicResource noStock.alternativesTitle}"
        Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <Style Selector="Button.alt-row">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.alt-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-22 (модалки, пакет 1): общая оболочка ModalShell 512 вместо своей Border 480 с MaxHeight 600 — шапка
         с ✕ (Esc), список прокручивается между шапкой и закреплённым подвалом; «Закрыть» 46 px обводкой (была 38 px).
         Главной жёлтой нет: действие — нажать на строку товара. -->
    <dlg:ModalShell Margin="16"
                    Title="{DynamicResource noStock.alternativesTitle}"
                    Subtitle="{DynamicResource noStock.alternativesSubtitle}">
        <dlg:ModalShell.Footer>
            <Button Content="{DynamicResource common.close}" Classes="modal-cancel"
                    IsCancel="True" Click="Close_Click"/>
        </dlg:ModalShell.Footer>
        <StackPanel Spacing="12">
            <ItemsControl x:Name="AlternativesList" x:CompileBindings="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="alt-row" Tag="{Binding}" Click="AlternativeRow_Click"
                                AutomationProperties.Name="{Binding Title}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Info}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextSoft}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}, ConverterParameter=som}" FontWeight="SemiBold" Margin="12,0,0,0"
                                           Foreground="{DynamicResource BrushAccentStrong}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource noStock.alternativesEmpty}"
                       IsVisible="False" Foreground="{DynamicResource BrushTextSoft}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </dlg:ModalShell>
</Window>
