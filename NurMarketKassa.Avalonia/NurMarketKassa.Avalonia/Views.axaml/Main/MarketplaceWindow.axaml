<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:NurMarketKassa.AvaloniaHost.Views.Settings"
        x:Class="NurMarketKassa.AvaloniaHost.Views.MarketplaceWindow"
        x:CompileBindings="False"
        Title="{DynamicResource posSettings.navMarketplace}"
        Height="820" Width="1000" MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource BrushPanel}">

    <Window.Styles>
        <!-- 2026-10-19, этап О7: «Закрыть» — обводкой (была серая). -->
        <!-- 2026-11-13 (Д-1): местные описания кнопок удалены — вид один на всю программу (nur-primary / nur-secondary и их псевдонимы, PosDialogStyles.axaml). -->
    </Window.Styles>

    <DockPanel>
        <Border x:Name="WindowHeader" DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource BrushPanelElevated}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{DynamicResource posSettings.navMarketplace}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                    <TextBlock Text="{DynamicResource marketplace.subtitle}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>
                <Button IsCancel="True" Grid.Column="1" Content="{DynamicResource common.close}"
                        Classes="btn-secondary" Click="Close_Click"/>
            </Grid>
        </Border>

        <settings:MarketplaceView x:Name="MarketplaceContent"/>
    </DockPanel>
</Window>
