<Window x:Class="NurMarketKassa.AvaloniaHost.Views.ScalesPluWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        Title="{DynamicResource scalesPlu.title}"
        Height="700"
        Width="1180"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Styles>
        <Style Selector="Button.PrimaryActionButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SettingsButtonRadius}"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.SecondaryActionButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SettingsButtonRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="DataGrid.ModernGrid">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16" Background="{DynamicResource BrushPanel}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="{DynamicResource scalesPlu.title}"
                       FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- 2026-09-28: поиск весов в сети (анализ IP-адресов) и окно настроек выбранной марки. -->
                <Button Content="{DynamicResource loc.settings.scaleScan.open}" Classes="SecondaryActionButton"
                        Margin="0,0,8,0" Click="ScanNetwork_Click"/>
                <Button Content="{DynamicResource loc.settings.scaleBrandSettings.open}" Classes="SecondaryActionButton"
                        Margin="0,0,8,0" Click="BrandSettings_Click"/>
                <Button x:Name="ExportCsvButton" Content="{DynamicResource loc.owner.scales.exportCsv}" Classes="SecondaryActionButton"
                        Margin="0,0,8,0" Click="ExportCsv_Click"/>
                <Button Content="{DynamicResource common.refresh}" Classes="SecondaryActionButton"
                        Margin="0,0,10,0" Click="Refresh_Click"/>
                <Button IsCancel="True" Content="{DynamicResource common.close}" Classes="SecondaryActionButton" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="SubtitleText" Text="{DynamicResource scalesPlu.subtitle}"
                   Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
            <RadioButton x:Name="BrandShtrikhRadio" GroupName="ScaleBrand" IsChecked="True"
                         Content="{DynamicResource scalesPlu.brandShtrikh}" Click="BrandRadio_Click"/>
            <RadioButton x:Name="BrandRongtaRadio" GroupName="ScaleBrand"
                         Content="{DynamicResource scalesPlu.brandRongta}" Click="BrandRadio_Click"/>
            <RadioButton x:Name="BrandAiRadio" GroupName="ScaleBrand" Margin="16,0,0,0"
                         Content="{DynamicResource loc.owner.scales.brandAi}" Click="BrandRadio_Click"/>
            <!-- 2026-09-28: весы TM-30F (JHScale, серия TM-F/TM-xA) у владельца. Протокол закрыт —
                 как и для AI-весов, касса готовит файл для программы весов. -->
            <RadioButton x:Name="BrandTmRadio" GroupName="ScaleBrand"
                         Content="TM-30F (JHScale)" Click="BrandRadio_Click"/>
        </StackPanel>

        <Grid Grid.Row="3" x:Name="RongtaSourceRow" IsVisible="False" ColumnDefinitions="Auto,Auto,Auto,Auto"
              Margin="0,0,0,10">
            <RadioButton Grid.Column="0" x:Name="RongtaSourceSiteRadio" GroupName="RongtaSource" IsChecked="True"
                         Content="{DynamicResource scalesPlu.rongtaSourceSite}" Click="RongtaSourceRadio_Click"/>
            <RadioButton Grid.Column="1" x:Name="RongtaSourceServerRadio" GroupName="RongtaSource" Margin="16,0,0,0"
                         Content="{DynamicResource scalesPlu.rongtaSourceServer}" Click="RongtaSourceRadio_Click"/>
            <TextBlock Grid.Column="2" x:Name="RongtaPortLabel" Text="{DynamicResource scalesPlu.rongtaPortLabel}"
                       VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12"
                       Foreground="{DynamicResource BrushTextSoft}" IsVisible="False"/>
            <TextBox Grid.Column="3" x:Name="RongtaPortBox" Width="80" Text="5001" IsVisible="False"/>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,10">
            <Button Grid.Column="0" Content="{DynamicResource scalesPlu.selectAll}" Classes="SecondaryActionButton"
                    Margin="0,0,10,0" Click="SelectAll_Click"/>
            <Button Grid.Column="1" Content="{DynamicResource scalesPlu.selectNone}" Classes="SecondaryActionButton"
                    Margin="0,0,10,0" Click="SelectNone_Click"/>
            <!-- Поиск по весовым товарам (2026-09-28, просьба владельца). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" Width="240" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchCountText" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
            <!-- WrapPanel, а не StackPanel: в одну строку поля «Начальный PLU», галочка
                 «Напрямую по кабелю», IP, порт, пароль и кнопка «Проверить» не помещались —
                 на окне 900 px последние из них уезжали за правый край и были недоступны.
                 Теперь при нехватке ширины они переносятся на следующую строку. -->
            <WrapPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                       x:Name="PluStartRow">
                <TextBlock Text="{DynamicResource scalesPlu.pluStartLabel}" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource BrushTextSoft}" FontSize="12"/>
                <TextBox Margin="0,2,8,2" x:Name="PluStartBox" Width="70" Text="1"/>

                <CheckBox x:Name="SequentialPluCheck" Content="{DynamicResource loc.owner.scales.sequentialPlu}"
                          IsChecked="True"
                          Margin="12,2,0,2"
                          ToolTip.Tip="{DynamicResource loc.owner.scales.sequentialPluTip}"/>

                <CheckBox x:Name="DirectLanCheck" Content="{DynamicResource loc.owner.scales.directLan}"
                          VerticalAlignment="Center" Margin="16,0,0,0"
                          IsCheckedChanged="DirectLan_Changed"
                          ToolTip.Tip="{DynamicResource loc.owner.scales.directLanTip}"/>
                <Button x:Name="LanSettingsButton" Margin="8,2,0,2"
                        Content="{DynamicResource loc.owner.scales.lanSettings}"
                        Click="LanSettings_Click"
                        ToolTip.Tip="{DynamicResource loc.owner.scales.lanSettingsTip}"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="5">
            <DataGrid x:Name="ProductsGrid" Classes="ModernGrid" AutoGenerateColumns="False" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{ReflectionBinding IsSelected}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource scalesPlu.colName}" Width="*" Binding="{ReflectionBinding Name}"/>
                    <DataGridTextColumn Header="{DynamicResource scalesPlu.colPlu}" Width="90" Binding="{ReflectionBinding PluText}"/>
                    <!-- 2026-09-28: «Код в штрих-коде» — число, которое весы напечатают в ШК
                         этикетки (поле «Код товара» записи ПЛУ). Правится перед отправкой;
                         только для «Напрямую по кабелю» — серверный путь пишет код сам. -->
                    <DataGridTemplateColumn Tag="BarcodeCode" Header="{DynamicResource loc.owner.scales.colBarcodeCode}" Width="140" IsVisible="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{ReflectionBinding BarcodeCode, Mode=TwoWay}" MaxLength="6"
                                         VerticalAlignment="Center" Margin="4,2" LostFocus="BarcodeCode_LostFocus"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource warehouse.receivingUnit}" Width="70" Binding="{ReflectionBinding Unit}"/>
                    <DataGridTextColumn Header="{DynamicResource scalesPlu.colPrice}" Width="140" Binding="{ReflectionBinding PriceLine}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" IsVisible="False" Text="{DynamicResource scalesPlu.empty}"
                       Foreground="{DynamicResource BrushTextSoft}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <!-- 2026-09-28: живой пример весового штрих-кода, который ждёт касса. -->
                <TextBlock x:Name="BarcodeExampleText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushText}" IsVisible="False"/>
                <TextBlock x:Name="StatusText" FontSize="12"
                           Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 2026-09-28: штрих-код этикетки весов — пример и настройка (окно «Настройки весов
                 Штрих-ПРИНТ», вкладка «Штрих-код»). Здесь, а не в ряду над таблицей: там уже
                 нет места, и кнопка уезжала за правый край. -->
            <Button Grid.Column="1" x:Name="BarcodeSettingsButton" Classes="SecondaryActionButton"
                    Margin="12,0,10,0" VerticalAlignment="Center"
                    Content="{DynamicResource loc.owner.scales.barcodeSettings}"
                    Click="BarcodeSettings_Click"/>
            <Button Grid.Column="2" x:Name="SendButton" Content="{DynamicResource scalesPlu.sendButton}"
                    Classes="PrimaryActionButton" Padding="16,0" Click="Send_Click"/>
        </Grid>
    </Grid>
</Window>
