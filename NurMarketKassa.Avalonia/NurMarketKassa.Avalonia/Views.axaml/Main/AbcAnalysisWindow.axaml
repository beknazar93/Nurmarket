<Window x:Class="NurMarketKassa.AvaloniaHost.Views.AbcAnalysisWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:analytics="using:NurMarketKassa.AvaloniaHost.Views.Analytics"
        x:CompileBindings="False"
        Title="ABC"
        Height="820"
        Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBackdrop}"
        Loaded="Window_Loaded">

    <!-- 2026-10-18, этап О3 (правила аудита 1–2): свои стили Button.period / .accent / .active убраны. Период — сегменты
         (sec-seg; выбранный — класс active, тёмно-синий, как период «Сводки»; раньше — жёлтая заливка), «Обновить» — одна
         главная (sec-primary), Excel / Word / «Закрыть» — обводкой (sec-outline). Стили — PosDialogStyles.axaml. -->

    <Grid x:Name="RootGrid" Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Полоска загрузки, пока данные идут с сервера (2026-09-25, просьба владельца). -->
        <ProgressBar x:Name="LoadingBar" Grid.Row="0" Margin="0,-8,0,0" IsVisible="False" IsIndeterminate="True" Height="3" MinHeight="3" CornerRadius="2" VerticalAlignment="Top" IsHitTestVisible="False" ZIndex="100" Foreground="{DynamicResource BrushAccent}" Background="Transparent"/>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TitleText"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"
                           FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="ExcelButton" Content="Excel" Classes="sec-outline" Click="ExportExcel_Click"/>
                <Button x:Name="WordButton" Content="Word" Classes="sec-outline" Click="ExportWord_Click"/>
                <Button x:Name="RefreshButton" Classes="sec-primary" Click="Refresh_Click"/>
                <Button IsCancel="True" x:Name="CloseButton" Classes="sec-outline" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="sec-segment" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="TodayButton" Classes="sec-seg" Click="Today_Click"/>
                <Button x:Name="WeekButton" Classes="sec-seg" Click="Week_Click"/>
                <Button x:Name="MonthButton" Classes="sec-seg" Click="Month_Click"/>
                <Button x:Name="QuarterButton" Classes="sec-seg" Click="Quarter_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
            <CalendarDatePicker x:Name="FromPicker" Width="160" SelectedDateChanged="Period_Changed"/>
            <TextBlock Text="—" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSoft}"/>
            <CalendarDatePicker x:Name="ToPicker" Width="160" SelectedDateChanged="Period_Changed"/>
            <TextBlock x:Name="PeriodText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource BrushTextSoft}"/>
        </StackPanel>

        <analytics:AbcSectionView Grid.Row="3" x:Name="AbcSection"/>

        <Border Grid.Row="4" Margin="0,10,0,0" Padding="10"
                Background="{DynamicResource BrushDangerSoft}" CornerRadius="8"
                IsVisible="False" x:Name="ErrorBox">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
