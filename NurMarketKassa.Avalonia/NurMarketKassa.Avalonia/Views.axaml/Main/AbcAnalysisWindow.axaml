<Window x:Class="NurMarketKassa.AvaloniaHost.Views.AbcAnalysisWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:analytics="using:NurMarketKassa.AvaloniaHost.Views.Analytics"
        x:CompileBindings="False"
        Title="ABC"
        Height="820"
        Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindow}"
        Loaded="Window_Loaded">

    <Window.Styles>
        <Style Selector="Button.period">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TitleText"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock x:Name="SubtitleText"
                           FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExcelButton" Content="Excel" Classes="period" Click="ExportExcel_Click"/>
                <Button x:Name="WordButton" Content="Word" Classes="period" Click="ExportWord_Click"/>
                <Button x:Name="RefreshButton" Classes="period" Click="Refresh_Click"/>
                <Button x:Name="CloseButton" Classes="period" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="TodayButton" Classes="period" Click="Today_Click"/>
            <Button x:Name="WeekButton" Classes="period" Click="Week_Click"/>
            <Button x:Name="MonthButton" Classes="period" Click="Month_Click"/>
            <Button x:Name="QuarterButton" Classes="period" Click="Quarter_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
            <CalendarDatePicker x:Name="FromPicker" Width="160" SelectedDateChanged="Period_Changed"/>
            <TextBlock Text="—" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSoft}"/>
            <CalendarDatePicker x:Name="ToPicker" Width="160" SelectedDateChanged="Period_Changed"/>
            <TextBlock x:Name="PeriodText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource BrushTextSoft}"/>
        </StackPanel>

        <analytics:AbcSectionView Grid.Row="3" x:Name="AbcSection"/>

        <Border Grid.Row="4" Margin="0,10,0,0" Padding="10"
                Background="{DynamicResource BrushDangerSoft}" CornerRadius="8"
                IsVisible="False" x:Name="ErrorBox">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
