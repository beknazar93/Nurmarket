<Window x:Class="NurMarketKassa.AvaloniaHost.Views.LogsAndErrorsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        Title="{DynamicResource csh.menu.errorLogs}"
        Height="700"
        Width="1050"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Styles>
        <!-- 2026-11-13 (Д-1): местные описания кнопок удалены — вид один на всю программу (nur-primary / nur-secondary и их псевдонимы, PosDialogStyles.axaml). -->


        <Style Selector="DataGrid.ModernGrid">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Border.StatusBadge">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.StatusBadge TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.StatusBadge.warn">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.StatusBadge.warn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
        </Style>
        <Style Selector="Border.StatusBadge.error">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Border.StatusBadge.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
        </Style>
        <Style Selector="Border.StatusBadge.deferred">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        </Style>
        <Style Selector="Border.StatusBadge.deferred TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentStrong}"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" Margin="16" Background="{DynamicResource BrushPanel}" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" x:Name="HeaderGrid" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" x:Name="TitleText" Text="{DynamicResource csh.menu.errorLogs}"
                       FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- 2026-11-06: В6 Д4-25 — «Обновить» не главное действие: значок 40×40 с подсказкой, без жёлтой заливки. -->
                <Button x:Name="RefreshButton" Classes="SecondaryActionButton" Width="40" Height="40" Padding="0"
                        ToolTip.Tip="{DynamicResource common.refresh}" AutomationProperties.Name="{DynamicResource common.refresh}"
                        Margin="0,0,10,0" Click="Refresh_Click">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                </Button>
                <Button x:Name="OpenFolderButton" Content="{DynamicResource logs.openFolder}" Classes="SecondaryActionButton"
                        Margin="0,0,10,0" Click="OpenFolder_Click"/>
                <!-- 2026-10-01: журнал с компанией и логином — в Telegram-бот поддержки (SupportLogService). -->
                <Button x:Name="SendSupportButton" Classes="SecondaryActionButton"
                        Margin="0,0,10,0" Click="SendSupport_Click"/>
                <!-- 2026-11-13 (Л-12): сверка «касса ↔ сервер» по кнопке (то же, что раз в сутки в фоне); ничего не правит, только сообщает. -->
                <Button x:Name="ReconcileButton" Classes="SecondaryActionButton"
                        Margin="0,0,10,0" Click="Reconcile_Click"/>
                <Button IsCancel="True" x:Name="CloseButton" Content="{DynamicResource common.close}" Classes="SecondaryActionButton" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="SubtitleText" Text="{DynamicResource logs.subtitle}"
                   Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <DataGrid x:Name="LogGrid" Classes="ModernGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <!-- 2026-10-20 (живой аудит кассы, К18): «Время» обрезалось («13:36:3») и заголовок «Врем»; примечание — переносом
                         (до 3 строк, полный текст — во всплывающей подсказке). -->
                    <DataGridTextColumn Header="{DynamicResource common.date}" Width="110" MinWidth="96" Binding="{ReflectionBinding DateText}"/>
                    <DataGridTextColumn Header="{DynamicResource common.time}" Width="110" MinWidth="96" Binding="{ReflectionBinding TimeText}"/>
                    <DataGridTemplateColumn Header="{DynamicResource irregular.colStatus}" Width="170" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Classes="StatusBadge" Classes.warn="{ReflectionBinding IsWarning}"
                                        Classes.error="{ReflectionBinding IsError}" Classes.deferred="{ReflectionBinding IsDeferred}">
                                    <TextBlock Text="{ReflectionBinding LevelText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource irregular.colNote}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{ReflectionBinding Message}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="12,4" ToolTip.Tip="{ReflectionBinding Details}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" IsVisible="False" Text="{DynamicResource logs.empty}"
                       Foreground="{DynamicResource BrushTextSoft}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
