<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NurMarketKassa.AvaloniaHost.Controls"
        x:Class="NurMarketKassa.AvaloniaHost.Views.CrmWebViewWindow"
        Title="NurCRM"
        Width="1280" Height="840"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBackdrop}"
        FontFamily="Segoe UI">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" x:Name="ToolbarBorder"
                Background="{DynamicResource BrushWindowAlt}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <!-- 2026-10-21 (пакет 4, п. 130; аудит: «кнопки ← → ↻ серые без подписей»): кнопки — обводкой (sec-outline, как
                 в остальной программе; main-ghost здесь не подключён и Fluent красил их серым), со значком и подписью;
                 справа — «Открыть в браузере». У WhatsApp под кнопками — строка «зачем этот раздел и как войти». -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                <Button Grid.Column="0" Classes="sec-outline" Height="36" MinHeight="36" Padding="12,0"
                        ToolTip.Tip="{DynamicResource common.back}" Click="Back_Click"
                        AutomationProperties.Name="{DynamicResource common.back}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource common.back}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="sec-outline" Height="36" MinHeight="36" Padding="12,0"
                        Margin="8,0,0,0"
                        ToolTip.Tip="{DynamicResource common.forward}" Click="Forward_Click"
                        AutomationProperties.Name="{DynamicResource common.forward}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{DynamicResource common.forward}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="sec-outline" Height="36" MinHeight="36" Padding="12,0"
                        Margin="8,0,0,0"
                        ToolTip.Tip="{DynamicResource common.refresh}" Click="Reload_Click"
                        AutomationProperties.Name="{DynamicResource common.refresh}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource common.refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="3" x:Name="AddressLabel" Text="NurCRM — app.nurcrm.kg" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrushTextMuted}"/>
                <Button Grid.Column="4" x:Name="OpenInBrowserButton" Classes="sec-outline" Height="36" MinHeight="36" Padding="12,0"
                        Margin="8,0,0,0" Click="OpenInBrowser_Click"/>
                <Button IsCancel="True" Grid.Column="5" x:Name="CloseButton" Classes="sec-outline" Width="36" Height="36" MinHeight="36" Padding="0"
                        Margin="8,0,0,0"
                        ToolTip.Tip="{DynamicResource common.close}" Click="Close_Click"
                        AutomationProperties.Name="{DynamicResource common.close}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="6" x:Name="PurposeText" IsVisible="False" Margin="2,8,0,0"
                           FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSoft}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <controls:WebView2Host x:Name="WebHost"/>

            <Border x:Name="LoadingPanel"
                    Background="{DynamicResource BrushWindowBackdrop}"
                    IsVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock x:Name="LoadingText" Text="{DynamicResource crmWebView.loading}" FontSize="16"
                               Foreground="{DynamicResource BrushTextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel"
                    Background="{DynamicResource BrushWindowBackdrop}"
                    IsVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="480">
                    <TextBlock Text="{DynamicResource crmWebView.errorTitle}" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="ErrorDetailsText" FontSize="13" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                    <!-- 2026-10-21: главная кнопка — общим классом sec-primary (цвет и наведение по теме) (пакет 4, п. 130). -->
                    <Button x:Name="ErrorOpenButton" Content="{DynamicResource crmWebView.openInBrowser}" HorizontalAlignment="Center"
                            Click="OpenInBrowser_Click" Classes="sec-primary"
                            Padding="16,10" CornerRadius="10" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
