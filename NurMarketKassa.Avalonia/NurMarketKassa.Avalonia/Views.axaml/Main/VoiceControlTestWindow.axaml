<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.VoiceControlTestWindow"
        x:CompileBindings="False"
        Title="{DynamicResource loc.owner.voice.title}"
        Height="860" Width="960" MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Noto Sans"
        Background="{DynamicResource BrushInputAlt}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>

        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style Selector="Border.StatusBadge">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*">

        <!-- Заголовок — не скроллится, всегда видна кнопка "Закрыть" -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushWarningSoft}" CornerRadius="8" Padding="8">
                    <TextBlock Text="🎙️" FontSize="18" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource loc.owner.voice.title}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button IsCancel="True" Grid.Column="1" Content="{DynamicResource common.close}" Classes="SecondaryButton" Click="Close_Click"/>
        </Grid>

        <!-- Всё остальное — раньше не помещалось на маленьком экране/окне и низ (Живой поток)
             был не виден вообще без способа прокрутить (2026-09-05, по жалобе пользователя):
             один общий ScrollViewer на всё содержимое ниже заголовка. -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">

                <!-- Статус -->
                <Border x:Name="StatusBadge" Classes="StatusBadge" HorizontalAlignment="Left">
                    <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold"/>
                </Border>

                <!-- Обучение: примеры команд -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource loc.owner.voice.howTo}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="{DynamicResource loc.owner.voice.howToBody}"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu1}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu2}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu3}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu4}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu5}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu6}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu7}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu8}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu9}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exRu10}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource loc.owner.voice.kyHeader}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushText}" Margin="0,6,0,0"/>
                        <TextBlock Text="{DynamicResource loc.owner.voice.kyNote}"
                                   FontSize="11" FontStyle="Italic" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy1}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy2}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy3}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy4}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy5}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy6}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy7}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="{DynamicResource loc.owner.voice.exKy8}" FontSize="12" Foreground="{DynamicResource BrushText}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource loc.owner.voice.notHeard}"
                                   FontSize="11" FontStyle="Italic" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ручная проверка текста без микрофона -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource loc.owner.voice.manualTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="{DynamicResource loc.owner.voice.manualHint}"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="ManualTextBox" Grid.Column="0" Watermark="касса картошка два килограмма" KeyDown="ManualTextBox_KeyDown"/>
                            <Button Grid.Column="1" Content="{DynamicResource loc.owner.voice.parse}" Classes="PrimaryButton" Margin="8,0,0,0" Click="ParseManual_Click"/>
                        </Grid>
                        <TextBlock x:Name="ManualResultText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
                    </StackPanel>
                </Border>

                <!-- Голосовой замок -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource loc.owner.voice.lockTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="{DynamicResource loc.owner.voice.lockBody}"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="VoiceLockStatusText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="VoiceLockProgress" Height="6" IsVisible="False" IsIndeterminate="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="VoiceLockDownloadButton" Content="{DynamicResource loc.owner.voice.download}" Classes="PrimaryButton" Click="VoiceLockDownload_Click"/>
                            <Button x:Name="VoiceLockEnrollButton" Content="{DynamicResource loc.owner.voice.enroll}" Classes="PrimaryButton" Click="VoiceLockEnroll_Click"/>
                            <CheckBox x:Name="VoiceLockEnabledCheck" Content="{DynamicResource loc.owner.voice.lockOn}" VerticalAlignment="Center" Click="VoiceLockEnabledCheck_Click"/>
                            <Button x:Name="VoiceLockClearButton" Content="{DynamicResource csh.filter.reset}" Classes="SecondaryButton" Click="VoiceLockClear_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Озвучка своим голосом (2026-09-25): фразы кассы записываются с микрофона или
                     загружаются файлом; строки строятся в коде (RefreshCustomPrompts). -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CustomPromptsTitle" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock x:Name="CustomPromptsHint" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton x:Name="PromptLangRu" GroupName="PromptLang" Content="{DynamicResource posSettings.screen.langRussian}" Click="PromptLang_Click"/>
                            <RadioButton x:Name="PromptLangKy" GroupName="PromptLang" Content="{DynamicResource posSettings.screen.langKyrgyz}" Click="PromptLang_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="CustomPromptsPanel" Spacing="6"/>
                        <TextBlock x:Name="CustomPromptsStatus" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Словарь единиц измерения -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource loc.owner.voice.unitsTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="{DynamicResource loc.owner.voice.unitsBody}"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="2*,Auto,1*,Auto">
                            <TextBox x:Name="NewUnitWordBox" Grid.Column="0" Watermark="{DynamicResource loc.owner.voice.unitWordHint}"/>
                            <TextBlock Grid.Column="1" Text="(" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBox x:Name="NewUnitAbbreviationBox" Grid.Column="2" Watermark="{DynamicResource loc.owner.voice.unitAbbrHint}"/>
                            <Button Grid.Column="3" Content="{DynamicResource common.add}" Classes="PrimaryButton" Margin="8,0,0,0" Click="AddUnitWord_Click"/>
                        </Grid>
                        <ItemsControl x:Name="UnitWordsList"/>
                    </StackPanel>
                </Border>

                <!-- Обучение товарам -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource loc.owner.voice.aliasTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="{DynamicResource loc.owner.voice.aliasBody}"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                        <AutoCompleteBox x:Name="NewAliasProductBox" Watermark="{DynamicResource loc.owner.voice.aliasProductHint}"/>
                        <TextBox x:Name="NewAliasPhraseBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                                 Watermark="Фразы, по одной на строку, например:&#10;кола&#10;кокакола&#10;чёрный напиток"/>
                        <Button Content="{DynamicResource loc.owner.voice.aliasAdd}" Classes="PrimaryButton" HorizontalAlignment="Left" Click="AddProductAlias_Click"/>
                        <TextBlock x:Name="AliasErrorText" FontSize="12" Foreground="{DynamicResource BrushDanger}" IsVisible="False" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="ProductAliasesList"/>
                    </StackPanel>
                </Border>

                <!-- Живой поток -->
                <Grid ColumnDefinitions="*,12,*" Height="320">
                    <Border Grid.Column="0" Classes="Card">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="{DynamicResource loc.owner.voice.heardLive}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" x:Name="RawScroll">
                                <ItemsControl x:Name="RawTextList"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Classes="Card">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="{DynamicResource loc.owner.voice.recognized}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" x:Name="CommandScroll">
                                <ItemsControl x:Name="CommandList"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
