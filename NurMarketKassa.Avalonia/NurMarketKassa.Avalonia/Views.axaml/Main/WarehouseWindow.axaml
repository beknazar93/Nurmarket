<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
        xmlns:models="using:NurMarketKassa.Models"
        xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
        xmlns:analytics="using:NurMarketKassa.AvaloniaHost.Views.Analytics"
        xmlns:views="using:NurMarketKassa.AvaloniaHost.Views"
        xmlns:dc="using:Avalonia.Data.Converters"
        xmlns:ctl="using:NurMarketKassa.AvaloniaHost.Views.Controls"
        x:Class="NurMarketKassa.AvaloniaHost.Views.WarehouseWindow"
        x:DataType="vm:WarehouseViewModel"
        x:CompileBindings="True"
        Title="{DynamicResource warehouse.title}"
        Height="780" Width="1200" MinHeight="550" MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Noto Sans"
        Background="{DynamicResource BrushInputAlt}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- 2026-10-19, О9: ширина плитки товара — по ширине списка (WarehouseWindow.O9.cs), справа не остаётся пустой полосы. -->
    <Window.Resources>
        <x:Double x:Key="WarehouseTileWidth">208</x:Double>
    </Window.Resources>

    <Window.Styles>
        <!-- 2026-10-22 (аудит 1.17.59, П-И, Б10): на низком окне плитки сводки без пояснения (оно в подсказке плитки). -->
        <Style Selector="Window.wh-compact TextBlock.kpi-sub">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- 2026-10-22 (аудит новой сборки, П5): на низком окне (1366×768) оставалось ~6 строк — плитки сводки ниже, подписи
             «Единица продажи»/«Наличие» скрыты (сегменты понятны сами, подпись — во всплывающей подсказке), и обе группы фильтров
             встают в один ряд, а не в два. -->
        <!-- 2026-10-24, ТЗ «Склад» (Б1): на низком окне (1024×600) подсказка вкладки «Приёмка» скрыта (она же — подсказка поля скана), чтобы в таблице
             оставалось несколько строк. -->
        <Style Selector="Window.wh-compact TextBlock#ReceivingHintText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox#ReceivingSupplierProductsList">
            <Setter Property="MaxHeight" Value="190"/>
        </Style>
        <Style Selector="Window.wh-compact ListBox#ReceivingSupplierProductsList">
            <Setter Property="MaxHeight" Value="110"/>
        </Style>
        <Style Selector="Window.wh-compact Border.sec-kpi.compact">
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style Selector="Window.wh-compact WrapPanel#WarehouseFiltersRow TextBlock.seg-label">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- Остаток: цвет из темы, красный — только при малом количестве. -->
        <Style Selector="TextBlock.stock-low">
            <Setter Property="Foreground" Value="{DynamicResource BrushCatalogStockLow}"/>
        </Style>
        <!-- Пилюли фильтра "Единица продажи" (2026-09-07) — тот же визуальный стиль, что и
             RadioButton.ClickPill в ScreenSettingsView.axaml, продублирован локально: тот стиль
             определён в другом файле и не виден отсюда. -->
        <!-- 2026-10-19, этап О9 (аудит 19.10, проблема 1): пилюли были серыми, а выбранная — бледно-жёлтой с рыжей рамкой.
             Теперь как sec-seg во всей программе: невыбранная — обводкой, выбранная — тёмно-синяя с белым текстом.
             Почти все переключатели склада теперь sec-seg в рамке sec-segment; этот стиль — для оставшихся. -->
        <Style Selector="RadioButton.SaleUnitPill">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="44"/> <!-- 2026-10-27, аудит владельца С-5: пилюля «Единица продажи» 34 → 44 -->
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SaleUnitPill:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="RadioButton.SaleUnitPill:checked">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- 2026-10-19, О9: подпись перед группой переключателей («Единица продажи», «Наличие»). -->
        <Style Selector="TextBlock.seg-label">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- 2026-10-19, О9: пустая таблица — заголовок и подсказка посередине (не нажимается, строки не закрывает). -->
        <Style Selector="StackPanel.empty-state">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="Spacing" Value="6"/>
            <Setter Property="Margin" Value="16,48,16,16"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="StackPanel.empty-state TextBlock.empty-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="StackPanel.empty-state TextBlock.empty-hint">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 2026-10-19, О9: белая карточка с рамкой (списание; было — серая подложка). -->
        <Style Selector="Border.wh-card">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Кастомный стиль вкладок TabControl -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- 2026-10-19, О9: на 1024 вкладка «Редактор этикетки» уходила во 2-ю строку — шрифт 15 → 14, поля и промежутки меньше
             (и короче названия «Ревизия», «Списание» в Strings). -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="CornerRadius" Value="10,10,0,0"/>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Единый стиль полей ввода TextBox / ComboBox -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="44"/> <!-- 2026-10-27, аудит владельца С-5: было 42 -->
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
        </Style>

        <!-- Window sets a fixed Foreground that inherits everywhere, which fights FluentTheme's
             own selected/hover text color — without this override, text goes near-invisible on
             the blue selection/hover background in the reason dropdown and in the DataGrids. -->
        <Style Selector="ComboBoxItem:selected, ComboBoxItem:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- 2026-10-19, О9: выбранная строка — мягкий фон темы (BrushPanelPressed) с обычным цветом текста, а не голубая
             системная подсветка с белым текстом (у строк с наведением белый текст на светлом фоне не читался). -->
        <Style Selector="DataGridRow:selected, DataGridRow:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource BrushPanelPressed}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Кастомный стиль кнопок -->
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <!-- 2026-10-19, О9 (аудит, проблема 2): одна жёлтая на вкладку (PrimaryButton — как sec-primary: наведение темнее,
             выключенная — нейтральная, не серая Fluent), остальные — обводкой (SecondaryButton — как sec-outline, была серая
             заливка). Фокус по-прежнему не берут: Enter сканера не должен нажимать кнопку. -->
        <Style Selector="Button.PrimaryButton">
            <Setter Property="MinHeight" Value="44"/> <!-- 2026-10-27, С-5: было 40 -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="Button.PrimaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="Button.PrimaryButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        </Style>

        <Style Selector="Button.SecondaryButton">
            <Setter Property="MinHeight" Value="44"/> <!-- 2026-10-27, аудит владельца С-5: «Назад / Вперёд / Обновить / Массовая загрузка» 30–36 → 44 -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.SecondaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="Button.SecondaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
        </Style>
        <!-- 2026-10-27: прозрачность выключенной 0.45 → 0,7: в тёмной теме надпись выключенной кнопки была 1,5–2,5:1 (нужно ≥3:1). -->
        <Style Selector="Button.SecondaryButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <!-- 2026-10-19, О9: пункт раскрывающегося списка (причина списания, подсказки приёмки) — без рамки, наведение мягким фоном. -->
        <Style Selector="Button.list-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.list-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.list-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
        </Style>
        <!-- «✕» в строке приёмки/ревизии — маленькая обводка под строку 44 px. -->
        <Style Selector="Button.SecondaryButton.row-x">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Кнопки управления окном (Свернуть / Закрыть) -->
        <Style Selector="Button.WindowControlButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowControlButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.WindowCloseButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Стиль для DataGrid -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
        </Style>
        <!-- Ячейки таблицы: без этого отступа название товара начиналось вплотную к левой
             рамке, а иконки действий упирались в правую. -->
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <!-- 2026-10-21 (пакет 1, п. 71): название в строке приёмки — до 2 строк (на 1024 и по-кыргызски обрезалось), класс ставит O9.cs. -->
        <Style Selector="DataGridCell.rcv-name TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <!-- 2026-10-29, спека Fable (Specs-1029/01-receiving-table): числа вправо (классы rcv-num/rcv-soft/rcv-edit/rcv-sale/rcv-profit ставит O9.cs), 4 редактируемые ячейки —
             с подчёркиванием (InputAlt + низ 2 px BorderStrong), заливки «маржа < 10 %» (WarningSoft) и «ниже закупки» (DangerSoft) видны И под выделением (кисть
             Rectangle#BackgroundRectangle), фокус-строка — AccentSoft. Классы rcv-low / rcv-below у строки ставит WarehouseWindow.ReceivingScan.cs (LoadingRow). Только токены тем. -->
        <Style Selector="DataGrid#ReceivingGrid DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style Selector="DataGridCell.rcv-num TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="DataGridCell.rcv-num TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style Selector="DataGridCell.rcv-soft TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="DataGridCell.rcv-bar TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style Selector="DataGridCell.rcv-edit">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <Style Selector="DataGridCell.rcv-edit TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="DataGridCell.rcv-profit TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="DataGrid#ReceivingGrid DataGridRow:selected DataGridCell.rcv-edit">
            <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
        </Style>
        <Style Selector="DataGrid#ReceivingGrid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGrid#ReceivingGrid DataGridRow.rcv-low /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource BrushWarningSoft}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGrid#ReceivingGrid DataGridRow.rcv-below /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource BrushDangerSoft}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGrid#ReceivingGrid DataGridRow.rcv-low:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="DataGrid#ReceivingGrid DataGridRow.rcv-below:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="DataGrid#ReceivingGrid DataGridRow.rcv-low DataGridCell.rcv-edit, DataGrid#ReceivingGrid DataGridRow.rcv-below DataGridCell.rcv-edit">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow.rcv-low DataGridCell.rcv-sale TextBlock, DataGridRow.rcv-low DataGridCell.rcv-profit TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="DataGridRow.rcv-below DataGridCell.rcv-sale TextBlock, DataGridRow.rcv-below DataGridCell.rcv-profit TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerOnSoft}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.rcv-sub">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.hdr-sub">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="LineHeight" Value="12"/>
        </Style>
        <Style Selector="TextBlock.chg">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="TextBlock.chg.up">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.chg.down">
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.chg-short">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGrid.rcv-compact TextBlock.chg-short">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="DataGrid.rcv-compact TextBlock.chg-long, DataGrid.rcv-compact TextBlock.rcv-sub">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.mode">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.mode-auto">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="TextBlock.mode-manual">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.rcv-tag">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.rcv-tag TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.rcv-tag.low">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.rcv-tag.low TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
        </Style>
        <Style Selector="Border.rcv-tag.below">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Border.rcv-tag.below TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerOnSoft}"/>
        </Style>
        <Style Selector="Border.rcv-newbadge">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.sum-cap">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="TextBlock.sum-val">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TextBlock.sum-val.ok">
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
        </Style>
        <Style Selector="TextBlock.sum-val.neg">
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerOnSoft}"/>
        </Style>
        <Style Selector="Border.sum-flag">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.sum-flag.low">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.sum-flag.low TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
        </Style>
        <Style Selector="Border.sum-flag.below">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Border.sum-flag.below TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerOnSoft}"/>
        </Style>
        <Style Selector="TextBlock.sum-flagtext">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SeparatorBrush" Value="{DynamicResource BrushBorder}"/>
        </Style>
        <!-- 2026-10-19, О9 (аудит, проблема 6: «Цена закупк», «Ожидаемый оста», «Коли», «Причина сп»): заголовок — TextBlock,
             длинный переносится на 2-ю строку. Справа в шаблоне Fluent всегда занято 32 px под значок сортировки — текст
             заходит на это место (отрицательное поле), заодно заголовки «по правому краю» встали над числами. -->
        <Style Selector="DataGridColumnHeader TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="Margin" Value="0,0,-24,0"/>
        </Style>
        <!-- 2026-10-29: заголовки приёмки. Стили ниже общего «DataGridColumnHeader» (в Avalonia побеждает более поздний стиль, а не более точный селектор). -->
        <Style Selector="DataGrid#ReceivingGrid DataGridColumnHeader">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Резерв под значок сортировки (DataGridSortIconMinWidth = 0, см. ReceivingGrid.Resources); общий отрицательный отступ справа (−24) здесь не нужен. -->
        <Style Selector="DataGrid#ReceivingGrid DataGridColumnHeader TextBlock">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        </Style>

        <!-- Плашка остатка. 2026-10-19, О9 (аудит, проблема 5: «0 шт» было зелёным, «3 шт» — красным; правило 4): норма —
             нейтральная, «заканчивается» (меньше 10, IsLowStock) — оранжевая, «нет в наличии» (0 и меньше) — красная.
             Цвет — только классами (stock / low / out), без своего цвета у Border и TextBlock. -->
        <Style Selector="Border.stock">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Border.stock TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Border.stock.low">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.stock.low TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
        </Style>
        <Style Selector="Border.stock.out">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Border.stock.out TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
        </Style>

        <!-- Вид операции в журнале перемещений: продажа — акцентом, списание — красным, чтобы
             потери отличались от обычного расхода при беглом просмотре. -->
        <Style Selector="Border.writeoff">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Border.writeoff TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
        </Style>

        <!-- Статус перемещения: в пути — предупреждающим цветом, доставлено — зелёным,
             отменено — красным (класс writeoff), создано — акцентом по умолчанию. -->
        <Style Selector="Border.transit">
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.transit TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
        </Style>
        <Style Selector="Border.done">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
        </Style>
        <Style Selector="Border.done TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
        </Style>
        <!-- Кнопки-иконки в строке таблицы товаров (2026-09-07): векторные PathIcon вместо эмодзи —
             эмодзи-карандаш в Segoe UI не отрисовывался, остальные выходили обрезанными. -->
        <Style Selector="Button.RowIcon">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.RowIcon PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <!-- 2026-10-18, решение владельца (аудит, правило 5): действия строки товара — «± Остаток» и «✎ Изменить» с
             подписью, остальное в «⋯» (WarehouseWindow.RowActions.cs). Вид и отклик — общий sec-outline (наведение, нажатие,
             выключенная); здесь только размер под строку 52 px. Без фокуса, как прежние значки (Enter сканера). -->
        <!-- 2026-10-27, аудит владельца С-5: кнопки строки 36 → 44 (цель нажатия; строка 52 это вмещает). -->
        <Style Selector="Button.row-act">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.row-act PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <!-- 2026-10-29, Android: «⋯» трудно нажать пальцем — зона нажатия не меньше 48 dp (строка 52 это вмещает). -->
        <Style Selector="Button.row-more">
            <Setter Property="Width" Value="48"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- Узкая таблица (класс ставит ProductsGrid_SizeChanged) — только значки, подпись в подсказке. -->
        <Style Selector="DataGrid.row-compact Button.row-act">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="DataGrid.row-compact Button.row-more">
            <Setter Property="Width" Value="48"/>
        </Style>
        <Style Selector="DataGrid.row-compact TextBlock.row-act-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- 2026-10-06, редизайн склада: метка срока годности в строке товара и плитки сводки. -->
        <Style Selector="Border.expiryBadge">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
        </Style>
        <Style Selector="Border.expiryBadge TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
        </Style>
        <Style Selector="Border.expiryBadge.expired">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Border.expiryBadge.expired TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <!-- Кастомная шапка окна (TitleBar + действия) -->
            <RowDefinition Height="Auto"/>
            <!-- Контент вкладок -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна с возможностью перетаскивания (DragWindow) -->
        <Border x:Name="WindowHeaderBorder" Grid.Row="0"
                Background="{DynamicResource BrushPanel}"
                CornerRadius="14"
                Padding="16,10"
                Margin="0,0,0,16"
                BoxShadow="0 2 8 0 #0F000000">
            <DockPanel LastChildFill="True">

                <!-- Правый блок: Кнопки управления окном (Свернуть / Закрыть) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- 2026-10-26, владелец: «что там в правом углу сканер делает, он не работает — убери его». Подсказка скрыта (элемент оставлен: на него ссылается код окна). -->
                    <Border x:Name="ScanHintBorder" IsVisible="False" Background="{DynamicResource BrushInputAlt}" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="18" TextAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                            <TextBlock Foreground="{DynamicResource BrushTextSoft}" FontSize="12" FontWeight="Medium"
                                       Text="{DynamicResource warehouse.scanHint}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2026-10-04, клиент: «добавить кнопку "обновить страницу" для склада». -->
                    <Button x:Name="RefreshWarehouseButton" Classes="SecondaryButton" Margin="0,0,8,0" Padding="12,6"
                            Click="RefreshWarehouse_Click" ToolTip.Tip="{DynamicResource warehouse.refreshTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 2026-10-11, тестировщик (склад.md, 1): «непонятно — обновляет или завис». Значок крутится, пока идёт загрузка. -->
                            <TextBlock x:Name="RefreshWarehouseIcon" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"
                                       RenderTransformOrigin="50%,50%">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="RefreshWarehouseText" Text="{DynamicResource warehouse.refresh}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MinimizeWindowButton" Classes="WindowControlButton" Click="MinimizeButton_Click" ToolTip.Tip="{DynamicResource csh.filter.minimizeTooltip}">
                        <TextBlock Text="🗕" FontSize="12"/>
                    </Button>
                    <Button x:Name="CloseWindowButton" Classes="WindowControlButton WindowCloseButton" Click="CloseButton_Click" ToolTip.Tip="{DynamicResource csh.filter.closeTooltip}">
                        <TextBlock Text="✕" FontSize="13"/>
                    </Button>
                </StackPanel>

                <!-- Левый блок: Иконка и заголовок (для перемещения окна) -->
                <StackPanel x:Name="WindowTitlePanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="8" Padding="8">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Width="22" TextAlignment="Center" FontSize="16"
                                   Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource warehouse.header}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Основной блок с вкладками -->
        <TabControl x:Name="WarehouseTabs" Grid.Row="1">

            <!-- Вкладка 1: Товары -->
            <TabItem x:Name="ProductsTabItem" Header="{DynamicResource warehouse.tabProducts}">
                <Border x:Name="ProductsTabBorder" Background="{DynamicResource BrushPanel}" CornerRadius="0,14,14,14" Padding="16" BoxShadow="0 4 12 0 #0D000000">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <!-- 2026-10-06, владелец: «проведи полный редизайн склада». Сводка склада — плитками сверху (была строкой
                             под таблицей): товары, стоимость по закупке и по продаже, «Заканчивается», «Нет в наличии», «Срок
                             годности»; нажатие на плитку включает фильтр. Собирается в коде (WarehouseWindow.Redesign.cs). -->
                        <!-- 2026-10-19, О9 (аудит, проблема 4): плитки sec-kpi в KpiTileGrid — на 1024 суммы не обрезаются «65 087 с…». -->
                        <ctl:KpiTileGrid Grid.Row="0" x:Name="WarehouseKpiPanel" MinTileWidth="128" Spacing="8" Margin="0,0,0,14"/>

                        <Grid x:Name="ProductsSearchRow" Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                            <!-- 2026-10-06, владелец: «сделай редизайн кнопок, расположение, удобство» — у поиска значок и «✕» очистки. -->
                            <TextBox Grid.Column="0" x:Name="ProductSearchBox"
                                     Watermark="{DynamicResource warehouse.productSearchWatermark}"
                                     Text="{Binding ProductSearchText}"
                                     KeyDown="SearchBox_KeyDown">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Width="15" Height="15" Margin="10,0,2,0" Foreground="{DynamicResource BrushTextSoft}"
                                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                                </TextBox.InnerLeftContent>
                                <TextBox.InnerRightContent>
                                    <Button x:Name="ProductSearchClearButton" Classes="SecondaryButton RowIcon" Margin="0,0,4,0" IsVisible="False"
                                            Click="ProductSearchClear_Click">
                                        <TextBlock Text="✕" FontSize="12"/>
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <Panel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                <TextBlock x:Name="ProductCountLabel"
                                           Text="{Binding ProductCountText}"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           FontSize="13"/>
                                <!-- 2026-10-11: во время «Обновить» — «Загружаю…» с секундами вместо «Всего / Найдено». -->
                                <TextBlock x:Name="ProductCountLoading" IsVisible="False"
                                           Foreground="{DynamicResource BrushAccentStrong}" FontWeight="SemiBold"
                                           FontSize="13"/>
                            </Panel>
                            <Button Grid.Column="2" Classes="SecondaryButton"
                                    Content="{DynamicResource warehouse.bulkImportButton}"
                                    Margin="0,0,8,0"
                                    Click="BulkImport_Click"/>
                            <Button x:Name="BulkPriceTagButton" Grid.Column="3" Classes="SecondaryButton"
                                    Content="{DynamicResource warehouse.bulkPriceTagButton}"
                                    Margin="0,0,8,0"
                                    Click="BulkPriceTag_Click"/>
                            <Button Grid.Column="4" Classes="PrimaryButton"
                                    Content="{DynamicResource product.addButton}"
                                    Click="AddProduct_Click"/>
                        </Grid>

                        <!-- Фильтр "Единица продажи" (2026-09-07, по образцу stage.nurcrm.kg/crm/sklad) -->
                        <!-- 2026-10-06: слева — фильтры (единица продажи, наличие), справа — вид списка (это не фильтр). -->
                        <Grid x:Name="ProductsFilterRow" Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <!-- 2026-10-19, О9: группы — сегментами sec-segment/sec-seg (выбранный тёмно-синий, как «Продажи» и «Клиенты»). -->
                        <WrapPanel Grid.Column="0" x:Name="WarehouseFiltersRow" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Classes="seg-label" Text="{DynamicResource warehouse.saleUnitFilterLabel}"/>
                            <Border Classes="sec-segment" ToolTip.Tip="{DynamicResource warehouse.saleUnitFilterLabel}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton x:Name="SaleUnitAllRadio" GroupName="SaleUnitFilter" Classes="sec-seg" IsChecked="True"
                                                 Content="{DynamicResource warehouse.saleUnitAll}" Click="SaleUnitFilter_Changed"/>
                                    <RadioButton x:Name="SaleUnitWeightRadio" GroupName="SaleUnitFilter" Classes="sec-seg"
                                                 Content="{DynamicResource warehouse.saleUnitWeight}" Click="SaleUnitFilter_Changed"/>
                                    <RadioButton x:Name="SaleUnitPieceRadio" GroupName="SaleUnitFilter" Classes="sec-seg"
                                                 Content="{DynamicResource warehouse.saleUnitPiece}" Click="SaleUnitFilter_Changed"/>
                                    <RadioButton x:Name="SaleUnitPiecePackageRadio" GroupName="SaleUnitFilter" Classes="sec-seg"
                                                 Content="{DynamicResource warehouse.saleUnitPiecePackage}" Click="SaleUnitFilter_Changed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- 2026-10-06: фильтр наличия — «Все / Заканчивается / Нет в наличии / Срок годности» (кнопки — в коде). -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="StockFilterLabel" Classes="seg-label"/>
                            <Border Classes="sec-segment">
                                <StackPanel x:Name="StockFilterPanel" Orientation="Horizontal" Spacing="2"/>
                            </Border>
                        </StackPanel>
                        </WrapPanel>
                        <!-- Вид списка. Таблица отвечает на вопрос «сколько и почём» — цифры в колонках сравнивать удобнее;
                             плитки отвечают на «что это» — товар узнают по фотографии. -->
                        <Border Grid.Column="1" Classes="sec-segment" VerticalAlignment="Top" Margin="12,0,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton x:Name="ViewListRadio" GroupName="WarehouseViewMode" Classes="sec-seg" IsChecked="True"
                                             Content="{DynamicResource warehouse.viewList}" Click="WarehouseViewMode_Changed"/>
                                <RadioButton x:Name="ViewTilesRadio" GroupName="WarehouseViewMode" Classes="sec-seg"
                                             Content="{DynamicResource warehouse.viewTiles}" Click="WarehouseViewMode_Changed"/>
                            </StackPanel>
                        </Border>
                        </Grid>

                        <!-- Таблица товаров (2026-09-07, перестроена по образцу Shopify Polaris IndexTable:
                             миниатюра 36px + название крупнее и с усечением, ОДНА колонка "Код" (это Article —
                             в маппере уже article ?? code, и только он хранится в локальном кэше SQLite,
                             отдельного "code" там нет), все значения кроме названия — по центру (заголовки
                             тоже: у центрируемых колонок Header задан TextBlock'ом с TextAlignment=Center,
                             у DataGridColumnHeader стоит HorizontalContentAlignment=Stretch, иначе выравнивание
                             содержимого заголовка не работает), остаток цветом (красный при малом), скидка
                             плашкой только когда есть, действия — 5 компактных векторных иконок с подсказками
                             (Изменить / Этикетка / Ценник / Фото / Удалить) вместо широких кнопок с текстом,
                             чтобы место доставалось названию. -->
                        <DataGrid Grid.Row="3"
                                  x:Name="ProductsGrid"
                                  x:CompileBindings="False"
                                  ItemsSource="{Binding PagedProducts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="52"
                                  SizeChanged="ProductsGrid_SizeChanged">
                            <DataGrid.Columns>
                                <!-- Сумма ширин НЕ должна превышать окно, иначе появляется горизонтальная прокрутка
                                     и последняя кнопка в «Действиях» обрезается по краю. Сейчас
                                     160+124+128+120+190 = 722 плюс минимум названия 200 = 922 при
                                     доступных ~990 (окно минус поля). Колонку «Ед. изм.» убрали:
                                     единица переехала в плашку остатка — «93 шт». Прибавку заголовкам «Скидка» и «Остаток» (они
                                     обрезались при крупном шрифте) оплатили «Действия»: иконки стали
                                     32 px вместо 36, и колонка ужалась с 210 до 184. -->
                                <DataGridTemplateColumn Header="{DynamicResource common.name}" Width="*" MinWidth="200" SortMemberPath="Title">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0">
                                                    <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="6">
                                                        <PathIcon Width="16" Height="16" Foreground="{DynamicResource BrushTextMuted}"
                                                                  Data="M12,2L2,7V17L12,22L22,17V7L12,2M12,4.15L19.16,7.75L12,11.35L4.84,7.75L12,4.15M4,9.28L11,12.78V19.7L4,16.2V9.28M13,19.7V12.78L20,9.28V16.2L13,19.7Z"/>
                                                    </Border>
                                                    <Border CornerRadius="6" ClipToBounds="True"
                                                            IsVisible="{ReflectionBinding ProductImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <Image Source="{ReflectionBinding ProductImagePath, Converter={x:Static conv:AssetPathToBitmapConverter.Instance}, ConverterParameter=thumb}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                                <!-- 2026-10-06, редизайн склада: под названием — «категория · бренд» и метка срока годности. -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{ReflectionBinding Title}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{ReflectionBinding Title}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{ReflectionBinding SubtitleText}" FontSize="11.5"
                                                                   Foreground="{DynamicResource BrushTextSoft}" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{ReflectionBinding HasSubtitle}" VerticalAlignment="Center"/>
                                                        <Border Classes="expiryBadge" Classes.expired="{ReflectionBinding ExpiryExpired}"
                                                                IsVisible="{ReflectionBinding HasExpiryBadge}">
                                                            <TextBlock Text="{ReflectionBinding ExpiryBadgeText}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Код и штрихкод — одна колонка в две строки. По отдельности они занимали
                                     две трети ширины таблицы, хотя читают их редко: код сверху, штрихкод под
                                     ним мельче. Освободившееся место ушло названию товара. -->
                                <DataGridTemplateColumn Width="160" SortMemberPath="Article">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.colCodeBarcode}" TextAlignment="Left"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{ReflectionBinding Article}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                                <TextBlock Text="{ReflectionBinding Barcode}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource BrushTextSoft}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Ширины колонок держат запас под заголовок: они были подогнаны впритык под кегль 13,
                                     и стоило шрифту стать крупнее (масштаб интерфейса, тема с крупным шрифтом), как
                                     «Скидка» превращалась в «Скидк», а «Остаток» — в «Остато». -->

                                <!-- Цена прижата вправо: у чисел сравнивают разряды, а по центру единицы,
                                     десятки и тысячи стоят вразнобой и колонку приходится читать построчно. -->
                                <!-- 2026-10-06: сортировка по числу (PriceValue), а не по строке цены. -->
                                <!-- 2026-10-22 (аудит новой сборки, П5): 124 → 152 — «615 000,10 сом» (жирным, 14) обрезалось «615 000,10 со». -->
                                <DataGridTemplateColumn Width="152" SortMemberPath="PriceValue">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource csh.catalog.colPrice}" TextAlignment="Right"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,6,0">
                                                <!-- 2026-10-06: с разрядами, как закупка («1 800,00 сом»). -->
                                                <TextBlock Text="{ReflectionBinding PriceLineDisplay}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushText}"
                                                           HorizontalAlignment="Right"/>
                                                <!-- Скидка переехала под цену: своей колонкой она стояла пустым
                                                     прочерком почти во всех строках и занимала место, которое
                                                     понадобилось себестоимости. -->
                                                <Border Background="{DynamicResource BrushWarningSoft}" CornerRadius="5" Padding="6,1"
                                                        HorizontalAlignment="Right"
                                                        IsVisible="{ReflectionBinding HasDiscount}">
                                                    <TextBlock Text="{ReflectionBinding DiscountPercent, StringFormat=-\{0:0.##\}%}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushWarning}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Себестоимость, как в «Остатках товаров»: сверху закупочная цена за
                                     единицу, снизу — вся сумма, которая лежит на полке этим товаром
                                     (закупка × остаток). До этого закупочную цену в таблице не показывали
                                     вовсе, и сказать, на сколько денег стоит склад, можно было только
                                     через вкладку «Аналитика». -->
                                <DataGridTemplateColumn Width="128" SortMemberPath="PurchasePrice">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.colCost}" TextAlignment="Right"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Spacing="1" Margin="0,0,6,0">
                                                <TextBlock Text="{ReflectionBinding PurchasePrice, StringFormat=\{0:N2\}}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                                <!-- 2026-10-31 (стресс-тест 1.17.68): огромная сумма не режется молча — многоточие и полное значение в подсказке. -->
                                                <TextBlock Text="{ReflectionBinding StockCostText}"
                                                           FontSize="11.5"
                                                           HorizontalAlignment="Right"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{ReflectionBinding StockCostText}"
                                                           Foreground="{DynamicResource BrushTextSoft}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Остаток — плашкой: заканчивающийся товар должен бросаться в глаза при
                                     беглом взгляде на страницу, а не отличаться оттенком цифры. -->
                                <DataGridTemplateColumn Width="120" SortMemberPath="Quantity">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource csh.catalog.colStock}" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Classes="stock" CornerRadius="6" Padding="10,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Classes.low="{ReflectionBinding IsLowStock}"
                                                    Classes.out="{ReflectionBinding Quantity, Converter={x:Static views:WarehouseWindow.IsOutOfStock}}">
                                                <TextBlock Text="{ReflectionBinding StockWithUnitText}"
                                                           FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- 2026-10-18: ширину колонки (300 с подписями / 156 значками) ставит ProductsGrid_SizeChanged. -->
                                <DataGridTemplateColumn Width="300">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.colActions}" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- 2026-10-18, решение владельца: было 6 значков без подписей (±, ✎, этикетка, ценник, фото,
                                                 корзина). Видны два главных действия с подписью, остальное — в «⋯» (меню с подписями,
                                                 «Удалить» последним, красным, под чертой). Обработчики прежние. -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,20,0"> <!-- 2026-10-29: отступ справа 12 → 20 (Android: «⋯» у края экрана) -->
                                                <!-- 2026-10-06, редизайн склада: «±» — приход, списание или точное количество прямо из строки. -->
                                                <Button Classes="sec-outline row-act" Click="StockAdjust_Click" Tag="{Binding}"
                                                        AutomationProperties.Name="{x:Static views:WarehouseWindow.RowStockName}"
                                                        ToolTip.Tip="{ReflectionBinding Title, Converter={x:Static conv:StockAdjustTipConverter.Instance}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="M11,3 H13 V8 H18 V10 H13 V15 H11 V10 H6 V8 H11 Z M6,18 H18 V20 H6 Z"/>
                                                        <TextBlock Classes="row-act-text" VerticalAlignment="Center" Text="{x:Static views:WarehouseWindow.RowStockText}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="sec-outline row-act" Click="EditProduct_Click" Tag="{Binding}"
                                                        AutomationProperties.Name="{x:Static views:WarehouseWindow.RowEditName}"
                                                        ToolTip.Tip="{x:Static views:WarehouseWindow.RowEditName}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                                                        <TextBlock Classes="row-act-text" VerticalAlignment="Center" Text="{DynamicResource product.editRowButton}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="sec-outline row-act row-more" Click="RowMore_Click" Tag="{Binding}"
                                                        AutomationProperties.Name="{x:Static views:WarehouseWindow.RowMoreText}"
                                                        ToolTip.Tip="{x:Static views:WarehouseWindow.RowMoreText}">
                                                    <PathIcon Data="M6,10A2,2 0 1,1 6,14A2,2 0 1,1 6,10M12,10A2,2 0 1,1 12,14A2,2 0 1,1 12,10M18,10A2,2 0 1,1 18,14A2,2 0 1,1 18,10Z"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Плиточный вид: та же страница товаров, но карточками. Скрыт, пока в
                             переключателе выбран «Список». -->
                        <ScrollViewer Grid.Row="3" x:Name="ProductsTilesScroll" IsVisible="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:CompileBindings="False" ItemsSource="{Binding PagedProducts}" Margin="0,0,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{DynamicResource WarehouseTileWidth}" Margin="0,0,12,12" Padding="12"
                                                Background="{DynamicResource BrushCatalogTileBg}"
                                                BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource SettingsCardRadius}">
                                            <StackPanel Spacing="8">
                                                <Grid Height="96">
                                                    <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="8"/>
                                                    <PathIcon Width="26" Height="26"
                                                              Foreground="{DynamicResource BrushTextSoft}"
                                                              Data="M12,2L2,7V17L12,22L22,17V7L12,2M12,4.15L19.16,7.75L12,11.35L4.84,7.75L12,4.15M4,9.28L11,12.78V19.7L4,16.2V9.28M13,19.7V12.78L20,9.28V16.2L13,19.7Z"/>
                                                    <Border CornerRadius="8" ClipToBounds="True"
                                                            IsVisible="{ReflectionBinding ProductImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <Image Source="{ReflectionBinding ProductImagePath, Converter={x:Static conv:AssetPathToBitmapConverter.Instance}, ConverterParameter=thumb}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{ReflectionBinding Title}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           MaxLines="2" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Height="36"
                                                           Foreground="{DynamicResource BrushText}"
                                                           ToolTip.Tip="{ReflectionBinding Title}"/>

                                                <Grid ColumnDefinitions="*,Auto">
                                                    <!-- 2026-10-19, О9: цена — цветом текста (в тёмной теме была жёлтой — акцент без смысла). -->
                                                    <TextBlock Grid.Column="0" Text="{ReflectionBinding PriceLine}"
                                                               FontSize="15" FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource BrushText}"/>
                                                    <Border Grid.Column="1" Classes="stock" CornerRadius="6" Padding="8,2"
                                                            VerticalAlignment="Center"
                                                            Classes.low="{ReflectionBinding IsLowStock}"
                                                            Classes.out="{ReflectionBinding Quantity, Converter={x:Static views:WarehouseWindow.IsOutOfStock}}">
                                                        <TextBlock Text="{ReflectionBinding StockWithUnitText}"
                                                                   FontSize="12" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{ReflectionBinding Barcode}"
                                                           FontSize="11" Foreground="{DynamicResource BrushTextSoft}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- 2026-10-18, решение владельца: в плитке — «✎ Изменить» с подписью и «⋯» (ценник, фото,
                                                     этикетка, «Удалить» красным под чертой) вместо 4 значков без подписей. -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Button Classes="sec-outline row-act" HorizontalAlignment="Stretch"
                                                            Click="EditProduct_Click" Tag="{Binding}"
                                                            AutomationProperties.Name="{x:Static views:WarehouseWindow.RowEditName}"
                                                            ToolTip.Tip="{x:Static views:WarehouseWindow.RowEditName}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource product.editRowButton}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Margin="6,0,0,0" Classes="sec-outline row-act row-more" Click="RowMore_Click" Tag="{Binding}"
                                                            AutomationProperties.Name="{x:Static views:WarehouseWindow.RowMoreText}"
                                                            ToolTip.Tip="{x:Static views:WarehouseWindow.RowMoreText}">
                                                        <PathIcon Data="M6,10A2,2 0 1,1 6,14A2,2 0 1,1 6,10M12,10A2,2 0 1,1 12,14A2,2 0 1,1 12,10M18,10A2,2 0 1,1 18,14A2,2 0 1,1 18,10Z"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Итог по складу — то же, что в нижней строке «Остатков товаров»: сколько
                             позиций, сколько единиц лежит и на какую сумму, по закупке и по продаже.
                             Считается по всему каталогу, а не по текущей странице: страница — это
                             способ показа, а не часть склада. -->
                        <!-- 2026-10-06: итог переехал плитками наверх (WarehouseKpiPanel); строка скрыта. -->
                        <Border Grid.Row="4" Margin="0,10,0,0" Padding="14,10" IsVisible="False"
                                Background="{DynamicResource BrushPanelSoft}"
                                CornerRadius="{DynamicResource SettingsCardRadius}">
                            <ItemsControl x:Name="WarehouseTotalsPanel" x:CompileBindings="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,26,0" Spacing="7">
                                            <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextSoft}"/>
                                            <TextBlock Text="{Binding Value}" FontSize="13.5" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0"
                              IsVisible="{Binding ShowProductPager}">
                            <Button Grid.Column="0" Classes="SecondaryButton"
                                    Content="{DynamicResource csh.catalog.prevPage}"
                                    Command="{Binding PreviousProductPageCommand}"/>
                            <!-- 2026-10-21 (пакет 1, п. 109): «Товары 1–50 из 330 · страница 1 из 7» — текст ставит WarehouseWindow.O9.cs. -->
                            <TextBlock Grid.Column="1" x:Name="ProductPageStatus"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSoft}" FontSize="13"/>
                            <Button Grid.Column="2" Classes="SecondaryButton"
                                    Content="{DynamicResource csh.catalog.nextPage}"
                                    Command="{Binding NextProductPageCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Вкладка 2: Ревизия -->
            <!-- Вкладка: приёмка товара. Кладовщик пробивает накладную обычным сканером, и
                 принятое сразу уходит на склад. До этого прибавить остаток можно было только
                 через ревизию, вручную пересчитав и вписав новое количество целиком. -->
            <TabItem x:Name="ReceivingTabItem" Header="{DynamicResource warehouse.tabReceiving}">
                <Border Background="{DynamicResource BrushPanel}" CornerRadius="0,14,14,14" Padding="16" BoxShadow="0 4 12 0 #0D000000">
                    <!-- 2026-10-24, ТЗ «Склад» (Б1): наверху поле скана, ниже поставщик (необязателен, выбирается в любой момент до «Оприходовать»).
                         Подсказка вкладки — в коде (WarehouseWindow.ReceivingScan.cs). -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <!-- 2026-10-29, спека Fable (Specs-1029/01): над таблицей одна панель — «Наценка для всех, %» (поле 88×44, число жирное 16) · «Сразу к скану» · подсказка в одну строку. -->
                        <Border Grid.Row="0" x:Name="ReceivingCtlPanel" Margin="0,0,0,10" Padding="12,8" CornerRadius="12" BorderThickness="1" MinHeight="60"
                                Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}">
                            <Grid x:Name="ReceivingCtlGrid" ColumnDefinitions="Auto,Auto,*">
                                <StackPanel x:Name="ReceivingMarkupGroup" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReceivingMarkupLabel" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox x:Name="ReceivingMarkupBox" Width="88" Height="44" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Right"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ReceivingFastNextCheck" Margin="14,0,0,0" MinHeight="44" VerticalAlignment="Center" Focusable="False"/>
                                <TextBlock Grid.Column="2" x:Name="ReceivingHintText" Margin="14,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource BrushTextSoft}"/>
                            </Grid>
                        </Border>

                        <WrapPanel Grid.Row="1" x:Name="ReceivingToolsWrap" Margin="0,0,0,2">
                            <WrapPanel.Styles>
                                <Style Selector="WrapPanel > :is(Control)"><Setter Property="Margin" Value="0,0,8,8"/></Style>
                            </WrapPanel.Styles>
                            <!-- Поле принимает и скан (сканер дописывает перевод строки, срабатывает
                                 Enter), и набор названия руками — тогда под полем появляются
                                 подсказки, см. ReceivingScan_TextChanged. -->
                            <TextBox x:Name="ReceivingScanBox" Width="240"
                                     Watermark="{DynamicResource warehouse.receivingScanHint}"
                                     TextChanged="ReceivingScan_TextChanged"
                                     KeyDown="ReceivingScan_KeyDown"/>
                            <!-- 2026-10-04, Android: камера аппарата как сканер (CameraScan). -->
                            <Button Classes="SecondaryButton"
                                    IsVisible="{OnPlatform False, Android=True}"
                                    Click="CameraScanButton_Click" Focusable="False"
                                    ToolTip.Tip="{DynamicResource csh.cart.cameraScan}">
                                <TextBlock Classes="mdl2" Text="&#xE722;" FontSize="18" VerticalAlignment="Center"/>
                            </Button>
                            <TextBox x:Name="ReceivingQuantityBox" Width="90" Text="1"
                                     KeyDown="ReceivingQuantity_KeyDown"/>
                            <Button Classes="SecondaryButton"
                                    Content="{DynamicResource warehouse.transferPickFromList}"
                                    Click="ReceivingPickFromList_Click"/>
                            <Button Classes="SecondaryButton"
                                    Content="{DynamicResource warehouse.transferRemoveItem}"
                                    Click="ReceivingRemove_Click"/>
                            <!-- Товар без скана: пустая строка, название/штрихкод/цены вписываются в
                                 таблице. Можно добавлять подряд (2026-09-26). -->
                            <Button Classes="SecondaryButton"
                                    Content="{DynamicResource warehouse.receivingAddNew}"
                                    Click="ReceivingAddNew_Click"/>
                            <!-- 2026-10-29: «Наценка…» (правила автонаценки) и «Очистить список» — в верхнем ряду; внизу остаётся итоговая панель (спека Fable). -->
                            <Button Classes="SecondaryButton" x:Name="ReceivingMarkupButton" Click="ReceivingMarkup_Click"/>
                            <Button Classes="SecondaryButton" x:Name="ReceivingClearButton" Click="ReceivingClear_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="2" x:Name="ReceivingSuggestionsBox" IsVisible="False"
                                Margin="0,0,0,8" Padding="4"
                                Background="{DynamicResource BrushPanelSoft}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                CornerRadius="8">
                            <!-- 2026-10-11, тестировщик (склад.md, 2.2.4): «список зависает, и его никак не убрать» — крестик закрытия. -->
                            <Grid RowDefinitions="Auto,Auto">
                            <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" Classes="SecondaryButton row-x" Padding="10,2" Margin="0,0,0,2"
                                    Click="ReceivingSuggestionsClose_Click"/>
                            <ItemsControl Grid.Row="1" x:Name="ReceivingSuggestionsPanel" x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="list-item"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,1" Padding="10,6"
                                                Tag="{Binding}"
                                                Click="ReceivingSuggestion_Click">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="{ReflectionBinding Title}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <!-- 2026-10-24: товар выбранного поставщика (приходил раньше) — значком, такие подсказки идут первыми. -->
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{DynamicResource BrushAccent}"
                                                           Text="{x:Static views:WarehouseWindow.SupplierBadgeText}"
                                                           IsVisible="{ReflectionBinding Id, Converter={x:Static views:WarehouseWindow.IsSupplierProductConverter}}"/>
                                                <TextBlock Grid.Column="2" Text="{ReflectionBinding Barcode}" Margin="12,0"
                                                           VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{DynamicResource BrushTextSoft}"/>
                                                <TextBlock Grid.Column="3" Text="{ReflectionBinding StockInfo}"
                                                           VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{DynamicResource BrushTextSoft}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Поставщик и оплата. С поставщиком приход проводится документом
                             «Закупки» сайта, без него — пишется прямо в товар. -->
                        <!-- Без выпадающих списков (2026-09-25): у окна склада своя рамка без
                             системного хрома, и всплывающий список ComboBox в нём не открывается
                             (так же не работал фильтр статусов перемещений). Поставщик — кнопка с
                             раскрывающимся прямо в окне списком, оплата — два переключателя. -->
                        <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,10" x:CompileBindings="False">
                            <WrapPanel>
                                <WrapPanel.Styles>
                                    <Style Selector="WrapPanel > :is(Control)"><Setter Property="Margin" Value="0,0,10,8"/></Style>
                                </WrapPanel.Styles>
                                <TextBlock Text="{DynamicResource warehouse.receivingSupplier}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                                <!-- 2026-10-27 (приёмка 1.17.63, Д-10): имя для диктора — выбранный поставщик (читалось «Без поставщика» и после выбора). -->
                                <Button x:Name="ReceivingSupplierButton" Classes="SecondaryButton" Width="190"
                                        AutomationProperties.Name="{Binding ReceivingSupplier.Name}"
                                        HorizontalContentAlignment="Stretch" Click="ReceivingSupplierButton_Click">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding ReceivingSupplier.Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="▾" Margin="8,0,0,0" Foreground="{DynamicResource BrushTextSoft}"/>
                                    </Grid>
                                </Button>
                                <!-- 2026-10-24, ТЗ «Склад» (пакет В): «＋» — создать поставщика прямо в приёмке (WarehouseWindow.ReceivingScan.cs → SupplierQuickCreate). -->
                                <Button x:Name="ReceivingNewSupplierButton" Classes="SecondaryButton" Width="44" Height="44" Padding="0"
                                        HorizontalContentAlignment="Center" Click="ReceivingNewSupplier_Click">
                                    <TextBlock Text="＋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Border Classes="sec-segment" IsVisible="{Binding HasReceivingSupplier}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <RadioButton x:Name="ReceivingPaidRadio" GroupName="ReceivingPayment" Classes="sec-seg" IsChecked="True"
                                                     Content="{DynamicResource warehouse.receivingPaidNow}" Click="ReceivingPayment_Click"/>
                                        <RadioButton x:Name="ReceivingDebtRadio" GroupName="ReceivingPayment" Classes="sec-seg"
                                                     Content="{DynamicResource warehouse.receivingOnDebt}" Click="ReceivingPayment_Click"/>
                                    </StackPanel>
                                </Border>
                                <!-- 2026-10-24, ТЗ «Склад» (Б1): вместо 60 кнопок — «Товары поставщика (N)»: панель с поиском и списком. -->
                                <Button x:Name="ReceivingSupplierProductsButton" Classes="SecondaryButton" IsVisible="False"
                                        Click="ReceivingSupplierProducts_Click"/>
                                <!-- 2026-10-27: «Загрузить накладную» — электронная накладная Excel/CSV/XML (WarehouseWindow.InvoiceImport.cs). -->
                                <Button x:Name="ReceivingInvoiceImportButton" Classes="SecondaryButton" Height="44"
                                        Click="ReceivingInvoiceImport_Click"/>
                            </WrapPanel>
                            <Border x:Name="ReceivingSupplierPanel" IsVisible="False" Width="400" HorizontalAlignment="Left"
                                    Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <StackPanel Spacing="4">
                                    <!-- 2026-10-24: поиск по названию и цифрам телефона (как в PurchasesSupplierPicker). -->
                                    <TextBox x:Name="ReceivingSupplierSearch" TextChanged="ReceivingSupplierSearch_TextChanged"/>
                                    <ListBox x:Name="ReceivingSupplierList" MaxHeight="240"
                                             ItemsSource="{Binding ReceivingSuppliers}"
                                             SelectionChanged="ReceivingSupplierList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{ReflectionBinding Name}" Foreground="{DynamicResource BrushText}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <!-- 2026-10-11, тестировщик (склад.md, 2.2.1): товары, которые раньше приходовали от выбранного поставщика
                                 (WarehouseWindow.ReceivingScan.cs → ShowSupplierProductsAsync). 2026-10-24, ТЗ «Склад» (Б1): панель с поиском и
                                 списком (виртуализирован) вместо 60 кнопок — 20 позиций из 600 находятся поиском, без прокрутки. -->
                            <Border x:Name="ReceivingSupplierProductsBox" IsVisible="False" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ReceivingSupplierProductsTitle" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Classes="SecondaryButton row-x" Padding="10,2" Margin="8,0,0,0"
                                                Click="ReceivingSupplierProductsClose_Click"/>
                                    </Grid>
                                    <TextBox x:Name="ReceivingSupplierProductsSearch" TextChanged="ReceivingSupplierProductsSearch_TextChanged"
                                             KeyDown="ReceivingSupplierProductsSearch_KeyDown"/>
                                    <ListBox x:Name="ReceivingSupplierProductsList" Background="Transparent">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="list-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        MinHeight="32" Padding="8,2" Tag="{Binding}" Click="ReceivingSupplierProduct_Click">
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <TextBlock Grid.Column="0" Text="{ReflectionBinding Title}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{ReflectionBinding Info}" Margin="12,0" VerticalAlignment="Center"
                                                                   FontSize="11.5" Foreground="{DynamicResource BrushTextSoft}"/>
                                                        <TextBlock Grid.Column="2" Text="＋" FontSize="16" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource BrushAccent}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Количество и обе цены правятся прямо в таблице: со сканера приходит
                             по одной единице, а в накладной обычно коробка. Название и единицу
                             можно вписать только у нового товара — у существующего они живут в
                             карточке склада (см. ReceivingGrid_BeginningEdit). -->
                        <DataGrid Grid.Row="4" x:Name="ReceivingGrid"
                                  x:CompileBindings="False"
                                  ItemsSource="{Binding ReceivingLines}"
                                  AutoGenerateColumns="False"
                                  BeginningEdit="ReceivingGrid_BeginningEdit"
                                  CellEditEnded="ReceivingGrid_CellEditEnded"
                                  CellPointerPressed="ReceivingGrid_CellPointerPressed"
                                  RowHeight="52" ColumnHeaderHeight="44">
                            <DataGrid.Resources>
                                <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- 2026-10-29, спека Fable (Specs-1029/01): порядок (0–13) — Название (+подстрока «источник · категория») · Штрихкод · Ед. · На складе · Принимаем · Закупка ·
                                     Наценка % · Цена продажи · Закупка изменилась · Как посчитана цена · Прибыль с шт. · Сумма закупки · Размеры · ✕. Код обращается к колонкам по именам
                                     RcvCol* (WarehouseWindow.ReceivingScan.cs) — при смене порядка править только их. Редактируются 4 ячейки (класс rcv-edit — подчёркивание). -->
                                <DataGridTemplateColumn Width="*" MinWidth="170" SortMemberPath="ProductName">
                                    <DataGridTemplateColumn.Header><TextBlock x:Name="RcvNameHeader"/></DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="2,0" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{ReflectionBinding ProductName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border Classes="rcv-newbadge" IsVisible="{ReflectionBinding IsNew}">
                                                        <TextBlock Text="{ReflectionBinding NewBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="rcv-sub" Text="{ReflectionBinding NameSubText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{ReflectionBinding ProductName, Mode=TwoWay}" VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="108"
                                                    Binding="{ReflectionBinding Barcode}">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvBarHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="48"
                                                    Binding="{ReflectionBinding Unit}">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvUnitHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="68"
                                                    Binding="{ReflectionBinding StockBefore, StringFormat=\{0:0.###\}}" IsReadOnly="True">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvWasHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="92"
                                                    Binding="{ReflectionBinding QuantityText, Converter={x:Static views:WarehouseWindow.CommaDecimal}}">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvTakenHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="88"
                                                    Binding="{ReflectionBinding PurchasePriceText, Converter={x:Static views:WarehouseWindow.CommaDecimal}}">
                                    <DataGridTextColumn.Header>
                                        <StackPanel><TextBlock x:Name="RcvPurchaseHeader"/><TextBlock x:Name="RcvPurchaseSub" Classes="hdr-sub"/></StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="84"
                                                    Binding="{ReflectionBinding MarkupText, Converter={x:Static views:WarehouseWindow.CommaDecimal}}">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvMarkupHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="92"
                                                    Binding="{ReflectionBinding SalePriceText, Converter={x:Static views:WarehouseWindow.CommaDecimal}}">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvSaleHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- «Закупка изменилась»: «↑ дороже на 5 сом (+3 %)» красным · «↓ дешевле…» зелёным · «без изменений», «новый товар» серым; ниже «было 145,00».
                                     На 1024 (класс rcv-compact у таблицы): только «↑ +3 %», подстрока скрыта. -->
                                <DataGridTemplateColumn Width="132" IsReadOnly="True">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel><TextBlock x:Name="RcvChangeHeader"/><TextBlock x:Name="RcvChangeSub" Classes="hdr-sub"/></StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="2,0" Spacing="1" ToolTip.Tip="{ReflectionBinding PurchaseChangeHint}">
                                                <TextBlock Classes="chg chg-long" Classes.up="{ReflectionBinding IsChangeUp}" Classes.down="{ReflectionBinding IsChangeDown}"
                                                           Text="{ReflectionBinding PurchaseChangeText}"/>
                                                <TextBlock Classes="chg chg-short" Classes.up="{ReflectionBinding IsChangeUp}" Classes.down="{ReflectionBinding IsChangeDown}"
                                                           Text="{ReflectionBinding PurchaseChangeShort}"/>
                                                <TextBlock Classes="rcv-sub" Text="{ReflectionBinding PurchaseWasText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- «Как посчитана цена»: «авто · общая 30 %» серым · «вручную · +10 %» (warning) · «⚠ маржа 8 % — мало» · «⛔ ниже закупки»; кнопка «Как у всех» у трёх последних. -->
                                <DataGridTemplateColumn Width="132" IsReadOnly="True">
                                    <DataGridTemplateColumn.Header><TextBlock x:Name="RcvAutoHeader"/></DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="2,0" Spacing="2" ToolTip.Tip="{ReflectionBinding ModeHint}">
                                                <TextBlock Classes="mode mode-auto" Text="{ReflectionBinding ModeText}" IsVisible="{ReflectionBinding IsModeAuto}"/>
                                                <TextBlock Classes="mode mode-manual" Text="{ReflectionBinding ModeText}" IsVisible="{ReflectionBinding IsModeManual}"/>
                                                <Border Classes="rcv-tag low" IsVisible="{ReflectionBinding IsModeLow}"><TextBlock Text="{ReflectionBinding ModeText}"/></Border>
                                                <Border Classes="rcv-tag below" IsVisible="{ReflectionBinding IsModeBelow}"><TextBlock Text="{ReflectionBinding ModeText}"/></Border>
                                                <Button Content="{ReflectionBinding ReturnToAutoText}" Tag="{Binding}" Click="ReceivingAutoSale_Click"
                                                        Classes="SecondaryButton row-x" Padding="8,0" Height="24" MinHeight="24" MinWidth="0" FontSize="11.5"
                                                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                                        IsVisible="{ReflectionBinding ShowReturnButton}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="84"
                                                    Binding="{ReflectionBinding ProfitNumberText}" IsReadOnly="True">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvProfitHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- 2026-10-19, О9: сумма с разрядами («1 155,00», было «1155»). -->
                                <DataGridTextColumn Width="96"
                                                    Binding="{ReflectionBinding LineTotal, StringFormat=\{0:N2\}}" IsReadOnly="True">
                                    <DataGridTextColumn.Header><TextBlock x:Name="RcvTotalHeader"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- 2026-10-06 (О-70, магазин одежды): «Размеры» — сколько каких принимается; нажатие открывает сетку.
                                     Заголовок и видимость — в коде. -->
                                <!-- 2026-10-06, владелец (снимок): «Размеры» обрезались («46, Чёрный ×…») — теперь в две строки, полный
                                     список во всплывающей подсказке. -->
                                <DataGridTemplateColumn Header="" Width="300" IsVisible="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding VariantSummary}" ToolTip.Tip="{ReflectionBinding VariantSummary}"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                       FontSize="12.5" LineHeight="16" VerticalAlignment="Center" Margin="10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- 2026-10-11, тестировщик (склад.md): «нужен крестик справа от товара, если случайно добавил». -->
                                <DataGridTemplateColumn Header="" Width="46" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Tag="{Binding}" Click="ReceivingRowRemove_Click" Classes="SecondaryButton row-x"
                                                    Width="32" Height="30" Padding="0" HorizontalContentAlignment="Center"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ToolTip.Tip="{DynamicResource warehouse.transferRemoveItem}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 2026-10-19, О9: пустая накладная — что делать (тексты — WarehouseWindow.O9.cs). -->
                        <!-- 2026-10-29, спека Fable: пустое состояние — иконка 72, заголовок 18, порядок клавиш (тексты — WarehouseWindow.O9.cs). -->
                        <StackPanel Grid.Row="4" x:Name="ReceivingEmptyState" Classes="empty-state" MaxWidth="540">
                            <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,6"
                                    Background="{DynamicResource BrushPanelSoft}">
                                <TextBlock Classes="mdl2" Text="&#xE722;" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextSoft}"/>
                            </Border>
                            <TextBlock x:Name="ReceivingEmptyTitle" Classes="empty-title" FontSize="18"/>
                            <TextBlock x:Name="ReceivingEmptyHint" Classes="empty-hint" FontSize="13.5"/>
                        </StackPanel>

                        <!-- 2026-10-29, спека Fable: итоговая панель — Позиций · Штук · Сумма закупки · Выручка · Прибыль · Средняя наценка · флаги · «Провести» (Accent, 48).
                             На 1024 «Выручка» и «Средняя наценка» прячутся (WarehouseWindow.O9.cs). Подписи — в коде (WarehouseWindow.ReceivingScan.cs). -->
                        <Border Grid.Row="5" Margin="0,12,0,0" Padding="14,10" CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                    <StackPanel Spacing="2"><TextBlock x:Name="SumPosCap" Classes="sum-cap"/><TextBlock x:Name="SumPos" Classes="sum-val"/></StackPanel>
                                    <StackPanel Spacing="2"><TextBlock x:Name="SumQtyCap" Classes="sum-cap"/><TextBlock x:Name="SumQty" Classes="sum-val"/></StackPanel>
                                    <Border Width="1" Height="36" Background="{DynamicResource BrushBorder}"/>
                                    <StackPanel Spacing="2"><TextBlock x:Name="SumPurchaseCap" Classes="sum-cap"/><TextBlock x:Name="SumPurchase" Classes="sum-val"/></StackPanel>
                                    <StackPanel x:Name="SumSaleBox" Spacing="2"><TextBlock x:Name="SumSaleCap" Classes="sum-cap"/><TextBlock x:Name="SumSale" Classes="sum-val"/></StackPanel>
                                    <StackPanel Spacing="2"><TextBlock x:Name="SumProfitCap" Classes="sum-cap"/><TextBlock x:Name="SumProfit" Classes="sum-val"/></StackPanel>
                                    <StackPanel x:Name="SumMarkupBox" Spacing="2"><TextBlock x:Name="SumMarkupCap" Classes="sum-cap"/><TextBlock x:Name="SumMarkup" Classes="sum-val"/></StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border x:Name="SumFlagLowBox" Classes="sum-flag low" IsVisible="False"><TextBlock x:Name="SumFlagLow" Classes="sum-flagtext"/></Border>
                                        <Border x:Name="SumFlagBelowBox" Classes="sum-flag below" IsVisible="False"><TextBlock x:Name="SumFlagBelow" Classes="sum-flagtext"/></Border>
                                    </StackPanel>
                                    <TextBlock x:Name="ReceivingSummaryText" FontSize="11.5" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource BrushTextSoft}"/>
                                </StackPanel>
                                <!-- 2026-10-24, ТЗ «Склад» (Б0/Б1): «Обновить цены продажи (N)» — видна, если есть строки с подорожанием и непоправленной продажей. -->
                                <Button Grid.Column="2" Classes="SecondaryButton" Margin="0,0,10,0" x:Name="ReceivingRaiseButton" IsVisible="False"
                                        Click="ReceivingRaise_Click"/>
                                <!-- 2026-10-25, ТЗ «оприходование в фоне» (Q2): ≤ 0,5 с на кнопке «Оприходую…» с полоской, дальше — плашка ниже. -->
                                <Button Grid.Column="3" Classes="PrimaryButton" x:Name="ReceivingCommitButton"
                                        Click="ReceivingCommit_Click"
                                        Command="{Binding CommitReceivingCommand}">
                                    <Grid>
                                        <TextBlock Text="{DynamicResource warehouse.receivingCommit}" HorizontalAlignment="Center"
                                                   IsVisible="{Binding !IsReceivingPosting}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                                    IsVisible="{Binding IsReceivingPosting}">
                                            <TextBlock x:Name="ReceivingCommitBusyText" VerticalAlignment="Center"/>
                                            <ProgressBar IsIndeterminate="True" Width="34" MinWidth="34" MaxWidth="34" Height="4" MinHeight="4" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- 2026-10-25: плашка под кнопкой — «Операция выполняется в фоне — можно продолжать работу» (нейтрально-жёлтая), итог или ошибка (не модальная). -->
                        <Border Grid.Row="6" x:Name="ReceivingBackgroundNoticeBorder" Margin="0,10,0,0" Padding="12,8" CornerRadius="8"
                                BorderThickness="1" IsVisible="{Binding HasReceivingBackgroundNotice}"
                                Classes.err="{Binding ReceivingNoticeIsError}">
                            <Border.Styles>
                                <Style Selector="Border#ReceivingBackgroundNoticeBorder">
                                    <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                </Style>
                                <Style Selector="Border#ReceivingBackgroundNoticeBorder.err">
                                    <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
                                </Style>
                            </Border.Styles>
                            <TextBlock Text="{Binding ReceivingBackgroundNotice}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}"/>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 2026-10-24, ТЗ «Склад», пакет Р2: вкладка «Ревизия» собрана кодом (WarehouseWindow.Revision.cs) на движке RevisionSession;
                 старая таблица с правкой ячеек (ошибки ТЗ 1.2) убрана. -->
            <TabItem x:Name="RevisionTabItem" Header="{DynamicResource warehouse.tabRevision}">
                <Border x:Name="RevisionPanel" Background="{DynamicResource BrushPanel}" CornerRadius="0,14,14,14" Padding="16" BoxShadow="0 4 12 0 #0D000000"/>
            </TabItem>

            <!-- Вкладка 2: Списание -->
            <TabItem x:Name="WriteOffTabItem" Header="{DynamicResource warehouse.tabWriteOff}">
                <!-- 2026-10-19, О9 (аудит, проблема 6): списание было на серой подложке и без скругления, как ни одна другая
                     вкладка; форма — фиксированной ширины 560 (на 1024 история сжималась до щели). Теперь панель как у
                     остальных вкладок, форма — белая карточка 4/10 ширины (не шире 560), история — остальное. -->
                <Border Background="{DynamicResource BrushPanel}" CornerRadius="0,14,14,14" Padding="16" BoxShadow="0 4 12 0 #0D000000">
                <Grid ColumnDefinitions="4*,16,6*">
                <Border Grid.Column="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Classes="wh-card" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <StackPanel Spacing="18">
                                <TextBlock Text="{DynamicResource warehouse.writeOffTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>

                                <!-- Поиск товара -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource warehouse.findProductLabel}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                                    <TextBox x:CompileBindings="False"
                                             Text="{Binding WriteOffSearchText}"
                                             Watermark="{DynamicResource warehouse.startTypingWatermark}"
                                             KeyDown="SearchBox_KeyDown"/>
                                    <ItemsControl x:CompileBindings="False" ItemsSource="{Binding WriteOffSearchResults}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,6" Classes="SecondaryButton" Padding="10,6"
                                                        Content="{ReflectionBinding Title}"
                                                        Command="{Binding DataContext.WriteOffPickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Товар -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource warehouse.selectedProductLabel}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding WriteOffProductName, Mode=OneWay}"
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource BrushText}"
                                             Background="{DynamicResource BrushInputAlt}" />
                                    <!-- 2026-10-19, О9: «Штрих-код:» было вписано по-русски на всех языках; без товара строки нет. -->
                                    <TextBlock Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="2,0,0,0"
                                               IsVisible="{Binding WriteOffBarcode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Run Text="{DynamicResource csh.catalog.colBarcode}"/><Run Text=": "/><Run Text="{Binding WriteOffBarcode}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Количество -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource warehouse.qtyForWriteOffLabel}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                                    <TextBox x:Name="WriteOffQuantityBox"
                                             Text="{Binding WriteOffQuantity}"
                                             FontSize="16"
                                             FontWeight="Bold"/>
                                </StackPanel>

                                <!-- Причина: обычный ComboBox — надёжная альтернатива на случай проблем
                                     с попапом ComboBox в этом окне (ExtendClientAreaToDecorationsHint) —
                                     кнопка с раскрывающимся встроенным списком без Popup. -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource warehouse.writeOffReasonLabel}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                                    <Button x:Name="WriteOffReasonButton" Classes="SecondaryButton"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Click="WriteOffReasonButton_Click">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="WriteOffReasonButtonText" Grid.Column="0"
                                                       HorizontalAlignment="Left" Foreground="{DynamicResource BrushText}"/>
                                            <TextBlock Grid.Column="1" Text="⌄" FontSize="13" Foreground="{DynamicResource BrushTextSoft}"/>
                                        </Grid>
                                    </Button>
                                    <Border x:Name="WriteOffReasonListBorder" IsVisible="False"
                                            Background="{DynamicResource BrushPanel}"
                                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="4">
                                        <StackPanel x:Name="WriteOffReasonListPanel" Spacing="2"/>
                                    </Border>
                                </StackPanel>

                                <Separator Height="1" Background="{DynamicResource BrushBorder}" Margin="0,6"/>

                                <!-- Кнопка отправки -->
                                <Button Content="{DynamicResource warehouse.confirmWriteOffButton}"
                                        Classes="PrimaryButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding WriteOffCommand}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Border>

                <!-- История списаний (AI-фичи 2026-09-04) — локальный журнал этой кассы, см.
                     WarehouseViewModel.WriteOffHistory/WriteOffHistoryStore — API актов
                     списания не даёт прочитать историю обратно с сервера. -->
                <Border Grid.Column="2">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="{DynamicResource warehouse.writeOffHistoryTitle}"
                                       FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="SecondaryButton" FontSize="13" Padding="12,6"
                                    Content="{DynamicResource warehouse.writeOffHistoryExpandButton}"
                                    Click="ExpandWriteOffHistory_Click"/>
                        </Grid>
                        <!-- 2026-10-19, О9: история — белая таблица; «Количество» вместо «Количество для списания» (обрезалось
                             «Коли»); на узкой таблице «Кассир» прячется (WarehouseWindow.O9.cs). -->
                        <DataGrid Grid.Row="1" x:Name="WriteOffHistoryGrid" x:CompileBindings="False"
                                  ItemsSource="{Binding WriteOffHistory}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="44">
                            <DataGrid.Columns>
                                <!-- 2026-10-27, В-2: дата с временем «27.10.2026 11:05» не влезала в 104 (обрезалась до «27.10.2026 1») — ширина 152. -->
                                <DataGridTextColumn Width="152" Binding="{ReflectionBinding DateText}">
                                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource common.date}"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="*" MinWidth="140" Binding="{ReflectionBinding ProductName}">
                                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource common.product}"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" Binding="{ReflectionBinding QuantityText}">
                                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource common.quantity}"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="112" Binding="{ReflectionBinding Reason}">
                                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource warehouse.writeOffReasonLabel}"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="150" Binding="{ReflectionBinding CashierName}">
                                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource common.cashier}"/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" x:Name="WriteOffEmptyState" Classes="empty-state">
                            <TextBlock x:Name="WriteOffEmptyTitle" Classes="empty-title"/>
                            <TextBlock x:Name="WriteOffEmptyHint" Classes="empty-hint"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
                </Border>
            </TabItem>

            <!-- Вкладка 4: Аналитика (склад/товары) — считается локально из уже загруженного
                 каталога (CatalogCacheService.Products), без отдельных запросов к серверу.
                 Платная доп. услуга (2026-09-04) — пока не куплена и не активирована в
                 Маркетплейс → Доп. функции, вкладка вообще не показывается (не просто заблокирована
                 поверх — её нет в списке табов, см. WarehouseWindow.axaml.cs, RefreshPaidFeatureVisibility). -->
            <!-- Вкладка: перемещение товаров. Журнал того, что уходило со склада — продажи и
                 списания в одном списке. До этого движение можно было смотреть только по одному
                 товару за раз, открыв его карточку из каталога. -->
            <TabItem x:Name="MovementsTabItem" Header="{DynamicResource warehouse.tabMovements}">
                <Border Background="{DynamicResource BrushPanel}" CornerRadius="0,14,14,14" Padding="16" BoxShadow="0 4 12 0 #0D000000">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- 2026-10-19, О9: строка переносится (на 1024 «Excel», «Word» уходили за край); переключатели — сегменты. -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <!-- Два разных вопроса в одном разделе: «какие отгрузки идут между
                                 складами» и «что вообще уходило со склада». Первый — документы с
                                 маршрутом и статусом, второй — сплошной журнал расхода. -->
                            <Border Classes="sec-segment" Margin="0,0,10,8">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton x:Name="TransfersDocsRadio" GroupName="MovementsSection" Classes="sec-seg" IsChecked="True"
                                                 Content="{DynamicResource warehouse.transfersDocs}" Click="MovementsSection_Changed"/>
                                    <RadioButton x:Name="TransfersFlowRadio" GroupName="MovementsSection" Classes="sec-seg"
                                                 Content="{DynamicResource warehouse.transfersFlow}" Click="MovementsSection_Changed"/>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="MovementsSearchBox" Width="280" Margin="0,0,10,8"
                                     Watermark="{DynamicResource warehouse.movementsSearchHint}"
                                     TextChanged="MovementsFilter_Changed"/>
                            <Border Classes="sec-segment" Margin="0,0,10,8" IsVisible="{Binding #MovementsWeekRadio.IsVisible}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton x:Name="MovementsWeekRadio" GroupName="MovementsPeriod" Classes="sec-seg" IsChecked="True"
                                                 Content="{DynamicResource warehouse.movementsWeek}" Click="MovementsFilter_Changed"/>
                                    <RadioButton x:Name="MovementsMonthRadio" GroupName="MovementsPeriod" Classes="sec-seg"
                                                 Content="{DynamicResource warehouse.movementsMonth}" Click="MovementsFilter_Changed"/>
                                    <RadioButton x:Name="MovementsQuarterRadio" GroupName="MovementsPeriod" Classes="sec-seg"
                                                 Content="{DynamicResource warehouse.movementsQuarter}" Click="MovementsFilter_Changed"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="CreateTransferButton" Classes="PrimaryButton" IsVisible="False" Margin="0,0,8,8"
                                    Content="{DynamicResource warehouse.transferCreate}"
                                    Click="CreateTransfer_Click"/>
                            <!-- Выгрузка всего журнала: для инвентаризации и разбора нужен список
                                 документов целиком, а не по одному открытому. -->
                            <Button x:Name="TransfersExcelButton" Classes="SecondaryButton" IsVisible="False" Margin="0,0,8,8"
                                    Content="Excel" Click="ExportTransfersExcel_Click"/>
                            <Button x:Name="TransfersWordButton" Classes="SecondaryButton" IsVisible="False" Margin="0,0,0,8"
                                    Content="Word" Click="ExportTransfersWord_Click"/>
                        </WrapPanel>

                        <!-- Фильтр статусов — кнопками, а не выпадающим списком (2026-09-25, «статусы
                             серые, не нажимаются»): у окна склада своя рамка без системного хрома, и
                             всплывающий список ComboBox в таком окне у Avalonia не открывается. -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                            <Border Grid.Column="0" Classes="sec-segment" IsVisible="{Binding #TransferStatusPills.IsVisible}">
                                <StackPanel x:Name="TransferStatusPills" Orientation="Horizontal" Spacing="2" IsVisible="False"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="MovementsSummaryText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}"/>
                        </Grid>

                        <DataGrid Grid.Row="2" x:Name="TransfersGrid"
                                  x:CompileBindings="False"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="46"
                                  DoubleTapped="TransferRow_Opened">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.transferNumber}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding Number}" VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="156">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.movementsWhen}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding WhenText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextSoft}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.transferRoute}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding RouteText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{ReflectionBinding RouteText}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="160">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.transferStatus}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource BrushAccentSoft}"
                                                    Classes.transit="{ReflectionBinding IsInTransit}"
                                                    Classes.done="{ReflectionBinding IsDelivered}"
                                                    Classes.writeoff="{ReflectionBinding IsCancelled}">
                                                <TextBlock Text="{ReflectionBinding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushAccentStrong}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.transferItems}" TextAlignment="Right"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding ItemsText}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="200">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.transferResponsible}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding ResponsibleText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextSoft}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Row="2" x:Name="MovementsGrid" IsVisible="False"
                                  x:CompileBindings="False"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="150">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.movementsWhen}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding WhenText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextSoft}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource common.name}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding ProductName}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{ReflectionBinding ProductName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="150">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.movementsKind}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource BrushAccentSoft}"
                                                    Classes.writeoff="{ReflectionBinding IsWriteOff}">
                                                <TextBlock Text="{ReflectionBinding KindText}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushAccentStrong}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="136">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.movementsQuantity}" TextAlignment="Right"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding QuantityText}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" FontWeight="Bold" Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="260">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource warehouse.movementsNote}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ReflectionBinding Note}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextSoft}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 2026-10-19, О9: пустой журнал — что делать (тексты — WarehouseWindow.O9.cs). -->
                        <StackPanel Grid.Row="2" x:Name="MovementsEmptyState" Classes="empty-state">
                            <TextBlock x:Name="MovementsEmptyTitle" Classes="empty-title"/>
                            <TextBlock x:Name="MovementsEmptyHint" Classes="empty-hint"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem x:Name="AnalyticsTabItem" Header="{DynamicResource warehouse.tabAnalytics}" IsVisible="False">
                <Border Background="{DynamicResource BrushPanel}" CornerRadius="0,14,14,14" Padding="16" BoxShadow="0 4 12 0 #0D000000">
                    <!-- Содержимое вынесено в Views/Analytics/WarehouseStockAnalyticsView (2026-09-27):
                         тот же блок стоит вкладкой «Склад» в разделе «Аналитика» программы владельца. -->
                    <analytics:WarehouseStockAnalyticsView x:Name="StockAnalyticsView"/>
                </Border>
            </TabItem>

            <!-- Вкладка: Редактор этикетки — всегда видна (в отличие от Аналитики выше), но сам
                 редактор платный с 2026-09-07 (EnsureLabelEditorUnlocked): подпись «Бесплатно»
                 в описании осталась с тех времён и противоречила запросу серийного номера. Кнопка открывает тот же LabelTemplateEditorDialog, что и кнопка "Печать"
                 на строке товара и карточка в Маркетплейсе (2026-09-06, по просьбе пользователя —
                 отдельный раздел в Складе, а не только через диалог печати одного товара). -->
            <TabItem x:Name="LabelEditorTabItem" Header="{DynamicResource warehouse.tabLabelEditor}">
                <Border Background="{DynamicResource BrushPanel}" CornerRadius="0,14,14,14" Padding="16" BoxShadow="0 4 12 0 #0D000000">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   Foreground="{DynamicResource BrushTextSoft}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource warehouse.labelEditorTabTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource warehouse.labelEditorTabDescription}" FontSize="13"
                                   Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" TextAlignment="Center"/>
                        <!-- 2026-10-21 (пакет 1, п. 110): цена и где купить; подпись кнопки — по состоянию (WarehouseWindow.O9.cs). -->
                        <TextBlock x:Name="LabelEditorPaidText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="LabelEditorOpenButton" Content="{DynamicResource warehouse.labelEditorTabButton}" Classes="PrimaryButton"
                                HorizontalAlignment="Center" Click="OpenLabelEditorTab_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Модальный индикатор загрузки (IsBusy) -->
        <Border Grid.RowSpan="2"
                Background="#60000000"
                ZIndex="10"
                IsVisible="{Binding IsBusy}"
                CornerRadius="12">
            <Border Background="{DynamicResource BrushPanel}"
                    CornerRadius="16"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 20 25 -5 #20000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6" CornerRadius="3" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="{DynamicResource warehouse.savingData}" Foreground="{DynamicResource BrushText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
