<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.BulkImportWindow"
        x:CompileBindings="False"
        Title="{DynamicResource bulkImport.title}"
        Height="720" Width="992" MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        FontFamily="Segoe UI, Inter, Noto Sans"
        Background="{DynamicResource DialogWindowBackground}">
    <Window.Styles>
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <!-- 2026-10-27: прозрачность выключенной 0.5 → 0,7: в тёмной теме надпись выключенной кнопки была 1,5–2,5:1 (нужно ≥3:1). -->
        <Style Selector="Button.PrimaryButton:disabled">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
        <!-- 2026-10-19, О9: заголовок переносится и занимает место значка сортировки (как в «Складе»): «№», «Кол-во» обрезались. -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="DataGridColumnHeader TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="Margin" Value="0,0,-24,0"/>
        </Style>
    </Window.Styles>

    <!-- 2026-10-24 (аудит круга 8, С-8, пакет П-10): окно переведено на общую оболочку ModalShell (карточка 960) —
         белая карточка, шапка с названием и пояснением, ✕ 44 px, «Закрыть» (Esc) и «Загрузить» в подвале, итог слева
         на строке кнопок. Было: серый фон, своя шапка с кнопкой «Закрыть» текстом, без ✕. Загрузка и сохранение
         (разбор CSV, проверка строк, StartImport_Click) не менялись; DataGrid получает всю оставшуюся высоту. -->
    <dlg:ModalShell x:Name="Shell" Margin="16" ContentScroll="Disabled"
                    Title="{DynamicResource bulkImport.title}" Subtitle="{DynamicResource bulkImport.description}">
        <dlg:ModalShell.Hint>
            <TextBlock x:Name="SummaryText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushText}"/>
        </dlg:ModalShell.Hint>
        <dlg:ModalShell.Footer>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button IsCancel="True" Classes="modal-cancel" MaxWidth="200"
                        Content="{DynamicResource common.close}" Click="Close_Click"/>
                <Button x:Name="StartImportButton" Classes="modal-primary" MaxWidth="260"
                        Content="{DynamicResource bulkImport.startButton}" IsEnabled="False" Click="StartImport_Click"/>
            </StackPanel>
        </dlg:ModalShell.Footer>

        <Grid RowDefinitions="Auto,*">
            <!-- Панель действий -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,12">
                <Button Grid.Column="0" Content="{DynamicResource bulkImport.downloadTemplate}" Classes="modal-secondary" Click="DownloadTemplate_Click"/>
                <Button Grid.Column="1" Content="{DynamicResource bulkImport.pickFile}" Classes="modal-secondary" Margin="8,0,0,0" Click="PickFile_Click"/>
                <TextBlock Grid.Column="2" x:Name="FileNameText" FontSize="12" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1">
        <!-- Предпросмотр -->
        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50" Binding="{Binding RowNumber}">
                    <DataGridTextColumn.Header><TextBlock Text="№"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Width="2*" Binding="{Binding Name}">
                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource bulkImport.colName}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Width="140" Binding="{Binding Barcode}">
                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource csh.catalog.colBarcode}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Width="80" Binding="{Binding QuantityText}">
                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource bulkImport.colQty}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Width="80" Binding="{Binding PriceText}">
                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource csh.catalog.colPrice}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Width="1.3*" Binding="{Binding StatusText}">
                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource bulkImport.colStatus}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Spacing="6"
                    IsHitTestVisible="False" IsVisible="{Binding #PreviewGrid.ItemsSource, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock x:Name="EmptyHintTitle" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushText}"/>
            <TextBlock x:Name="EmptyHintText" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSoft}"/>
        </StackPanel>
            </Grid>
        </Grid>
    </dlg:ModalShell>
</Window>
