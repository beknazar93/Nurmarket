<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.StaffTimesheetWindow"
        x:CompileBindings="False"
        Title="{DynamicResource staffTimesheet.title}"
        Height="640" Width="1112"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}"
        Loaded="Window_Loaded">

    <!-- 2026-10-22 (аудит новой сборки, П2): было окно в системной рамке Windows с обрезанными заголовками столбцов
         («Смен», «Дней»). Теперь общая оболочка ModalShell: шапка и «Закрыть» закреплены, таблица прокручивается сама,
         заголовки столбцов переносятся на вторую строку, у столбцов есть минимальная ширина. -->
    <Window.Styles>
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="TextBlock.colHeader">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <dlg:ModalShell x:Name="Shell" Margin="16" ContentScroll="Disabled"
                    Title="{DynamicResource staffTimesheet.title}"
                    Subtitle="{DynamicResource staffTimesheet.description}">
        <dlg:ModalShell.Footer>
            <Button IsCancel="True" IsDefault="True" Classes="modal-cancel" MaxWidth="200"
                    Content="{DynamicResource common.close}" Click="Close_Click"/>
        </dlg:ModalShell.Footer>

        <Grid RowDefinitions="Auto,*">
            <!-- 2026-11-08 (запрос владельца «вернуть табель»): две вкладки — «Отметки» (сетка сотрудники × дни месяца, ручные отметки и автоотметка)
                 и «Итоги по сменам» (прежняя таблица по закрытым сменам, без изменений). -->
            <Border Grid.Row="0" Classes="Card" Margin="0,0,0,12" Padding="10,8">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Classes="sec-segment" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="MarksTabRadio" GroupName="TimesheetTab" Classes="sec-seg" IsChecked="True" Click="Tab_Click"/>
                            <RadioButton x:Name="ShiftsTabRadio" GroupName="TimesheetTab" Classes="sec-seg" Click="Tab_Click"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="MonthBar" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="PrevMonthButton" Content="‹" Classes="SecondaryButton" MinWidth="44" MinHeight="44" Padding="8,0" Click="PrevMonth_Click"/>
                        <TextBlock x:Name="MonthText" MinWidth="140" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource BrushText}"/>
                        <Button x:Name="NextMonthButton" Content="›" Classes="SecondaryButton" MinWidth="44" MinHeight="44" Padding="8,0" Click="NextMonth_Click"/>
                        <Button x:Name="ThisMonthButton" Classes="SecondaryButton" MinHeight="44" Click="ThisMonth_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="PeriodBar" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="False">
                        <TextBlock Text="{DynamicResource staffTimesheet.periodLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,10,0"/>
                        <CalendarDatePicker x:Name="FromDatePicker" Width="160" Margin="0,0,10,0" Watermark="{DynamicResource staffTimesheet.fromWatermark}" SelectedDateChanged="DateFilter_Changed"/>
                        <TextBlock Text="—" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,10,0"/>
                        <CalendarDatePicker x:Name="ToDatePicker" Width="160" Margin="0,0,10,0" Watermark="{DynamicResource staffTimesheet.toWatermark}" SelectedDateChanged="DateFilter_Changed"/>
                        <Button Content="{DynamicResource staffTimesheet.allPeriod}" Classes="SecondaryButton" Margin="0,0,10,0" Click="ClearFilter_Click"/>
                    </StackPanel>
                    <Button Content="{DynamicResource common.refresh}" Classes="SecondaryButton" MinHeight="44" Margin="0,0,10,0" Click="Refresh_Click"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" MaxWidth="460"/>
                </WrapPanel>
            </Border>

            <!-- Вкладка «Отметки» -->
            <Grid x:Name="MarksPanel" Grid.Row="1" RowDefinitions="Auto,*,Auto">
                <WrapPanel x:Name="ActionsPanel" Grid.Row="0" Margin="0,0,0,8">
                    <Button x:Name="MarkAllTodayButton" Classes="SecondaryButton" MinHeight="44" Margin="0,0,8,4" Click="MarkAllToday_Click"/>
                    <Button x:Name="CopyYesterdayButton" Classes="SecondaryButton" MinHeight="44" Margin="0,0,8,4" Click="CopyYesterday_Click"/>
                    <Button x:Name="JournalButton" Classes="SecondaryButton" MinHeight="44" Margin="0,0,8,4" Click="Journal_Click"/>
                </WrapPanel>
                <Border Grid.Row="1" Classes="Card" Padding="0" ClipToBounds="True">
                    <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="TableGrid"/>
                    </ScrollViewer>
                </Border>
                <WrapPanel x:Name="LegendPanel" Grid.Row="2" Margin="0,8,0,0"/>
            </Grid>

            <!-- Вкладка «Итоги по сменам» (прежняя таблица) -->
            <Border x:Name="ShiftsPanel" Grid.Row="1" Classes="Card" IsVisible="False">
                <DataGrid x:Name="TimesheetGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2.4*" MinWidth="170" Binding="{Binding Cashier}">
                            <DataGridTextColumn.Header><TextBlock Classes="colHeader" Text="{DynamicResource staffTimesheet.colCashier}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="0.8*" MinWidth="96" Binding="{Binding ShiftCountText}">
                            <DataGridTextColumn.Header><TextBlock Classes="colHeader" Text="{DynamicResource staffTimesheet.colShifts}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="0.8*" MinWidth="96" Binding="{Binding DaysWorkedText}">
                            <DataGridTextColumn.Header><TextBlock Classes="colHeader" Text="{DynamicResource staffTimesheet.colDays}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="1.5*" MinWidth="120" Binding="{Binding TotalWorkedText}">
                            <DataGridTextColumn.Header><TextBlock Classes="colHeader" Text="{DynamicResource staffTimesheet.colHours}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="1.5*" MinWidth="130" Binding="{Binding AverageShiftText}">
                            <DataGridTextColumn.Header><TextBlock Classes="colHeader" Text="{DynamicResource staffTimesheet.colAvgShift}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="1.7*" MinWidth="130" Binding="{Binding TotalRevenueText}">
                            <DataGridTextColumn.Header><TextBlock Classes="colHeader" Text="{DynamicResource staffTimesheet.colRevenue}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="2.4*" MinWidth="190" Binding="{Binding PeriodText}">
                            <DataGridTextColumn.Header><TextBlock Classes="colHeader" Text="{DynamicResource staffTimesheet.colPeriod}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </dlg:ModalShell>
</Window>
