<Window x:Class="NurMarketKassa.AvaloniaHost.Views.ServicesWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        Title="{DynamicResource services.title}"
        Width="912" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <!-- 2026-11-12 (Д-4): окно в общей рамке ModalShell (заголовок, ✕, «Закрыть» внизу), карточки на токенах темы, одна главная кнопка —
         «Перейти»; «Подключить» — вторичная. Раньше: серые кнопки, коричневая «Перейти», большие пустые поля, свой крестик слева.
         (Окно пока нигде не открывается — зарегистрировано в App.axaml.cs; вид готов к подключению.) -->
    <dlg:ModalShell x:Name="Shell" Margin="16"
                    Title="{DynamicResource services.title}"
                    Subtitle="{DynamicResource services.subtitle}">
        <dlg:ModalShell.Footer>
            <Button IsCancel="True" Content="{DynamicResource common.close}" Classes="modal-cancel" MaxWidth="200"
                    Click="CloseButton_Click"/>
        </dlg:ModalShell.Footer>

        <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource services.integrationsLabel}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSoft}"/>
            <UniformGrid Columns="3" Margin="-4,0">
                <Border Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource SettingsCardRadius}" Padding="20" Margin="4">
                    <Grid RowDefinitions="Auto,*,Auto" MinHeight="170">
                        <TextBlock Text="WhatsApp" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource services.whatsappDesc}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextSoft}" FontSize="13"/>
                        <Button Grid.Row="2" Content="{DynamicResource services.connectButton}" Classes="modal-secondary" HorizontalAlignment="Left"
                                Margin="0,16,0,0" Click="WhatsAppConnect_Click"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource SettingsCardRadius}" Padding="20" Margin="4">
                    <Grid RowDefinitions="Auto,*,Auto" MinHeight="170">
                        <TextBlock Text="Telegram" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource services.telegramDesc}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextSoft}" FontSize="13"/>
                        <Button Grid.Row="2" Content="{DynamicResource services.connectButton}" Classes="modal-secondary" HorizontalAlignment="Left"
                                Margin="0,16,0,0" Click="TelegramConnect_Click"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource SettingsCardRadius}" Padding="20" Margin="4">
                    <Grid RowDefinitions="Auto,*,Auto" MinHeight="170">
                        <TextBlock Text="{DynamicResource services.cashierInterfaceTitle}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource services.cashierInterfaceDesc}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextSoft}" FontSize="13"/>
                        <Button Grid.Row="2" Content="{DynamicResource services.goButton}" Classes="modal-primary" HorizontalAlignment="Left"
                                Margin="0,16,0,0" Click="CashierInterface_Click"/>
                    </Grid>
                </Border>
            </UniformGrid>
        </StackPanel>
    </dlg:ModalShell>
</Window>
