<Window x:Class="NurMarketKassa.AvaloniaHost.Views.AdminSupportWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        Title="{DynamicResource adminSupport.title}"
        Width="512" SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

    <Window.Styles>
        <!-- Карточка контакта: на всю ширину, касание ≥ 56 px, обводка темы. -->
        <Style Selector="Button.support-contact">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource BrushPanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.support-contact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
        </Style>
    </Window.Styles>

    <!-- 2026-10-22 (модалки, пакет 2): общая оболочка ModalShell 512 вместо своей карточки 420×580 без прокрутки — на 910×512
         «Закрыть» уходила за нижний край. Без жёлтых «волн» с цветами вручную (жёлтые пятна в тёмной теме); «Закрыть» —
         обводкой (это не главное действие), Esc и ✕ закрывают окно; контакты — карточками на всю ширину, тело прокручивается. -->
    <dlg:ModalShell Margin="16"
                    Title="{DynamicResource adminSupport.header}"
                    Subtitle="{DynamicResource adminSupport.subtitle}">
        <dlg:ModalShell.Footer>
            <Button IsCancel="True" Classes="modal-cancel" MaxWidth="200"
                    Content="{DynamicResource common.close}" Click="Close_Click" />
        </dlg:ModalShell.Footer>

        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True">
                    <Image Source="/Assets/app-logo.png" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="NurCRM" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushText}" />
            </StackPanel>
                <Button Classes="support-contact" Click="Phone_Click">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource BrushWarningSoft}">
                            <TextBlock Text="☎" FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource BrushWarning}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="+996 221068796" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </Grid>
                </Button>
                <Button Classes="support-contact" Click="WhatsApp_Click">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource BrushWarningSoft}">
                            <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource BrushWarning}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="+996 221068796 (WhatsApp)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </Grid>
                </Button>
                <Button Classes="support-contact" Click="Website_Click">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource BrushWarningSoft}">
                            <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource BrushWarning}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="https://nurcrm.kg/" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </Grid>
                </Button>
        </StackPanel>
    </dlg:ModalShell>
</Window>
