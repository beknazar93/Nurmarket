<Window x:Class="NurMarketKassa.AvaloniaHost.Views.SalesWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
        xmlns:analytics="using:NurMarketKassa.AvaloniaHost.Views.Analytics"
        xmlns:ctl="using:NurMarketKassa.AvaloniaHost.Views.Controls"
        x:CompileBindings="False"
        Title="{DynamicResource csh.menu.sales}"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <conv:AmountToColorConverter x:Key="AmountColor" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Вкладки окна и вкладки срезов ABC — как вкладки разделов, а не крупные вкладки Fluent по умолчанию.
             2026-10-18, этап О4: класс стоит в разметке (и в кассе) — вкладка «Чеки» теперь среди них. -->

        <Style Selector="TabControl.ownerTabs TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="TabControl.ownerTabs TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TabControl.ownerTabs TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="Background" Value="{DynamicResource BrushInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- 2026-10-18, этап О3: свои стили DatePill / PrimaryActionButton / SecondaryActionButton убраны — общие sec-seg, sec-primary, sec-outline (PosDialogStyles.axaml). -->


        <Style Selector="Border.TimeBadge">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0" />
        </Style>


        <Style Selector="Border.KpiCard">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <!-- 2026-10-18, доводка О4: шапка таблиц — цветом панели во всех темах (у Fluent в тёмной теме — чёрная полоса). -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <!-- СТИЛЬ ModernGrid -->
        <Style Selector="DataGrid.ModernGrid">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <!-- ОСНОВНАЯ СЕТКА -->
    <Grid x:Name="RootGrid" Margin="16" Background="{DynamicResource BrushPanel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: заголовок -->
            <RowDefinition Height="Auto" /> <!-- 1: панель дат (2026-10-18, этап О4: над плитками — сначала период, потом цифры) -->
            <RowDefinition Height="Auto" /> <!-- 2: KPI -->
            <RowDefinition Height="Auto" /> <!-- 3: время -->
            <RowDefinition Height="*" />    <!-- 4: таблица + доп. контент (растягивается) -->
            <RowDefinition Height="Auto" /> <!-- 5: ошибка -->
        </Grid.RowDefinitions>
        <!-- Полоска загрузки, пока данные идут с сервера (2026-09-25, просьба владельца). -->
        <ProgressBar Grid.Row="0" Margin="0,-10,0,0" IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="3" MinHeight="3" CornerRadius="2" VerticalAlignment="Top" IsHitTestVisible="False" ZIndex="100" Foreground="{DynamicResource BrushAccent}" Background="Transparent"/>

        <!-- 0: Заголовок -->
        <Grid Grid.Row="0" x:Name="HeaderRow" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TitleText" Text="{DynamicResource csh.menu.sales}" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
            <!-- 2026-10-18, доводка О4: часы кассира — в шапке справа от названия (была своя строка под плитками: пустая рамка,
                 меньше строк чеков). В программе владельца скрыты (AsOwnerSection). -->
            <Border Grid.Column="0" x:Name="ClockBadge" Classes="TimeBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,12,0">
                <TextBlock x:Name="CurrentTimeText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"
                           FontFeatures="{DynamicResource TabularNumbers}" />
            </Border>
            <!-- 2026-10-18, этап О3 (правило аудита 1): одна главная — жёлтая «Обновить» (sec-primary), Excel / Word / «Назад» —
                 обводкой (sec-outline), без серой заливки. Стили — PosDialogStyles.axaml. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushInput}" CornerRadius="8" Padding="4,0" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <!-- 2026-10-24 (аудит, круг 8, М-11): подсказка «Поиск чека: номер или товар» обрезалась при 220 -->
                    <TextBox x:Name="SearchReceiptBox" Width="320" MinWidth="320" Height="34"
                             BorderThickness="0" FontSize="14" Classes="TouchTextBox"
                             TextChanged="SearchReceiptBox_TextChanged" />
                </Border>
                <Button Content="Excel" Classes="sec-outline"
                        Margin="10,0,0,0" Click="ExportExcel_Click"
                        ToolTip.Tip="{DynamicResource loc.owner.sales.excelTip}"/>
                <Button Content="Word" Classes="sec-outline"
                        Margin="6,0,0,0" Click="ExportWord_Click"
                        ToolTip.Tip="{DynamicResource loc.owner.sales.wordTip}"/>
                <Button Content="{DynamicResource common.refresh}" Classes="sec-primary"
                        Margin="10,0,0,0" Click="Refresh_Click" />
                <Button x:Name="BackButton" Content="{DynamicResource common.back}" Classes="sec-outline"
                        Margin="10,0,0,0" Click="Back_Click" />
            </StackPanel>
        </Grid>

        <!-- 1: KPI-карточки. 2026-10-18, этап О3 (правило аудита 3): плитки по ширине (KpiTileGrid — 8 плиток на узком разделе
             встают 4 + 4), подпись переносится, сумма уменьшается целиком, а не обрезается («1 311,00 с», «Оплачено бону…»);
             суммы — цветом текста: жёлтый по светлому не читался, «Возвраты» и «Скидки» — не убыток, не красные. -->
        <!-- 2026-10-18, доводка О4: второй ряд (средний чек, чеки, скидки, бонусы) — компактные плитки (compact). -->
        <ctl:KpiTileGrid Grid.Row="2" x:Name="KpiTiles" MinTileWidth="170" Spacing="8" Margin="0,0,0,16">
            <Border Classes="sec-kpi">
                <StackPanel Spacing="4">
                    <!-- 2026-10-24 (аудит, круг 8, С-5): подпись «(без долга)» задаётся в коде через Tr.T -->
                    <TextBlock x:Name="RevenueLabel" Classes="sec-kpi-label" Text="{DynamicResource common.revenue}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="TotalSalesText" Classes="sec-kpi-value" /></Viewbox>
                </StackPanel>
            </Border>
            <Border Classes="sec-kpi">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource sales.returns}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="TotalRefundsText" Classes="sec-kpi-value" /></Viewbox>
                    <TextBlock x:Name="RefundsNoteText" FontSize="11" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Classes="sec-kpi">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource common.cash}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="CashText" Classes="sec-kpi-value" /></Viewbox>
                </StackPanel>
            </Border>
            <Border Classes="sec-kpi">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource sales.nonCashShort}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="NonCashText" Classes="sec-kpi-value" /></Viewbox>
                    <!-- 2026-09-28: смешанная оплата отдельно, как на сайте (см. UpdateStats). -->
                    <TextBlock x:Name="NonCashBreakdownText" FontSize="11" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0" IsVisible="False" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Classes="sec-kpi compact">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource sales.avgReceipt}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="AvgReceiptText" Classes="sec-kpi-value" /></Viewbox>
                </StackPanel>
            </Border>
            <Border Classes="sec-kpi compact">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ReceiptsLabel" Classes="sec-kpi-label" Text="{DynamicResource sales.receiptsCount}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="ReceiptCountText" Classes="sec-kpi-value" /></Viewbox>
                </StackPanel>
            </Border>
            <Border Classes="sec-kpi compact">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource sales.discounts}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="DiscountsText" Classes="sec-kpi-value" /></Viewbox>
                </StackPanel>
            </Border>
            <Border Classes="sec-kpi compact">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource sales.paidWithPoints}" />
                    <Viewbox Classes="sec-kpi-fit"><TextBlock x:Name="PointsRedeemedText" Classes="sec-kpi-value" /></Viewbox>
                </StackPanel>
            </Border>
        </ctl:KpiTileGrid>

        <!-- 2: Панель выбора дат -->
        <!-- 2026-10-18, этап О3 (правило аудита 2): период — сегменты в рамке, выбранный тёмно-синий (sec-seg, как «Сводка»). -->
        <WrapPanel Grid.Row="1" x:Name="PeriodBar" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Classes="sec-segment" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Content="{DynamicResource common.today}" Classes="sec-seg" IsChecked="True" Tag="Today" GroupName="QuickDate" Click="QuickDate_Click" />
                <RadioButton Content="{DynamicResource sales.yesterday}" Classes="sec-seg" Tag="Yesterday" GroupName="QuickDate" Click="QuickDate_Click" />
                <RadioButton Content="{DynamicResource common.week}" Classes="sec-seg" Tag="Week" GroupName="QuickDate" Click="QuickDate_Click" />
                <RadioButton Content="{DynamicResource common.month}" Classes="sec-seg" Tag="Month" GroupName="QuickDate" Click="QuickDate_Click" />
                <RadioButton x:Name="CustomDatePill" Content="{DynamicResource sales.customDate}" Classes="sec-seg" Tag="Custom" GroupName="QuickDate" Click="QuickDate_Click" />
            </StackPanel>
            </Border>
            <!-- 2026-10-20, проверка фильтров: поля «с / по» работают (раньше панель была скрыта, а изменение дат никто не слушал):
                 ввод даты — загрузка за этот период, выбранным становится «Спец. дата». Поля показывают и даты сегмента. -->
            <!-- 2026-10-20: период — WrapPanel: на узком окне поля дат переносятся строкой ниже, а не налезают на «Excel / Word». -->
            <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" Margin="0,2,0,2">
                <TextBlock Text="{DynamicResource sales.fromColon}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" />
                <CalendarDatePicker x:Name="FromPicker" Width="118" VerticalAlignment="Center" Margin="0,0,8,0" SelectedDateFormat="Short" SelectedDateChanged="DatePicker_DateChanged" />
                <TextBlock Text="{DynamicResource sales.toColon}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" />
                <CalendarDatePicker x:Name="ToPicker" Width="118" VerticalAlignment="Center" Margin="0,0,12,0" SelectedDateFormat="Short" SelectedDateChanged="DatePicker_DateChanged" />
            </StackPanel>
        </WrapPanel>

        <!-- 3: (время — 2026-10-18, доводка О4: в шапке) -->

        <!-- 4: ОСНОВНАЯ ТАБЛИЦА + ДОП. КОНТЕНТ -->
        <!-- 2026-10-18, этап О4 (аудит «Продажи»): чеки, показатели и ABC — вкладками на всю высоту. Раньше чеки делили
             высоту с нижними вкладками (3/5 и 2/5), и на 1366×768 в таблице было 4 строки, а ABC — окошко ~270 px со своей
             прокруткой. Вкладки — тем же видом, что в «Финансах» (ownerTabs), и в кассе. -->
        <Grid Grid.Row="4" x:Name="SalesBody">
            <TabControl x:Name="LowerTabs" Classes="ownerTabs">
                <TabItem x:Name="ChecksTab">
            <!-- Главная таблица чеков -->
            <DataGrid x:Name="SalesGrid"
                      x:CompileBindings="False"
                      Classes="ModernGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      DoubleTapped="SalesGrid_MouseDoubleClick"
                      Tapped="SalesGrid_Tapped"
                      ItemsSource="{Binding SalesView}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource common.date}" MinWidth="60" Binding="{ReflectionBinding DateText}" />
                    <DataGridTextColumn Header="{DynamicResource common.time}" MinWidth="60" Binding="{ReflectionBinding TimeText}" />
                    <DataGridTextColumn Header="{DynamicResource sales.colReceipt}" Width="*" Binding="{ReflectionBinding ReceiptText}" />
                    <DataGridTextColumn Header="{DynamicResource common.amount}" Width="130" Binding="{ReflectionBinding TotalAmount, StringFormat='{}{0:N2} сом'}" />
                    <!-- 2026-10-20, аудит программы владельца: «Смешанный» обрезался до «Смешанны» — ширина по надписи. -->
                    <DataGridTextColumn Header="{DynamicResource common.payment}" Width="Auto" MinWidth="110" Binding="{ReflectionBinding PaymentMethodDisplay}" />
                </DataGrid.Columns>
            </DataGrid>
                </TabItem>

            <!-- Дополнительная статистика и Топ-10 (оборонуты в ScrollViewer на случай небольших экранов) -->
                <TabItem x:Name="MetricsTab" Header="{DynamicResource loc.owner.sales.metricsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,8,4,4">

                    <!-- Расширенные KPI -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource sales.additionalMetrics}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource BrushText}"/>
                        <WrapPanel>
                            <Border Classes="sec-kpi" MinWidth="180" Margin="0,0,8,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource sales.netProfit}" />
                                    <TextBlock x:Name="NetProfitText" Classes="sec-kpi-value" />
                                </StackPanel>
                            </Border>
                            <Border Classes="sec-kpi" MinWidth="180" Margin="0,0,8,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sec-kpi-label" Text="{DynamicResource sales.marginPercent}" />
                                    <TextBlock x:Name="MarginPercentText" Classes="sec-kpi-value" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Топ-10 товаров -->
                    <TextBlock Text="{DynamicResource sales.top10Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="{DynamicResource BrushText}"/>
                    <DataGrid x:Name="TopItemsGrid"
                              x:CompileBindings="False"
                              Classes="ModernGrid"
                              MaxHeight="200"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding TopItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource common.product}" Width="*" Binding="{ReflectionBinding ProductName}" />
                            <DataGridTextColumn Header="{DynamicResource common.revenue}" Width="120" Binding="{ReflectionBinding Revenue, StringFormat='{}{0:N2} сом'}" />
                            <DataGridTextColumn Header="{DynamicResource sales.colQty}" Width="80" Binding="{ReflectionBinding Quantity}" />
                        </DataGrid.Columns>
                    </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AbcTab" Header="{DynamicResource csh.menu.abc}">
                    <analytics:AbcSectionView x:Name="AbcSection" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 5: Сообщение об ошибке -->
        <Border x:Name="NoticeBox" Grid.Row="5" Margin="0,8,0,0" Padding="12"
                Background="{DynamicResource BrushDangerSoft}" CornerRadius="8"
                IsVisible="{Binding HasError}">
            <TextBlock x:Name="NoticeText" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        </Border>

        <!-- Popup с деталями чека -->
        <Popup x:Name="ReceiptDetailsPopup" Placement="Center">
            <Border Background="{DynamicResource BrushPanel}" CornerRadius="12" Padding="16"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" MinWidth="400" MaxWidth="600">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" x:Name="PopupTitle" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushText}" />
                        <!-- 2026-10-24 (аудит, круг 8, С-15): ✕ 44x44 в шапке карточки чека, как в ModalShell. -->
                        <Button Grid.Column="1" Classes="modal-close" VerticalAlignment="Top" Click="CloseReceiptDetails_Click"
                                AutomationProperties.Name="{DynamicResource common.close}" IsTabStop="False">
                            <PathIcon Data="{DynamicResource IconClose}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- 2026-10-23, владелец: «чек красивым как в мобилке сделай» — карточка-«бумага» (SaleReceiptCardView) вместо
                         моноширинного текста; печать на принтер идёт прежним текстом (SaleReceiptTextBuilder). Прокрутка внутри,
                         кнопки ниже видны всегда (экран 1024x600). -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushWindowBackdrop}" CornerRadius="10" Padding="8,8,8,0">
                        <ScrollViewer MaxHeight="400" HorizontalAlignment="Center"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ContentControl x:Name="PopupReceiptHost" Margin="4,2,4,8"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Печать чека — жёлтая основная, остальные вторичные; в строку, при нехватке места переносятся (кыргызский текст длиннее). -->
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <!-- 2026-10-03, владелец: «нужна кнопка для печати документов из чека». -->
                        <Button Content="{DynamicResource receiptHistory.docSalesReceipt}" Classes="sec-outline" Margin="0,0,8,6" Click="DocSalesReceipt_Click" />
                        <Button Content="{DynamicResource receiptHistory.docWaybill}" Classes="sec-outline" Margin="0,0,8,6" Click="DocWaybill_Click" />
                        <Button Content="{DynamicResource sales.printReceiptButton}" Classes="sec-primary" Margin="0,0,8,6" Click="PrintReceiptAgain_Click" />
                        <Button Content="{DynamicResource common.close}" Classes="sec-outline" Margin="0,0,0,6" Click="CloseReceiptDetails_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>