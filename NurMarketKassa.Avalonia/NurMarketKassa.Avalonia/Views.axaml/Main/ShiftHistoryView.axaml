<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:NurMarketKassa.Models"
             xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
             xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
             x:Class="NurMarketKassa.AvaloniaHost.Views.ShiftHistoryView"
             x:DataType="vm:ShiftHistoryViewModel"
             x:CompileBindings="True"
             FontFamily="Segoe UI, Inter, Noto Sans"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Styles>
        <!-- Кнопка создания операции -->
        <Style Selector="Button.PrimaryActionButton">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <!-- 2026-10-27: белый на акценте «NUR CRM» (жёлтый #FFB208) — 1,8:1 («+ Новая операция» не читалась); цвет текста на акценте — BrushAccentForeground. -->
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 2026-10-27: наведение/нажатие — на ContentPresenter (стиль на самой кнопке перекрывался Fluent, и при наведении кнопка серела под цветным текстом). -->
        <Style Selector="Button.PrimaryActionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="Button.PrimaryActionButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>

        <!-- Кнопка действия в DataGrid (три точки) -->
        <Style Selector="Button.ShiftActionButton">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.ShiftActionButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>

        <!-- 2026-11-12 (Д-4): заголовки таблицы смен — поля уже (8 слева, справа нет), чтобы «№ Смены» / «Смена №» влезали в узкую колонку; шрифт 12,5. -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        </Style>

        <!-- Метки параметров смены -->
        <Style Selector="TextBlock.ShiftFieldLabel">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="16" RowDefinitions="Auto, *, Auto">

        <!-- 0: Шапка страницы -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushPanel}"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,0,0,16"
                BoxShadow="0 2 6 0 #0F000000">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{DynamicResource shiftHistory.title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                    <TextBlock Text="{DynamicResource shiftHistoryView.subtitle}"
                               FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource shiftHistoryView.newOperationButton}"
                        Classes="PrimaryActionButton"
                        VerticalAlignment="Center"
                        Command="{Binding NewOperationCommand}"/>
            </Grid>
        </Border>

        <!-- 1: Основная рабочая область (Таблица + Сайдбар метрик) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 16, 280">

            <!-- Таблица смен (Левая часть) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushPanel}"
                    CornerRadius="12"
                    Padding="16"
                    BoxShadow="0 2 6 0 #0F000000">
                <Grid RowDefinitions="Auto, Auto, Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource shiftHistoryView.tableTitle}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{DynamicResource BrushText}"
                               Margin="0,0,0,12"/>

                    <!-- 2026-10-31 (стресс-тест 1.17.68, п. 9): сервер не ответил — вместо пустой таблицы «Нет связи» и «Повторить».
                         2026-11-12 (Д-4): отдельной строкой под заголовком таблицы (раньше стояла на одной строке с ним и в ky наезжала на заголовок). -->
                    <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,8" CornerRadius="8"
                            Background="{DynamicResource BrushDangerSoft}"
                            IsVisible="{ReflectionBinding ServerOffline}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{ReflectionBinding ServerOfflineText}" Foreground="{DynamicResource BrushDangerOnSoft}" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="{ReflectionBinding RetryText}" Command="{ReflectionBinding RefreshCommand}" Classes="sec-outline" Height="40" Padding="14,0"/>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="3"
                              x:CompileBindings="False"
                              ItemsSource="{Binding PagedShifts}"
                              SelectedItem="{Binding SelectedShift, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource shiftHistoryView.colShiftNumber}" Binding="{ReflectionBinding ShiftNumber}" Width="84"/> <!-- 2026-10-31: «№ Смены» и даты «31.10.2026 08:00» обрезались (стресс-тест 1.17.68) -->
                            <DataGridTextColumn Header="{DynamicResource shiftDetails.openedLabel}" Binding="{ReflectionBinding OpenedAt, StringFormat=dd.MM.yy HH:mm}" Width="116"/>
                            <DataGridTextColumn Header="{DynamicResource shiftDetails.closedLabel}" Binding="{ReflectionBinding ClosedAt, StringFormat=dd.MM.yy HH:mm}" Width="116"/>
                            <DataGridTextColumn Header="{DynamicResource common.cashier}" Binding="{ReflectionBinding Cashier}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource common.status}" Binding="{ReflectionBinding Status}" Width="96"/>
                            <DataGridTextColumn Header="{DynamicResource common.revenue}" Binding="{ReflectionBinding Revenue, Converter={x:Static conv:CurrencyAmountConverter.Instance}}" Width="110"/>

                            <!-- Колонка действий -->
                            <DataGridTemplateColumn Header="" Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⋯"
                                                Classes="ShiftActionButton"
                                                HorizontalAlignment="Center"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.OpenShiftActionsCommand}"
                                                CommandParameter="{ReflectionBinding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 2026-11-12 (Д-4): пустой список — пояснение по центру, а не пустая таблица. -->
                    <TextBlock Grid.Row="3" Text="{DynamicResource shiftHistoryView.empty}" FontSize="14" TextWrapping="Wrap" MaxWidth="360"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding ShowEmptyShifts}"/>
                </Grid>
            </Border>

            <!-- Правая панель: Аналитика кассы и операции -->
            <Grid Grid.Column="2" RowDefinitions="2*, 16, *">

                <!-- 1) Карточка: Общий план по кассе -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushPanel}"
                        CornerRadius="12"
                        Padding="16"
                        BoxShadow="0 2 6 0 #0F000000">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="{DynamicResource shiftHistoryView.overallPlanTitle}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="0,0,10,0">
                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource shift.openingBalanceLabel}" Classes="ShiftFieldLabel" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OpeningBalanceText}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource shift.depositedLabel}" Classes="ShiftFieldLabel" Foreground="{DynamicResource BrushUiStatusOk}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DepositedTotalText}" FontWeight="Bold" Foreground="{DynamicResource BrushUiStatusOk}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource shift.withdrawnLabel}" Classes="ShiftFieldLabel" Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WithdrawnTotalText}" FontWeight="Bold" Foreground="{DynamicResource BrushDanger}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource shift.expectedBalanceLabel}" Classes="ShiftFieldLabel" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedBalanceText}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource common.revenue}" Classes="ShiftFieldLabel" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RevenueTotalText}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,4"/>

                                <Border Background="{DynamicResource BrushWarningSoft}" CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource shift.actualBalanceLabel}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ActualBalanceText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 2) Карточка: Последние операции -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushPanel}"
                        CornerRadius="12"
                        Padding="16"
                        BoxShadow="0 2 6 0 #0F000000">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="{DynamicResource shift.recentOperationsTitle}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Text="{DynamicResource shiftSummary.noOperations}" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding ShowNoRecentOperations}"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentOperations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CashOperationModel">
                                        <Border Background="{DynamicResource BrushPanelSoft}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                                                    <!-- 2026-10-22 (статьи изъятия): статья и комментарий операции («Аренда — за октябрь»). -->
                                                    <TextBlock Text="{Binding NoteDisplay}" IsVisible="{Binding HasNoteDisplay}" FontSize="12.5"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}"/>
                                                        <TextBlock Text="•" FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}"/>
                                                        <TextBlock Text="{Binding Cashier}" FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AmountDisplay}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{Binding AmountBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 2: Пагинатор списка смен -->
        <Border Grid.Row="2"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <Button Content="◀"
                        Command="{Binding PreviousPageCommand}"
                        ToolTip.Tip="{DynamicResource common.back}"
                        Height="40" Width="40" CornerRadius="{DynamicResource SettingsButtonRadius}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <ItemsControl ItemsSource="{Binding ShiftPagerEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PagerEntry">
                            <Button Content="{Binding Display}"
                                    Command="{ReflectionBinding $parent[UserControl].DataContext.GoToPageCommand}"
                                    CommandParameter="{Binding PageNumber}"
                                    IsEnabled="{Binding Kind}"
                                    Height="40" MinWidth="40" CornerRadius="{DynamicResource SettingsButtonRadius}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="▶"
                        Command="{Binding NextPageCommand}"
                        ToolTip.Tip="{DynamicResource common.forward}"
                        Height="40" Width="40" CornerRadius="{DynamicResource SettingsButtonRadius}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>