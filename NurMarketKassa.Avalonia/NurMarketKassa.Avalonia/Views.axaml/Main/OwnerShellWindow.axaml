<Window x:Class="NurMarketKassa.AvaloniaHost.Views.OwnerShellWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        Title="NurCRM Владелец"
        Height="860"
        Width="1360"
        MinWidth="1000"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBackdrop}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <!-- Программа владельца (2026-09-26, разделение программ): разделы слева, сводка справа.
         Разделы открываются теми же окнами, что раньше открывались из меню кассы. Сводка и
         последние продажи берутся с сервера NurCRM и обновляются сами — продажа на кассе
         появляется здесь через несколько секунд. Оформление — как у кассы: своя шапка вместо
         системной рамки, иконки меню из SideMenuView, цвета только из темы (светлая и тёмная).
         2026-10-18, этап О3: свой шрифт окна «Segoe UI, Inter, Noto Sans» убран — шрифт, как у кассы, из темы (AppFontFamily:
         вшитый Noto Sans, решение владельца; стиль Window в App.axaml). -->
    <Window.Resources>
        <StreamGeometry x:Key="HomeIcon">M3,11 L12,3 L21,11 V21 H15 V15 H9 V21 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="WarehouseIcon">M4,7 L12,3 L20,7 V17 L12,21 L4,17 Z M4,7 L12,11 L20,7 M12,11 V21</StreamGeometry>
        <StreamGeometry x:Key="RestockIcon">M3,17 L9,11 L13,15 L21,7 M21,7 H15 M21,7 V13</StreamGeometry>
        <StreamGeometry x:Key="SalesIcon">M3,4 H5 L7,15 H18 L21,8 H6 M9,20 A1.5,1.5 0 1 1 8.99,20 M17,20 A1.5,1.5 0 1 1 16.99,20</StreamGeometry>
        <StreamGeometry x:Key="FinanceIcon">M4,20 V11 M10,20 V5 M16,20 V14 M22,20 V8</StreamGeometry>
        <StreamGeometry x:Key="AbcIcon">M12,3 A9,9 0 1 0 21,12 H12 Z M15,2.5 A8,8 0 0 1 21.5,9 H15 Z</StreamGeometry>
        <!-- «Аналитика»: оси и линия тренда с точками (2026-09-27). -->
        <StreamGeometry x:Key="AnalyticsIcon">M4,4 V20 H20 M7.5,15.5 L11,11.5 L14,14 L19,8 M11,11.5 V11.51 M14,14 V14.01 M19,8 V8.01</StreamGeometry>
        <StreamGeometry x:Key="SalaryIcon">M2,6 H22 V18 H2 Z M12,9 A3,3 0 1 1 11.99,9 M5,9 V9.01 M19,15 V15.01</StreamGeometry>
        <!-- 2026-10-20, живой аудит (меню, МЕЛОЧЬ): у «Поставщиков» был значок «Клиентов» — свой, грузовик. -->
        <!-- 2026-10-22 (закупки как в вебе): «Закупки» — сумка со стрелкой «внутрь» (приход товара). -->
        <StreamGeometry x:Key="PurchasesIcon">M5,8 H19 L18,21 H6 Z M9,8 V6 A3,3 0 0 1 15,6 V8 M12,11 V17 M9.5,14.5 L12,17 L14.5,14.5</StreamGeometry>
        <StreamGeometry x:Key="SuppliersIcon">M2,6 H14 V17 H2 Z M14,9 H18 L21,12.5 V17 H14 M6,17 A2,2 0 1 1 5.99,17 M17,17 A2,2 0 1 1 16.99,17</StreamGeometry>
        <StreamGeometry x:Key="ClientsIcon">M9,11 A4,4 0 1 1 8.99,11 M3,20 A6,6 0 0 1 15,20 M17,11 A3,3 0 1 1 16.99,11 M17,14 A5,5 0 0 1 21,19</StreamGeometry>
        <StreamGeometry x:Key="CrmIcon">M4,5 H20 V16 H13 L9,20 V16 H4 Z</StreamGeometry>
        <!-- 2026-10-05: WhatsApp — трубка в облачке; «Воронка» — сужающиеся этапы. -->
        <StreamGeometry x:Key="WhatsAppIcon">M12,3 A9,9 0 1 1 4.5,17 L3,21 L7.2,19.6 A9,9 0 0 0 12,21 M9,8 C9,12 12,15 16,15 L16.5,13.5 L14.5,12.5 L13.5,13.5 C12,13 11,12 10.5,10.5 L11.5,9.5 L10.5,7.5 Z</StreamGeometry>
        <!-- 2026-10-06: раздел «Филиалы» — два магазина рядом. -->
        <StreamGeometry x:Key="BranchesIcon">M2,21 H22 M3,21 V10 L8,6 L13,10 V21 M13,21 V13 L17.5,10 L22,13 V21 M6.5,21 V16 H9.5 V21 M16,21 V17 H19 V21</StreamGeometry>
        <StreamGeometry x:Key="FunnelIcon">M3,4 H21 L14,12 V19 L10,21 V12 Z</StreamGeometry>
        <!-- 2026-10-01: раздел «Телеграм-бот» — самолётик Telegram. -->
        <StreamGeometry x:Key="TelegramBotIcon">M21,4 L3,11 L9,13.5 L11,20 L14,15.5 L19,19 Z M9,13.5 L21,4</StreamGeometry>
        <!-- 2026-10-05: раздел «ИИ-советник» — облачко разговора с искрой. -->
        <StreamGeometry x:Key="AiAdvisorIcon">M4,5 H20 V16 H11 L6,20 V16 H4 Z M12,7.5 L13,10 L15.5,10.5 L13,11 L12,13.5 L11,11 L8.5,10.5 L11,10 Z</StreamGeometry>
        <StreamGeometry x:Key="MarketplaceIcon">M6,8 H18 L19,21 H5 Z M9,8 V6 A3,3 0 0 1 15,6 V8</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M12,8 A4,4 0 1 1 11.99,8 M19,12 A7,7 0 0 0 18.8,10.4 L21,8 L18,5 L15.6,6.2 A7,7 0 0 0 14,5.5 L13,2 H9 L8,5.5 A7,7 0 0 0 6.4,6.2 L4,5 L1,8 L3.2,10.4 A7,7 0 0 0 3,12 A7,7 0 0 0 3.2,13.6 L1,16 L4,19 L6.4,17.8 A7,7 0 0 0 8,18.5 L9,22 H13 L14,18.5 A7,7 0 0 0 15.6,17.8 L18,19 L21,16 L18.8,13.6 A7,7 0 0 0 19,12</StreamGeometry>
        <StreamGeometry x:Key="KnowledgeBaseIcon">M4,5 A2,2 0 0 1 6,3 H20 V19 H6 A2,2 0 0 0 4,21 Z M4,5 V19 M8,8 H16 M8,12 H14</StreamGeometry>
        <StreamGeometry x:Key="RemoteSupportIcon">M3,5 H21 V16 H14 L15,19 H9 L10,16 H3 Z M8,10.5 A4,4 0 1 1 15.99,10.5</StreamGeometry>
        <StreamGeometry x:Key="ErrorLogIcon">M4,4 H20 V20 H4 Z M8,9 H16 M8,13 H16 M8,17 H12 M12,2 V4 M12,20 V22</StreamGeometry>
        <StreamGeometry x:Key="PowerIcon">M12,3 V12 M7.5,6.2 A7.5,7.5 0 1 0 16.5,6.2</StreamGeometry>
        <!-- 2026-09-29, владелец: «иконку нормальную поставь» вместо ⏻ — привычный знак выхода: рамка двери и стрелка наружу. -->
        <StreamGeometry x:Key="ExitIcon">M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9</StreamGeometry>
        <StreamGeometry x:Key="LogoutIcon">M13,4 H20 V20 H13 M10,8 L6,12 L10,16 M6,12 H16</StreamGeometry>
        <StreamGeometry x:Key="StoreIcon">M3,9 L5,4 H19 L21,9 M3,9 H21 M3,9 A3,3 0 0 0 9,9 A3,3 0 0 0 15,9 A3,3 0 0 0 21,9 M5,12 V20 H19 V12 M10,20 V15 H14 V20</StreamGeometry>
        <StreamGeometry x:Key="MoonIcon">M20,14.5 A8.5,8.5 0 1 1 9.5,4 A6.5,6.5 0 0 0 20,14.5 Z</StreamGeometry>
        <StreamGeometry x:Key="SunIcon">M12,8 A4,4 0 1 1 11.99,8 M12,2 V4 M12,20 V22 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M2,12 H4 M20,12 H22 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9</StreamGeometry>
        <StreamGeometry x:Key="RefreshIcon">M20,11 A8,8 0 1 0 17.7,16.6 M20,4 V11 H13</StreamGeometry>
        <StreamGeometry x:Key="ReceiptIcon">M6,3 H18 V21 L15,19 L12,21 L9,19 L6,21 Z M9,8 H15 M9,12 H15 M9,16 H12</StreamGeometry>
        <StreamGeometry x:Key="ScaleIcon">M12,3 V21 M7,21 H17 M5,7 H19 M5,7 L2,14 A3,3 0 0 0 8,14 Z M19,7 L16,14 A3,3 0 0 0 22,14 Z</StreamGeometry>
        <StreamGeometry x:Key="ReturnIcon">M9,7 L4,12 L9,17 M5,12 H14 A6,6 0 0 1 20,18</StreamGeometry>
        <StreamGeometry x:Key="CalculatorIcon">M6,3 H18 V21 H6 Z M8.5,6 H15.5 V9.5 H8.5 Z M9,13 V13.01 M12,13 V13.01 M15,13 V13.01 M9,16 V16.01 M12,16 V16.01 M15,16 V16.01 M9,19 V19.01 M12,19 V19.01 M15,19 V19.01</StreamGeometry>
        <StreamGeometry x:Key="ChevronRightIcon">M9,5 L16,12 L9,19</StreamGeometry>
        <StreamGeometry x:Key="CloseIcon">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
        <!-- 2026-10-02: прокат (вешалка) — пункт меню и уведомление о сроках. -->
        <StreamGeometry x:Key="RentalIcon">M12,6 A2,2 0 1 1 14,8 C14,9 12,9.5 12,11 L3,18 H21 L12,11</StreamGeometry>
        <!-- 2026-09-29, раздел «Сайт»: заказы — лоток входящих, настройки — глобус. -->
        <StreamGeometry x:Key="SiteOrdersIcon">M3,13 L6,4 H18 L21,13 V20 H3 Z M3,13 H8 L9.5,16 H14.5 L16,13 H21</StreamGeometry>
        <!-- 2026-10-06, редизайн меню: свои значки у пунктов, которые делили чужие (Прибыль/Финансы, Размеры/Аналитика,
             Убыток/Возвраты, Долги/Клиенты, Магазин в приложении/Маркетплейс); поиск и стрелка группы. -->
        <StreamGeometry x:Key="InvestIcon">M3,17 L9,11 L13,15 L21,7 M14,7 H21 V14</StreamGeometry>
        <StreamGeometry x:Key="ProfitIcon">M5,7 A7,2.5 0 1 0 19,7 A7,2.5 0 1 0 5,7 M5,7 V12 A7,2.5 0 0 0 19,12 V7 M5,12 V17 A7,2.5 0 0 0 19,17 V12</StreamGeometry>
        <StreamGeometry x:Key="LossIcon">M3,7 L9,13 L13,9 L21,17 M21,17 H15 M21,17 V11</StreamGeometry>
        <StreamGeometry x:Key="SizesIcon">M8,3 L3,6 L5,10 L7,9 V21 H17 V9 L19,10 L21,6 L16,3 A4,4 0 0 1 8,3 Z</StreamGeometry>
        <StreamGeometry x:Key="DebtsIcon">M3,7 H19 A2,2 0 0 1 21,9 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z M3,7 L15,3 V7 M16,13.5 H21</StreamGeometry>
        <StreamGeometry x:Key="AppShopIcon">M7,2 H17 V22 H7 Z M9,10 H15 L14.5,16 H9.5 Z M10.5,10 A1.5,1.5 0 0 1 13.5,10 M11,19 H13</StreamGeometry>
        <StreamGeometry x:Key="SearchIcon">M10.5,4 A6.5,6.5 0 1 1 10.49,4 M15.5,15.5 L20,20</StreamGeometry>
        <StreamGeometry x:Key="ChevronDownIcon">M6,9 L12,15 L18,9</StreamGeometry>
        <StreamGeometry x:Key="SiteSettingsIcon">M12,3 A9,9 0 1 1 11.99,3 M3,12 H21 M12,3 A14,14 0 0 1 12,21 M12,3 A14,14 0 0 0 12,21</StreamGeometry>
        <!-- 2026-10-18, этап О2 (макет OwnerNav): «Помощь» — знак вопроса в круге; «« / »» — свернуть и развернуть колонку пунктов. -->
        <StreamGeometry x:Key="HelpIcon">M12,3 A9,9 0 1 1 11.99,3 M9.5,9 A2.5,2.5 0 1 1 13,11.3 C12.4,11.6 12,12.2 12,13 M12,17 V17.01</StreamGeometry>
        <!-- Клиенты в тёмной колонке — значок макета (двое людей): ClientsIcon в 22 точках читался как «очки». -->
        <StreamGeometry x:Key="RailClientsIcon">M9,11 A4,4 0 1 0 9,3 A4,4 0 0 0 9,11 M2,21 A7,7 0 0 1 16,21 M17,11 A3,3 0 1 0 17,5 M22,21 A6,6 0 0 0 18,15.4</StreamGeometry>
        <StreamGeometry x:Key="CollapseNavIcon">M11,6 L5,12 L11,18 M19,6 L13,12 L19,18</StreamGeometry>
        <StreamGeometry x:Key="ExpandNavIcon">M5,6 L11,12 L5,18 M13,6 L19,12 L13,18</StreamGeometry>
        <!-- 2026-10-18, этап О2: цвета тёмной колонки групп. Здесь — значения темы NurMarket (светлая); по теме их пересчитывает
             ApplyRailBrushes (OwnerShellWindow.Nav.cs): светлые темы — цвет текста темы, тёмные — темнее фона окна. -->
        <SolidColorBrush x:Key="OwnerRailBg" Color="#0B2A3C"/>
        <SolidColorBrush x:Key="OwnerRailFg" Color="#C7D2DB"/>
        <SolidColorBrush x:Key="OwnerRailHoverBg" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="OwnerRailHoverFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OwnerRailActiveBg" Color="#29FFD600"/>
        <SolidColorBrush x:Key="OwnerRailActiveFg" Color="#FFD600"/>
        <SolidColorBrush x:Key="OwnerRailAvatarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OwnerRailAvatarFg" Color="#0B2A3C"/>
        <!-- 2026-10-18, вид меню на выбор: «Вид» внизу меню — три колонки макета; ☰ — открыть меню (вид «Бургер»);
             затемнение под выехавшим меню (пересчёт по теме — ApplyRailBrushes). -->
        <StreamGeometry x:Key="MenuStyleIcon">M4,4 H20 A1,1 0 0 1 21,5 V19 A1,1 0 0 1 20,20 H4 A1,1 0 0 1 3,19 V5 A1,1 0 0 1 4,4 Z M8,4 V20 M12,8 H17 M12,12 H17 M12,16 H15</StreamGeometry>
        <StreamGeometry x:Key="BurgerIcon">M4,7 H20 M4,12 H20 M4,17 H20</StreamGeometry>
        <SolidColorBrush x:Key="OwnerScrim" Color="#730B1A26"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Меню. 2026-10-18, этап О2 (макет OwnerNav): тёмная колонка групп (railGroup) и колонка пунктов выбранной группы (nav).
             Подписи групп — обычными буквами (правило аудита 9), у каждой кнопки есть имя для экранного диктора. -->
        <!-- 2026-10-22 (аудит новой сборки): подпись «Управление» ломалась «Управлени/е» (кегль 10,5 и MaxWidth 66 уже слова в
             Montserrat) — кнопка 72, подпись до 72 при кегле 10; слово теперь целиком. -->
        <Style Selector="Button.railGroup">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Padding" Value="0,7,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OwnerRailFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.railGroup:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.railGroup:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OwnerRailHoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OwnerRailHoverFg}"/>
        </Style>
        <Style Selector="Button.railGroup:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OwnerRailHoverBg}"/>
        </Style>
        <Style Selector="Button.railGroup.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OwnerRailActiveBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource OwnerRailActiveFg}"/>
        </Style>
        <Style Selector="Button.railGroup Path.railIcon">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.9"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{DynamicResource OwnerRailFg}"/>
        </Style>
        <Style Selector="Button.railGroup:pointerover Path.railIcon">
            <Setter Property="Stroke" Value="{DynamicResource OwnerRailHoverFg}"/>
        </Style>
        <Style Selector="Button.railGroup.active Path.railIcon">
            <Setter Property="Stroke" Value="{DynamicResource OwnerRailActiveFg}"/>
        </Style>
        <Style Selector="Button.railGroup TextBlock.railLabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="12.5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="72"/>
        </Style>
        <!-- 2026-10-18, ревью О2: низкое окно (1366×768 при 125 % — ~580 точек) — колонка групп плотнее, совсем низкое — только
             значки (ApplyRailDensity в OwnerShellWindow.Nav.cs). -->
        <Style Selector="Border.dense Button.railGroup">
            <Setter Property="Padding" Value="0,6,0,5"/>
        </Style>
        <!-- 2026-10-18: ступень плотнее («tight») — после кнопки «Вид» внизу колонки. -->
        <Style Selector="Border.tight Button.railGroup">
            <Setter Property="Padding" Value="0,4,0,3"/>
        </Style>
        <Style Selector="Border.iconsOnly Button.railGroup">
            <Setter Property="Padding" Value="0,7"/>
        </Style>
        <Style Selector="Border.iconsOnly Button.railGroup TextBlock.railLabel">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- Кнопка «»» в тёмной колонке (колонка пунктов свёрнута). -->
        <Style Selector="Button.railMini">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OwnerRailHoverBg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.railMini:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.railMini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OwnerRailHoverBg}"/>
        </Style>
        <Style Selector="Button.railMini Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource OwnerRailFg}"/>
        </Style>

        <!-- Пункт колонки пунктов: высота от 44, выбранный — светло-жёлтый фон и полоса акцента слева. -->
        <Style Selector="Button.nav">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <!-- 2026-10-18, вид меню на выбор: выбранный пункт во всех трёх видах — тёмно-синяя заливка (цвет текста темы) и текст
             цветом карточки, как выбранный период (правило аудита 2); было светло-жёлтое BrushAccentSoft. -->
        <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
        </Style>
        <Style Selector="Button.nav Border.navBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="10,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.nav.active Border.navBar">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- Подпись группы над пунктами и над найденным при поиске — обычными буквами. -->
        <Style Selector="TextBlock.navCaption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Margin" Value="12,10,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- ««: свернуть колонку пунктов. -->
        <Style Selector="Button.navCollapse">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.navCollapse:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.navCollapse:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="Button.navCollapse Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushTextMuted}"/>
        </Style>
        <!-- 2026-10-19, вид меню «Вкладки» (OwnerShellWindow.Tabs.cs): пункт группы — вкладка 42 над разделом. Выбранная —
             тёмно-синий текст и подчёркивание цветом текста темы (правило 2), без второй тёмной плашки рядом с колонкой групп. -->
        <Style Selector="Button.ownerTab">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ownerTab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.ownerTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.ownerTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.ownerTab.active">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.ownerTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.ownerTab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="Button.ownerTab Path.tabChevron">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <!-- 2026-10-18, вид меню «Старое» (как в выпуске 1.17.58): пункт 40 со значком, заголовок группы сворачивает её,
             число у «Заказов с сайта» и «Проката» — плашкой. Выбранный пункт — тёмно-синий, как в новом виде. -->
        <!-- Высота от 40: длинная подпись (ky, uz, tr) переносится второй строкой, а не обрезается «…» (было Height 40). -->
        <Style Selector="Button.navOld">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.navOld:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.navOld:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.navOld:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="Button.navOld.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
        </Style>
        <Style Selector="Button.navOld.active">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.navOld Path.navIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.navOld:pointerover Path.navIcon">
            <Setter Property="Stroke" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.navOld.active Path.navIcon">
            <Setter Property="Stroke" Value="{DynamicResource BrushPanel}"/>
        </Style>
        <Style Selector="Border.navBadge">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.navBadge TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.navGroupBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,14,10,5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.navGroupBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.navGroupBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.navGroupBtn TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="Button.navGroupBtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.navGroupBtn Path">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 2026-10-06: поиск раздела в меню (Ctrl+K); 2026-10-18, этап О2 — внизу колонки пунктов. -->
        <Style Selector="TextBox.navSearch">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="8,9,4,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TextBox.navSearch:pointerover /template/ Border#PART_BorderElement, TextBox.navSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Кнопки-иконки и кнопки окна -->
        <!-- 2026-10-21 (сенсорный моноблок): кнопки-значки сводки 36×36 → 40×40, период 34 → 40 по высоте, «Все продажи» не ниже 36,
             «»» в тёмной колонке 36×28 → 44×36 — пальцем на экране 100 % не попадали; рисунок и отступы прежние. -->
        <Style Selector="Button.iconBtn">
            <!-- 2026-10-27, аудит владельца С-5: 40 → 44 (цель нажатия не меньше 44). -->
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Button.iconBtn.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Path.btnIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="Button.iconBtn:pointerover Path.btnIcon">
            <Setter Property="Stroke" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.iconBtn.danger:pointerover Path.btnIcon">
            <Setter Property="Stroke" Value="{DynamicResource BrushDanger}"/>
        </Style>
        <Style Selector="Button.caption">
            <!-- 2026-10-27, аудит владельца С-5: высота кнопок окна 32 → 44 (цель нажатия не меньше 44). -->
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Path.capIcon">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover Path.capIcon">
            <Setter Property="Stroke" Value="White"/>
        </Style>

        <!-- Период: сегменты -->
        <Style Selector="Border.segment">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <!-- 2026-10-18, редизайн сводки (этап О1): у цвета одна роль — выбранный период тёмно-синий (цвет текста темы)
             с белым текстом, как modal-seg кассы; жёлтый остаётся только у «сегодня» на графике и у главной кнопки. -->
        <Style Selector="Button.seg">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.seg:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushText}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPanel}"/>
        </Style>
        <Style Selector="Button.seg.active">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- 2026-10-18, этап О1: «Спросить Нур Советника» — одна главная (жёлтая) кнопка сводки.
             2026-10-19, этап О10 (аудит: «единственная синяя/жёлтая кнопка сводки — не главное действие»): обычная обводка,
             как sec-outline разделов; цвет — текста темы (в светлой и тёмной), заливка — только при наведении. -->
        <Style Selector="Button.askAi">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.askAi:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.askAi:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="Button.askAi:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.askAi Path">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Карточки -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #0F000000"/>
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.cardHint">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 2026-10-18, этап О1: показатель — название, крупное число (цифры одной ширины) и строка сравнения;
             цветные плитки-значки убраны (у цвета одна роль: красный/зелёный — только стрелки изменений). -->
        <Style Selector="TextBlock.kpiLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.kpiValue">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontFeatures" Value="{DynamicResource TabularNumbers}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.deltaLine">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="FontFeatures" Value="{DynamicResource TabularNumbers}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Числа в списках сводки — цифры одной ширины. -->
        <Style Selector="TextBlock.num">
            <Setter Property="FontFeatures" Value="{DynamicResource TabularNumbers}"/>
        </Style>
        <!-- 2026-10-04, редизайн под Android-телефон (класс phone ставит OwnerShellWindow.Phone.cs, в Windows его
             нет): в карточке 190 точек «71 818,22 сом» обрезалось до «71 818,...», «Средний чек» уходил под значок. -->
        <Style Selector=".phone Border.card">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector=".phone TextBlock.kpiValue">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
        <Style Selector=".phone TextBlock.kpiLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector=".phone TextBlock.deltaLine">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 2026-10-18, этап О1: строка блока «Требует внимания» — точка-статус, заголовок, пояснение, действие справа. -->
        <Style Selector="Button.attnRow">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.attnRow:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.attnRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Border.attnRow">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TextBlock.empty">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,24"/>
        </Style>

        <!-- Вкладки срезов ABC в сводке — как вкладки разделов (Финансы, Склад), а не крупные
             вкладки Fluent по умолчанию: шесть срезов помещаются в одну строку. -->
        <Style Selector="Border#AbcCard TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="Border#AbcCard TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Border#AbcCard TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <!-- 2026-09-30: верхний ряд — полоса орнамента темы «Кыргыз» (у остальных тем высота 0). -->
    <Grid x:Name="RootGrid" ColumnDefinitions="252,*" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Height="{DynamicResource OrnamentBandHeight}"
                Background="{DynamicResource BrushOrnamentBand}" IsHitTestVisible="False"/>

        <!-- ============================== Меню ============================== -->
        <!-- 2026-10-18, этап О2 (макет OwnerNav): две колонки — тёмная колонка групп (76) и колонка пунктов выбранной группы (232).
             Группы, пункты, права и тариф — те же (BuildNavigation); «««» сворачивает колонку пунктов, на экране до 1366 точек она
             сворачивается сама, когда открыт раздел (OwnerShellWindow.Nav.cs). Сама кнопка-«меню» — Border в колонке 0, строке 1:
             её ищет телефонный режим (OwnerShellWindow.Phone.cs). -->
        <Border Grid.Row="1" Grid.Column="0" x:Name="NavSidebar">
            <Grid x:Name="NavSidebarGrid" ColumnDefinitions="76,*">
                <!-- Тёмная колонка групп -->
                <Border x:Name="NavRail" Background="{DynamicResource OwnerRailBg}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" x:Name="LogoGrid" Spacing="8" Margin="0,16,0,10" Background="Transparent"
                                    PointerPressed="DragArea_PointerPressed">
                            <Border x:Name="LogoImage" Width="44" Height="44" CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center">
                                <Image Source="avares://NurMarketKassa.Avalonia/Assets/app-logo.png" Stretch="UniformToFill"/>
                            </Border>
                            <Button x:Name="ExpandNavButton" Classes="railMini" Click="ExpandNav_Click" IsVisible="False">
                                <Path Data="{StaticResource ExpandNavIcon}"/>
                            </Button>
                            <!-- 2026-10-19, вид «Вкладки»: колонки пунктов нет — поиск раздела (тот же, что Ctrl+K) значком под логотипом. -->
                            <Button x:Name="RailSearchButton" Classes="railMini" Width="44" Height="36" Click="RailSearch_Click" IsVisible="False">
                                <Path Data="{StaticResource SearchIcon}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>

                        <!-- Внизу: тема, выход на рабочий стол (было «Система → Выйти»), пользователь. -->
                        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,6,0,14" HorizontalAlignment="Center">
                            <Button x:Name="ThemeButton" Classes="railGroup" Click="Theme_Click">
                                <StackPanel Spacing="3">
                                    <Path x:Name="ThemeIconPath" Classes="railIcon" Width="20" Height="20" Data="{StaticResource MoonIcon}"/>
                                    <TextBlock x:Name="ThemeLabel" Classes="railLabel"/>
                                </StackPanel>
                            </Button>
                            <!-- 2026-10-18: вид меню на выбор (новое / бургер ☰ / старое) — окно с карточками, рядом с «Тема». -->
                            <Button x:Name="MenuStyleButton" Classes="railGroup" Click="MenuStyle_Click">
                                <StackPanel Spacing="3">
                                    <Path Classes="railIcon" Width="20" Height="20" Data="{StaticResource MenuStyleIcon}"/>
                                    <TextBlock x:Name="MenuStyleLabel" Classes="railLabel"/>
                                </StackPanel>
                            </Button>
                            <!-- 2026-09-29, владелец: «выйти из учётной записи» — в Настройки → Аккаунт,
                                 здесь вместо него «Выйти на рабочий стол» (вход при этом сохраняется). -->
                            <Button x:Name="ExitButton" Classes="railGroup" Click="ExitToDesktop_Click">
                                <StackPanel Spacing="3">
                                    <Path Classes="railIcon" Width="20" Height="20" Data="{StaticResource ExitIcon}"/>
                                    <TextBlock x:Name="ExitLabel" Classes="railLabel"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="AvatarBadge" Width="40" Height="40" CornerRadius="20" Margin="0,6,0,0" HorizontalAlignment="Center"
                                    Background="{DynamicResource OwnerRailAvatarBg}">
                                <TextBlock x:Name="AvatarText" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource OwnerRailAvatarFg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      BringIntoViewOnFocusChange="False">
                            <StackPanel x:Name="RailPanel" Spacing="4" HorizontalAlignment="Center"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Колонка пунктов выбранной группы -->
                <Border Grid.Column="1" x:Name="NavItemsColumn" Background="{DynamicResource BrushPanel}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                    <DockPanel x:Name="NavItemsDock" Margin="14,18,14,14">
                        <!-- Компания и тариф; «««» — свернуть колонку. -->
                        <Grid DockPanel.Dock="Top" x:Name="CompanyCard" ColumnDefinitions="*,Auto" Margin="10,0,0,10"
                              Background="Transparent" PointerPressed="DragArea_PointerPressed">
                            <StackPanel Spacing="3" VerticalAlignment="Top">
                                <TextBlock x:Name="CompanyNameText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushText}"/>
                                <TextBlock x:Name="TariffText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextSoft}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="CollapseButton" Classes="navCollapse" Margin="8,0,0,0"
                                    VerticalAlignment="Top" Click="Collapse_Click">
                                <Path Data="{StaticResource CollapseNavIcon}"/>
                            </Button>
                        </Grid>

                        <!-- 2026-10-06, владелец: «займись редизайном и удобством админки» — поиск раздела по названию:
                             Ctrl+K из любого раздела, Enter открывает первый найденный, Esc очищает (OwnerShellWindow.NavSearch.cs).
                             2026-10-18, этап О2: внизу колонки пунктов, ищет по всем группам. -->
                        <Border DockPanel.Dock="Bottom" x:Name="NavSearchBox" Margin="0,10,0,0" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource BrushInputAlt}" BorderBrush="{DynamicResource BrushBorder}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Path Classes="btnIcon" Width="15" Height="15" Margin="11,0,0,0" VerticalAlignment="Center"
                                      Data="{StaticResource SearchIcon}"/>
                                <TextBox Grid.Column="1" x:Name="NavSearchText" Classes="navSearch"/>
                                <Border Grid.Column="2" x:Name="NavSearchKeyHint" Margin="0,0,8,0" Padding="6,1,6,2" CornerRadius="5"
                                        VerticalAlignment="Center" Background="{DynamicResource BrushPanel}"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" IsHitTestVisible="False">
                                    <TextBlock Text="Ctrl+K" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" x:Name="NavGroupTitle" Classes="navCaption" Margin="12,4,0,6"/>

                        <!-- 2026-10-05, владелец: «после того как пролистаешь, кнопка слева не нажимается, а уезжает вниз или вверх».
                             Нажатая кнопка получала фокус (а при возврате из раздела фокус возвращался прежней кнопке), меню
                             прокручивалось к ней, и под курсором оказывалось другое место — первое нажатие терялось. -->
                        <ScrollViewer x:Name="NavItemsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      BringIntoViewOnFocusChange="False">
                            <StackPanel x:Name="NavPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2026-10-18, вид меню «Старое» — меню выпуска 1.17.58: логотип с «Владелец» и ☰ (свернуть до значков), карточка
             компании, поиск вверху, все группы и пункты списком, внизу пользователь, «Вид», тема и выход. Поиск (NavSearchBox) и
             список пунктов (NavPanel) — те же, что в новом виде: переносятся сюда (OwnerShellWindow.MenuStyle.cs). -->
        <Border Grid.Row="1" Grid.Column="0" x:Name="OldNavSidebar" IsVisible="False" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" x:Name="OldLogoGrid" Margin="18,18,12,14" ColumnDefinitions="Auto,*,Auto"
                      Background="Transparent" PointerPressed="DragArea_PointerPressed">
                    <Border x:Name="OldLogoImage" Width="40" Height="40" CornerRadius="11" ClipToBounds="True">
                        <Image Source="avares://NurMarketKassa.Avalonia/Assets/app-logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" x:Name="OldLogoTextPanel" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="NurCRM" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                        <Border HorizontalAlignment="Left" Background="{DynamicResource BrushAccent}" CornerRadius="6" Padding="7,1,7,2">
                            <TextBlock x:Name="OwnerBadgeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccentForeground}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="OldCollapseButton" Classes="iconBtn" Click="OldCollapse_Click" VerticalAlignment="Center">
                        <Path Classes="btnIcon" Data="{StaticResource BurgerIcon}"/>
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Top" x:Name="OldCompanyCard" Margin="14,0,14,4" Padding="12,10" CornerRadius="12"
                        Background="{DynamicResource BrushInputAlt}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrushPanel}">
                            <Path Classes="btnIcon" Data="{StaticResource StoreIcon}" Stroke="{DynamicResource BrushText}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="OldCompanyNameText" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/>
                            <!-- 2026-10-20, живой аудит (меню, МЕЛОЧЬ): «Тариф «Стандарт» · до 01.…» обрезался — переносим строкой,
                                 полный текст и в подсказке карточки. -->
                            <TextBlock x:Name="OldTariffText" FontSize="11.5" TextWrapping="Wrap" MaxLines="2"
                                       Foreground="{DynamicResource BrushTextSoft}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Decorator DockPanel.Dock="Top" x:Name="OldNavSearchSlot" Margin="14,8,14,2"/>

                <Border DockPanel.Dock="Bottom" x:Name="OldUserFooter" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                        Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Border x:Name="OldAvatarBadge" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource BrushAccent}">
                            <TextBlock x:Name="OldAvatarText" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccentForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" x:Name="OldUserInfoPanel" Margin="10,0,2,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="OldUserNameText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/>
                            <!-- 2026-10-20: «Вход через …» обрезался — перенос строкой и подсказка (OwnerShellWindow.MenuStyle.cs). -->
                            <TextBlock x:Name="OldUserRoleText" FontSize="11.5" TextWrapping="Wrap" MaxLines="2"
                                       Foreground="{DynamicResource BrushTextSoft}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="OldMenuStyleButton" Classes="iconBtn" Width="32" Click="MenuStyle_Click">
                            <Path Classes="btnIcon" Data="{StaticResource MenuStyleIcon}"/>
                        </Button>
                        <Button Grid.Column="3" x:Name="OldThemeButton" Classes="iconBtn" Width="32" Click="Theme_Click">
                            <Path x:Name="OldThemeIconPath" Classes="btnIcon" Data="{StaticResource MoonIcon}"/>
                        </Button>
                        <Button Grid.Column="4" x:Name="OldExitButton" Classes="iconBtn" Width="32" Click="ExitToDesktop_Click">
                            <Path Classes="btnIcon" Data="{StaticResource ExitIcon}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="OldNavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              BringIntoViewOnFocusChange="False"/>
            </DockPanel>
        </Border>

        <!-- 2026-10-18, вид меню «Бургер ☰»: затемнение под выехавшим меню (щелчок — закрыть). Само меню — NavSidebar поверх
             правой части (Grid.ColumnSpan и ZIndex ставит ApplyBurgerLayout). -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="BurgerScrim" IsVisible="False" ZIndex="30"
                Background="{DynamicResource OwnerScrim}" PointerPressed="BurgerScrim_PointerPressed"/>

        <!-- ============================== Сводка ============================== -->
        <!-- 2026-10-19: строка 0 — полоса вкладок вида меню «Вкладки» (в остальных видах скрыта, высота 0). -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <!-- 2026-10-19, вид меню «Вкладки» (OwnerShellWindow.Tabs.cs): «NBS · Товары» мелко, под ней пункты группы вкладками;
                 справа — плашка проката и кнопки окна (переносятся сюда из шапки). Не помещаются — последние в «Ещё ▾».
                 За полосу окно перетаскивается, как за шапку. -->
            <Border Grid.Row="0" x:Name="TabsBar" IsVisible="False" Background="Transparent"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    PointerPressed="DragArea_PointerPressed">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,0,10,0">
                    <StackPanel x:Name="TabsMain" VerticalAlignment="Bottom" ClipToBounds="True">
                        <!-- 2026-10-20, живой аудит (меню, МЕЛОЧЬ): «NBS · Главная» была прижата к верху окна — отступ 10 → 16. -->
                        <TextBlock x:Name="TabsCrumbText" FontSize="12" FontWeight="SemiBold" Margin="2,16,0,4"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushTextSoft}"/>
                        <TextBlock x:Name="TabsTitleText" FontSize="17" FontWeight="Bold" Margin="2,2,0,12" IsVisible="False"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushText}"/>
                        <StackPanel x:Name="TabsStrip" Orientation="Horizontal" Spacing="2"/>
                    </StackPanel>
                    <Decorator Grid.Column="1" x:Name="TabsAlertSlot" VerticalAlignment="Center" Margin="12,6,0,0"/>
                    <Decorator Grid.Column="2" x:Name="TabsCaptionSlot" VerticalAlignment="Top" Margin="8,8,0,0"/>
                </Grid>
            </Border>

            <!-- Шапка: за неё окно перетаскивается, двойной щелчок разворачивает -->
            <Grid Grid.Row="1" x:Name="HeaderGrid" Margin="28,12,10,4" ColumnDefinitions="*,Auto,Auto"
                  Background="Transparent"
                  PointerPressed="DragArea_PointerPressed">
                <!-- В разделе шапка становится узкой полосой: название раздела и кнопки окна. -->
                <TextBlock Grid.Column="0" x:Name="SectionTitleText" IsVisible="False" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushText}"/>
                <!-- 2026-10-18, этап О1: заголовок 28 Bold; «Обновлено в …» — под ним, рядом с датой (как в макете Owner),
                     справа остаются «Обновить», период и «Спросить Нур Советника». -->
                <StackPanel Grid.Column="0" x:Name="TitlePanel" VerticalAlignment="Center" Margin="0,6,12,0" Spacing="2">
                    <TextBlock x:Name="DashboardTitle" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushText}"
                               TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock x:Name="DateText" FontSize="13" Margin="0,0,12,0" Foreground="{DynamicResource BrushTextSoft}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{DynamicResource BrushSuccess}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpdatedText" FontSize="13" Foreground="{DynamicResource BrushTextSoft}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <!-- 2026-10-31 (стресс-тест 1.17.68): WrapPanel вместо StackPanel — на 800×480 в две строки шапки «Спросить Нур Советника» уходила
                     за край окна; теперь при нехватке места кнопки переносятся строкой ниже. -->
                <WrapPanel Grid.Column="1" x:Name="OverviewTools" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,6,18,0">
                    <Button x:Name="RefreshButton" Classes="iconBtn" Click="Refresh_Click" Margin="0,0,10,3">
                        <Path Classes="btnIcon" Data="{StaticResource RefreshIcon}"/>
                    </Button>
                    <Border Classes="segment" Margin="0,0,10,3">
                        <!-- 2026-10-31: Viewbox (только уменьшение) — на узкой шапке кнопки периода не выходят за рамку сегмента. -->
                        <Viewbox StretchDirection="DownOnly">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="TodayButton" Classes="seg active" Tag="today" Click="Period_Click"/>
                            <Button x:Name="WeekButton" Classes="seg" Tag="week" Click="Period_Click"/>
                            <Button x:Name="MonthButton" Classes="seg" Tag="month" Click="Period_Click"/>
                            <!-- 2026-09-30: свои даты, как «Спец. дата» в «Финансах». -->
                            <Button x:Name="CustomButton" Classes="seg" Tag="custom" Click="Period_Click"/>
                        </StackPanel>
                        </Viewbox>
                    </Border>
                    <!-- 2026-10-18, этап О1: открывает тот же раздел «Нур Советник», что пункт меню (виден, только если пункт есть).
                         На узкой шапке — только значок (OwnerShellWindow.Attention.cs, FitHeaderTools). -->
                    <Button x:Name="AskAiButton" Classes="askAi" Click="AskAi_Click" IsVisible="False" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="{StaticResource AiAdvisorIcon}"/>
                            <TextBlock x:Name="AskAiText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 2026-10-02, владелец: «уведомление об окончании и приближении срока проката» (со звуком).
                     2026-10-18, этап О2: плашка — не в меню (правило аудита 9), а в полосе над открытым разделом: окно раздела
                     лежит поверх правой части, а эта полоса видна всегда. В «Сводке» те же сроки — строками «Требует внимания». -->
                <Border Grid.Column="1" x:Name="RentalAlertCard" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Margin="0,0,12,0" Padding="10,3,3,3" CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource BrushWarningSoft}" BorderBrush="{DynamicResource BrushWarning}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="btnIcon" Width="16" Height="16" VerticalAlignment="Center" Stroke="{DynamicResource BrushText}"
                              Data="{StaticResource RentalIcon}"/>
                        <TextBlock x:Name="RentalAlertTitle" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushText}"/>
                        <TextBlock x:Name="RentalAlertText" FontSize="13" VerticalAlignment="Center" MaxWidth="320"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushText}"/>
                        <Button x:Name="RentalAlertOpen" Classes="link" Padding="8,3" Click="RentalAlertOpen_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="RentalAlertOpenText" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText}"/>
                                <Path Classes="btnIcon" Width="12" Height="12" Data="{StaticResource ChevronRightIcon}"
                                      Stroke="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RentalAlertClose" Classes="iconBtn" Width="28" Height="28" VerticalAlignment="Center"
                                Click="RentalAlertClose_Click">
                            <Path Classes="btnIcon" Width="12" Height="12" Data="{StaticResource CloseIcon}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" x:Name="CaptionButtons" Orientation="Horizontal" VerticalAlignment="Top" Spacing="2">
                    <Button x:Name="MinimizeCaptionButton" Classes="caption" Click="Minimize_Click">
                        <Path Classes="capIcon" Data="M0,5 H10"/>
                    </Button>
                    <Button x:Name="MaximizeCaptionButton" Classes="caption" Click="Maximize_Click">
                        <Path x:Name="MaximizeIconPath" Classes="capIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"/>
                    </Button>
                    <Button x:Name="CloseCaptionButton" Classes="caption close" Click="Close_Click">
                        <Path Classes="capIcon" Data="M0,0 L10,10 M10,0 L0,10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Место раздела: окно раздела без рамки лежит ровно поверх этой области и двигается
                 вместе с окном программы (см. OwnerShellWindow.SyncSectionBounds). -->
            <Border Grid.Row="2" x:Name="SectionHost" IsVisible="False" Margin="0,0,0,0"
                    Background="{DynamicResource BrushWindowBackdrop}">
                <!-- 2026-10-18, вид «Бургер ☰»: пока меню выехало, окно раздела спрятано, а здесь — его снимок под затемнением. -->
                <Panel>
                    <TextBlock x:Name="SectionLoadingText" Classes="empty"/>
                    <Image x:Name="SectionSnapshot" IsVisible="False" Stretch="Fill"/>
                </Panel>
            </Border>

            <ScrollViewer Grid.Row="2" x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,12,28,28" Spacing="16">

                    <!-- Показатели. 2026-10-18, этап О1 (макет Owner): название, число без копеек, строка сравнения
                         «▲ 10 % к вчера на это время (3 900)»; цветных плиток-значков нет. Переходов у показателей нет —
                         карточки не нажимаются. -->
                    <Grid x:Name="OverviewKpiGrid" ColumnDefinitions="*,16,*,16,*,16,*">
                        <Border Grid.Column="0" Classes="card">
                            <StackPanel>
                                <TextBlock x:Name="RevenueLabel" Classes="kpiLabel"/>
                                <TextBlock x:Name="RevenueValue" Classes="kpiValue" Text="—"/>
                                <TextBlock x:Name="RevenueDelta" Classes="deltaLine" Text="—"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card">
                            <StackPanel>
                                <TextBlock x:Name="ChecksLabel" Classes="kpiLabel"/>
                                <TextBlock x:Name="ChecksValue" Classes="kpiValue" Text="—"/>
                                <TextBlock x:Name="ChecksDelta" Classes="deltaLine" Text="—"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Classes="card">
                            <StackPanel>
                                <TextBlock x:Name="AvgLabel" Classes="kpiLabel"/>
                                <TextBlock x:Name="AvgValue" Classes="kpiValue" Text="—"/>
                                <TextBlock x:Name="AvgDelta" Classes="deltaLine" Text="—"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Classes="card">
                            <StackPanel>
                                <TextBlock x:Name="ProfitLabel" Classes="kpiLabel"/>
                                <TextBlock x:Name="ProfitValue" Classes="kpiValue" Text="—"/>
                                <TextBlock x:Name="ProfitDelta" Classes="deltaLine" Text="—"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- 2026-10-21 (пакет 2, п. 85): сравнивать не с чем — одна строка под всеми плитками, а не одно и то же
                         «вчера к этому времени продаж не было» в каждой из четырёх. -->
                    <TextBlock x:Name="KpiCompareNote" Classes="deltaLine" Margin="2,-8,0,0" TextWrapping="Wrap" IsVisible="False"/>

                    <!-- 2026-10-18, этап О1: слева — выручка по дням и способы оплаты, справа — «Требует внимания»
                         (прокат, долги, заказы с сайта, товары на исходе — OwnerShellWindow.Attention.cs). -->
                    <Grid x:Name="OverviewRow1" ColumnDefinitions="2*,16,*">
                        <StackPanel Grid.Column="0" Spacing="16">
                            <Border Classes="card">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                        <TextBlock x:Name="ChartTitle" Classes="cardTitle" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" x:Name="ChartTotalText" Classes="cardHint num" Margin="12,0,0,0"/>
                                    </Grid>
                                    <!-- 2026-10-26: легенда «лучший день / самый слабый / сегодня» — в ApplyChart; Panel 230 → 238: кольцо «сегодня» добавляет 7 px -->
                                    <StackPanel x:Name="ChartLegend" DockPanel.Dock="Bottom"/>
                                    <Panel Height="238">
                                        <Grid x:Name="ChartBars"/>
                                        <TextBlock x:Name="ChartEmptyText" Classes="empty" IsVisible="False"/>
                                    </Panel>
                                </DockPanel>
                            </Border>

                            <!-- Способы оплаты: полоса и точки — оттенки цвета текста (без зелёного), суммы справа. -->
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="PaymentsTitle" Classes="cardTitle"/>
                                        <TextBlock Grid.Column="1" x:Name="PaymentsCountText" Classes="cardHint num"/>
                                    </Grid>
                                    <Border Height="8" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource BrushInputAlt}">
                                        <Grid x:Name="PaymentsBar"/>
                                    </Border>
                                    <StackPanel x:Name="PaymentsLegend" Spacing="8"/>
                                    <TextBlock x:Name="PaymentsEmptyText" Classes="empty" Margin="0,4" IsVisible="False"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ReturnsLabel" FontSize="14"
                                                   Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ReturnsValue" Classes="num" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="2" Classes="card" x:Name="AttentionCard">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AttentionTitle" Classes="cardTitle"/>
                                <StackPanel x:Name="AttentionList" Spacing="8"/>
                                <TextBlock x:Name="AttentionEmptyText" FontSize="14" TextWrapping="Wrap" IsVisible="False"
                                           Foreground="{DynamicResource BrushTextSoft}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Последние продажи + долги, план и лучшие товары -->
                    <Grid x:Name="OverviewRow2" ColumnDefinitions="2*,16,*">
                        <Border Grid.Column="0" Classes="card" Padding="20,16,20,10" VerticalAlignment="Top">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock x:Name="RecentTitle" Classes="cardTitle"/>
                                    <Button Grid.Column="1" x:Name="AllSalesButton" Classes="link" Click="AllSales_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Name="AllSalesText" VerticalAlignment="Center"/>
                                            <Path Classes="btnIcon" Width="12" Height="12" Data="{StaticResource ChevronRightIcon}"
                                                  VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Panel>
                                    <StackPanel x:Name="RecentList"/>
                                    <TextBlock x:Name="RecentEmptyText" Classes="empty" IsVisible="False"/>
                                </Panel>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top">
                        <!-- 2026-10-05, владелец: «где в сводке и аналитике долги??». Карточка «Долги клиентов» — первой в правой колонке, видна без прокрутки:
                             сколько должны магазину, должники, просрочка больше 30 дней, крупные должники; «Подробно» —
                             раздел «Долги клиентов». Заполняется в OwnerShellWindow.Debts.cs. -->
                        <Border Classes="card" x:Name="DebtsCard" Padding="20,16,20,14" VerticalAlignment="Top" IsVisible="False">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock x:Name="DebtsTitle" Classes="cardTitle"/>
                                    <Button Grid.Column="1" x:Name="DebtsLink" Classes="link" Click="DebtsLink_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Name="DebtsLinkText" VerticalAlignment="Center"/>
                                            <Path Classes="btnIcon" Width="12" Height="12" Data="{StaticResource ChevronRightIcon}"
                                                  VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="DebtsHost" Spacing="6"/>
                            </DockPanel>
                        </Border>

                        <!-- 2026-10-05, ТЗ часть 7, п. 2.5: план продаж на месяц (сервер выложил sales-targets 05.10).
                             Заполняется в OwnerShellWindow.SalesPlan.cs; у сервера без адреса карточки нет. -->
                        <Border Classes="card" x:Name="SalesPlanCard" Padding="20,16,20,14" VerticalAlignment="Top" IsVisible="False">
                            <StackPanel x:Name="SalesPlanHost" Spacing="8"/>
                        </Border>

                        <Border Classes="card" Padding="20,16,20,14" VerticalAlignment="Top">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="TopTitle" Classes="cardTitle" Margin="0,0,0,12"/>
                                <Panel>
                                    <StackPanel x:Name="TopList" Spacing="12"/>
                                    <TextBlock x:Name="TopEmptyText" Classes="empty" IsVisible="False"/>
                                </Panel>
                            </DockPanel>
                        </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ABC-анализ по всем срезам (2026-09-27, владелец: «ABC анализ должен быть в сводке
                         и он должен быть по всем»). Считается локально, за тот же период, что и сводка;
                         пересчёт — при смене периода и после новых продаж, а не каждые 20 секунд.
                         2026-10-21 (пакет 2, п. 86): высота блока — по содержимому, своей вертикальной прокрутки нет
                         (была «прокрутка в прокрутке»): Сводка листается целиком. -->
                    <Border x:Name="AbcCard" Classes="card" Padding="20,16,20,14" IsVisible="False">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="AbcTitle" Classes="cardTitle"/>
                                    <TextBlock x:Name="AbcHint" Classes="cardHint" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="AbcOpenButton" Classes="link" VerticalAlignment="Top" Click="AbcOpen_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock x:Name="AbcOpenText" VerticalAlignment="Center"/>
                                        <Path Classes="btnIcon" Width="12" Height="12" Data="{StaticResource ChevronRightIcon}"
                                              VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Panel x:Name="AbcHost">
                                <TextBlock x:Name="AbcLoadingText" Classes="empty" VerticalAlignment="Top"/>
                            </Panel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
