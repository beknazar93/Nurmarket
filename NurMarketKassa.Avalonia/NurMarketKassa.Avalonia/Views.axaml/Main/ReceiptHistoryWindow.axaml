<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.ReceiptHistoryWindow"
        x:CompileBindings="False"
        Title="{DynamicResource csh.menu.receiptHistory}"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="{DynamicResource DialogTransparencyHint}"
        Background="{DynamicResource DialogWindowBackground}">

  <!-- «История чеков» для кассира (2026-09-27). Оформление — как у окна возврата
       (ReturnSaleDialog): на весь экран, слева список, справа выбранный чек. -->
  <!-- 2026-10-20, владелец: «вид чека как в мобилке оформи» (макет design/…/screens/PCashCheck.html). Кнопки — общие
       sec-primary (одна жёлтая главная) и sec-outline (обводка), период — сегменты sec-segment/sec-seg (выбранный
       тёмно-синий), выбранная строка — мягкий фон темы, справа — карточка чека обычным шрифтом вместо ленты принтера
       (docs/owner-redesign-plan.md, правила 1–4, 9). -->
  <Window.Styles>
    <!-- Сегменты периода — на всю высоту поля поиска. -->
    <Style Selector="RadioButton.sec-seg">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.sec-primary, Button.sec-outline">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
    <!-- Обводка — на цвете панели: справа фон серый, прозрачная кнопка выглядела серой залитой (правило 1). -->
    <Style Selector="Button.sec-outline">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    </Style>
    <!-- 2026-10-27: прозрачность выключенной 0.5 → 0,7: в тёмной теме надпись выключенной кнопки была 1,5–2,5:1 (нужно ≥3:1). -->
    <Style Selector="Button.sec-outline:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.sec-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- Пунктир карточки чека: линия длиннее карточки, лишнее обрезает холст. -->
    <Style Selector="Canvas.dash">
      <Setter Property="Height" Value="1"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Margin" Value="0,12"/>
    </Style>
    <Style Selector="Canvas.dash > Line">
      <Setter Property="Stroke" Value="{DynamicResource BrushBorderStrong}"/>
      <Setter Property="StrokeThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.card-soft">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBox.ModernInput">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.ModernInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
    </Style>

    <!-- Строки списка чеков: крупные, под палец. -->
    <Style Selector="ListBox#ReceiptsList">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox#ReceiptsList ListBoxItem">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="MinHeight" Value="60"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox#ReceiptsList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
    </Style>
    <!-- 2026-10-20: выбранная строка — мягкий фон темы и тёмная полоска слева (был жёлтый BrushAccentSoft). -->
    <Style Selector="ListBox#ReceiptsList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    </Style>
    <Style Selector="ListBox#ReceiptsList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    </Style>
    <Style Selector="ListBox#ReceiptsList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    </Style>
    <Style Selector="ListBox#ReceiptsList ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelPressed}"/>
    </Style>
    <Style Selector="ListBox#ReceiptsList ListBoxItem Border.sel-bar">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ListBox#ReceiptsList ListBoxItem:selected Border.sel-bar">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Плашка статуса чека. -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushUiStatusOk}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushUiStatusOk}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge.warn">
      <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
    </Style>
    <Style Selector="Border.badge.warn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
    </Style>
    <Style Selector="Border.badge.danger">
      <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
    </Style>
    <Style Selector="Border.badge.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
    </Style>
    <!-- «В долг»: BrushDiscountPanelBg/Border — пара, различимая в обеих темах (см. ShiftDetailsDialog). -->
    <Style Selector="Border.badge.info">
      <Setter Property="Background" Value="{DynamicResource BrushDiscountPanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushDiscountPanelBorder}"/>
    </Style>
    <Style Selector="Border.badge.info TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>

    <!-- Строки карточки под итогом (скидки, оплата, сдача): подпись мягким, сумма — цветом текста. -->
    <Style Selector="TextBlock.summary-label">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.summary-value">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border x:Name="RootCard" Margin="12" CornerRadius="{DynamicResource SettingsCardRadius}"
          Background="{DynamicResource BrushDialogPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="20">
    <Grid RowDefinitions="Auto,Auto,Auto,*">

      <!-- 0: шапка -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="{DynamicResource csh.menu.receiptHistory}"
                     FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
          <TextBlock Text="{DynamicResource receiptHistory.subtitle}"
                     Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrushTextSoft}"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="{DynamicResource common.close}"
                Classes="sec-outline"
                VerticalAlignment="Top"
                MinHeight="42" MinWidth="120"
                IsCancel="True"
                Click="Close_Click"/>
      </Grid>

      <!-- 1: период, поиск, обновить -->
      <Grid x:Name="ToolbarGrid" Classes="no-reflow" Grid.Row="1" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="3*" MaxWidth="480"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="PeriodChips" Grid.Column="0" Classes="sec-segment">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Classes="sec-seg" GroupName="ReceiptPeriod" Tag="shift" IsChecked="True"
                         Content="{DynamicResource receiptHistory.periodShift}" Click="Period_Click"/>
            <RadioButton Classes="sec-seg" GroupName="ReceiptPeriod" Tag="today"
                         Content="{DynamicResource common.today}" Click="Period_Click"/>
            <RadioButton Classes="sec-seg" GroupName="ReceiptPeriod" Tag="yesterday"
                         Content="{DynamicResource sales.yesterday}" Click="Period_Click"/>
          </StackPanel>
        </Border>
        <TextBox x:Name="SearchBox" Grid.Column="1"
                 Classes="ModernInput"
                 Margin="12,0"
                 HorizontalAlignment="Stretch"
                 Watermark="{DynamicResource receiptHistory.searchWatermark}"
                 TextChanged="SearchBox_TextChanged"/>
        <Button x:Name="RefreshButton" Grid.Column="3"
                Content="{DynamicResource common.refresh}"
                Classes="sec-outline"
                MinHeight="42" MinWidth="110"
                Click="Refresh_Click"/>
      </Grid>

      <!-- 2: загрузка и предупреждения (нет связи, смена не открыта) -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
        <ProgressBar x:Name="LoadingBar" IsVisible="False" IsIndeterminate="True"
                     Height="3" MinHeight="3" CornerRadius="2"
                     Foreground="{DynamicResource BrushAccent}" Background="Transparent"/>
        <Border x:Name="NoticeBorder" IsVisible="False"
                Background="{DynamicResource BrushWarningSoft}"
                BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="13"
                     Foreground="{DynamicResource BrushText}"/>
        </Border>
      </StackPanel>

      <!-- 3: список и выбранный чек -->
      <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="5*,16,4*">

        <Border Grid.Column="0"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
          <Grid>
            <ListBox x:Name="ReceiptsList"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ReceiptsList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Panel>
                  <Border Classes="sel-bar" Width="3" HorizontalAlignment="Left" Margin="-14,-10,0,-10"
                          Background="{DynamicResource BrushText}" CornerRadius="0,2,2,0"/>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" MinWidth="92" VerticalAlignment="Center">
                      <TextBlock Text="{Binding NumberText}" FontSize="15" FontWeight="Bold"
                                 Foreground="{DynamicResource BrushText}"/>
                      <TextBlock Text="{Binding TimeText}" FontSize="12" Margin="0,2,0,0"
                                 Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SummaryText}" FontSize="14"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource BrushText}"/>
                      <TextBlock Text="{Binding SubText}" FontSize="12" Margin="0,2,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{Binding TotalText}" FontSize="15" FontWeight="Bold"
                                 HorizontalAlignment="Right"
                                 Foreground="{DynamicResource BrushText}"/>
                      <Border Classes="badge"
                              Classes.warn="{Binding IsWarn}"
                              Classes.danger="{Binding IsDanger}"
                              Classes.info="{Binding IsInfo}"
                              HorizontalAlignment="Right"
                              MaxWidth="190">
                        <TextBlock Text="{Binding StatusText}"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 2026-10-20: пустое состояние — значок, причина и подсказка, что делать (текст подсказки — из кода). -->
            <StackPanel x:Name="EmptyText" IsVisible="False" Margin="24" Spacing="8" MaxWidth="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <PathIcon Data="{DynamicResource IconReceipt}" Width="36" Height="36"
                        Foreground="{DynamicResource BrushTextMuted}"/>
              <TextBlock Text="{DynamicResource receiptHistory.empty}"
                         FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{DynamicResource BrushText}"/>
              <TextBlock x:Name="EmptyHintText"
                         FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
            <TextBlock x:Name="NoMatchText" IsVisible="False"
                       Text="{DynamicResource receiptHistory.noMatch}"
                       Margin="24" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSoft}"/>
          </Grid>
        </Border>

        <!-- 2026-10-20, владелец: «вид чека как в мобилке оформи» (макет PCashCheck): шапка «Чек …», дата · время ·
             кассир и плашка статуса; белая карточка (в тёмной теме — цвет панели) обычным шрифтом: магазин, адрес/ИНН,
             «Товарный чек · Кассир», позиции «2 × 85 — 170», скидки, «Итого» крупно, оплата, сдача, клиент. Печать —
             прежним текстом (ReceiptHistoryService.BuildReprintText), карточка его не меняет. Фискальных ККМ/ФД/ФП/QR
             у кассы нет (чек нефискальный, решение 16.10) — их блока нет. -->
        <Border Grid.Column="2"
                Background="{DynamicResource BrushWindowBackdrop}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14">
          <Grid>
            <TextBlock x:Name="SelectHintText"
                       Text="{DynamicResource receiptHistory.selectHint}"
                       FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSoft}"/>

            <Grid x:Name="DetailsPanel" IsVisible="False" RowDefinitions="Auto,*">

              <!-- 0: «Чек 001832», плашка статуса; дата · время · кассир -->
              <StackPanel Grid.Row="0" Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="DetailTitle" Grid.Column="0"
                             FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource BrushText}"/>
                  <Border x:Name="DetailBadge" Grid.Column="1" Classes="badge"
                          Margin="12,0,0,0" MaxWidth="200">
                    <TextBlock x:Name="DetailStatusText"/>
                  </Border>
                </Grid>
                <TextBlock x:Name="DetailMeta" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSoft}"/>
              </StackPanel>

              <!-- 1: карточка и сразу под ней действия, как в макете. Сетка прижата кверху: строка «*» берёт высоту
                   карточки, а длинный чек прокручивается, и кнопки остаются видны. -->
              <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto" VerticalAlignment="Top">
              <ScrollViewer Grid.Row="0" Margin="0,10,0,0"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="480">
                  <!-- чек не отправлен на сервер / отклонён сервером — и причина последней неудачи (прокручивается с карточкой) -->
                  <Border x:Name="DetailNotice" IsVisible="False"
                          Margin="0,0,0,10" Padding="12,10" CornerRadius="10"
                          Background="{DynamicResource BrushWarningSoft}"
                          BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1">
                    <StackPanel Spacing="4">
                      <TextBlock x:Name="DetailNoticeText" FontSize="13" TextWrapping="Wrap"
                                 Foreground="{DynamicResource BrushText}"/>
                      <TextBlock x:Name="DetailReasonText" IsVisible="False" FontSize="13" FontWeight="SemiBold"
                                 TextWrapping="Wrap" Foreground="{DynamicResource BrushText}"/>
                      <TextBlock x:Name="DetailAttemptText" IsVisible="False" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>
                  </Border>
                  <ProgressBar x:Name="DetailLoadingBar" IsVisible="False"
                               IsIndeterminate="True" Height="3" MinHeight="3" CornerRadius="2" Margin="0,0,0,8"
                               Foreground="{DynamicResource BrushAccent}" Background="Transparent"/>
                  <TextBlock x:Name="DetailErrorText" IsVisible="False"
                             FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                             Foreground="{DynamicResource BrushDanger}"/>

                  <!-- 2026-10-27, владелец: «вид чека как в мобилке» — бумага чека строится общим контролом (SaleReceiptCardView) из кода:
                       порядок блоков, шрифты и зубцы один в один с ReceiptView мобилки; возвраты — отдельным блоком под оплатой. -->
                  <ContentControl x:Name="ReceiptPaperHost" IsVisible="False" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </ScrollViewer>

              <!-- действия под карточкой. Одна жёлтая главная: «Печать копии», а у неотправленного чека —
                   «Отправить на сервер» (тогда печать — обводкой). Текст переносится: по-кыргызски он длинный. -->
              <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="8" MaxWidth="480">
                <!-- 2026-10-27: «Отправить на сервер» (досылка офлайн-чека) — отдельной жёлтой кнопкой, только у неотправленного чека. -->
                <Button x:Name="SendButton" IsVisible="False"
                        Classes="sec-primary" MinHeight="48"
                        HorizontalAlignment="Stretch"
                        Click="Send_Click">
                  <DockPanel HorizontalAlignment="Center">
                    <PathIcon Data="{DynamicResource IconExport}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="SendButtonText" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                  </DockPanel>
                </Button>
                <!-- 2026-10-27, владелец: «вид чека как в мобилке» — панель «Печать / QR / PDF / Отправить / Вернуть» (ReceiptActionBar),
                     как «Печать · QR · PDF» под чеком мобилки. «Печать» — прежняя печать копии, «Вернуть» — прежнее окно возврата. -->
                <ContentControl x:Name="ActionBarHost"/>
                <!-- 2026-10-03, владелец: «нужна кнопка для печати документов из чека» — лист A4 в браузере. -->
                <Grid ColumnDefinitions="*,8,*">
                  <Button x:Name="DocReceiptButton" Grid.Column="0" Classes="sec-outline" MinHeight="38"
                          HorizontalAlignment="Stretch" IsEnabled="False" Click="DocReceipt_Click"
                          AutomationProperties.Name="{DynamicResource receiptHistory.docSalesReceipt}">
                    <TextBlock Text="{DynamicResource receiptHistory.docSalesReceipt}" TextWrapping="Wrap" TextAlignment="Center"/>
                  </Button>
                  <Button x:Name="DocWaybillButton" Grid.Column="2" Classes="sec-outline" MinHeight="38"
                          HorizontalAlignment="Stretch" IsEnabled="False" Click="DocWaybill_Click"
                          AutomationProperties.Name="{DynamicResource receiptHistory.docWaybill}">
                    <TextBlock Text="{DynamicResource receiptHistory.docWaybill}" TextWrapping="Wrap" TextAlignment="Center"/>
                  </Button>
                </Grid>
              </StackPanel>

              <!-- результат печати / отправки -->
              <TextBlock x:Name="ActionMessage" Grid.Row="2" IsVisible="False"
                         Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold"
                         TextWrapping="Wrap" TextAlignment="Center"/>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
