<Window x:Class="NurMarketKassa.AvaloniaHost.Views.TelegramBotSetupWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sec="using:NurMarketKassa.AvaloniaHost.Views.Controls"
        x:CompileBindings="False"
        Title="{DynamicResource loc.owner.tgSetup.title}"
        Height="760"
        Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBackdrop}"
        Loaded="Window_Loaded">

  <!-- 2026-10-27, жалоба «в тёмной теме у кнопок не видно надписей»: голубой текст #229ED9 на тёмной панели — 4,0:1, при наведении #1E8CC4 — 2,7:1
       (надпись темнела и пропадала); белый на #2AABEE у главных кнопок — 2,6:1 в обеих темах; выключенные — серый 50 % (≈2,5:1).
       Теперь: вторичные — светло-голубой текст в тёмной теме (#7FD0F8, 5,0–8,8:1) и тёмно-голубой в светлой (#0A5F8E / #085684, ≥4,8:1);
       главные — белый на более глубоком голубом #1A74A8 (5,1:1; наведение #166A96, нажатие #135A80); выключенные — #9A9A9A / #6B6B6B (≥4,5:1). -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TgGhostText" Color="#0A5F8E"/>
          <SolidColorBrush x:Key="TgGhostTextHover" Color="#085684"/>
          <SolidColorBrush x:Key="TgDisabledText" Color="#6B6B6B"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TgGhostText" Color="#7FD0F8"/>
          <SolidColorBrush x:Key="TgGhostTextHover" Color="#7FD0F8"/>
          <SolidColorBrush x:Key="TgDisabledText" Color="#9A9A9A"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.StepCard">
      <Setter Property="Background" Value="{DynamicResource BrushPanelElevated}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.StepTitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="TextBlock.StepBody">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
    </Style>
    <!-- 2026-10-03, владелец: «телеграм-бота дизайн кнопки сделай как Telegram-приложение, красиво и
         профессионально». Фирменный синий Telegram (#2AABEE / #229ED9), скругление 12, без рамки;
         вторичные — светло-голубые с синим текстом. -->
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#1A2AABEE"/>
      <Setter Property="Foreground" Value="{DynamicResource TgGhostText}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#332AABEE"/>
      <Setter Property="Foreground" Value="{DynamicResource TgGhostTextHover}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4D2AABEE"/>
    </Style>
    <Style Selector="Button.Primary">
      <Setter Property="Background" Value="#1A74A8"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#166A96"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#135A80"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14808080"/>
      <Setter Property="Foreground" Value="{DynamicResource TgDisabledText}"/>
    </Style>
    <Style Selector="ProgressBar.tg">
      <Setter Property="Foreground" Value="#2AABEE"/>
      <Setter Property="Height" Value="4"/>
      <Setter Property="MinHeight" Value="4"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="{DynamicResource loc.owner.tgSetup.title}" FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"/>
      <TextBlock Classes="StepBody"
                 Text="{DynamicResource loc.owner.tgSetup.intro}"/>
      <TextBlock Classes="StepBody" Foreground="{DynamicResource BrushWarning}"
                 Text="{DynamicResource loc.owner.tgSetup.warning}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">

        <!-- Шаг 1 -->
        <Border Classes="StepCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="StepTitle" Text="{DynamicResource loc.owner.tgSetup.step1}"/>
            <TextBlock Classes="StepBody"
                       Text="{DynamicResource loc.owner.tgSetup.step1Body}"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="Primary" Content="{DynamicResource loc.owner.tgSetup.openBotFather}" Click="OpenBotFather_Click"/>
              <Button Content="{DynamicResource loc.owner.tgSetup.copyNewBot}" Click="CopyNewBot_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Шаг 2 -->
        <Border Classes="StepCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="StepTitle" Text="{DynamicResource loc.owner.tgSetup.step2}"/>
            <TextBlock Classes="StepBody"
                       Text="{DynamicResource loc.owner.tgSetup.step2Body}"/>
            <sec:SecretTextBox x:Name="TokenBox" Watermark="123456789:AAG..." PasswordChar="•"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="Primary" x:Name="CheckTokenButton" Content="{DynamicResource loc.owner.tgSetup.checkToken}" Click="CheckToken_Click"/>
              <Button Content="{DynamicResource loc.owner.tgSetup.pasteToken}" Click="PasteToken_Click"/>
            </StackPanel>
            <TextBlock x:Name="TokenStatus" Classes="StepBody"/>
          </StackPanel>
        </Border>

        <!-- Шаг 3 -->
        <Border Classes="StepCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="StepTitle" Text="{DynamicResource loc.owner.tgSetup.step3}"/>
            <TextBlock Classes="StepBody"
                       Text="{DynamicResource loc.owner.tgSetup.step3Body}"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="OpenMyBotButton" Content="{DynamicResource loc.owner.tgSetup.openMyBot}" Click="OpenMyBot_Click" IsEnabled="False"/>
              <Button Classes="Primary" x:Name="DetectButton" Content="{DynamicResource loc.owner.tgSetup.detect}" Click="Detect_Click" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="DetectStatus" Classes="StepBody"/>
          </StackPanel>
        </Border>

        <!-- Шаг 4 -->
        <Border Classes="StepCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="StepTitle" Text="{DynamicResource loc.owner.tgSetup.step4}"/>
            <Button x:Name="TestButton" Content="{DynamicResource loc.owner.tgSetup.sendTest}" Click="Test_Click" IsEnabled="False"/>
            <TextBlock x:Name="TestStatus" Classes="StepBody"/>
            <CheckBox x:Name="SummaryCheck" Content="{DynamicResource loc.owner.tgSetup.summaryOnClose}"
                      IsCheckedChanged="Toggles_Changed"/>
            <CheckBox x:Name="CommandsCheck" Content="{DynamicResource loc.owner.tgSetup.answerCommands}"
                      IsCheckedChanged="Toggles_Changed"/>
            <TextBlock Classes="StepBody"
                       Text="{DynamicResource loc.owner.tgSetup.commandsHelp}"/>
          </StackPanel>
        </Border>

        <!-- 2026-10-24 (ТЗ «Склад…», пакет Г1): «Группа заказов» — заказы из бота в общую группу сотрудников (или группа + личка).
             Тексты — в коде (5 языков). Группа подключается кодом /group от подтверждённого владельца. -->
        <Border Classes="StepCard" x:Name="OrdersGroupCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="StepTitle" x:Name="OrdersGroupTitle"/>
            <TextBlock Classes="StepBody" x:Name="OrdersGroupHint"/>
            <TextBlock Classes="StepBody" x:Name="OrdersGroupStatus" FontWeight="SemiBold"/>
            <TextBlock Classes="StepBody" x:Name="OrdersGroupInstruction" IsVisible="False"/>
            <WrapPanel>
              <Button Classes="Primary" x:Name="OrdersGroupDetectButton" Margin="0,0,10,8" Click="OrdersGroupDetect_Click"/>
              <Button x:Name="OrdersGroupDisconnectButton" Margin="0,0,10,8" Click="OrdersGroupDisconnect_Click"/>
            </WrapPanel>
            <StackPanel Spacing="4">
              <RadioButton x:Name="OrdersTargetGroupRadio" GroupName="OrdersTarget" IsCheckedChanged="OrdersTarget_Changed"/>
              <RadioButton x:Name="OrdersTargetBothRadio" GroupName="OrdersTarget" IsCheckedChanged="OrdersTarget_Changed"/>
              <RadioButton x:Name="OrdersTargetOwnerRadio" GroupName="OrdersTarget" IsCheckedChanged="OrdersTarget_Changed"/>
            </StackPanel>
            <CheckBox x:Name="OrdersShowAmountCheck" IsCheckedChanged="OrdersShowAmount_Changed"/>
            <TextBlock Classes="StepBody" x:Name="OrdersGroupPrivateHint"/>
          </StackPanel>
        </Border>

        <!-- 2026-10-01, ТЗ часть 5: бот на сервере NurCRM — отвечает круглые сутки, даже когда
             касса и программа владельца выключены. Тексты — в коде (5 языков). -->
        <Border Classes="StepCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="StepTitle" x:Name="ServerTitle"/>
            <TextBlock Classes="StepBody" x:Name="ServerHint"/>
            <TextBlock Classes="StepBody" x:Name="ServerStatus" FontWeight="SemiBold"/>
            <!-- 2026-10-03, владелец: «индикатор ИИ на сервере добавь у клиентов» — метки состояния. -->
            <WrapPanel x:Name="ServerChips"/>
            <WrapPanel>
              <Button Classes="Primary" x:Name="ServerMoveButton" Margin="0,0,10,8" Click="ServerMove_Click"/>
              <Button x:Name="ServerTestButton" Margin="0,0,10,8" Click="ServerTest_Click" IsEnabled="False"/>
              <Button x:Name="ServerTestAiButton" Margin="0,0,10,8" Click="ServerTestAi_Click" IsEnabled="False"/>
              <Button x:Name="ServerBackButton" Margin="0,0,10,8" Click="ServerBack_Click" IsEnabled="False"/>
            </WrapPanel>
            <!-- 2026-10-04, владелец: «ИИ тоже на сервер — возможность для клиентов сделай». Ключ ИИ отправляется
                 прямо на сервер (в программе не сохраняется) — без ключа в самой кассе. -->
            <StackPanel x:Name="ServerAiPanel" Spacing="6" IsVisible="False">
              <TextBlock Classes="StepBody" x:Name="ServerAiHint"/>
              <WrapPanel>
                <sec:SecretTextBox x:Name="ServerAiKeyBox" Width="340" PasswordChar="•" Watermark="AIza..." Margin="0,0,10,8"/>
                <Button Classes="Primary" x:Name="ServerAiSaveButton" Margin="0,0,10,8" Click="ServerAiSave_Click"/>
                <Button x:Name="ServerAiGetKeyButton" Margin="0,0,10,8" Click="ServerAiGetKey_Click"/>
              </WrapPanel>
            </StackPanel>
            <ProgressBar x:Name="ServerProgress" Classes="tg" IsIndeterminate="True" IsVisible="False"/>
            <TextBlock Classes="StepBody" x:Name="ServerActionStatus"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
      <Button IsCancel="True" Classes="Primary" Content="{DynamicResource loc.owner.tgSetup.done}" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
