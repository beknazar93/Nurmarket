<Window x:Class="NurMarketKassa.AvaloniaHost.Views.RemoteSupportWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        Title="{DynamicResource csh.menu.remoteSupport}"
        Height="480"
        Width="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!-- 2026-09-08: переделаны отступы всего окна (владелец: "переделать все отступы... для
         красоты") + кнопка теперь не даёт тексту прятаться (владелец: "текст отчётливо читался
         а не прятался") — было Height=46 без явного FontSize/MinHeight у ContentPresenter, из-за
         чего эмодзи+длинный текст на некоторых языках (на узбекском и кыргызском подписи заметно
         длиннее русских) мог обрезаться;
         теперь высота больше, явный FontSize, TextWrapping разрешён вместо жёсткого обрезания. -->
    <Window.Styles>
        <Style Selector="Button.PrimaryActionButton">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SettingsButtonRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="20,8" TextBlock.TextAlignment="Center" TextBlock.TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 2026-10-21: выключенная главная (нет связи с сервером поддержки) — серая, не жёлтая (пакет 3, п. 143). -->
        <Style Selector="Button.PrimaryActionButton:disabled">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.SecondaryActionButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SettingsButtonRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="16,8" TextBlock.TextAlignment="Center" TextBlock.TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- 2026-10-16: сторонняя программа удалённого доступа убрана (кнопки запуска и скачивания). Единственный способ
         удалённой помощи — блок «Нур Поддержка» (RemoteSupportWindow.NurSupport.cs), он встраивается в строку 2 над
         StatusText; строка 2 прижата к верху — без пустого места между вступлением и блоком. -->
    <Grid x:Name="RootGrid" Margin="28" Background="{DynamicResource BrushPanel}" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" x:Name="TitlePanel" Orientation="Horizontal" Spacing="14">
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource BrushAccentSoft}"
                    BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                <TextBlock Text="🖥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{DynamicResource csh.menu.remoteSupport}" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrushText}"/>
        </StackPanel>

        <!-- 2026-10-21: текст вступления — в коде (RemoteSupportWindow.axaml.cs: «экран кассы» / у владельца «экран этого
             компьютера»), пакет 3, п. 143. -->
        <TextBlock Grid.Row="1" x:Name="IntroText" FontSize="13"
                   Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" LineHeight="20" Margin="0,20,0,0"/>

        <!-- 2026-10-16: прокрутка — если вопрос оператора с кнопками не помещается на невысоком экране, он не наезжает на
             кнопки внизу окна. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,14">
            <StackPanel VerticalAlignment="Top" Spacing="12">
                <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource BrushTextSoft}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 2026-10-05, владелец: «кнопку "скопировать информацию об устройстве" — чтобы легче было адаптировать под
             такие устройства». Текст об аппарате и экране — в буфер обмена (DeviceInfoReport). На Android и Linux — главная
             кнопка окна (своей удалённой помощи там нет, 2026-10-16). WrapPanel — на узком экране кнопки переносятся. -->
        <WrapPanel Grid.Row="3" x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="CopyDeviceInfoButton" Content="{DynamicResource remoteSupport.copyDeviceInfo}"
                    Classes="SecondaryActionButton" Click="CopyDeviceInfo_Click" Margin="0,0,12,8"/>
            <Button IsCancel="True" x:Name="CloseButton" Content="{DynamicResource common.close}" Classes="SecondaryActionButton" Click="Close_Click" Margin="0,0,0,8"/>
        </WrapPanel>
    </Grid>
</Window>
