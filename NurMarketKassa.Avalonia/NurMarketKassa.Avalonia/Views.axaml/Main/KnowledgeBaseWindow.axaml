<Window x:Class="NurMarketKassa.AvaloniaHost.Views.KnowledgeBaseWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        Title="{DynamicResource csh.menu.knowledgeBase}"
        Height="720"
        Width="780"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.SecondaryActionButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SettingsButtonRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="TextBlock.CategoryTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Expander TextBlock.Answer">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,8,4,10"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" Background="{DynamicResource BrushPanel}" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}"
                    BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{DynamicResource csh.menu.knowledgeBase}" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrushText}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{DynamicResource kb.subtitle}" FontSize="12"
                   Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock Classes="CategoryTitle" Text="{DynamicResource kb.catFeaturesTitle}"/>
                <Expander Header="{DynamicResource kb.q.offlineQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.offlineA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.deferredCartsQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.deferredCartsA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.themesQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.themesA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.zeroStockQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.zeroStockA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.irregularReceiptsQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.irregularReceiptsA}"/>
                </Expander>

                <TextBlock Classes="CategoryTitle" Text="{DynamicResource kb.catCashierTitle}"/>
                <Expander Header="{DynamicResource kb.q.permissionsQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.permissionsA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.financeAccessQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.financeAccessA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.shiftQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.shiftA}"/>
                </Expander>

                <TextBlock Classes="CategoryTitle" Text="{DynamicResource kb.catUpdatesTitle}"/>
                <Expander Header="{DynamicResource kb.q.checkUpdateQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.checkUpdateA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.rollbackQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.rollbackA}"/>
                </Expander>

                <TextBlock Classes="CategoryTitle" Text="{DynamicResource kb.catFailureTitle}"/>
                <Expander Header="{DynamicResource kb.q.errorDialogQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.errorDialogA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.logsQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.logsA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.remoteSupportQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.remoteSupportA}"/>
                </Expander>
                <Expander Header="{DynamicResource kb.q.printerQ}">
                    <TextBlock Classes="Answer" Text="{DynamicResource kb.q.printerA}"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource common.close}" Classes="SecondaryActionButton" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
