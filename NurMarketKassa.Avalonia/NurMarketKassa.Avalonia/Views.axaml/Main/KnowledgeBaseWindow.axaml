<Window x:Class="NurMarketKassa.AvaloniaHost.Views.KnowledgeBaseWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        Title="{DynamicResource csh.menu.knowledgeBase}"
        Height="820"
        Width="1240"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindow}">

    <!-- База знаний (2026-09-26, «все вопросы и обучение со скриншотами»): статьи — из базы
         знаний бота поддержки NurCRM (Assets/kb/kb.json), к ним — снимки настоящих окон кассы и
         программы владельца (Assets/kb/*.png). Слева поиск и разделы, справа статья. -->
    <Window.Styles>
        <Style Selector="Button.SecondaryActionButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SettingsButtonRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="TextBlock.navSection">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Margin" Value="10,18,0,6"/>
        </Style>
        <Style Selector="TextBlock.navGroup">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Margin" Value="10,10,0,4"/>
        </Style>
        <Style Selector="Button.kbItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="Button.kbItem:pointerover">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="Button.kbItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.kbItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="Button.kbItem.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        </Style>
        <Style Selector="Button.kbItem TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.kbItem.active TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="340,*">
        <!-- Шапка -->
        <Border Grid.ColumnSpan="2" Padding="20,14" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource BrushAccentSoft}"
                        BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                    <TextBlock Text="📚" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{DynamicResource csh.menu.knowledgeBase}" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="CloseButton" IsCancel="True" Content="{DynamicResource common.close}"
                        Classes="SecondaryActionButton" Click="Close_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Поиск и список статей -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="14,14,14,6" Height="38"
                         VerticalContentAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Margin="8,0,8,16"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Статья -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="ArticleScroll"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ArticlePanel" Margin="34,24,34,36" MaxWidth="1000" HorizontalAlignment="Left" Spacing="12"/>
        </ScrollViewer>
    </Grid>
</Window>
