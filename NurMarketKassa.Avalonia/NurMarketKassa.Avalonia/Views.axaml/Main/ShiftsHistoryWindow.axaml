<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NurMarketKassa.AvaloniaHost.Views"
        xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
        x:Class="NurMarketKassa.AvaloniaHost.Views.ShiftsHistoryWindow"
        x:DataType="vm:ShiftHistoryViewModel"
        x:CompileBindings="True"
        Title="{DynamicResource shiftHistory.title}"
        Width="1280"
        Height="840"
        MinWidth="960"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        SystemDecorations="None"
        Background="{DynamicResource BrushWindowBackdrop}"
        FontFamily="Segoe UI">

  <Window.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Shared/ShiftHistoryResources.axaml"/>
  </Window.Styles>

  <Grid RowDefinitions="64,*">

    <!-- Шапка окна -->
    <Border Grid.Row="0"
            Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1"
            Padding="20,0"
            PointerPressed="Header_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{DynamicResource shiftHistory.title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}"
                   VerticalAlignment="Center"/>
        <!-- 2026-11-12 (Д-4): вкладки вместо боковой панели на два пункта (230 px ширины съедали таблицу, на 1024 появлялась горизонтальная прокрутка). -->
        <Border Grid.Column="1" Classes="sec-segment" Margin="24,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="sec-seg" Classes.active="{Binding IsHistoryPage}"
                    Content="{DynamicResource shiftHistory.title}"
                    Command="{Binding ShowHistoryCommand}"/>
            <Button Classes="sec-seg" Classes.active="{Binding IsSummaryPage}"
                    Content="{DynamicResource shiftHistory.summaryTab}"
                    Command="{Binding ShowSummaryCommand}"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <Button Content="&#xE921;"
                  FontFamily="Segoe MDL2 Assets"
                  Classes="ShiftWindowChromeButton"
                  ToolTip.Tip="{DynamicResource csh.filter.minimizeTooltip}"
                  Command="{Binding MinimizeCommand}"/>
          <Button Content="&#xE8BB;"
                  FontFamily="Segoe MDL2 Assets"
                  Classes="ShiftWindowChromeButton"
                  ToolTip.Tip="{DynamicResource csh.filter.closeTooltip}"
                  Command="{Binding CloseCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">

      <!-- Контент: история / сводка -->
      <Grid Background="{DynamicResource BrushWindowAlt}">
        <views:ShiftHistoryView IsVisible="{Binding IsHistoryPage}"/>
        <views:ShiftSummaryView IsVisible="{Binding IsSummaryPage}"/>

        <Border Background="{DynamicResource BrushOverlay}"
                ZIndex="20"
                IsVisible="{Binding IsLoading}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12">
            <TextBlock Text="{DynamicResource common.loadingDots}"
                       Foreground="{DynamicResource BrushText}"
                       FontSize="18"
                       HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True"
                         MinWidth="200"
                         Height="8"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
