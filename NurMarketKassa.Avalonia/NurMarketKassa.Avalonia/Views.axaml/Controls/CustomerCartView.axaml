<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:NurMarketKassa.AvaloniaHost.Views.Main.Controls"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.CustomerCartView"
             x:DataType="vm:BasketPanelViewModel"
             x:CompileBindings="True"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <controls:BasketPanelView HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"/>
</UserControl>
