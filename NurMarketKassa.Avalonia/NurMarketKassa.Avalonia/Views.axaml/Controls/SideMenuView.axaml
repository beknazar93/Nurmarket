<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.SideMenuView"
             x:DataType="vm:SideMenuViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <StreamGeometry x:Key="HomeIcon">M3,11 L12,3 L21,11 V21 H15 V15 H9 V21 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="WarehouseIcon">M4,7 L12,3 L20,7 V17 L12,21 L4,17 Z M4,7 L12,11 L20,7 M12,11 V21</StreamGeometry>
        <StreamGeometry x:Key="ShiftIcon">M12,3 A9,9 0 1 1 11.99,3 M12,7 V12 L16,14</StreamGeometry>
        <StreamGeometry x:Key="CashOperationsIcon">M5,4 H19 V9 H5 Z M4,9 H20 V20 H4 Z M7,13 H12 M15,13 H17 M7,17 H17</StreamGeometry>
        <StreamGeometry x:Key="ReturnIcon">M9,7 L4,12 L9,17 M5,12 H14 A6,6 0 0 1 20,18</StreamGeometry>
        <StreamGeometry x:Key="FinanceIcon">M4,20 V11 M10,20 V5 M16,20 V14 M22,20 V8</StreamGeometry>
        <StreamGeometry x:Key="SalesIcon">M3,4 H5 L7,15 H18 L21,8 H6 M9,20 A1.5,1.5 0 1 1 8.99,20 M17,20 A1.5,1.5 0 1 1 16.99,20</StreamGeometry>
        <StreamGeometry x:Key="ClientsIcon">M9,11 A4,4 0 1 1 8.99,11 M3,20 A6,6 0 0 1 15,20 M17,11 A3,3 0 1 1 16.99,11 M17,14 A5,5 0 0 1 21,19</StreamGeometry>
        <StreamGeometry x:Key="PayDebtIcon">M4,7 H20 V17 H4 Z M4,10 H20 M7,14 H10 M13,3 A4,4 0 0 1 13,7</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M12,8 A4,4 0 1 1 11.99,8 M19,12 A7,7 0 0 0 18.8,10.4 L21,8 L18,5 L15.6,6.2 A7,7 0 0 0 14,5.5 L13,2 H9 L8,5.5 A7,7 0 0 0 6.4,6.2 L4,5 L1,8 L3.2,10.4 A7,7 0 0 0 3,12 A7,7 0 0 0 3.2,13.6 L1,16 L4,19 L6.4,17.8 A7,7 0 0 0 8,18.5 L9,22 H13 L14,18.5 A7,7 0 0 0 15.6,17.8 L18,19 L21,16 L18.8,13.6 A7,7 0 0 0 19,12</StreamGeometry>
        <StreamGeometry x:Key="CrmIcon">M4,5 H20 V16 H13 L9,20 V16 H4 Z</StreamGeometry>
        <StreamGeometry x:Key="LogoutIcon">M13,4 H20 V20 H13 M10,8 L6,12 L10,16 M6,12 H16</StreamGeometry>
        <StreamGeometry x:Key="ExitAppIcon">M12,3 V11 M6.5,5.5 A8,8 0 1 0 17.5,5.5</StreamGeometry>
        <StreamGeometry x:Key="DeferredReceiptIcon">M6,3 H18 V21 L15,19 L12,21 L9,19 L6,21 Z M9,8 H15 M9,12 H15 M9,16 H12</StreamGeometry>
        <StreamGeometry x:Key="ErrorLogIcon">M4,4 H20 V20 H4 Z M8,9 H16 M8,13 H16 M8,17 H12 M12,2 V4 M12,20 V22</StreamGeometry>
        <StreamGeometry x:Key="RemoteSupportIcon">M3,5 H21 V16 H14 L15,19 H9 L10,16 H3 Z M8,10.5 A4,4 0 1 1 15.99,10.5</StreamGeometry>
        <StreamGeometry x:Key="KnowledgeBaseIcon">M4,5 A2,2 0 0 1 6,3 H20 V19 H6 A2,2 0 0 0 4,21 Z M4,5 V19 M8,8 H16 M8,12 H14</StreamGeometry>
        <StreamGeometry x:Key="RestockIcon">M3,17 L9,11 L13,15 L21,7 M21,7 H15 M21,7 V13</StreamGeometry>
        <StreamGeometry x:Key="SwitchCashierIcon">M17,8 L21,12 L17,16 M21,12 H9 M7,16 L3,12 L7,8 M3,12 H15</StreamGeometry>
        <StreamGeometry x:Key="StaffTimesheetIcon">M3,5 H21 V19 H3 Z M6,9 A2,2 0 1 1 5.99,9 M4,16 A3,3 0 0 1 10,16 M14,9 H18 M14,13 H18</StreamGeometry>
        <StreamGeometry x:Key="MarketplaceIcon">M6,8 H18 L19,21 H5 Z M9,8 V6 A3,3 0 0 1 15,6 V8</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.sidebar-menu-item">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item.active">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item.logout">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item.logout:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
        <Style Selector="Border.NewBadge">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.NewBadge TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentStrong}"/>
        </Style>
        <Style Selector="Button.sidebar-section-header">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,4,8,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sidebar-section-header:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
    </UserControl.Styles>

    <Border Width="300"
            Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="16,14"
                    Background="{DynamicResource BrushPanelElevated}">
                <Grid>
                    <TextBlock Text="{Binding CashboxTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}"
                               VerticalAlignment="Center"/>
                    <Button Classes="main-ghost"
                            Content="✕"
                            Width="32" Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseMenuCommand}"/>
                </Grid>
            </Border>

            <ScrollViewer DockPanel.Dock="Bottom"
                          >
                <StackPanel Margin="0,8,0,16" Spacing="2">
                    <Border Margin="12,0,12,10"
                            Padding="14"
                            CornerRadius="10"
                            Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource sideMenu.shiftLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Text="{Binding ShiftBalanceText}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}"/>
                        </StackPanel>
                    </Border>

                    <Button Classes="sidebar-section-header" Command="{Binding ToggleWorkSectionCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{DynamicResource sideMenu.sectionWork}"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Grid.Column="1" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding IsWorkSectionExpanded}"/>
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding !IsWorkSectionExpanded}"/>
                        </Grid>
                    </Button>
                    <StackPanel Spacing="2" IsVisible="{Binding IsWorkSectionExpanded}">
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewWarehouse}"
                            Command="{Binding NavigateWarehouseCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeJoin="Round"
                                  Data="{StaticResource WarehouseIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.warehouse}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewStaffTimesheet}"
                            Command="{Binding NavigateStaffTimesheetCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource StaffTimesheetIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.staffTimesheet}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewReturn}"
                            Command="{Binding NavigateReturnCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource ReturnIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.return}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewDeferredReceipts}"
                            Command="{Binding NavigateDeferredReceiptsCommand}">
                        <Grid ColumnDefinitions="24,12,*,Auto" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource DeferredReceiptIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.deferredReceipts}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="NewBadge">
                                <TextBlock Text="{DynamicResource csh.menu.newBadge}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewRestock}"
                            Command="{Binding NavigateRestockCommand}">
                        <Grid ColumnDefinitions="24,12,*,Auto" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource RestockIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.restock}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="NewBadge">
                                <TextBlock Text="{DynamicResource csh.menu.newBadge}"/>
                            </Border>
                        </Grid>
                    </Button>

                    </StackPanel>

                    <Button Classes="sidebar-section-header" Command="{Binding ToggleInfoSectionCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{DynamicResource sideMenu.sectionInfoClients}"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Grid.Column="1" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding IsInfoSectionExpanded}"/>
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding !IsInfoSectionExpanded}"/>
                        </Grid>
                    </Button>
                    <StackPanel Spacing="2" IsVisible="{Binding IsInfoSectionExpanded}">
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewFinance}"
                            Command="{Binding NavigateFinanceCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="{StaticResource FinanceIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.finance}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewSales}"
                            Command="{Binding NavigateSalesCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource SalesIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.sales}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewSales}"
                            Command="{Binding NavigateAbcCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <!-- Три столбика разной высоты: узнаваемая картинка ABC и она же
                                 отличает пункт от «Финансов», где иконка тоже столбчатая. -->
                            <Canvas Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                <Rectangle Canvas.Left="1" Canvas.Top="4" Width="4.5" Height="14" RadiusX="1" RadiusY="1" Fill="#16A34A"/>
                                <Rectangle Canvas.Left="7.5" Canvas.Top="9" Width="4.5" Height="9" RadiusX="1" RadiusY="1" Fill="#F59E0B"/>
                                <Rectangle Canvas.Left="14" Canvas.Top="13" Width="4.5" Height="5" RadiusX="1" RadiusY="1" Fill="#3B82F6"/>
                            </Canvas>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.abc}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewClients}"
                            Command="{Binding NavigateClientsCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource ClientsIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.clients}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewPayDebt}"
                            Command="{Binding NavigatePayDebtCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource PayDebtIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.payDebt}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    </StackPanel>

                    <Button Classes="sidebar-section-header" Command="{Binding ToggleSystemSectionCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{DynamicResource sideMenu.sectionSystem}"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Grid.Column="1" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding IsSystemSectionExpanded}"/>
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource BrushTextSoft}" IsVisible="{Binding !IsSystemSectionExpanded}"/>
                        </Grid>
                    </Button>
                    <StackPanel Spacing="2" IsVisible="{Binding IsSystemSectionExpanded}">
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewCrm}"
                            Command="{Binding NavigateCrmCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource CrmIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.crm}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewErrorLogs}"
                            Command="{Binding NavigateErrorLogsCommand}">
                        <Grid ColumnDefinitions="24,12,*,Auto" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource ErrorLogIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.errorLogs}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="NewBadge">
                                <TextBlock Text="{DynamicResource csh.menu.newBadge}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewRemoteSupport}"
                            Command="{Binding NavigateRemoteSupportCommand}">
                        <Grid ColumnDefinitions="24,12,*,Auto" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource RemoteSupportIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.remoteSupport}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="NewBadge">
                                <TextBlock Text="{DynamicResource csh.menu.newBadge}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewKnowledgeBase}"
                            Command="{Binding NavigateKnowledgeBaseCommand}">
                        <Grid ColumnDefinitions="24,12,*,Auto" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource KnowledgeBaseIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.knowledgeBase}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="NewBadge">
                                <TextBlock Text="{DynamicResource csh.menu.newBadge}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            IsVisible="{Binding CanViewMarketplace}"
                            Command="{Binding NavigateMarketplaceCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource MarketplaceIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.marketplace}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    </StackPanel>

                    <!-- Настройки вынесены из свёрнутого раздела "Система" и всегда видны —
                         единственный пункт из раздела, которым пользуются постоянно, а не
                         время от времени (2026-09-05, вместе со сворачиванием остальных
                         разделов бургер-меню). -->
                    <Button Classes="sidebar-menu-item"
                            Margin="8,10,8,2"
                            IsVisible="{Binding CanViewSettings}"
                            Command="{Binding NavigateSettingsCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  StrokeJoin="Round"
                                  Data="{StaticResource SettingsIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.settings}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Classes="sidebar-menu-item"
                            Margin="8,2,8,2"
                            Command="{Binding SwitchCashierCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource SwitchCashierIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.switchCashier}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            Margin="8,2,8,16"
                            Command="{Binding ExitApplicationCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource ExitAppIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource csh.menu.exitApp}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
