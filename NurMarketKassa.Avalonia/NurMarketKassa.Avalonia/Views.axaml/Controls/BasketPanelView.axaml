<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             xmlns:pos="using:NurMarketKassa.Models.Pos"
             xmlns:ctl="using:NurMarketKassa.AvaloniaHost.Views.Main.Controls"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.BasketPanelView"
             x:DataType="vm:BasketPanelViewModel"
             x:CompileBindings="True"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <UserControl.Styles>
        <!-- 2026-09-30, владелец: «ловушку с Enter убрать и у остальных кнопок». Enter, которым сканер
             заканчивает каждый код, нажимал кнопку, оставшуюся в фокусе после щелчка («Доп. услуга»,
             «Скидка», «Ещё», «Печать последнего», «Оплатить»…), а код до сканера не доходил. Как у
             Button.receipt-tab (978b762) и всех кнопок новых видов кассы — без фокуса. -->
        <!-- 2026-10-04, редизайн под сенсорные моноблоки: все кнопки чека не ниже 44 точек — по ним
             попадают пальцем (было 42, у +/−/%/корзины — 32). -->
        <Style Selector="Button.cart-action">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cart-action:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="Button.cart-qty, RepeatButton.cart-qty">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="RepeatButton.cart-qty">
            <Setter Property="Delay" Value="300"/>
            <Setter Property="Interval" Value="100"/>
        </Style>

        <Style Selector="Button.cart-delete">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cart-chip">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cart-accent">
            <!-- 2026-09-30: без фокуса, см. Button.cart-action выше. -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ListBox.cart-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="ListBox.cart-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ListBox.cart-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.cart-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Стили для вкладок чека -->
        <!-- 2026-09-29, жалоба магазина «нажал "+ Новый чек", отсканировал товар — создаётся ещё
             один новый чек»: кнопка после щелчка мышью оставалась в фокусе (рамки фокуса не видно —
             FocusAdorner пустой), и Enter, которым сканер заканчивает каждый код, нажимал её ещё раз,
             а сам код до сканера не доходил. Кнопки вкладок и «+ Новый чек» фокус не берут — как
             +/− у строк чека и все кнопки новых видов кассы (LayoutStyles.axaml). -->
        <Style Selector="Button.receipt-tab">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.receipt-tab:pointerover, Button.receipt-tab:pressed, Button.receipt-tab:focus">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.receipt-tab.active">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.receipt-tab.active:pointerover, Button.receipt-tab.active:pressed, Button.receipt-tab.active:focus">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Редизайн 2026-09-28. Выбранная вкладка «выключена» (её нельзя выбрать ещё раз), и тема
             Fluent красила её серым, как недоступную: чек, с которым работает кассир, выглядел
             неактивным. Выбранная вкладка теперь всегда цвета темы. -->
        <Style Selector="Button.receipt-tab.active:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.receipt-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.receipt-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>

        <!-- Наведение, нажатие и недоступность кнопок чека — в цветах темы, а не серым Fluent. -->
        <Style Selector="Button.cart-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.cart-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
        </Style>
        <Style Selector="Button.cart-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
        </Style>
        <Style Selector="Button.cart-accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="Button.cart-accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="Button.cart-accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="Button.cart-accent:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.cart-qty:pointerover /template/ ContentPresenter#PART_ContentPresenter, RepeatButton.cart-qty:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.cart-qty:pressed /template/ ContentPresenter#PART_ContentPresenter, RepeatButton.cart-qty:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="Button.cart-qty:disabled, RepeatButton.cart-qty:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.cart-qty PathIcon, RepeatButton.cart-qty PathIcon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <Style Selector="Button.cart-delete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
        </Style>
        <Style Selector="Button.cart-delete:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.new-receipt-tab">
            <!-- 2026-09-29: без фокуса, см. комментарий у Button.receipt-tab выше. -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.new-receipt-tab:pointerover, Button.new-receipt-tab:pressed, Button.new-receipt-tab:focus">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- ============ Компактный вид (2026-10-04) ============
             Класс "compact" ставит окно кассы, когда обычный вид не помещается на экран (1024×768,
             1280×800, 1366×768, сенсорные моноблоки; см. MainWindow.RefreshUiScale). Касса тогда не
             уменьшается целиком, а перестраивает чек: строка товара в два ряда (название и сумма
             сверху, цена × количество и кнопки снизу), отступы и итог плотнее. Ниже сначала обычный
             вид (значения, которые раньше стояли прямо на элементах), потом .compact — он идёт
             позже и переопределяет. -->
        <Style Selector="Border.cart-surface">
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style Selector="Border.cart-tabs-row">
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.cart-tabs-pad">
            <Setter Property="Padding" Value="0,4,0,18"/>
        </Style>
        <Style Selector="Border.cart-line">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- Место суммы и кнопок в сетке строки задаётся только здесь (не на самих элементах), иначе
             компактный вид не смог бы его поменять: значение на элементе сильнее стиля. -->
        <Style Selector="StackPanel.line-amount">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="Grid.line-controls">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="2"/>
        </Style>
        <Style Selector="TextBlock.line-priceqty-compact">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.cart-entry-row">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Grid.cart-total-row">
            <Setter Property="Margin" Value="0,8,0,10"/>
        </Style>
        <Style Selector="TextBlock.cart-total">
            <Setter Property="FontSize" Value="40"/>
        </Style>
        <Style Selector="TextBlock.cart-action-text">
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style Selector=".compact Border.cart-surface">
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector=".compact Border.cart-tabs-row">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector=".compact Border.cart-tabs-pad">
            <Setter Property="Padding" Value="0,2,0,8"/>
        </Style>
        <Style Selector=".compact Border.cart-line">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Кнопки строки — вторым рядом на всю ширину строки, слева от них «цена × количество». -->
        <Style Selector=".compact Grid.line-controls">
            <Setter Property="Grid.Row" Value="2"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector=".compact StackPanel.line-amount">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector=".compact TextBlock.line-priceqty-wide">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".compact TextBlock.line-priceqty-compact">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector=".compact Grid.cart-entry-row">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector=".compact Grid.cart-total-row">
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style Selector=".compact TextBlock.cart-total">
            <Setter Property="FontSize" Value="32"/>
        </Style>
        <!-- Узкий чек: подписи кнопок — в две строки вместо «Отложить ч…», «Кошумча …». -->
        <Style Selector=".compact Button.cart-action">
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style Selector=".compact TextBlock.cart-action-text">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <!-- 2026-09-30: своя кисть корзины (= BrushWindowAlt; у темы «Кыргыз» — узор тумар). -->
    <Border Classes="cart-surface"
            Background="{DynamicResource BrushCartSurface}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*,Auto"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Вкладки открытых чеков -->
            <Border Grid.Row="0"
                    Classes="cart-tabs-row"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <DockPanel>
                <!-- 2026-10-04, клиент: «тумблер сверху (Оптовый/Розничный)». Без фокуса — Enter сканера не должен
                     его переключать. -->
                <ToggleSwitch DockPanel.Dock="Right"
                              Margin="10,0,0,14"
                              VerticalAlignment="Center"
                              Focusable="False"
                              IsChecked="{Binding IsWholesaleMode}"
                              OnContent="{DynamicResource csh.cart.modeWholesale}"
                              OffContent="{DynamicResource csh.cart.modeRetail}"
                              ToolTip.Tip="{DynamicResource csh.cart.modeTooltip}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinWidth="0">
                    <!--
                      Fluent ScrollViewer uses an overlay scrollbar. The bottom
                      padding reserves a separate hit area below the receipt tabs.
                    -->
                    <Border Classes="cart-tabs-pad">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{Binding ReceiptTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReceiptTabVm">
                                        <Button Classes="receipt-tab"
                                                Classes.active="{Binding IsActive}"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Title}"
                                                       MaxWidth="190"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="new-receipt-tab"
                                    Content="{DynamicResource csh.cart.newReceipt}"
                                    Command="{Binding NewReceiptCommand}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Список позиций в корзине -->
            <Grid Grid.Row="1"
                  MinHeight="0"
                  Margin="0,0,0,8"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <!-- 2026-10-04: пустой чек с «Быстрыми товарами» — в прокрутке. Без неё на низком месте для чека
                     (вертикальный телефон, маленький экран) блок вылезал за свою строку и ложился поверх
                     поля ввода, кнопок и «Итого». -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding IsEmpty}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Margin="16"
                            IsVisible="{Binding IsEmpty}">
                    <PathIcon Width="52"
                              Height="52"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource BrushTextSoft}"
                              Data="M7,18C5.89,18 5,18.89 5,20A2,2 0 0,0 7,22A2,2 0 0,0 9,20C9,18.89 8.1,18 7,18M17,18C15.89,18 15,18.89 15,20A2,2 0 0,0 17,22A2,2 0 0,0 19,20C19,18.89 18.1,18 17,18M7.17,14.75L7.92,16H17.55C18.3,16 18.96,15.59 19.3,14.97L23.16,7.96L21.42,7H21.41L20.3,9L17.55,14H8.34L7.68,12.88L7.04,11.8L4.38,6.59L3.43,4.75L2.5,3H0V5H1.25L5.12,13.19L3.67,15.83C3.25,16.57 3.79,17.5 4.64,17.5H19V15.5H5.07L6.17,13.5L7.17,14.75Z"/>
                    <TextBlock Text="{DynamicResource csh.cart.empty}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}"
                               TextAlignment="Center"/>
                    <TextBlock Text="{DynamicResource csh.cart.emptyHint}"
                               FontSize="13"
                               Foreground="{DynamicResource BrushTextSoft}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <!-- Товары, отмеченные звёздочкой в каталоге. Пока чек пуст, половина
                         экрана всё равно ничем не занята — пусть на ней лежит то, что кассир
                         пробивает каждый день. Блока нет вовсе, если избранного не отметили:
                         пустая рамка с заголовком была бы хуже, чем ничего. -->
                    <StackPanel Spacing="10" Margin="0,18,0,0" IsVisible="{Binding HasQuickProducts}">
                        <Grid ColumnDefinitions="*,Auto,*" Margin="10,0">
                            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center"
                                       Fill="{DynamicResource BrushCatalogTileBorder}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource csh.cart.quickProducts}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="10,0"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                                       Fill="{DynamicResource BrushCatalogTileBorder}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding QuickProducts}" MaxWidth="440">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pos:CatalogProductTileVm">
                                    <!-- Рамку и фон задаём прямо здесь, а не классом: у класса
                                         main-ghost фона нет вовсе, и плитки читались как простой
                                         текст посреди пустой панели, без намёка на то, что по ним
                                         можно нажать. Вид взят у карточки каталога — один и тот же
                                         товар должен выглядеть одинаково с обеих сторон экрана. -->
                                    <!-- 2026-09-30: быстрый товар без фокуса — иначе Enter сканера добавлял его ещё раз. -->
                                    <Button Width="134" Height="66"
                                            Focusable="False"
                                            Margin="4"
                                            Padding="10,6"
                                            Cursor="Hand"
                                            Background="{DynamicResource BrushCatalogTileBg}"
                                            BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource SettingsButtonRadius}"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding $parent[UserControl].((vm:BasketPanelViewModel)DataContext).AddQuickProductCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource BrushText}"/>
                                            <TextBlock Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushCatalogPrice}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="{Binding HasLines}">
                    <ListBox Classes="cart-list"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             ItemsSource="{Binding Lines}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CartLineItemVm">
                                <!-- 2026-10-04, редизайн: отступы строки — в стиле Border.cart-line (обычный и
                                     компактный вид). Сетка строки: [название | сумма | кнопки]. В компактном виде
                                     кнопки (Grid.line-controls) уходят вторым рядом на всю ширину, слева от них —
                                     «цена × количество» (line-priceqty-compact), название получает всю ширину. -->
                                <Border Classes="cart-line"
                                        Background="{DynamicResource BrushCatalogTileBg}"
                                        BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        HorizontalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto,Auto"
                                          MinWidth="0">
                                        <!-- 2026-10-03, владелец: «при скидке, если в убыток продаёт, — рядом с товаром показывать, сколько убытка». -->
                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Right" Margin="0,0,0,3">
                                            <Border IsVisible="{Binding HasLoss}" Background="#7F1D1D" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" ToolTip.Tip="{Binding LossTooltip}"><TextBlock Text="{Binding LossDisplayText}" Foreground="White" FontSize="12" FontWeight="Bold"/></Border>
                                            <Border IsVisible="{Binding HasDiscount}"
                                                    Background="#D32F2F"
                                                    CornerRadius="6"
                                                    Padding="9,4">
                                                <TextBlock Text="{Binding DiscountDisplayText}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    MinWidth="0"
                                                    Spacing="2"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NumberedTitle}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource BrushText}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Title}"/>
                                            <TextBlock Classes="line-priceqty-wide"
                                                       Text="{Binding PriceQuantityLine}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource BrushTextSoft}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Classes="line-amount"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding LineTotalAmount}"
                                                       Classes="num"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushMoney}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Кнопки строки и (в компактном виде) «цена × количество» слева от них.
                                             Корзина — последней кнопкой этого ряда (раньше отдельной колонкой). -->
                                        <Grid Classes="line-controls"
                                              ColumnDefinitions="*,Auto"
                                              VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0"
                                                       Classes="line-priceqty-compact"
                                                       Text="{Binding PriceQuantityLine}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource BrushTextSoft}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <!-- 2026-10-03: строка ↔ оптовая цена (видно, если у товара есть оптовая цена). -->
                                                <Button Classes="cart-qty"
                                                        Focusable="False"
                                                        IsVisible="{Binding CanWholesale}"
                                                        Width="NaN" MinWidth="44" Padding="10,0"
                                                        ToolTip.Tip="{DynamicResource csh.cart.wholesaleTooltip}"
                                                        Command="{Binding WholesaleCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding WholesaleButtonText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Button>
                                                <!-- 2026-10-06 (О-03, магазин одежды): «Размер» — сменить размер/цвет строки. Видна у строк с вариантом. -->
                                                <Button Classes="cart-qty"
                                                        Focusable="False"
                                                        IsVisible="{Binding CanChangeVariant}"
                                                        Width="NaN" MinWidth="44" Padding="10,0"
                                                        ToolTip.Tip="{Binding ChangeVariantTooltip}"
                                                        Command="{Binding ChangeVariantCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding ChangeVariantText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Classes="cart-qty"
                                                        Focusable="False"
                                                        ToolTip.Tip="{DynamicResource csh.cart.discountTooltip}"
                                                        Command="{Binding DiscountCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconPercent}"/>
                                                </Button>
                                                <Button Classes="cart-qty"
                                                        Focusable="False"
                                                        IsVisible="{Binding IsWeight}"
                                                        ToolTip.Tip="{DynamicResource csh.cart.weighTooltip}"
                                                        Command="{Binding WeighCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconScale}"/>
                                                </Button>
                                                <RepeatButton Classes="cart-qty"
                                                              Focusable="False"
                                                              ToolTip.Tip="{DynamicResource csh.cart.decreaseTooltip}"
                                                              Command="{Binding DecreaseCommand}"
                                                              CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconMinus}"/>
                                                </RepeatButton>
                                                <TextBox Text="{Binding QuantityInput, Mode=TwoWay}" MaxLength="5"
                                                         MinWidth="52" Height="44"
                                                         Background="{DynamicResource BrushInputAlt}"
                                                         BorderBrush="{DynamicResource BrushBorder}"
                                                         BorderThickness="1"
                                                         CornerRadius="6"
                                                         Padding="6,0"
                                                         MinHeight="0"
                                                         FontSize="15"
                                                         FontWeight="Bold"
                                                         Foreground="{DynamicResource BrushText}"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip.Tip="{DynamicResource csh.cart.typeQuantityTooltip}"
                                                         LostFocus="QuantityInput_LostFocus">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding SetQuantityCommand}" CommandParameter="{Binding}"/>
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <RepeatButton Classes="cart-qty"
                                                              Focusable="False"
                                                              IsEnabled="{Binding CanIncrease}"
                                                              ToolTip.Tip="{DynamicResource csh.cart.increaseTooltip}"
                                                              Command="{Binding IncreaseCommand}"
                                                              CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconPlus}"/>
                                                </RepeatButton>
                                                <Button Classes="cart-delete"
                                                        Focusable="False"
                                                        Margin="2,0,0,0"
                                                        ToolTip.Tip="{DynamicResource csh.cart.removeTooltip}"
                                                        Command="{Binding RemoveCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Width="16"
                                                              Height="16"
                                                              Foreground="{DynamicResource BrushDanger}"
                                                              Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- Нижняя панель действий и итога -->
            <Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  HorizontalAlignment="Stretch">

                <!-- Ввод штрихкода + количество -->
                <!-- 2026-10-04: поле, −/+ и «Добавить» — высотой 44 (палец); отступ — в стиле Grid.cart-entry-row. -->
                <Grid Grid.Row="0"
                      Classes="cart-entry-row"
                      ColumnDefinitions="*,8,Auto,8,Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch">
                    <Border Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource BrushInput}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,0">
                        <DockPanel>
                        <!-- 2026-10-04, Android: камера аппарата как сканер (CameraScan) — код уходит в чек как скан. -->
                        <Button DockPanel.Dock="Right"
                                IsVisible="{OnPlatform False, Android=True}"
                                Click="CameraScanButton_Click"
                                Focusable="False"
                                Width="44" Height="44" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="{DynamicResource csh.cart.cameraScan}">
                            <TextBlock Classes="mdl2" Text="&#xE722;" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <TextBox Text="{Binding BarcodeInput}"
                                 Watermark="{DynamicResource csh.cart.barcodeWatermark}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource BrushText}"
                                 MinHeight="44"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddByBarcodeCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource BrushInputAlt}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="2,0">
                        <Grid ColumnDefinitions="44,40,44" VerticalAlignment="Center">
                            <RepeatButton Grid.Column="0"
                                          Width="44"
                                          Height="44"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource BrushText}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Cursor="Hand"
                                          Command="{Binding DecreaseManualQuantityCommand}">
                                <PathIcon Data="{StaticResource IconMinus}" Width="15" Height="15"/>
                            </RepeatButton>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ManualQuantity}" MaxLength="5"
                                     MinHeight="44"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource BrushText}"
                                     TextAlignment="Center"
                                     FontWeight="Bold"
                                     VerticalAlignment="Center"/>
                            <RepeatButton Grid.Column="2"
                                          Width="44"
                                          Height="44"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource BrushText}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Cursor="Hand"
                                          Command="{Binding IncreaseManualQuantityCommand}">
                                <PathIcon Data="{StaticResource IconPlus}" Width="15" Height="15"/>
                            </RepeatButton>
                        </Grid>
                    </Border>

                    <Button Grid.Column="4"
                            Classes="cart-accent"
                            MinWidth="120"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="44"
                            Padding="10,8"
                            FontSize="13"
                            Content="{DynamicResource csh.cart.add}"
                            Command="{Binding AddByBarcodeCommand}"/>
                </Grid>

                <!-- Панель основных быстрых кнопок -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,8,*,8,*,8,*"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,6">
                    <!-- 2026-09-29: «Отложить чек» и «Удалить чек» тоже открывают/убирают чек — без
                         фокуса, иначе Enter сканера нажал бы их ещё раз (см. Button.receipt-tab). -->
                    <Button Grid.Column="0"
                            Classes="cart-action"
                            Focusable="False"
                            Command="{Binding DeferCartCommand}"
                            IsEnabled="{Binding HasItems}"
                            ToolTip.Tip="{DynamicResource csh.cart.deferTooltip}">
                        <Grid ColumnDefinitions="Auto,*"
                              MinWidth="0"
                              HorizontalAlignment="Stretch">
                            <PathIcon Grid.Column="0"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource csh.cart.defer}"
                                       Classes="cart-action-text"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2"
                            Classes="cart-action"
                            Focusable="False"
                            Command="{Binding DeleteReceiptCommand}"
                            ToolTip.Tip="{DynamicResource csh.cart.deleteReceiptTooltip}">
                        <Grid ColumnDefinitions="Auto,*"
                              MinWidth="0"
                              HorizontalAlignment="Stretch">
                            <PathIcon Grid.Column="0"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource csh.cart.deleteReceipt}"
                                       Classes="cart-action-text"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <!-- «Доп. услуга» (2026-09-07) — в основном ряду, а не в «Ещё»: доставка/услуга
                         добавляются в чек так же часто, как отложить чек. -->
                    <Button Grid.Column="4"
                            Classes="cart-action"
                            Command="{Binding AddCustomItemCommand}"
                            ToolTip.Tip="{DynamicResource customService.title}">
                        <Grid ColumnDefinitions="Auto,*"
                              MinWidth="0"
                              HorizontalAlignment="Stretch">
                            <PathIcon Grid.Column="0"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Data="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource csh.cart.customService}"
                                       Classes="cart-action-text"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="6"
                            Classes="cart-action"
                            Command="{Binding ToggleMoreActionsCommand}"
                            ToolTip.Tip="{DynamicResource csh.cart.moreTooltip}">
                        <Grid ColumnDefinitions="Auto,*"
                              MinWidth="0"
                              HorizontalAlignment="Stretch">
                            <PathIcon Grid.Column="0"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource csh.cart.more}"
                                       Classes="cart-action-text"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Расширенные действия -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,8,*,8,*,8,*"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,6"
                      IsVisible="{Binding IsMoreActionsVisible}">
                    <Button Grid.Column="0"
                            Classes="cart-action"
                            Content="{DynamicResource csh.cart.restore}"
                            Command="{Binding RestoreLastHeldReceiptCommand}"
                            IsEnabled="{Binding HasHeldReceipts}"/>
                    <Button Grid.Column="2"
                            Classes="cart-action"
                            Content="{DynamicResource csh.cart.deferredList}"
                            Command="{Binding OpenDeferredCartsCommand}"/>
                    <Button Grid.Column="4"
                            Classes="cart-action"
                            Content="{DynamicResource csh.cart.orderDiscount}"
                            Command="{Binding ApplyOrderDiscountCommand}"
                            IsEnabled="{Binding HasItems}"/>
                    <!-- 2026-10-03, клиент: «опт не только на весь чек, но и на сам товар». -->
                    <Button Grid.Column="6"
                            Classes="cart-action"
                            Content="{DynamicResource csh.cart.wholesaleAll}"
                            Command="{Binding WholesaleAllCommand}"
                            IsEnabled="{Binding HasItems}"/>
                </Grid>

                <Grid Grid.Row="3"
                      ColumnDefinitions="*,8,*,8,*,Auto"
                      Margin="0,0,0,6"
                      IsVisible="{Binding IsMoreActionsVisible}">
                    <Button Grid.Column="0"
                            Classes="cart-action"
                            HorizontalAlignment="Stretch"
                            Content="{DynamicResource csh.cart.payDebt}"
                            Command="{Binding OpenPayDebtCommand}"/>
                    <!-- Копия последнего чека (2026-09-27): покупатель просит чек ещё раз, а кассе
                         не нужно искать его в «Истории чеков». Текст переносится на две строки —
                         по-кыргызски он длинный. -->
                    <Button Grid.Column="2"
                            Classes="cart-action"
                            Padding="8,2"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="{DynamicResource csh.cart.printLastReceiptTooltip}"
                            Click="PrintLastReceipt_Click">
                        <TextBlock Text="{DynamicResource csh.cart.printLastReceipt}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <!-- Списание испорченного товара прямо из кассы (2026-09-27, просьба владельца). -->
                    <Button Grid.Column="4"
                            Classes="cart-action"
                            Padding="8,2"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="{DynamicResource csh.cart.writeOffTooltip}"
                            Click="WriteOff_Click">
                        <TextBlock Text="{DynamicResource csh.cart.writeOff}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <!-- 2026-10-02: прокат (одежда и услуги). -->
                    <Button Grid.Column="5"
                            Classes="cart-action"
                            Padding="12,2"
                            Margin="8,0,0,0"
                            MinWidth="96"
                            IsVisible="{Binding ShowRental}"
                            Content="{DynamicResource csh.menu.rental}"
                            Click="Rental_Click"/>
                </Grid>

                <!-- Сообщения корзины -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="{Binding CartMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushUiStatusOk}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasCartMessage}"/>
                    <!-- 2026-10-01: подсказка допродажи «С этим часто берут». -->
                    <ctl:UpsellBannerView/>
                </StackPanel>

                <!-- Итоговая сумма -->
                <!-- Редизайн 2026-09-28: подпись «Итого» слева, сумма с валютой вплотную справа —
                     как итог на бумажном чеке; сумма крупнее всего остального на экране. -->
                <!-- 2026-10-04: отступы и размер итога — в стилях Grid.cart-total-row / TextBlock.cart-total
                     (в компактном виде итог 32 вместо 40, чтобы чеку осталось больше строк). -->
                <Grid Grid.Row="5"
                      Classes="cart-total-row"
                      ColumnDefinitions="*,Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <!-- Подпись именно «Итого»: TotalAmount — это ИТОГОВАЯ сумма к оплате
                             (BasketPanelViewModel.Total), а ключ csh.cart.subtotal означает
                             «Промежуточный итог» — подпись противоречила числу под ней.
                             В 1С-раскладке та же цифра всегда была подписана верно. -->
                        <TextBlock Text="{DynamicResource onecLayout.totalLabel}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <!-- 40px вместо 30: цена товара на плитке каталога — 22px и повторяется
                             на экране десятки раз, из-за чего итог чека почти не выделялся. -->
                        <TextBlock Text="{Binding TotalAmount}"
                                   Classes="num cart-total"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushMoney}"/>
                        <TextBlock Text="{DynamicResource csh.catalog.currency}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSoft}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопка оплаты -->
                <Button Grid.Row="6"
                        Classes="cart-accent"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="18"
                        Command="{Binding PayCommand}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">
                        <PathIcon Width="20"
                                  Height="20"
                                  Foreground="{DynamicResource BrushAccentForeground}"
                                  Data="M20,8H4V6H20M20,18H4V12H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"/>
                        <TextBlock Text="{Binding PayButtonText}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushAccentForeground}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
