<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.SplashWindow"
        Title="NurCRM"
        Width="440"
        Height="270"
        CanResize="False"
        ShowInTaskbar="True"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SplashBackgroundBrush}">

    <!-- Local theme dictionaries keep the splash readable in both app themes. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#151922" />
                    <SolidColorBrush x:Key="SplashBorderBrush" Color="#2B3240" />
                    <SolidColorBrush x:Key="SplashTitleBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SplashSubtitleBrush" Color="#B8C0CC" />
                    <SolidColorBrush x:Key="SplashProgressBarForeground" Color="#FFB208" /> <!-- 2026-10-23 (аудит Б-9): брендовый жёлтый, был синий -->
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#F4F7FB" />
                    <SolidColorBrush x:Key="SplashBorderBrush" Color="#D7DEE8" />
                    <SolidColorBrush x:Key="SplashTitleBrush" Color="#172033" />
                    <SolidColorBrush x:Key="SplashSubtitleBrush" Color="#526176" />
                    <SolidColorBrush x:Key="SplashProgressBarForeground" Color="#FFB208" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Credential-free startup surface: intentionally no input controls. -->
    <Border Padding="40"
            Background="{DynamicResource SplashBackgroundBrush}"
            BorderBrush="{DynamicResource SplashBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <StackPanel Spacing="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <!-- 2026-10-23 (аудит Б-9): логотип на заставке -->
            <Image Source="avares://NurMarketKassa.Avalonia/Assets/app-logo.png"
                   Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center" />

            <TextBlock Text="NurCRM"
                       HorizontalAlignment="Center"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SplashTitleBrush}" />

            <TextBlock Text="{DynamicResource splash.checkingSession}"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource SplashSubtitleBrush}" />

            <ProgressBar Height="5"
                         Margin="4,4,4,0"
                         HorizontalAlignment="Stretch"
                         IsIndeterminate="True"
                         Foreground="{DynamicResource SplashProgressBarForeground}" />

            <!-- 2026-11-05 (С-03, аудит «зависание при медленном сервере»): если запуск тянется долго, появляется подсказка и «Выйти» — окно без выхода больше не заперто. -->
            <StackPanel x:Name="SlowPanel" IsVisible="False" Spacing="10" HorizontalAlignment="Center">
                <TextBlock x:Name="SlowText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource SplashSubtitleBrush}" />
                <Button x:Name="ExitButton"
                        HorizontalAlignment="Center"
                        Padding="22,8"
                        Click="ExitButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
