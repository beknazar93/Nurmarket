<layouts:KassaLayoutBase xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:layouts="using:NurMarketKassa.AvaloniaHost.Views.MainKassir.Layouts"
                         xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
                         xmlns:vm="using:NurMarketKassa.ViewModels.Main"
                         xmlns:pos="using:NurMarketKassa.Models.Pos"
                         x:Class="NurMarketKassa.AvaloniaHost.Views.MainKassir.Layouts.CardsLayoutView"
                         x:DataType="vm:MainWindowViewModel"
                         x:CompileBindings="True"
                         Background="{DynamicResource BrushWindow}">

    <!-- Раскладка «Карточки» (2026-09-28). Образец — кыргызские и казахстанские облачные кассы
         (POS ESEP и похожие): спокойный светлый экран, категории кнопками-чипами сверху, товары
         карточками по центру, чек справа с кнопками +/− у каждой строки и большая зелёная кнопка
         «Оплатить». -->

    <layouts:KassaLayoutBase.Styles>
        <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/MainKassir/Layouts/LayoutStyles.axaml"/>

        <Style Selector="Border.cd-card">
            <Setter Property="Background" Value="{DynamicResource BrushCatalogTileBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCatalogTileBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #0D101828"/>
        </Style>
        <Style Selector="Border.cd-line">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button.receipt-pill">
            <!-- 2026-09-30: без фокуса — иначе Enter, которым сканер заканчивает код, нажимал кнопку ещё раз (товар/чек добавлялся сам) -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.receipt-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="Button.receipt-pill.active">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
        </Style>
        <Style Selector="Button.receipt-pill.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.receipt-pill.active:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
        </Style>
    </layouts:KassaLayoutBase.Styles>

    <Grid Margin="16,12,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="460"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="0.62*" MinWidth="360" MaxWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= каталог карточками ======================= -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Classes="lx-field" CornerRadius="22" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource IconSearch}" Margin="4,0,10,0"/>
                    <TextBox x:Name="ProductSearchBox" Grid.Column="1" Text="{Binding Catalog.SearchText}"
                             Watermark="{DynamicResource lx.searchWatermark}" FontSize="15"/>
                </Grid>
            </Border>

            <!-- Чипы: тип товара и категории -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="lx-chip" Tag="0" Click="CatalogTab_Click" Content="{DynamicResource csh.catalog.tabAll}"
                            Classes.active="{Binding Catalog.SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=0}"/>
                    <Button Classes="lx-chip" Tag="1" Click="CatalogTab_Click" Content="{DynamicResource csh.catalog.tabWeighted}"
                            Classes.active="{Binding Catalog.SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=1}"/>
                    <Button Classes="lx-chip" Tag="2" Click="CatalogTab_Click" Content="{DynamicResource csh.catalog.tabPiece}"
                            Classes.active="{Binding Catalog.SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=2}"/>
                    <Button Classes="lx-chip" Tag="3" Click="CatalogTab_Click" Content="{DynamicResource csh.catalog.tabPieceOption}"
                            Classes.active="{Binding Catalog.SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=3}"/>
                    <Button Classes="lx-chip" Tag="4" Click="CatalogTab_Click" Content="{DynamicResource csh.catalog.tabBundle}"
                            Classes.active="{Binding Catalog.SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=4}"/>
                    <Button Classes="lx-chip" Tag="5" Click="CatalogTab_Click" Content="{DynamicResource csh.catalog.tabServices}"
                            Classes.active="{Binding Catalog.SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=5}"/>
                    <Border x:Name="CategoryDivider" Width="1" Height="24" Margin="4,0" VerticalAlignment="Center"
                            Background="{DynamicResource BrushBorder}"/>
                    <!-- Категории товаров — строятся из каталога (см. code-behind). -->
                    <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="8"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Карточки товаров -->
            <Panel Grid.Row="2">
                <StackPanel IsVisible="{Binding Catalog.IsCatalogEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <PathIcon Data="{StaticResource IconPackage}" Width="44" Height="44" HorizontalAlignment="Center"
                              Foreground="{DynamicResource BrushTextSoft}" Opacity="0.6"/>
                    <TextBlock Text="{Binding Catalog.StatusText}" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>
                <ScrollViewer Classes="lx-scroll" IsVisible="{Binding Catalog.HasProducts}">
                    <ListBox x:Name="CardsList" Classes="lx-tiles"
                             ItemsSource="{Binding Catalog.Products}"
                             SelectedItem="{Binding Catalog.SelectedProduct}" SelectionMode="Single">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="pos:CatalogProductTileVm">
                                <Button Classes="lx-tile" Width="172" Height="224" Margin="0,0,12,12"
                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Catalog.SelectProductCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="cd-card lx-tile-face">
                                        <Grid RowDefinitions="92,Auto,*,Auto">
                                            <!-- Фото, а без фото — буквы названия на светлой подложке -->
                                            <Border Grid.Row="0" CornerRadius="{DynamicResource SettingsButtonRadius}" ClipToBounds="True"
                                                    Background="{DynamicResource BrushSurfaceSubtle}">
                                                <Panel>
                                                    <!-- Без фото — кружок цвета товара с первыми буквами названия. -->
                                                    <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="{Binding Title, Converter={x:Static conv:TileColorConverter.Instance}}">
                                                        <TextBlock Text="{Binding Title, Converter={x:Static conv:MonogramConverter.Instance}}"
                                                                   FontSize="20" FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image Stretch="UniformToFill"
                                                           IsVisible="{Binding ProductImagePath, Converter={x:Static conv:ShowProductPhotoConverter.Instance}}"
                                                           Source="{Binding ProductImagePath, Converter={x:Static conv:AssetPathToBitmapConverter.Instance}, ConverterParameter=thumb}"/>
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource BrushText}"/>
                                            <TextBlock Grid.Row="2" Text="{Binding StockInfo}" FontSize="11" Margin="0,4,0,0"
                                                       IsVisible="{Binding !IsService}" Foreground="{DynamicResource BrushCatalogStock}"/>
                                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Classes="lx-price" FontSize="18"
                                                               Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}}"/>
                                                    <TextBlock Text="{DynamicResource csh.catalog.currency}" FontSize="11" VerticalAlignment="Bottom"
                                                               Margin="0,0,0,3" Foreground="{DynamicResource BrushCatalogMeta}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15"
                                                        Background="{DynamicResource BrushSuccess}">
                                                    <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"
                                                              Foreground="{DynamicResource BrushWindow}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Panel>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Button Classes="lx-btn" MinHeight="36" Command="{Binding Catalog.PreviousPageCommand}">
                    <PathIcon Data="{StaticResource IconChevronLeft}" Width="16" Height="16"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Catalog.PageStatusText}" Classes="lx-muted"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="lx-btn" MinHeight="36" Command="{Binding Catalog.NextPageCommand}">
                    <PathIcon Data="{StaticResource IconChevronRight}" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Grid>

        <!-- ======================= чек ======================= -->
        <Border Grid.Column="2" Classes="lx-card" Padding="16" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
                <!-- Заголовок чека и вкладки открытых чеков одной строкой -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                        <PathIcon Data="{StaticResource IconCart}" Width="20" Height="20" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Classes="lx-title" FontSize="18" Text="{DynamicResource lx.receipt}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushPanelSoft}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                IsVisible="{Binding Basket.HasItems}">
                            <TextBlock Text="{Binding Basket.LineCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Basket.ReceiptTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReceiptTabVm">
                                    <Button Classes="receipt-pill" Classes.active="{Binding IsActive}"
                                            Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Title}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Column="2" Classes="lx-ghost" Width="36" Padding="0" Margin="6,0,0,0"
                            Command="{Binding Basket.NewReceiptCommand}" ToolTip.Tip="{DynamicResource onecLayout.newReceiptButton}">
                        <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2" Classes="lx-field" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Data="{StaticResource IconBarcode}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Basket.BarcodeInput}" Watermark="{DynamicResource lx.scanWatermark}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding Basket.AddByBarcodeCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Строки чека -->
                <Panel Grid.Row="3">
                    <StackPanel IsVisible="{Binding Basket.IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="16">
                        <PathIcon Data="{StaticResource IconCart}" Width="40" Height="40" HorizontalAlignment="Center"
                                  Foreground="{DynamicResource BrushTextSoft}" Opacity="0.6"/>
                        <TextBlock Text="{DynamicResource lx.emptySale}" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="{DynamicResource lx.emptySaleHint}" FontSize="12" TextWrapping="Wrap" MaxWidth="280"
                                   TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>
                    <ScrollViewer Classes="lx-scroll" IsVisible="{Binding Basket.HasItems}">
                        <ItemsControl ItemsSource="{Binding Basket.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CartLineItemVm">
                                    <Border Classes="cd-line">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushText}"/>
                                                <TextBlock Text="{Binding PriceQuantityLine}" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="lx-money" FontSize="16" FontWeight="Bold" VerticalAlignment="Top"
                                                       Text="{Binding LineTotal, Converter={x:Static conv:MoneyConverter.Instance}}"/>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Button Classes="lx-step" Command="{Binding DecreaseCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource csh.cart.decreaseTooltip}">
                                                        <PathIcon Data="{StaticResource IconMinus}"/>
                                                    </Button>
                                                    <!-- 2026-09-28: количество вводится с клавиатуры, как в «Классике» (раньше здесь был
                                                         только текст — точное количество в этом виде кассы ввести было нельзя). -->
                                                    <TextBox Text="{Binding QuantityInput, Mode=TwoWay}" MinWidth="44" Height="30" MinHeight="0"
                                                             Padding="4,0" FontSize="15" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Background="{DynamicResource BrushInputAlt}" BorderBrush="{DynamicResource BrushBorder}"
                                                             BorderThickness="1" CornerRadius="6" Foreground="{DynamicResource BrushText}"
                                                             ToolTip.Tip="{DynamicResource csh.cart.typeQuantityTooltip}" LostFocus="QuantityInput_LostFocus">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding SetQuantityCommand}" CommandParameter="{Binding}"/>
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <Button Classes="lx-step" IsEnabled="{Binding CanIncrease}"
                                                            Command="{Binding IncreaseCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource csh.cart.increaseTooltip}">
                                                        <PathIcon Data="{StaticResource IconPlus}"/>
                                                    </Button>
                                                    <Border Classes="lx-badge-danger" IsVisible="{Binding HasDiscount}" VerticalAlignment="Center" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding DiscountDisplayText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="lx-ghost" Width="32" Height="32" MinHeight="0" Padding="0" IsVisible="{Binding IsWeight}"
                                                            Command="{Binding WeighCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource csh.cart.weighTooltip}">
                                                        <PathIcon Data="{StaticResource IconScale}" Width="15" Height="15"/>
                                                    </Button>
                                                    <Button Classes="lx-ghost" Width="32" Height="32" MinHeight="0" Padding="0"
                                                            Command="{Binding DiscountCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource csh.cart.discountTooltip}">
                                                        <PathIcon Data="{StaticResource IconPercent}" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Classes="lx-ghost" Width="32" Height="32" MinHeight="0" Padding="0"
                                                            Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource csh.cart.removeTooltip}">
                                                        <PathIcon Data="{StaticResource IconTrash}" Width="15" Height="15" Foreground="{DynamicResource BrushDanger}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>

                <TextBlock Grid.Row="4" Text="{Binding Basket.CartMessage}" IsVisible="{Binding Basket.HasCartMessage}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource BrushUiStatusOk}"/>

                <!-- Итоги -->
                <StackPanel Grid.Row="5" Spacing="6" Margin="0,12,0,12">
                    <Border Classes="lx-divider" Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource csh.cart.subtotal}" Classes="lx-muted" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding Basket.SubtotalDisplay}" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource onecLayout.discountLabel}" Classes="lx-muted" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding Basket.DiscountDisplay}" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource onecLayout.totalLabel}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushText}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="num" Text="{Binding Basket.Total, Converter={x:Static conv:MoneyConverter.Instance}}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushMoney}"/>
                            <TextBlock Text="{DynamicResource csh.catalog.currency}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                       Margin="0,0,0,5" Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Второстепенные действия -->
                <UniformGrid Grid.Row="6" Columns="4" Margin="0,0,0,10">
                    <Button Classes="lx-btn" Margin="0,0,4,0" Padding="4,0" Command="{Binding Basket.DeferCartCommand}"
                            ToolTip.Tip="{DynamicResource csh.cart.deferTooltip}">
                        <StackPanel Spacing="2">
                            <PathIcon Data="{StaticResource IconPauseCircle}" Width="16" Height="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource onecLayout.holdButton}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="lx-btn" Margin="2,0" Padding="4,0" Command="{Binding Basket.ApplyOrderDiscountCommand}">
                        <StackPanel Spacing="2">
                            <PathIcon Data="{StaticResource IconTag}" Width="16" Height="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource onecLayout.discountButton}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="lx-btn" Margin="2,0" Padding="4,0" Command="{Binding Basket.AddCustomItemCommand}">
                        <StackPanel Spacing="2">
                            <PathIcon Data="{StaticResource IconPlusCircle}" Width="16" Height="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource csh.cart.customService}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="lx-btn" Margin="4,0,0,0" Padding="4,0">
                        <StackPanel Spacing="2">
                            <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource csh.cart.more}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuItem Header="{DynamicResource csh.cart.restore}" Command="{Binding Basket.RestoreLastHeldReceiptCommand}"/>
                                <MenuItem Header="{DynamicResource csh.cart.deferredList}" Command="{Binding Basket.OpenDeferredCartsCommand}"/>
                                <MenuItem Header="{DynamicResource csh.cart.payDebt}" Command="{Binding Basket.OpenPayDebtCommand}"/>
                                <MenuItem Header="{DynamicResource csh.cart.printLastReceipt}" Click="PrintLastReceipt_Click"/>
                                <MenuItem Header="{DynamicResource csh.cart.writeOff}" Click="WriteOff_Click"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource csh.cart.deleteReceipt}" Command="{Binding Basket.DeleteReceiptCommand}"/>
                                <MenuItem Header="{DynamicResource onecLayout.clearButton}" Command="{Binding Basket.ClearCartCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </UniformGrid>

                <Button Grid.Row="7" Classes="lx-success" MinHeight="60" HorizontalAlignment="Stretch" Command="{Binding Basket.PayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Basket.PayButtonText}" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="·" FontSize="18" VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Classes="num" Text="{Binding Basket.Total, Converter={x:Static conv:MoneyConverter.Instance}}" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource csh.catalog.currency}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</layouts:KassaLayoutBase>
