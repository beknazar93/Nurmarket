<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NurMarketKassa.AvaloniaHost.Views.Main.Controls"
        xmlns:views="using:NurMarketKassa.AvaloniaHost.Views.Main.Controls"
        xmlns:mainKassir="using:NurMarketKassa.AvaloniaHost.Views.MainKassir"
        xmlns:vm="using:NurMarketKassa.ViewModels.Main"
        xmlns:pos="using:NurMarketKassa.Models.Pos"
        x:Class="NurMarketKassa.AvaloniaHost.Views.MainKassir.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="{DynamicResource mainWindow.windowTitle}"
        Width="1280"
        Height="840"
        MinWidth="850"
        MinHeight="520"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnMainWindowKeyDown"
        Foreground="{DynamicResource BrushText}"
        FontFamily="Segoe UI">

    <!-- Фон окна берётся ИЗ ТЕМЫ КАССЫ, а не из системного цвета Windows. С
         SystemRegionColor верхняя полоса окна была чёрной (#000000 — измерено на скриншоте
         2026-09-22) и не имела отношения ни к светлой, ни к синей теме: получалась чужая
         чёрная шапка над тёмно-синим экраном. -->
    <Window.Background>
        <DynamicResourceExtension ResourceKey="BrushWindow"/>
    </Window.Background>

    <Window.Resources>
        <!--
          Catalog minimum:
          2 × (180px tile + 2 × 6px margin) + 32px outer padding
          + 32px catalog padding + border/scrollbar allowance ≈ 470px.
        -->
        <x:Double x:Key="CatalogMinimumWidth">470</x:Double>
        <x:Double x:Key="CartMinimumWidth">490</x:Double>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Shared/MainViewStyles.axaml"/>

        <Style Selector="GridSplitter#CatalogGridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border x:Name="GripLine"
                                Width="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                CornerRadius="2"
                                Background="{DynamicResource BrushBorderStrong}">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="10">
                            </StackPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter#CatalogGridSplitter:pointerover /template/ Border#GripLine">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
        </Style>

        <!-- 2026-10-04, телефон: переключатель «Товары / Чек» (см. PhoneModeBar). -->
        <Style Selector="ToggleButton.phone-tab">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.phone-tab:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>
        <Style Selector="ToggleButton.phone-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="ToggleButton.phone-tab:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
        </Style>

        <!-- 1. Полностью отключаем системную рамку FocusAdorner -->
        <Style Selector="TextBox">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>

        <!-- 2. Делаем внутреннюю границу PART_BorderElement полностью прозрачной при фокусе -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 3. Также убираем подсвечивание границы при наведении (pointerover) -->
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- 4. Убираем фоновый фокус у фонового контейнера (если используется FluentControlResources) -->
        <Style Selector="TextBox:focus /template/ Border#PART_BackgroundControlThickness">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- ============ Шапка: обычный и компактный вид (2026-10-04) ============
             Владелец: «сделай редизайн, учитывай маленькие экраны и моноблоки сенсорные, где не
             умещается всё». Размеры кнопок шапки заданы стилями, а не прямо на кнопках: значение,
             заданное на самом элементе, стиль переопределить не может, а компактному виду (класс
             окна "compact", см. MainWindow.RefreshUiScale) нужно их менять. Цели нажатия — не меньше
             44 точек: по ним попадают пальцем. -->
        <Style Selector="Border.kassa-header">
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style Selector="Button.header-tool">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.header-menu">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- «⋯ Ещё» шапки есть только в компактном виде: в нём прячутся «Экран», «Тема» и
             «Горячие» (кнопка экранной клавиатуры остаётся — без неё на сенсорном моноблоке не
             набрать текст). -->
        <Style Selector="Button.header-more">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.shift-action">
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style Selector="TextBlock.header-title">
            <Setter Property="MaxWidth" Value="360"/>
        </Style>
        <Style Selector="TextBlock.header-network">
            <Setter Property="MaxWidth" Value="280"/>
        </Style>
        <Style Selector="MenuItem.header-menu-item">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style Selector=".compact Border.kassa-header">
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector=".compact Button.header-tool">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style Selector=".compact TextBlock.header-tool-label">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".compact Button.header-secondary">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".compact Button.header-more">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- Две кнопки смены, из которых одна всегда недоступна (смена или открыта, или нет), —
             в компактном виде видна только та, которую можно нажать. -->
        <Style Selector=".compact Button.shift-action:disabled">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".compact Button.shift-action">
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector=".compact TextBlock.header-title">
            <Setter Property="MaxWidth" Value="200"/>
        </Style>
        <Style Selector=".compact TextBlock.header-network">
            <Setter Property="MaxWidth" Value="170"/>
        </Style>
        <Style Selector=".compact StackPanel.header-status">
            <Setter Property="Spacing" Value="10"/>
        </Style>
        <!-- 2026-10-04, Android, вертикальный телефон (класс окна "portrait", см. ApplyPortraitLayout):
             шапка в ширину телефона — название короче, у «Открыть/Закрыть смену» только замок. -->
        <Style Selector=".portrait TextBlock.header-title">
            <Setter Property="MaxWidth" Value="130"/>
        </Style>
        <Style Selector=".portrait Button.shift-action TextBlock">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".portrait Button.shift-action">
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <!-- «Касса: N сом» в ширину телефона не помещается (оставалась буква «К») — она есть в окне смены. -->
        <Style Selector=".portrait TextBlock.header-network">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".portrait TextBlock.header-balance">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Фоновые обои экрана кассира (Настройки → Кастомизация → "Применить эти обои к
             экрану кассира") — растянуты на оба ряда, объявлены первыми, поэтому по Z-порядку
             документа рисуются позади всего остального. Скрыты по умолчанию (см.
             MainWindow.RefreshBackgroundWallpaper), не мешают кликам (IsHitTestVisible=False). -->
        <Image x:Name="BackgroundWallpaperImage" Grid.Row="0" Grid.RowSpan="2"
               Stretch="UniformToFill" IsVisible="False" IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="0"/>
            </Image.Effect>
        </Image>
        <Border x:Name="BackgroundTintOverlay" Grid.Row="0" Grid.RowSpan="2"
                IsVisible="False" IsHitTestVisible="False"/>

        <!-- Имитация "Жидкого стекла": мягкие цветные пятна с настоящим блюром позади
             интерфейса — включается сама, когда активна тема "glass" и не выбрано своё фото
             в Кастомизации (см. RefreshBackgroundWallpaper). Никакого живого снимка экрана —
             тот подход был отброшен раньше в этой сессии как хрупкий; здесь просто статичные
             фигуры с BlurEffect, то же самое, чем уже размывается BackgroundWallpaperImage. -->
        <Canvas x:Name="GlassAmbientLayer" Grid.Row="0" Grid.RowSpan="2"
                ClipToBounds="True" IsVisible="False" IsHitTestVisible="False">
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1B1030" Offset="0"/>
                    <GradientStop Color="#241A45" Offset="1"/>
                </LinearGradientBrush>
            </Canvas.Background>
            <Ellipse Canvas.Left="-140" Canvas.Top="-120" Width="520" Height="520" Fill="#8A3B82F6">
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Right="-160" Canvas.Top="-80" Width="460" Height="460" Fill="#8AA855F7">
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="200" Canvas.Bottom="-180" Width="560" Height="560" Fill="#80EC4899">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Right="80" Canvas.Bottom="-140" Width="420" Height="420" Fill="#7022D3EE">
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- Масштаб интерфейса (Настройки → Экран → "Масштаб", 50–200%) — LayoutTransformControl,
             а не голый RenderTransform, потому что он также пересчитывает координаты
             кликов/попаданий курсором под новым масштабом, а не только картинку (см.
             MainWindow.RefreshUiScale). Оборачивает шапку+контент+боковое меню, но НЕ фоновые
             слои выше (обои/имитацию стекла) — они должны заполнять окно как есть, а не
             растягиваться вместе с масштабом интерфейса. -->
        <LayoutTransformControl x:Name="UiScaleTransform" Grid.Row="0" Grid.RowSpan="2">
        <Grid RowDefinitions="Auto,*">

        <!-- ============================ Шапка ============================ -->
        <!-- Тон полотна кассы. Раньше здесь стояла СИСТЕМНАЯ кисть Fluent
             (SystemControlBackgroundAltHighBrush): в тёмном режиме Windows она даёт чистый
             чёрный, и шапка чернела независимо от выбранной темы — на скриншоте 2026-09-22
             это #000000 над тёмно-синим экраном. К теме кассы системная кисть отношения не
             имеет и на переключение цвета темы не реагирует вовсе. -->
        <!-- 2026-09-30: полоса орнамента под шапкой (тема «Кыргыз»; у остальных высота 0). -->
        <DockPanel Grid.Row="0">
        <Border DockPanel.Dock="Bottom" Height="{DynamicResource OrnamentBandHeight}"
                Background="{DynamicResource BrushOrnamentBand}" IsHitTestVisible="False"/>
        <!-- 2026-10-04: отступы и размеры шапки — в стилях Border.kassa-header / Button.header-*
             (обычный и компактный вид, см. Window.Styles выше). -->
        <Border Classes="kassa-header"
                Background="{DynamicResource BrushWindowAlt}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Меню, логотип, название кассы -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="main-ghost header-menu"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{DynamicResource mainWindow.menuTooltip}"
                            Command="{Binding Toolbar.ToggleSideMenuCommand}">
                        <PathIcon Data="{StaticResource IconMenu}" Width="20" Height="20"/>
                    </Button>
                    <Border Width="34" Height="34"
                            CornerRadius="17"
                            ClipToBounds="True">
                        <Image Source="avares://NurMarketKassa.Avalonia/Assets/app-logo.png"
                               Stretch="Uniform"/>
                    </Border>
                    <!-- 2026-10-04: длинное имя кассы/кассира не выталкивает кнопки шапки за край. -->
                    <TextBlock Classes="header-title"
                               Text="{Binding Toolbar.UserTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip.Tip="{Binding Toolbar.UserTitle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Статус: сеть + баланс кассы/смены -->
                <StackPanel Grid.Column="1"
                            Classes="header-status"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            Spacing="18">
                    <!-- 2026-09-29: подсказка — с какого времени сервер не отвечает и последняя ошибка -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip.Tip="{Binding Toolbar.Status.StatusToolTip}">
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource BrushUiStatusOk}"
                                 IsVisible="{Binding Toolbar.Status.IsOnline}"/>
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource BrushUiStatusWarn}"
                                 IsVisible="{Binding !Toolbar.Status.IsOnline}"/>
                        <TextBlock Text="{Binding Toolbar.Status.StatusLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>

                    <TextBlock Classes="header-network"
                               Text="{Binding Toolbar.Status.NetworkModeText}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSoft}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <!-- Очередь чеков, не отправленных на сервер (см. OfflinePendingSalesStore) -->
                    <Border Background="{DynamicResource BrushUiStatusWarn}"
                            CornerRadius="10"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Toolbar.Status.HasQueuedItems}">
                        <TextBlock Text="{Binding Toolbar.Status.QueueText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <!-- Срок подписки: "N дн. осталось" → в последние 3 часа тикающий ЧЧ:ММ:СС -->
                    <Border Background="{DynamicResource BrushDanger}"
                            CornerRadius="10"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Toolbar.Status.HasSubscriptionCountdown}">
                        <TextBlock Text="{Binding Toolbar.Status.SubscriptionCountdownText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <!-- Баланс кассы, по умолчанию "Касса: 0.00 сом" -->
                    <TextBlock Classes="header-balance"
                               Text="{Binding Toolbar.Status.ShiftBalanceText}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushMoney}"
                               VerticalAlignment="Center"/>

                    <!-- Ненавязчивое уведомление о новой версии кассы -->
                    <Button Classes="main-ghost"
                            Padding="10,4"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{DynamicResource mainWindow.openDownloadTooltip}"
                            IsVisible="{Binding Toolbar.HasUpdateAvailable}"
                            Command="{Binding Toolbar.OpenUpdateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="mdl2" Text="&#xE895;" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushWarning}"/>
                            <TextBlock Text="{Binding Toolbar.UpdateNoticeText}" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushWarning}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Тема, клавиатура, смена -->
                <!-- 2026-10-04: кнопки с подписью — Button.header-tool (размер в стилях окна). В компактном
                     виде «Экран», «Тема» и «Горячие» (header-secondary) уходят в меню «⋯», подписи под
                     значками прячутся; клавиатура остаётся на месте. -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="main-ghost header-tool header-secondary"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{DynamicResource mainWindow.checkCustomerDisplayTooltip}"
                            Command="{Binding Toolbar.CheckCustomerDisplayCommand}">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <PathIcon Classes="header-icon" Data="{StaticResource IconMonitor}"/>
                            <TextBlock Classes="header-tool-label" Text="{DynamicResource header.labelCustomerDisplay}" FontSize="9"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="main-ghost header-tool header-secondary"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{Binding Toolbar.ThemeTooltip}"
                            Click="ToggleTheme_Click">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="mdl2" Text="{Binding Toolbar.ThemeGlyph}" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Classes="header-tool-label" Text="{DynamicResource header.labelTheme}" FontSize="9"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="main-ghost header-tool"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{DynamicResource mainWindow.onScreenKeyboardTooltip}"
                            Focusable="False"
                            Command="{Binding Toolbar.ToggleKeyboardCommand}">
                        <!-- 2026-09-30: Focusable=False — нажатие не уводит фокус из поля ввода, иначе
                             набор на экранной клавиатуре уходил в буфер сканера и пропадал. -->
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <PathIcon Classes="header-icon" Data="{StaticResource IconKeyboard}"/>
                            <TextBlock Classes="header-tool-label" Text="{DynamicResource header.labelKeyboard}" FontSize="9"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="main-ghost header-tool header-secondary"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{DynamicResource mainWindow.hotkeysTooltip}"
                            Click="OpenHotkeySettings_Click">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <PathIcon Classes="header-icon" Data="{StaticResource IconBolt}"/>
                            <TextBlock Classes="header-tool-label" Text="{DynamicResource header.labelHotkeys}" FontSize="9"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                    </Button>
                    <!-- 2026-10-04: «⋯ Ещё» — только в компактном виде (см. стиль Button.header-more). Без
                         фокуса, как кнопка клавиатуры: Enter сканера не должен открывать меню. Пункты меню —
                         те же действия, что у спрятанных кнопок, крупные (48 точек) для пальца. -->
                    <Button Classes="main-ghost header-tool header-more"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            ToolTip.Tip="{DynamicResource csh.cart.moreTooltip}">
                        <PathIcon Classes="header-icon" Data="{StaticResource IconMore}"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Classes="header-menu-item"
                                          Header="{DynamicResource mainWindow.checkCustomerDisplayTooltip}"
                                          Command="{Binding Toolbar.CheckCustomerDisplayCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconMonitor}" Width="18" Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="header-menu-item"
                                          Header="{Binding Toolbar.ThemeTooltip}"
                                          Click="ToggleTheme_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="mdl2" Text="{Binding Toolbar.ThemeGlyph}" FontSize="17"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Classes="header-menu-item"
                                          Header="{DynamicResource mainWindow.hotkeysTooltip}"
                                          Click="OpenHotkeySettings_Click">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconBolt}" Width="18" Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="main-outline shift-action"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OpenShift_Click"
                            IsEnabled="{Binding Toolbar.CanOpenShift}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- 2026-09-15, по просьбе пользователя ("сделай дизайн
                                 профессиональным") — векторная иконка вместо эмодзи 🔓, тот
                                 же приём (PathIcon с MDI-геометрией), что уже используется в
                                 Складе и боковом меню. -->
                            <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                                      Data="M18,20V10H6V20H18M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H15V6A3,3 0 0,0 12,3A3,3 0 0,0 9,6H7A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18Z"/>
                            <TextBlock Text="{DynamicResource csh.toolbar.openShift}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="main-primary shift-action"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CloseShift_Click"
                            IsEnabled="{Binding Toolbar.CanCloseShift}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                                      Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"/>
                            <TextBlock Text="{DynamicResource csh.toolbar.closeShift}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </DockPanel>

        <!-- ======================== Основной контент ======================== -->
        <Grid x:Name="MainContentGrid" Grid.Row="1"
              MinHeight="0"
              ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"
                                  MinWidth="{StaticResource CatalogMinimumWidth}"/>
                <ColumnDefinition Width="8"
                                  MinWidth="8"
                                  MaxWidth="8"/>
                <ColumnDefinition Width="*"
                                  MinWidth="{StaticResource CartMinimumWidth}"/>
            </Grid.ColumnDefinitions>

            <controls:CatalogPanelView x:Name="CatalogPanel"
                                       Grid.Column="0"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       DataContext="{Binding Catalog}"/>

            <GridSplitter x:Name="CatalogGridSplitter"
                          Grid.Column="1"
                          Width="8"
                          MinWidth="8"
                          MaxWidth="8"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ShowsPreview="False"
                          ZIndex="100"/>

            <views:CustomerCartView x:Name="CartPanelView" Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    DataContext="{Binding Basket}"/>

            <!-- 2026-10-04, редизайн под Android-телефон: на вертикальном телефоне каталог и чек вместе не
                 помещаются (оставался ряд товаров и строка чека). Как в мобильных кассах — два экрана «Товары» и
                 «Чек» с переключателем: на нём сколько позиций в чеке, а «Оплатить» с суммой — прямо из каталога.
                 Показывает MainWindow.ApplyPortraitLayout; на планшетах, терминалах и в Windows скрыт. -->
            <Border x:Name="PhoneModeBar"
                    IsVisible="False"
                    Background="{DynamicResource BrushCartSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid ColumnDefinitions="*,6,*,6,Auto">
                    <ToggleButton x:Name="PhoneCatalogTab"
                                  Grid.Column="0"
                                  Classes="phone-tab"
                                  Focusable="False"
                                  Click="PhoneCatalogTab_Click">
                        <TextBlock Text="{DynamicResource csh.phone.products}" FontSize="14" FontWeight="SemiBold"/>
                    </ToggleButton>
                    <ToggleButton x:Name="PhoneCartTab"
                                  Grid.Column="2"
                                  Classes="phone-tab"
                                  Focusable="False"
                                  Click="PhoneCartTab_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{DynamicResource csh.phone.receipt}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding Basket.HasLines}"
                                    Background="{DynamicResource BrushDanger}"
                                    CornerRadius="10"
                                    MinWidth="22"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Basket.Lines.Count}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="PhonePayButton"
                            Grid.Column="4"
                            Classes="main-primary"
                            Focusable="False"
                            MinHeight="44"
                            Padding="14,2"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding Basket.PayCommand}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Basket.PayButtonText}" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Basket.TotalDisplay}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Альтернативная раскладка "1С-стиль" (2026-09-06) — переключается в Настройках →
             Экран, см. UserPreferences.MainLayoutMode / MainWindow.RefreshLayoutMode. Видимость
             двух блоков всегда взаимоисключающая, задаётся из code-behind, не биндингом. -->
        <mainKassir:OneCLayoutView x:Name="OneCLayout" Grid.Row="1" IsVisible="False"/>
        <!-- Остальные раскладки (2026-09-28): «Табличная», «Карточки», «Минимал», «Профи» —
             создаются по выбору в Настройках → Экран (см. KassaLayouts / RefreshLayoutMode). -->
        <ContentControl x:Name="AltLayoutHost" Grid.Row="1" IsVisible="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <!-- 2026-09-29: уведомление об аварии сервера NurCRM и о восстановлении связи — поверх
             кассы под шапкой, само исчезает (MainStatusViewModel.ShowToast), щелчок закрывает.
             Не окно: кассир не должен ничего нажимать, чтобы продолжить продажи. -->
        <Border Grid.Row="1"
                ZIndex="150"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="16,8,16,0"
                MaxWidth="720"
                Padding="14,8"
                CornerRadius="10"
                BorderThickness="1"
                Classes="outageToast"
                IsVisible="{Binding Toolbar.Status.HasOutageToast}"
                Classes.recovery="{Binding Toolbar.Status.IsOutageToastRecovery}"
                PointerPressed="OnOutageToastPressed">
            <!-- Мягкий фон и текст темы, как у плашки смены: белый текст на жёлтом в тёмной
                 теме не читался (проверено снимком стенда 29.09). -->
            <Border.Styles>
                <Style Selector="Border.outageToast">
                    <Setter Property="Background" Value="{DynamicResource BrushShiftWarnBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushShiftWarnBorder}"/>
                </Style>
                <Style Selector="Border.outageToast.recovery">
                    <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushUiStatusOk}"/>
                </Style>
            </Border.Styles>
            <TextBlock Text="{Binding Toolbar.Status.OutageToastText}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       TextWrapping="Wrap"/>
        </Border>
        <Panel Grid.RowSpan="2"
               ZIndex="200"
               IsVisible="{Binding IsSideMenuOpen}">
            <Border Background="#66000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerPressed="OnSideMenuBackdropPressed"/>
            <controls:SideMenuView DataContext="{Binding SideMenu}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch"/>
        </Panel>

        </Grid>
        </LayoutTransformControl>
    </Grid>
</Window>
