<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
             xmlns:parts="using:NurMarketKassa.AvaloniaHost.Views.Customer.Parts"
             xmlns:aconv="using:NurMarketKassa.AvaloniaHost.Converters"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Customer.Layouts.ClassicCustomerLayout"
             x:DataType="vm:CustomerDisplayViewModel">
  <!-- Экран покупателя, вид «Классика» (2026-09-28) — прежний экран покупателя, перенесённый из
       CustomerDisplayWindow без изменений в раскладке: шапка, список покупок карточками, справа
       QR / реклама и состояние сканера, внизу итоги. Добавлено только то, что задаёт редактор:
       своя надпись сверху, скрытие часов и списка, фото товара вместо значка корзины. -->
  <Grid Margin="{Binding PageMargin}" RowDefinitions="Auto,*,Auto">
    <!-- Верхняя информационная полоса -->
    <Border Grid.Row="0" Classes="cd-card" Padding="22,16">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="50" Height="50" CornerRadius="14" Margin="0,0,14,0">
          <Image Source="/Assets/app-logo.png"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="cd-text" Text="{Binding HeaderTitle}" FontSize="{Binding HeaderFontSize}" FontWeight="Bold"/>
          <TextBlock Classes="cd-soft" Text="{DynamicResource csh.customer.tagline}" FontSize="14"/>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="cd-text" Text="{Binding DateTimeText}" FontSize="18" FontWeight="SemiBold"
                     IsVisible="{Binding ShowClock}"/>
          <TextBlock Classes="cd-soft" Text="{Binding ItemCountText}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Контент: товары + постоянный информационный блок -->
    <Grid Grid.Row="1" Margin="0,16" ColumnDefinitions="2.25*,0.9*">
      <Border Grid.Column="0" Classes="cd-card" Padding="20">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="{DynamicResource csh.customer.receiptEyebrow}" FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource CustomerDisplayAccentInkBrush}"/>
              <TextBlock Classes="cd-text" Text="{DynamicResource csh.customer.receiptTitle}" FontSize="25" FontWeight="Bold"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource CustomerDisplayAccentSoftBrush}"
                    CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
              <TextBlock Classes="cd-text" Text="{Binding ItemCountText}" FontSize="15" FontWeight="Bold"/>
            </Border>
          </Grid>

          <Grid Grid.Row="1">
            <parts:CustomerGreeting IsVisible="{Binding IsEmpty}"/>

            <!-- Список скрыт в редакторе — вместо него крупная сумма. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding ShowTotalOnly}">
              <TextBlock Classes="cd-soft" Text="{Binding TotalDueLabel}" FontSize="{DynamicResource CdFont22}" HorizontalAlignment="Center"/>
              <TextBlock Classes="cd-text cd-num" Text="{Binding TotalText}" FontSize="{Binding BigTotalFontSize}" FontWeight="Bold"
                         HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Classes="cd-list" IsVisible="{Binding ShowLines}">
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CustomerDisplayItemViewModel">
                    <Border Background="{DynamicResource CustomerDisplaySurfaceAltBrush}"
                            BorderBrush="{DynamicResource CustomerDisplayBorderBrush}"
                            BorderThickness="1" CornerRadius="14"
                            Padding="16,13" Margin="0,0,0,10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="44" Height="44" CornerRadius="12" ClipToBounds="True"
                                Background="{DynamicResource CustomerDisplayAccentSoftBrush}"
                                Margin="0,0,14,0">
                          <Panel>
                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource CustomerDisplayAccentInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding HasNoPhoto}"/>
                            <Image Stretch="UniformToFill" IsVisible="{Binding HasPhoto}"
                                   Source="{Binding ImagePath, Converter={x:Static aconv:AssetPathToBitmapConverter.Instance}, ConverterParameter=thumb}"/>
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                                     Foreground="{DynamicResource CustomerDisplayTextBrush}"
                                     TextWrapping="Wrap"/>
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding BarcodeDisplay}"
                                       FontSize="12"
                                       Foreground="{DynamicResource CustomerDisplaySecondaryTextBrush}"
                                       IsVisible="{Binding HasBarcode}"/>
                            <TextBlock Text="{Binding UnitPriceText}" FontSize="13"
                                       Foreground="{DynamicResource CustomerDisplaySecondaryTextBrush}"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding TotalText}" FontSize="21" FontWeight="Bold"
                                     Foreground="{DynamicResource CustomerDisplayTextBrush}"
                                     HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding QuantityText}" FontSize="13"
                                     Foreground="{DynamicResource CustomerDisplaySecondaryTextBrush}"
                                     HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <!-- QR / реклама и состояние сканера -->
      <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="14">
        <parts:CustomerInfoCard/>

        <Border Classes="cd-card" Padding="16">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="21"
                    Background="{Binding ScannerStatusSoftBrush}" Margin="0,0,12,0">
              <Ellipse Width="12" Height="12" Fill="{Binding ScannerStatusBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="cd-text" Text="{Binding ScannerStatusText}" FontSize="15" FontWeight="Bold"/>
              <TextBlock Classes="cd-soft" Text="{Binding ScannerStatusDescription}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Итоги с явной акцентной сеткой -->
    <Border Grid.Row="2" Classes="cd-card" Padding="22,16">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="0,0,36,0">
          <TextBlock Classes="cd-soft" Text="{DynamicResource csh.customer.subtotal}" FontSize="11" FontWeight="Bold"/>
          <TextBlock Classes="cd-text" Text="{Binding SubtotalAmountText}" FontSize="23" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="cd-soft" Text="{DynamicResource csh.customer.discount}" FontSize="11" FontWeight="Bold"/>
          <Border Background="{Binding DiscountSoftBrush}" CornerRadius="9" Padding="10,4">
            <TextBlock Text="{Binding DiscountAmountText}" FontSize="20" FontWeight="Bold"
                       Foreground="{Binding DiscountBrush}"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,36,0"
                    IsVisible="{Binding HasCashInfo}">
          <Grid ColumnDefinitions="Auto,Auto">
            <StackPanel Margin="0,0,28,0" IsVisible="{Binding ShowPaidAmountColumn}">
              <TextBlock Classes="cd-soft" Text="{DynamicResource csh.customer.received}" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Right"/>
              <TextBlock Classes="cd-text" Text="{Binding CashReceivedText}" FontSize="20" FontWeight="Bold"
                         HorizontalAlignment="Right"/>
            </StackPanel>
            <StackPanel Grid.Column="1" IsVisible="{Binding ShowChangeColumn}">
              <TextBlock Classes="cd-soft" Text="{DynamicResource csh.customer.change}" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding ChangeDueText}" FontSize="20" FontWeight="Bold"
                         Foreground="{Binding AccentBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
          <TextBlock Classes="cd-soft" Text="{DynamicResource csh.customer.totalDue}" FontSize="13" FontWeight="Bold"
                     HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding TotalText}" FontSize="{Binding TotalFontSize}" FontWeight="Bold"
                     Foreground="{Binding AccentBrush}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
