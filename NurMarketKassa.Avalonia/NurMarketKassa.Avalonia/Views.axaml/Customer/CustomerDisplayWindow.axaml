<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
        xmlns:conv="using:NurMarketKassa.Converters"
        xmlns:controls="using:NurMarketKassa.AvaloniaHost.Controls"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Customer.CustomerDisplayWindow"
        x:DataType="vm:CustomerDisplayViewModel"
        Title="{DynamicResource csh.customer.title}"
        MinWidth="800" MinHeight="520"
        ShowInTaskbar="False"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        KeyDown="OnKeyDown"
        Background="{Binding BackgroundBrush}">
  <Window.Resources>
    <conv:PathToImageConverter x:Key="PathToImageConverter"/>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.display-card">
      <Setter Property="Background" Value="{Binding SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{Binding BorderBrushValue}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{Binding DisplayCornerRadius}"/>
    </Style>
    <Style Selector="Button.customer-display-close">
      <Setter Property="Background" Value="{Binding SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{Binding TextBrush}"/>
      <Setter Property="BorderBrush" Value="{Binding BorderBrushValue}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
    </Style>
  </Window.Styles>

  <Grid>
    <Image Source="{Binding Settings.BackgroundImagePath, Converter={StaticResource PathToImageConverter}}"
           Stretch="UniformToFill"
           IsVisible="{Binding HasBackgroundImage}"/>
    <Border Background="{Binding BackgroundBrush}"
            Opacity="{Binding Settings.BackgroundOverlayOpacity}"
            IsVisible="{Binding HasBackgroundImage}"/>

    <Grid Margin="{Binding PageMargin}" RowDefinitions="Auto,*,Auto">
      <!-- Верхняя информационная полоса -->
      <Border Grid.Row="0" Classes="display-card" Padding="22,16">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="50" Height="50" CornerRadius="14"
                  Margin="0,0,14,0">
            <Image Source="/Assets/app-logo.png"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding StoreName}" FontSize="{Binding HeaderFontSize}"
                       FontWeight="Bold" Foreground="{Binding TextBrush}"/>
            <TextBlock Text="{DynamicResource csh.customer.tagline}"
                       FontSize="14" Foreground="{Binding SecondaryTextBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding DateTimeText}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{Binding TextBrush}"/>
            <TextBlock Text="{Binding ItemCountText}" HorizontalAlignment="Right"
                       Foreground="{Binding SecondaryTextBrush}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Контент: товары + постоянный информационный блок -->
      <Grid Grid.Row="1" Margin="0,16" ColumnDefinitions="2.25*,0.9*">
        <Border Grid.Column="0" Classes="display-card" Padding="20">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{DynamicResource csh.customer.receiptEyebrow}" FontSize="13" FontWeight="Bold"
                           Foreground="{Binding AccentBrush}"/>
                <TextBlock Text="{DynamicResource csh.customer.receiptTitle}" FontSize="25" FontWeight="Bold"
                           Foreground="{Binding TextBrush}"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{Binding AccentSoftBrush}"
                      CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding ItemCountText}" FontSize="15"
                           FontWeight="Bold" Foreground="{Binding TextBrush}"/>
              </Border>
            </Grid>

            <Grid Grid.Row="1">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12" IsVisible="{Binding IsEmpty}">
                <Border Width="88" Height="88" CornerRadius="44"
                        Background="{Binding AccentSoftBrush}">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="38"
                             Foreground="{Binding AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Settings.EmptyTitle}" FontSize="{Binding EmptyTitleFontSize}"
                           FontWeight="Bold" Foreground="{Binding TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Settings.EmptyDescription}" FontSize="18"
                           Foreground="{Binding SecondaryTextBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="600"/>
              </StackPanel>

              <ScrollViewer IsVisible="{Binding HasItems}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomerDisplayItemViewModel">
                      <Border Background="{DynamicResource CustomerDisplaySurfaceAltBrush}"
                              BorderBrush="{DynamicResource CustomerDisplayBorderBrush}"
                              BorderThickness="1" CornerRadius="14"
                              Padding="16,13" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                          <Border Width="44" Height="44" CornerRadius="12"
                                  Background="{DynamicResource CustomerDisplayAccentSoftBrush}"
                                  Margin="0,0,14,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource CustomerDisplayAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource CustomerDisplayTextBrush}"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                              <TextBlock Text="{Binding BarcodeDisplay}"
                                         FontSize="12"
                                         Foreground="{DynamicResource CustomerDisplaySecondaryTextBrush}"
                                         IsVisible="{Binding HasBarcode}"/>
                              <TextBlock Text="{Binding UnitPriceText}" FontSize="13"
                                         Foreground="{DynamicResource CustomerDisplaySecondaryTextBrush}"/>
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TotalText}" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource CustomerDisplayTextBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding QuantityText}" FontSize="13"
                                       Foreground="{DynamicResource CustomerDisplaySecondaryTextBrush}"
                                       HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <!-- QR / реклама и состояние сканера -->
        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="14">
          <Border Classes="display-card" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding InformationEyebrow}" FontSize="12" FontWeight="Bold"
                         Foreground="{Binding AccentBrush}"/>
              <TextBlock Text="{Binding InformationTitle}" FontSize="22" FontWeight="Bold"
                         Foreground="{Binding TextBrush}" TextWrapping="Wrap"/>
              <Border Background="White" CornerRadius="16" Padding="12"
                      HorizontalAlignment="Center" IsVisible="{Binding IsStaticInformationImage}">
                <Image Source="{Binding InformationImagePath, Converter={StaticResource PathToImageConverter}}"
                       Width="210" Height="210"
                       Stretch="Uniform"/>
              </Border>
              <Border Background="White" CornerRadius="16" Width="210" Height="210"
                      ClipToBounds="True"
                      HorizontalAlignment="Center" IsVisible="{Binding IsAnimatedInformationMedia}">
                <controls:WebView2Host x:Name="AdMediaHost"/>
              </Border>
              <Border Height="190" CornerRadius="16" Background="{Binding AccentSoftBrush}"
                      IsVisible="{Binding !HasInformationImage}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="52"
                             Foreground="{Binding AccentBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource csh.customer.adPlaceholder}"
                             TextAlignment="Center" TextWrapping="Wrap"
                             Foreground="{Binding SecondaryTextBrush}"/>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding InformationDescription}" FontSize="14"
                         Foreground="{Binding SecondaryTextBrush}" TextWrapping="Wrap"
                         TextAlignment="Center"/>
            </StackPanel>
          </Border>

          <Border Classes="display-card" Padding="16">
            <Grid ColumnDefinitions="Auto,*">
              <Border Width="42" Height="42" CornerRadius="21"
                      Background="{Binding ScannerStatusSoftBrush}" Margin="0,0,12,0">
                <Ellipse Width="12" Height="12" Fill="{Binding ScannerStatusBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScannerStatusText}" FontSize="15" FontWeight="Bold"
                           Foreground="{Binding TextBrush}"/>
                <TextBlock Text="{Binding ScannerStatusDescription}" FontSize="12"
                           Foreground="{Binding SecondaryTextBrush}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Итоги с явной акцентной сеткой -->
      <Border Grid.Row="2" Classes="display-card" Padding="22,16">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <StackPanel Margin="0,0,36,0">
            <TextBlock Text="{DynamicResource csh.customer.subtotal}" FontSize="11" FontWeight="Bold"
                       Foreground="{Binding SecondaryTextBrush}"/>
            <TextBlock Text="{Binding SubtotalAmountText}" FontSize="23" FontWeight="Bold"
                       Foreground="{Binding TextBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{DynamicResource csh.customer.discount}" FontSize="11" FontWeight="Bold"
                       Foreground="{Binding SecondaryTextBrush}"/>
            <Border Background="{Binding DiscountSoftBrush}" CornerRadius="9" Padding="10,4">
              <TextBlock Text="{Binding DiscountAmountText}" FontSize="20" FontWeight="Bold"
                         Foreground="{Binding DiscountBrush}"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,36,0"
                      IsVisible="{Binding HasCashInfo}">
            <Grid ColumnDefinitions="Auto,Auto">
              <StackPanel Margin="0,0,28,0" IsVisible="{Binding ShowPaidAmountColumn}">
                <TextBlock Text="{DynamicResource csh.customer.received}" FontSize="11" FontWeight="Bold"
                           Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding CashReceivedText}" FontSize="20" FontWeight="Bold"
                           Foreground="{Binding TextBrush}" HorizontalAlignment="Right"/>
              </StackPanel>
              <StackPanel Grid.Column="1" IsVisible="{Binding ShowChangeColumn}">
                <TextBlock Text="{DynamicResource csh.customer.change}" FontSize="11" FontWeight="Bold"
                           Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding ChangeDueText}" FontSize="20" FontWeight="Bold"
                           Foreground="{Binding AccentBrush}" HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="3" HorizontalAlignment="Right">
            <TextBlock Text="{DynamicResource csh.customer.totalDue}" FontSize="13" FontWeight="Bold"
                       Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding TotalText}" FontSize="{Binding TotalFontSize}" FontWeight="Bold"
                       Foreground="{Binding AccentBrush}" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,16,16,0" Width="44" Height="44" Padding="0"
            Classes="customer-display-close"
            Command="{Binding CloseCustomerDisplayCommand}"
            IsVisible="{Binding IsPreviewMode}">
      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
    </Button>
  </Grid>
</Window>
