<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
        xmlns:customer="using:NurMarketKassa.AvaloniaHost.Views.Customer"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Customer.CustomerDisplayWindow"
        x:DataType="vm:CustomerDisplayViewModel"
        Title="{DynamicResource csh.customer.title}"
        MinWidth="800" MinHeight="520"
        ShowInTaskbar="False"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        KeyDown="OnKeyDown"
        Background="{Binding BackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button.customer-display-close">
      <Setter Property="Background" Value="{Binding SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{Binding TextBrush}"/>
      <Setter Property="BorderBrush" Value="{Binding BorderBrushValue}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SettingsButtonRadius}"/>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- Содержимое экрана — один из шести видов (2026-09-28): тот же, что у кассы, или выбранный
         в редакторе экрана покупателя. См. CustomerDisplayView. -->
    <customer:CustomerDisplayView x:Name="DisplayView"/>

    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,16,16,0" Width="44" Height="44" Padding="0"
            Classes="customer-display-close"
            Command="{Binding CloseCustomerDisplayCommand}"
            IsVisible="{Binding IsPreviewMode}">
      <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
    </Button>
  </Grid>
</Window>
