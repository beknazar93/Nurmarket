<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
             xmlns:brand="using:NurMarketKassa.AvaloniaHost.Controls"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Customer.Parts.CustomerGreeting"
             x:DataType="vm:CustomerDisplayViewModel"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <!-- Пустой чек (2026-09-28): приветствие из редактора экрана покупателя; текст по умолчанию —
       на языке программы. Общее для всех видов экрана. -->
  <StackPanel Spacing="12" MaxWidth="640">
    <!-- 2026-10-22, брендбук NUR CRM: на простое — знак «солнце над горой» (было: значок корзины) на белом круге (знак «на светлом» читается и на тёмном экране)
         и еле заметный паттерн лучей позади приветствия. -->
    <Panel>
      <brand:BrandPattern Foreground="{DynamicResource CustomerDisplayAccentInkBrush}" Opacity="0.07" CellSize="64"
                          Width="560" Height="260" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <Border x:Name="IconCircle" CornerRadius="24" HorizontalAlignment="Center" Background="#FFFFFF" Padding="26,20">
        <brand:BrandLogo Kind="Vertical" Variant="Light" Width="170"/>
      </Border>
    </Panel>
    <TextBlock x:Name="TitleText" Classes="cd-text brand-h" Text="{Binding GreetingTitle}" FontSize="{DynamicResource CdFont36}"
               FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock Classes="cd-soft" Text="{Binding GreetingDescription}" FontSize="{DynamicResource CdFont18}"
               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
