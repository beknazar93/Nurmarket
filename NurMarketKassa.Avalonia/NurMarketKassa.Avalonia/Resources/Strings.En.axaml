  <!-- POS settings: Screen tab -->
  <x:String x:Key="posSettings.screen.title">Screen and interface</x:String>
  <x:String x:Key="posSettings.screen.subtitle">Till display, window behavior and store details</x:String>
  <x:String x:Key="posSettings.screen.behaviorTitle">App behavior</x:String>
  <x:String x:Key="posSettings.screen.groupDisplay">Display and startup</x:String>
  <x:String x:Key="posSettings.screen.groupPerformance">Performance</x:String>
  <x:String x:Key="posSettings.screen.groupCashierLang">Till and language</x:String>
  <x:String x:Key="posSettings.screen.groupScaleLayout">UI scale and layout</x:String>
  <x:String x:Key="posSettings.screen.fullscreen">Fullscreen mode</x:String>
  <x:String x:Key="posSettings.screen.trueFullscreen">True fullscreen mode</x:String>
  <x:String x:Key="posSettings.screen.trueFullscreenDesc">Hides the Windows taskbar completely. Works only together with fullscreen mode.</x:String>
  <x:String x:Key="posSettings.screen.quickProducts">Quick products in an empty receipt</x:String>
  <x:String x:Key="posSettings.screen.quickProductsDesc">Favourite products (★ in the catalog) under “Cart is empty”. Turn off if you don’t need them.</x:String>
  <x:String x:Key="csh.upsell.title">Often bought with this</x:String>
  <x:String x:Key="csh.upsell.add">Add</x:String>
  <x:String x:Key="csh.upsell.skip">Skip</x:String>
  <x:String x:Key="posSettings.screen.upsell">Upsell suggestions</x:String>
  <x:String x:Key="posSettings.screen.upsellDesc">Above the receipt total — a product often bought together with the items in the receipt (from 90 days of receipts, in stock only). “Add” puts it in the receipt, “Skip” stops suggesting it in this receipt.</x:String>
  <x:String x:Key="posSettings.screen.autostart">Launch with Windows</x:String>
  <x:String x:Key="posSettings.screen.lowPerfMode">Low-power device mode</x:String>
  <x:String x:Key="posSettings.screen.lowPerfModeDesc">Software rendering instead of the graphics card — for older all-in-one PCs and low-end laptops. Requires restarting the till.</x:String>
  <x:String x:Key="posSettings.screen.voiceControl">Voice control</x:String>
  <x:String x:Key="posSettings.screen.voiceControlDesc">Say "kassa" and the product name with a quantity — the till finds the product and adds it to the receipt. Works offline and listens to the microphone continuously.</x:String>
  <x:String x:Key="posSettings.screen.voiceControlTest">Test voice</x:String>
  <x:String x:Key="posSettings.screen.voiceControlMovedDesc">Now a paid add-on — activated and downloaded separately (~113 MB) to keep the base app light.</x:String>
  <x:String x:Key="posSettings.screen.voiceControlOpenMarketplace">Open in Marketplace</x:String>
  <x:String x:Key="posSettings.screen.autoTouchKeyboard">Auto-show touch keyboard</x:String>
  <x:String x:Key="posSettings.screen.showCatalogPhotos">Show product photos in the catalog</x:String>
  <x:String x:Key="posSettings.screen.showCatalogPhotosDesc">If a product has no uploaded photo, only the name is shown.</x:String>
  <x:String x:Key="posSettings.screen.cashbox">Till</x:String>
  <x:String x:Key="posSettings.screen.cashboxDesc">The first active till is used by default. If it's the wrong one, pick the right one here.</x:String>
  <x:String x:Key="posSettings.screen.refreshCashboxesTooltip">Refresh the list of tills</x:String>
  <x:String x:Key="posSettings.screen.cashierLanguage">Cashier screen language</x:String>
  <x:String x:Key="posSettings.screen.appliesImmediately">Applies immediately, no restart needed.</x:String>
  <x:String x:Key="posSettings.screen.langRussian">Russian</x:String>
  <x:String x:Key="posSettings.screen.langKyrgyz">Kyrgyz</x:String>
  <x:String x:Key="posSettings.screen.langTurkish">Turkish</x:String>
  <x:String x:Key="posSettings.screen.langUzbek">Uzbek</x:String>
  <x:String x:Key="posSettings.screen.langEnglish">English</x:String>
  <x:String x:Key="posSettings.screen.languagePackHint">English, Turkish and Uzbek are part of the paid "Language pack": Marketplace → Extras</x:String>
  <x:String x:Key="posSettings.screen.uiScale">UI scale</x:String>
  <x:String x:Key="posSettings.screen.uiScaleDesc">Size of all elements on the till screen, from 50% to 200%. Applies immediately, no restart needed.</x:String>
  <x:String x:Key="posSettings.screen.tileSize">Product tile size</x:String>
  <x:String x:Key="posSettings.screen.tileSizeDesc">Larger tiles are easier to tap on a touch screen; smaller ones fit more products on the screen. The header and receipt are not affected.</x:String>
  <x:String x:Key="posSettings.screen.compactLayout">Compact layout for small screens</x:String>
  <x:String x:Key="posSettings.screen.compactLayoutDesc">On 1024×768, 1280×800 and 1366×768 screens and touch all-in-ones the till rearranges itself instead of shrinking: a “⋯” menu in the header, two-row receipt lines, buttons at least 44 points high. Works in the Classic layout.</x:String>
  <x:String x:Key="posSettings.screen.compactAuto">Auto</x:String>
  <x:String x:Key="posSettings.screen.compactOn">Always</x:String>
  <x:String x:Key="posSettings.screen.compactOff">Off</x:String>
  <x:String x:Key="posSettings.screen.layoutMode">Till layout</x:String>
  <x:String x:Key="posSettings.screen.layoutModeDesc">Six till screen layouts. Pick a card and the till rearranges instantly, with no restart. Products, receipts, payment and the scanner work the same in every layout.</x:String>
  <x:String x:Key="posSettings.screen.layoutStandard">Standard</x:String>
  <x:String x:Key="posSettings.screen.layoutOneC">1C style</x:String>
  <x:String x:Key="posSettings.screen.addToCheckTitle">Adding products to a receipt</x:String>
  <x:String x:Key="posSettings.screen.clickOnProduct">Clicking a product</x:String>
  <x:String x:Key="posSettings.screen.doubleClick">Double</x:String>
  <x:String x:Key="posSettings.screen.singleClick">Single</x:String>
  <x:String x:Key="posSettings.screen.resetQtyAfterInput">Reset quantity after entry</x:String>
  <x:String x:Key="posSettings.screen.receiptDataTitle">Details shown on the receipt</x:String>
  <x:String x:Key="posSettings.screen.storeName">Store name</x:String>
  <x:String x:Key="posSettings.screen.storeNameWatermark">E.g., Supermarket No. 1</x:String>
  <x:String x:Key="posSettings.screen.storeNameTooltip">Shown at the top of the receipt</x:String>
  <x:String x:Key="posSettings.screen.storeAddress">Store address</x:String>
  <x:String x:Key="posSettings.screen.storeAddressWatermark">E.g., 15 Lenin St.</x:String>
  <x:String x:Key="posSettings.screen.storeAddressTooltip">Printed on the receipt if "Address" is enabled</x:String>
  <x:String x:Key="posSettings.screen.showInn">Show tax ID</x:String>
  <x:String x:Key="posSettings.screen.showInnDesc">Print the company's tax ID in the receipt header</x:String>

