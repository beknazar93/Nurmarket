  <x:String x:Key="posSettings.customization.opacityTitle">Glass density</x:String>
  <x:String x:Key="posSettings.customization.opacityDesc">Adjusts the opacity of glass surfaces from 0 to 100% (not the transparency of the content).</x:String>
  <x:String x:Key="posSettings.customization.applyToCashierTitle">Apply this wallpaper to the cashier screen</x:String>
  <x:String x:Key="posSettings.customization.applyToCashierDesc">After saving, the background will appear in the main till interface.</x:String>
  <x:String x:Key="posSettings.customization.transparencyTitle">Transparency and blur</x:String>
  <x:String x:Key="posSettings.customization.blurTitle">Background blur</x:String>
  <x:String x:Key="posSettings.customization.blurDesc">0% turns blur off; 40% is the balanced default.</x:String>

  <!-- POS settings: Marketplace tab -->
  <x:String x:Key="marketplace.subtitle">Themes and extra features for the till</x:String>
  <x:String x:Key="marketplace.updateNowButton">Update</x:String>
  <x:String x:Key="marketplace.themesTab">Themes</x:String>
  <x:String x:Key="marketplace.extrasTab">Extras</x:String>
  <x:String x:Key="marketplace.themeTitle">Theme</x:String>
  <x:String x:Key="marketplace.themesRebuilding">The previous themes have been removed — the theme set is being rebuilt. For now, the till runs in light or dark mode; the toggle is in the header.</x:String>
  <x:String x:Key="marketplace.themeDesc">Changes the accent color, button and card shapes, and window background across the whole app at once. Applies with one click.</x:String>
  <x:String x:Key="marketplace.liquidGlassToggleTitle">Liquid glass</x:String>
  <x:String x:Key="marketplace.liquidGlassToggleDesc">On — glossy semi-transparent cards and blur on the till. Off — matte, barely transparent cards without blur.</x:String>
  <x:String x:Key="marketplace.glassOpacityTitle">Glass transparency</x:String>
  <x:String x:Key="marketplace.glassOpacityDesc">How transparent modal windows and catalog tiles are in the "Liquid glass" theme. The higher the value, the more transparent.</x:String>
  <x:String x:Key="marketplace.customColorTitle">Custom accent color</x:String>
  <x:String x:Key="marketplace.customColorDesc">Enter a HEX color code (e.g., #FF6B00) — the other shades (soft background, hover, tiles) are picked automatically.</x:String>
  <x:String x:Key="marketplace.radiusTitle">Corner rounding</x:String>
  <x:String x:Key="marketplace.radiusDesc">Sets the shape of buttons and cards/windows independently of the color theme.</x:String>
  <x:String x:Key="marketplace.radiusButtons">Buttons</x:String>
  <x:String x:Key="marketplace.radiusCards">Cards and windows</x:String>
  <x:String x:Key="marketplace.radiusReset">Reset</x:String>
  <x:String x:Key="theme.editorSubtitle">Changes appear on the right instantly — click "Apply" to use them across the whole till</x:String>
  <x:String x:Key="theme.previewLabel">PREVIEW</x:String>
  <x:String x:Key="marketplace.themeSettingsButton">Theme settings</x:String>
  <x:String x:Key="marketplace.themeFactoryReset">Restore factory settings</x:String>
  <x:String x:Key="marketplace.fontTitle">Font</x:String>
  <x:String x:Key="marketplace.fontSize">Size</x:String>
  <x:String x:Key="marketplace.fontColor">Text color</x:String>
  <x:String x:Key="marketplace.editorPriceLabel">Paid editor — 1500 som</x:String>
  <x:String x:Key="marketplace.serialTitle">Theme activation</x:String>
  <x:String x:Key="marketplace.serialActivate">Activate</x:String>
  <x:String x:Key="marketplace.installedBadge">Installed</x:String>
  <x:String x:Key="marketplace.installButton">Install</x:String>
  <x:String x:Key="marketplace.extrasIntro">Extra modules for the till. We're adding them gradually — the list will keep growing.</x:String>
  <x:String x:Key="marketplace.comingSoonBadge">Coming soon</x:String>
  <x:String x:Key="marketplace.extra1Title">Loyalty program</x:String>
