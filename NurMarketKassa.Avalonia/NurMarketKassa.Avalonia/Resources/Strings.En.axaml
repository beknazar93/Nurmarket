  <x:String x:Key="posSettings.screen.lowPerfMode">Low-power device mode</x:String>
  <x:String x:Key="posSettings.screen.lowPerfModeDesc">Software rendering instead of the graphics card — for older all-in-one PCs and weak laptops. Requires restarting the till.</x:String>
  <x:String x:Key="posSettings.screen.voiceControl">Voice control</x:String>
  <x:String x:Key="posSettings.screen.voiceControlDesc">Say "kassa" and the product name with a quantity — the till finds it and adds it to the receipt. Works offline, listens to the microphone continuously.</x:String>
