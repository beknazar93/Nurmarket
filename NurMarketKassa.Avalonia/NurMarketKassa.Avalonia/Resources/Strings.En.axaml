    <x:String x:Key="loc.settings.scale.aiScales">AI scales</x:String>
    <x:String x:Key="loc.settings.scaleConn.title">Scale connection</x:String>
    <x:String x:Key="loc.settings.scaleConn.desc">The till will talk to the scale directly over the local network, without a server. Get the address, port and password from the scale's own system menu.</x:String>
    <x:String x:Key="loc.settings.scaleConn.password4">Password (4 digits)</x:String>
    <x:String x:Key="loc.settings.scaleConn.hint">The port is usually 1111 and the password 0030. With a wrong password, the scale blocks access after several attempts: then turn it off and on again and enter the correct password.</x:String>
    <x:String x:Key="loc.settings.scaleConn.test">Test connection</x:String>
  <!-- История чеков и печать копии (2026-09-27) -->
  <x:String x:Key="csh.menu.receiptHistory">Receipt history</x:String>
  <x:String x:Key="receiptHistory.subtitle">Receipts of this till. Tap a receipt to see its items on the right and print a copy from there.</x:String>
