  <x:String x:Key="csh.menu.switchCashier">Switch cashier</x:String>
  <x:String x:Key="switchCashier.title">Switch cashier</x:String>
  <x:String x:Key="switchCashier.message">Enter the next cashier's login and password. The current shift will be closed (same as a normal shift close) until the correct details are entered — nothing changes until then.</x:String>
  <x:String x:Key="switchCashier.emailWatermark">Email</x:String>
  <x:String x:Key="switchCashier.passwordWatermark">Password</x:String>
  <x:String x:Key="switchCashier.confirmButton">Switch</x:String>
  <x:String x:Key="restock.tabReorder">Restock</x:String>
  <x:String x:Key="restock.reorderSubtitle">Calculated from sales recorded on this till. Empty if there have been no sales yet, or less than a couple of days have passed since the update.</x:String>
  <x:String x:Key="restock.lookbackLabel">Count sales speed over:</x:String>
  <x:String x:Key="restock.colDailyRate">Sales/day</x:String>
  <x:String x:Key="restock.colDaysLeft">Enough for</x:String>
  <x:String x:Key="restock.reorderEmpty">No sales history yet for a forecast. Click "Pull history from server" or wait a few days — the till builds up data after every sale on its own.</x:String>
  <x:String x:Key="restock.backfillButton">Pull history from server</x:String>
  <x:String x:Key="restock.tabExpiry">Expiry dates</x:String>
  <x:String x:Key="restock.expirySubtitle">Expiry date — an estimate based on product category (no real internet search without an AI key, see settings). Intake date — when the product first got stock on this till.</x:String>
  <x:String x:Key="restock.colIntakeDate">Received</x:String>
  <x:String x:Key="restock.colExpiryDate">Expires by</x:String>
  <x:String x:Key="restock.expiryEmpty">No products with a known intake date yet — it's recorded automatically as soon as a product gets stock.</x:String>
  <x:String x:Key="posSettings.operations.loyaltyTitle">Loyalty program</x:String>
  <x:String x:Key="posSettings.operations.loyaltySubtitle">Balance is stored locally on this till — NurCRM doesn't have a points field for clients yet.</x:String>
  <x:String x:Key="posSettings.operations.loyaltyEnable">Enable points</x:String>
  <x:String x:Key="posSettings.operations.loyaltyEarnPercent">Earn percentage from receipt total</x:String>
