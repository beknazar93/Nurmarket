  <!-- POS settings: Scale tab -->
  <x:String x:Key="posSettings.scale.subtitle">Connection settings and hardware polling</x:String>
  <x:String x:Key="posSettings.scale.enablePolling">Enable scale polling</x:String>
  <x:String x:Key="posSettings.scale.connectionParams">Connection settings</x:String>
  <x:String x:Key="posSettings.scale.baudRate">Baud rate</x:String>
  <x:String x:Key="posSettings.scale.poleDisplayTitle">Customer price display</x:String>
  <x:String x:Key="posSettings.scale.poleDisplayDesc">A separate small box with a price display on a COM port (not a second monitor). The CD5220 protocol is the most common for such devices, but it may not suit your particular model. Click "Test display" to check right away.</x:String>
  <x:String x:Key="posSettings.scale.poleDisplayTest">Test display</x:String>
  <x:String x:Key="posSettings.scale.pluSectionTitle">PLU on Shtrikh-M scales</x:String>
  <x:String x:Key="posSettings.scale.pluSectionDesc">Send weighed products with PLU codes to networked Shtrikh-M scales over LAN (same as the "Shtrikh-M" tab in the "Scales" section of the website).</x:String>
