  <x:String x:Key="marketplace.liquidGlassToggleTitle">Sıvı cam</x:String>
  <x:String x:Key="marketplace.liquidGlassToggleDesc">Açık — kasada parlak yarı saydam kartlar ve bulanıklık. Kapalı — mat, hafif saydam, bulanıklıksız kartlar.</x:String>
