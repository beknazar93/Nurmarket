  <x:String x:Key="marketplace.customColorTitle">Özel vurgu rengi</x:String>
  <x:String x:Key="marketplace.customColorDesc">Bir HEX renk kodu girin (örn. #FF6B00) — diğer tonlar (yumuşak arka plan, üzerine gelme, kartlar) otomatik seçilir.</x:String>
  <x:String x:Key="marketplace.radiusTitle">Köşe yuvarlaklığı</x:String>
