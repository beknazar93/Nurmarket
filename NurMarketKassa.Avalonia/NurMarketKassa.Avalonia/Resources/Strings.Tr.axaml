  <x:String x:Key="posSettings.scale.pluCheckConnection">Bağlantıyı kontrol et</x:String>
  <x:String x:Key="scalesPlu.title">Tartılar</x:String>
  <x:String x:Key="scalesPlu.brandShtrikh">Shtrikh-M</x:String>
  <x:String x:Key="scalesPlu.brandRongta">Rongta</x:String>
  <x:String x:Key="scalesPlu.rongtaSourceSite">Site üzerinden (.txp)</x:String>
  <x:String x:Key="scalesPlu.rongtaSourceServer">Kendi sunucunuz (yerel veritabanı)</x:String>
  <x:String x:Key="scalesPlu.rongtaPortLabel">Port:</x:String>
  <x:String x:Key="scalesPlu.subtitle">Tartılabilir ürünleri seçin ve ağa bağlı Shtrikh-M tartısına gönderin. Sunucu verileri yerel ağ üzerinden tartıya kendisi iletir.</x:String>
