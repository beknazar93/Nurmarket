  <x:String x:Key="posSettings.screen.groupDisplay">Ekran va ishga tushirish</x:String>
  <x:String x:Key="posSettings.screen.groupPerformance">Unumdorlik</x:String>
  <x:String x:Key="posSettings.screen.groupCashierLang">Kassa va til</x:String>
  <x:String x:Key="posSettings.screen.groupScaleLayout">Masshtab va joylashuv</x:String>
  <x:String x:Key="posSettings.screen.fullscreen">To'liq ekran rejimi</x:String>
  <x:String x:Key="posSettings.screen.trueFullscreen">Haqiqiy to'liq ekran rejimi</x:String>
  <x:String x:Key="posSettings.screen.trueFullscreenDesc">Windows vazifalar panelini butunlay yashiradi. Faqat to'liq ekran rejimi bilan birga ishlaydi.</x:String>
  <x:String x:Key="posSettings.screen.autostart">Windows bilan birga ishga tushirish</x:String>
  <x:String x:Key="posSettings.screen.lowPerfMode">Zaif qurilma rejimi</x:String>
  <x:String x:Key="posSettings.screen.lowPerfModeDesc">Video karta o'rniga dasturiy render — eski hammasi birida kompyuterlar va zaif noutbuklar uchun. Kassani qayta ishga tushirishni talab qiladi.</x:String>
  <x:String x:Key="posSettings.screen.voiceControl">Ovozli boshqaruv</x:String>
  <x:String x:Key="posSettings.screen.voiceControlDesc">"kassa" deb ayting va mahsulot nomini miqdori bilan — kassa uni topib chekka qo'shadi. Oflayn ishlaydi, mikrofonni doimiy tinglaydi.</x:String>
  <x:String x:Key="posSettings.screen.voiceControlTest">Ovozni sinash</x:String>
  <x:String x:Key="posSettings.screen.voiceControlMovedDesc">Endi bu pullik qo'shimcha xizmat — alohida faollashtiriladi va yuklab olinadi (~113 MB), asosiy kassani og'irlashtirmaslik uchun.</x:String>
  <x:String x:Key="posSettings.screen.voiceControlOpenMarketplace">Marketpleysda ochish</x:String>
  <x:String x:Key="posSettings.screen.autoTouchKeyboard">Sensorli klaviaturani avtomatik ko'rsatish</x:String>
  <x:String x:Key="posSettings.screen.showCatalogPhotos">Katalogda mahsulot rasmlarini ko'rsatish</x:String>
  <x:String x:Key="posSettings.screen.showCatalogPhotosDesc">Agar mahsulotning yuklangan rasmi bo'lmasa, faqat nomi ko'rsatiladi.</x:String>
  <x:String x:Key="posSettings.screen.cashbox">Kassa</x:String>
  <x:String x:Key="posSettings.screen.cashboxDesc">Standart bo'yicha birinchi faol kassa olinadi. Agar u noto'g'ri bo'lsa, bu yerdan kerakligini tanlang.</x:String>
  <x:String x:Key="posSettings.screen.refreshCashboxesTooltip">Kassalar ro'yxatini yangilash</x:String>
  <x:String x:Key="posSettings.screen.cashierLanguage">Kassir ekrani tili</x:String>
  <x:String x:Key="posSettings.screen.appliesImmediately">Qayta ishga tushirmasdan darhol qo'llaniladi.</x:String>
  <x:String x:Key="posSettings.screen.langRussian">Ruscha</x:String>
  <x:String x:Key="posSettings.screen.langKyrgyz">Qirg'izcha</x:String>
  <x:String x:Key="posSettings.screen.langTurkish">Turkcha</x:String>
  <x:String x:Key="posSettings.screen.langUzbek">O'zbekcha</x:String>
  <x:String x:Key="posSettings.screen.langEnglish">Inglizcha</x:String>
  <x:String x:Key="posSettings.screen.languagePackHint">Ingliz, turk va o'zbek tillari pullik Til paketi: Marketplace → Qo'shimcha funksiyalar</x:String>
  <x:String x:Key="posSettings.screen.uiScale">Masshtab</x:String>
  <x:String x:Key="posSettings.screen.uiScaleDesc">Kassa ekranidagi barcha elementlarning o'lchami — 50% dan 200% gacha. Qayta ishga tushirmasdan darhol qo'llaniladi.</x:String>
  <x:String x:Key="posSettings.screen.layoutMode">Asosiy ekran maketi</x:String>
  <x:String x:Key="posSettings.screen.layoutModeDesc">Oddiy — katalog va savat yonma-yon, o'lchami o'zgaruvchan. 1C-uslubi — katta mahsulot plitkalari, o'ng tomonda qat'iy chek ustuni, miqdor uchun klaviatura. Qayta ishga tushirmasdan darhol qo'llaniladi.</x:String>
  <x:String x:Key="posSettings.screen.layoutStandard">Oddiy</x:String>
  <x:String x:Key="posSettings.screen.layoutOneC">1C-uslubi</x:String>
