  <!-- Sozlamalar: Tarozi bo'limi -->
  <x:String x:Key="posSettings.scale.subtitle">Ulanish sozlamalari va uskunaga so'rov yuborish</x:String>
  <x:String x:Key="posSettings.scale.enablePolling">Tarozi so'rovini yoqish</x:String>
  <x:String x:Key="posSettings.scale.connectionParams">Ulanish sozlamalari</x:String>
  <x:String x:Key="posSettings.scale.baudRate">Tezlik (baud)</x:String>
  <x:String x:Key="posSettings.scale.poleDisplayTitle">Xaridor uchun narx displeyi</x:String>
  <x:String x:Key="posSettings.scale.poleDisplayDesc">COM portga ulanadigan, narx tablosi bor alohida qurilma (ikkinchi monitor emas). CD5220 protokoli bunday qurilmalar uchun eng keng tarqalgan, lekin aynan sizning modelingizga mos kelmasligi mumkin. Darhol tekshirish uchun "Test" tugmasini bosing.</x:String>
  <x:String x:Key="posSettings.scale.poleDisplayTest">Displeyni sinash</x:String>
  <x:String x:Key="posSettings.scale.pluSectionTitle">Shtrix-M tarozilarida PLU</x:String>
  <x:String x:Key="posSettings.scale.pluSectionDesc">PLU kodli vaznli mahsulotlarni LAN orqali tarmoqdagi Shtrix-M tarozilariga yuborish (saytdagidek: "Tarozilar" bo'limidagi "Shtrix-M" varag'i).</x:String>
  <x:String x:Key="posSettings.scale.pluSectionButton">Mahsulotlarni taroziga yuborish →</x:String>
  <x:String x:Key="posSettings.scale.pluBrandLabel">Tarozi modeli:</x:String>
  <x:String x:Key="posSettings.scale.pluIpLabel">Tarozi IP manzili (aloqani tekshirish uchun):</x:String>
  <x:String x:Key="posSettings.scale.pluCheckConnection">Aloqani tekshirish</x:String>
  <x:String x:Key="scalesPlu.title">Tarozi</x:String>
  <x:String x:Key="scalesPlu.brandShtrikh">Shtrix-M</x:String>
  <x:String x:Key="scalesPlu.brandRongta">Rongta</x:String>
  <x:String x:Key="scalesPlu.rongtaSourceSite">Sayt orqali (.txp)</x:String>
  <x:String x:Key="scalesPlu.rongtaSourceServer">O'z serveringiz (mahalliy baza)</x:String>
  <x:String x:Key="scalesPlu.rongtaPortLabel">Port:</x:String>
  <x:String x:Key="scalesPlu.subtitle">Vaznli mahsulotlarni tanlang va ularni tarmoqdagi Shtrix-M tarozisiga yuboring. Server ma'lumotlarni taroziga lokal tarmoq orqali o'zi uzatadi.</x:String>
