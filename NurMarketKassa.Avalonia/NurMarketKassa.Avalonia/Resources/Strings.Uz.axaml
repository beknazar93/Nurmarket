  <x:String x:Key="posSettings.customization.wallpaperDesc">Rasm tanlang (PNG, JPG, JPEG, WEBP). O'zgarishlar darhol qo'llaniladi.</x:String>
  <x:String x:Key="posSettings.customization.opacityTitle">Shisha zichligi</x:String>
  <x:String x:Key="posSettings.customization.opacityDesc">Shisha sirtlarning noshaffofligini 0 dan 100% gacha sozlaydi (kontent shaffofligiga ta'sir qilmaydi).</x:String>
  <x:String x:Key="posSettings.customization.applyToCashierTitle">Ushbu fon rasmini kassir ekraniga qo'llash</x:String>
  <x:String x:Key="posSettings.customization.applyToCashierDesc">Saqlangandan so'ng fon kassaning asosiy interfeysida paydo bo'ladi.</x:String>
  <x:String x:Key="posSettings.customization.transparencyTitle">Shaffoflik va xiralashtirish</x:String>
  <x:String x:Key="posSettings.customization.blurTitle">Fonni xiralashtirish</x:String>
  <x:String x:Key="posSettings.customization.blurDesc">0% xiralashtirishni o'chiradi, 40% — muvozanatli standart rejim.</x:String>

  <!-- Sozlamalar: Bozor bo'limi -->
  <x:String x:Key="marketplace.subtitle">Kassa uchun mavzular va qo'shimcha funksiyalar</x:String>
  <x:String x:Key="marketplace.updateNowButton">Yangilash</x:String>
  <x:String x:Key="marketplace.themesTab">Mavzular</x:String>
  <x:String x:Key="marketplace.extrasTab">Qo'shimcha funksiyalar</x:String>
  <x:String x:Key="marketplace.themeTitle">Mavzu</x:String>
  <x:String x:Key="marketplace.themesRebuilding">Avvalgi mavzular olib tashlandi — mavzular to'plami qaytadan tuzilmoqda. Hozircha kassa yorug' yoki qorong'i rejimda ishlaydi; almashtirgich yuqori panelda.</x:String>
  <x:String x:Key="marketplace.themeDesc">Butun dasturda urg'u rangini, tugma va kartalar shaklini hamda oynalar fonini birdaniga o'zgartiradi. Bir bosishda qo'llaniladi.</x:String>
  <x:String x:Key="marketplace.liquidGlassToggleTitle">Suyuq shisha</x:String>
  <x:String x:Key="marketplace.liquidGlassToggleDesc">Yoqilgan — kassada yaltiroq, yarim shaffof kartalar va xiralashtirish. O'chirilgan — mat, kam shaffof kartalar, xiralashtirishsiz.</x:String>
  <x:String x:Key="marketplace.glassOpacityTitle">Shisha shaffofligi</x:String>
  <x:String x:Key="marketplace.glassOpacityDesc">"Suyuq shisha" mavzusida modal oynalar va katalog kartalari qanchalik shaffof bo'lishi. Qiymat qancha katta bo'lsa, shunchalik shaffof.</x:String>
  <x:String x:Key="marketplace.customColorTitle">O'z urg'u rangi</x:String>
  <x:String x:Key="marketplace.customColorDesc">HEX rang kodini kiriting (masalan, #FF6B00) — qolgan tuslar (yumshoq fon, kursor ustida turganda, kartalar) avtomatik tanlanadi.</x:String>
  <x:String x:Key="marketplace.radiusTitle">Burchak yumaloqligi</x:String>
  <x:String x:Key="marketplace.radiusDesc">Tugma va karta/oyna shaklini rang mavzusidan alohida sozlaydi.</x:String>
  <x:String x:Key="marketplace.radiusButtons">Tugmalar</x:String>
  <x:String x:Key="marketplace.radiusCards">Kartalar va oynalar</x:String>
  <x:String x:Key="marketplace.radiusReset">Tozalash</x:String>
  <x:String x:Key="theme.editorSubtitle">O'zgarishlar o'ngda darhol ko'rinadi — ularni butun kassada qo'llash uchun "Qo'llash" tugmasini bosing</x:String>
  <x:String x:Key="theme.previewLabel">OLDINDAN KO'RISH</x:String>
  <x:String x:Key="marketplace.themeSettingsButton">Mavzu sozlamalari</x:String>
  <x:String x:Key="marketplace.themeFactoryReset">Zavod sozlamalariga qaytarish</x:String>
  <x:String x:Key="marketplace.fontTitle">Shrift</x:String>
  <x:String x:Key="marketplace.fontSize">O'lcham</x:String>
  <x:String x:Key="marketplace.fontColor">Matn rangi</x:String>
  <x:String x:Key="marketplace.editorPriceLabel">Pullik muharrir — 1500 so'm</x:String>
  <x:String x:Key="marketplace.serialTitle">Mavzuni faollashtirish</x:String>
  <x:String x:Key="marketplace.serialActivate">Faollashtirish</x:String>
  <x:String x:Key="marketplace.installedBadge">O'rnatilgan</x:String>
  <x:String x:Key="marketplace.installButton">O'rnatish</x:String>
  <x:String x:Key="marketplace.extrasIntro">Kassa uchun qo'shimcha modullar. Biz ularni asta-sekin qo'shmoqdamiz — ro'yxat kengayib boradi.</x:String>
  <x:String x:Key="marketplace.comingSoonBadge">Tez orada</x:String>
  <x:String x:Key="marketplace.extra1Title">Sodiqlik dasturi</x:String>
  <x:String x:Key="marketplace.extra1Desc">Doimiy mijozlar uchun bonus ballar va chegirmalar</x:String>
  <x:String x:Key="marketplace.extra2Title">Mijozlarga SMS xabarnomalar</x:String>
  <x:String x:Key="marketplace.extra2Desc">Buyurtma holati va aksiyalar haqida avtomatik xabarnomalar</x:String>
  <x:String x:Key="marketplace.extra3Title">Xodimlar hisobi</x:String>
  <x:String x:Key="marketplace.extra3Desc">Tabel, smenalar va xodimlarni rag'batlantirish</x:String>
  <x:String x:Key="marketplace.extra4Title">Kengaytirilgan analitika</x:String>
  <x:String x:Key="marketplace.extra4Desc">Sotuv bashoratlari va xarid tavsiyalari</x:String>

  <!-- Sozlamalar: Ekran bo'limi -->
  <x:String x:Key="posSettings.screen.title">Ekran va interfeys</x:String>
  <x:String x:Key="posSettings.screen.subtitle">Kassa ko'rinishi, oyna rejimi va do'kon ma'lumotlari</x:String>
  <x:String x:Key="posSettings.screen.behaviorTitle">Dasturning ishlash tartibi</x:String>
  <x:String x:Key="posSettings.screen.groupDisplay">Ekran va ishga tushirish</x:String>
  <x:String x:Key="posSettings.screen.groupPerformance">Unumdorlik</x:String>
  <x:String x:Key="posSettings.screen.groupCashierLang">Kassa va til</x:String>
  <x:String x:Key="posSettings.screen.groupScaleLayout">Masshtab va joylashuv</x:String>
  <x:String x:Key="posSettings.screen.fullscreen">To'liq ekran rejimi</x:String>
  <x:String x:Key="posSettings.screen.trueFullscreen">Haqiqiy to'liq ekran rejimi</x:String>
  <x:String x:Key="posSettings.screen.trueFullscreenDesc">Windows vazifalar panelini butunlay yashiradi. Faqat to'liq ekran rejimi bilan birga ishlaydi.</x:String>
  <x:String x:Key="posSettings.screen.autostart">Windows bilan birga ishga tushirish</x:String>
  <x:String x:Key="posSettings.screen.lowPerfMode">Zaif qurilma rejimi</x:String>
  <x:String x:Key="posSettings.screen.lowPerfModeDesc">Videokarta o'rniga dasturiy render — eski monobloklar va kuchsiz noutbuklar uchun. Kassani qayta ishga tushirish talab qilinadi.</x:String>
  <x:String x:Key="posSettings.screen.voiceControl">Ovozli boshqaruv</x:String>
  <x:String x:Key="posSettings.screen.voiceControlDesc">"Kassa" deb, so'ng mahsulot nomi va miqdorini ayting — kassa uni o'zi topib, chekka qo'shadi. Oflayn ishlaydi, mikrofonni doimiy tinglaydi.</x:String>
  <x:String x:Key="posSettings.screen.voiceControlTest">Ovozni sinash</x:String>
  <x:String x:Key="posSettings.screen.voiceControlMovedDesc">Endi bu pullik qo'shimcha xizmat — asosiy kassani og'irlashtirmaslik uchun alohida faollashtiriladi va yuklab olinadi (~113 MB).</x:String>
