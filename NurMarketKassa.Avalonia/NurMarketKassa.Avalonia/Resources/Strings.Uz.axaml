  <x:String x:Key="onecLayout.lineDiscountButton">Pozitsiyaga chegirma</x:String>
    <!-- 2026-09-26: надписи, которые раньше были зашиты по-русски -->
    <x:String x:Key="loc.kassa.addBank.pickPlaceholder">Ro'yxatdan bankni tanlang</x:String>
    <x:String x:Key="loc.kassa.addBank.orTypeName">yoki bank nomini o'zingiz yozing</x:String>
    <x:String x:Key="loc.kassa.transfer.weightWatermark">0, kg</x:String>
    <x:String x:Key="loc.kassa.weigh.quick01">0,1 kg</x:String>
    <x:String x:Key="loc.kassa.weigh.quick05">0,5 kg</x:String>
    <x:String x:Key="loc.kassa.weigh.quick1">1 kg</x:String>
    <x:String x:Key="loc.kassa.weigh.quick2">2 kg</x:String>
    <x:String x:Key="loc.kassa.weigh.quick5">5 kg</x:String>
    <x:String x:Key="loc.owner.shift.writeOffs">Hisobdan chiqarishlar</x:String>
    <x:String x:Key="loc.owner.shift.debtPayments">Qarz to'lovlari</x:String>
    <x:String x:Key="loc.owner.shift.cashDrawerTitle">Smenadagi pul qutisi</x:String>
    <x:String x:Key="loc.owner.shift.deposits">Kirimlar</x:String>
    <x:String x:Key="loc.owner.shift.withdrawalsExpense">Chiqimlar (xarajat)</x:String>
    <x:String x:Key="loc.owner.shift.reportTitle">Smena hisoboti</x:String>
    <x:String x:Key="loc.owner.irregular.retry">Qayta yuborish</x:String>
    <x:String x:Key="loc.owner.scales.exportCsv">CSV'ga eksport</x:String>
    <x:String x:Key="loc.owner.scales.brandAi">AI tarozi</x:String>
    <x:String x:Key="loc.owner.scales.sequentialPlu">Tarozi tugmalariga moslab raqamlash</x:String>
    <x:String x:Key="loc.owner.scales.sequentialPluTip">Tarozi panelidagi tugmalar PLUni uning RAQAMI bo'yicha chaqiradi: 1-tugma — PLU 1, 2-tugma — PLU 2 va hokazo. Agar mahsulotni o'z raqami bilan yozsangiz (masalan, 10007), uni hech bir tugma topa olmaydi. Bu belgi qo'yilganda mahsulotlar ko'rsatilgan raqamdan boshlab ketma-ket raqam oladi, quyidagi ro'yxat tartibi esa tugmalar tartibidir.</x:String>
    <x:String x:Key="loc.owner.scales.directLan">To'g'ridan-to'g'ri kabel orqali</x:String>
    <x:String x:Key="loc.owner.scales.directLanTip">Kassa tarozi bilan lokal tarmoq orqali serversiz o'zi bog'lanadi. Haqiqiy tarozilarda sinovdan o'tkazilmagan — portni tarozining tizim menyusida tekshiring.</x:String>
    <x:String x:Key="loc.owner.scales.lanSettings">Ulanish sozlamalari…</x:String>
    <x:String x:Key="loc.owner.scales.lanSettingsTip">Tarozi manzili, porti va paroli — alohida oynada, aloqani tekshirish ham o'sha yerda.</x:String>
    <x:String x:Key="loc.owner.tgSetup.title">Telegram-botni ulash</x:String>
    <x:String x:Key="loc.owner.tgSetup.intro">Bot sizga yopilgan smena bo'yicha hisobot yuboradi va buyruqlarga javob beradi: tushum, top mahsulotlar, nimani buyurtma qilish kerakligi, qarzdorlar. Do'kondan ishlaydi: o'z serveringiz ham, statik IP manzil ham kerak emas.</x:String>
    <x:String x:Key="loc.owner.tgSetup.warning">Botning o'zini kassa emas, Telegram yaratadi: BotFather'da dasturlar uchun interfeys yo'q, shuning uchun 1-qadam Telegram'da qo'lda bajariladi. Qolgan hammasini kassa siz uchun o'zi bajaradi.</x:String>
    <x:String x:Key="loc.owner.tgSetup.step1">1-qadam. @BotFather orqali bot yarating</x:String>
    <x:String x:Key="loc.owner.tgSetup.step1Body">«BotFather'ni ochish» tugmasini bosing — Telegram'da chat ochiladi. U yerda /newbot buyrug'ini yuboring, bot nomi va foydalanuvchi nomini o'ylab toping (u «bot» bilan tugashi kerak). Javob sifatida BotFather token yuboradi — 123456789:AAG... ko'rinishidagi uzun qator.</x:String>
    <x:String x:Key="loc.owner.tgSetup.openBotFather">BotFather'ni ochish</x:String>
    <x:String x:Key="loc.owner.tgSetup.copyNewBot">/newbot'ni nusxalash</x:String>
    <x:String x:Key="loc.owner.tgSetup.step2">2-qadam. Tokenni qo'ying</x:String>
    <x:String x:Key="loc.owner.tgSetup.step2Body">Tokenni BotFather bilan chatdan nusxalab, bu yerga to'liq qo'ying. Kassa uni tekshiradi va bot nomini ko'rsatadi.</x:String>
    <x:String x:Key="loc.owner.tgSetup.checkToken">Tokenni tekshirish</x:String>
    <x:String x:Key="loc.owner.tgSetup.pasteToken">Buferdan qo'yish</x:String>
    <x:String x:Key="loc.owner.tgSetup.step3">3-qadam. Botingizga «Start» deb yozing</x:String>
    <x:String x:Key="loc.owner.tgSetup.step3Body">Telegram botga birinchi bo'lib yozishga ruxsat bermaydi — avval botingizni ochib, «Start» tugmasini bosishingiz kerak. Shundan so'ng kassa hisobotlarni qaysi chatga yuborishni bilib oladi.</x:String>
    <x:String x:Key="loc.owner.tgSetup.openMyBot">Botimni ochish</x:String>
    <x:String x:Key="loc.owner.tgSetup.detect">Qabul qiluvchini aniqlash</x:String>
    <x:String x:Key="loc.owner.tgSetup.step4">4-qadam. Tekshiring va yoqing</x:String>
    <x:String x:Key="loc.owner.tgSetup.sendTest">Sinov xabarini yuborish</x:String>
    <x:String x:Key="loc.owner.tgSetup.summaryOnClose">Smena yopilganda hisobot yuborish</x:String>
    <x:String x:Key="loc.owner.tgSetup.answerCommands">Telegram'dagi buyruqlarga javob berish</x:String>
    <x:String x:Key="loc.owner.tgSetup.commandsHelp">Buyruqlar: /segodnya — bugungi tushum, /nedelya — haftalik tushum, /top — top mahsulotlar, /abc — ABC-tahlil, /sezon — mavsumiylik, /soveti — tavsiyalar, /zakaz — nimani buyurtma qilish kerak, /ostatki — nima tugayapti, /dolgi — qarzdorlar. Kassa yoqilgan paytda bot javob beradi.</x:String>
    <x:String x:Key="loc.owner.tgSetup.done">Tayyor</x:String>
    <x:String x:Key="loc.owner.sales.excelTip">Tanlangan davr uchun sotuv va ombor tahlilini grafiklar bilan Excel'ga eksport qilish.</x:String>
    <x:String x:Key="loc.owner.sales.wordTip">Xuddi shu hisobotni Word'ga eksport qilish — jadvallar va grafiklar bilan.</x:String>
    <x:String x:Key="loc.owner.sales.metricsTab">Ko'rsatkichlar</x:String>
    <x:String x:Key="loc.owner.finance.excelTip">Tanlangan davr tahlilini grafiklar va ABC-tahlil bilan Excel'ga eksport qilish.</x:String>
    <x:String x:Key="loc.owner.finance.wordTip">Xuddi shu hisobot Word'da — jadvallar, grafiklar va ABC-tahlil.</x:String>
    <x:String x:Key="loc.owner.finance.expenses">Xarajatlar (chiqimlar)</x:String>
    <x:String x:Key="loc.owner.finance.profitAfterExpenses">Xarajatlar chegirilgandan keyingi foyda</x:String>
    <x:String x:Key="loc.owner.zeroMoney">0,00 so'm</x:String>
    <x:String x:Key="loc.owner.voice.title">Ovozli boshqaruvni tekshirish</x:String>
    <x:String x:Key="loc.owner.voice.howTo">Qanday foydalanish kerak</x:String>
    <x:String x:Key="loc.owner.voice.howToBody">Doim «касса» kalit so'zidan boshlang, keyin darhol buyruqni ayting — mikrofon doimiy tinglaydi, alohida tugma bosish shart emas.</x:String>
    <x:String x:Key="loc.owner.voice.exRu1">• «касса картошка два килограмма» — chekka 2 kg kartoshka qo'shadi</x:String>
    <x:String x:Key="loc.owner.voice.exRu2">• «касса молоко» — 1 dona sut qo'shadi (son aytilmasa — 1)</x:String>
    <x:String x:Key="loc.owner.voice.exRu3">• «касса манго 20 штук» — mahsulotning dona narxi bo'lsa, so'ramasdan darhol donalab qo'shadi</x:String>
    <x:String x:Key="loc.owner.voice.exRu4">• «касса манго 2 пачки» — darhol butun pachkalab qo'shadi; «штук»/«пачки» demasdan faqat son aytsangiz — qayta so'raydi</x:String>
    <x:String x:Key="loc.owner.voice.exRu5">• «касса найди сахар» — mahsulotni topib ko'rsatadi, qo'shmaydi</x:String>
    <x:String x:Key="loc.owner.voice.exRu6">• «касса убери последнюю» — oxirgi qo'shilgan pozitsiyani o'chiradi (tasdiq so'raydi)</x:String>
    <x:String x:Key="loc.owner.voice.exRu7">• «касса очисти чек» — butun chekni tozalaydi (tasdiq so'raydi)</x:String>
    <x:String x:Key="loc.owner.voice.exRu8">• «касса повтори» — oxirgi qo'shilgan mahsulotni yana qo'shadi</x:String>
    <x:String x:Key="loc.owner.voice.exRu9">• «касса оплата» — chekni to'lashga o'tadi</x:String>
    <x:String x:Key="loc.owner.voice.exRu10">• «касса отмена» — joriy amalni bekor qiladi</x:String>
    <x:String x:Key="loc.owner.voice.kyHeader">Qirg'izcha buyruqlar (Кыргызча буйруктар)</x:String>
    <x:String x:Key="loc.owner.voice.kyNote">Til qirg'izcha qilib qo'yilsa (Sozlamalar → Ekran), qirg'izcha buyruqlar yaxshiroq taniladi — bunda kassa qirg'iz tiliga o'rgatilgan modeldan foydalanadi.</x:String>
    <x:String x:Key="loc.owner.voice.exKy1">• «касса нан эки даана» — chekka 2 dona non qo'shadi</x:String>
    <x:String x:Key="loc.owner.voice.exKy2">• «касса сүт» — 1 dona sut qo'shadi (son aytilmasa — 1)</x:String>
    <x:String x:Key="loc.owner.voice.exKy3">• «касса кант тап» — mahsulotni topib ko'rsatadi, qo'shmaydi</x:String>
    <x:String x:Key="loc.owner.voice.exKy4">• «касса акыркысын өчүр» — oxirgi qo'shilgan mahsulotni o'chiradi (tasdiq so'raydi)</x:String>
    <x:String x:Key="loc.owner.voice.exKy5">• «касса чекти тазала» — butun chekni tozalaydi (tasdiq so'raydi)</x:String>
    <x:String x:Key="loc.owner.voice.exKy6">• «касса кайтала» — oxirgi qo'shilgan mahsulotni takrorlaydi</x:String>
    <x:String x:Key="loc.owner.voice.exKy7">• «касса төлө» — chekni to'lashga o'tadi</x:String>
    <x:String x:Key="loc.owner.voice.exKy8">• «касса жокко чыгар» — joriy amalni bekor qiladi</x:String>
    <x:String x:Key="loc.owner.voice.notHeard">Noto'g'ri eshitdimi? Iborani quyidagi «Matnni mikrofonsiz tekshirish» maydonida sinab ko'ring — dastur uni qanday tahlil qilishini mikrofonsiz va chekka haqiqatda qo'shmasdan ko'rasiz.</x:String>
    <x:String x:Key="loc.owner.voice.manualTitle">Matnni mikrofonsiz tekshirish</x:String>
    <x:String x:Key="loc.owner.voice.manualHint">Iborani mikrofon uni allaqachon tanigandek yozing («касса» so'zi bilan yoki usiz) — dastur uni qanday tahlil qilishini ko'rasiz.</x:String>
    <x:String x:Key="loc.owner.voice.parse">Tahlil qilish</x:String>
    <x:String x:Key="loc.owner.voice.lockTitle">Ovozli qulf</x:String>
    <x:String x:Key="loc.owner.voice.lockBody">Kassir ovozini yozib oladi — keyin har bir ovozli buyruq u bilan solishtiriladi. Ovoz mos kelmasa, buyruq BAJARILMAYDI va ogohlantirish chiqadi (ovozli ham). Bu parol emas: shamollash, shovqin yoki boshqa mikrofon tufayli ovoz ba'zan yanglishib mos kelmay qolishi mumkin — unda buyruqni takrorlang yoki sichqoncha/klaviaturadan foydalaning.</x:String>
    <x:String x:Key="loc.owner.voice.download">Modulni yuklab olish (~27 MB)</x:String>
    <x:String x:Key="loc.owner.voice.enroll">🎙 Ovozni yozib olish (3 ibora)</x:String>
    <x:String x:Key="loc.owner.voice.lockOn">Qulf yoqilgan</x:String>
    <x:String x:Key="loc.owner.voice.unitsTitle">O'lchov birliklari lug'ati</x:String>
    <x:String x:Key="loc.owner.voice.unitsBody">Rus va qirg'iz birliklari o'rnatilgan (кг, л, шт, даана, бөтөлкө va h.k.) — do'konda boshqalari ishlatilsa, bu yerda o'zingiznikini qo'shishingiz mumkin (masalan, «мешок», «ящик»). So'z — kassir ovoz chiqarib AYTADIGAN narsa; qisqartma — faqat ro'yxatda ko'rsatish uchun.</x:String>
    <x:String x:Key="loc.owner.voice.unitWordHint">So'z, masalan: мешок</x:String>
    <x:String x:Key="loc.owner.voice.unitAbbrHint">qisqartma, masalan: меш</x:String>
    <x:String x:Key="loc.owner.voice.aliasTitle">Mahsulot nomlarini o'rgatish</x:String>
    <x:String x:Key="loc.owner.voice.aliasBody">Agar nutqni tanish mahsulot nomini doimiy ravishda tushunmasa (yoki kassirlar uni kartochkada yo'q so'zlashuv so'zi bilan atasa) — mahsulotga bir vaqtning o'zida BIR NECHTA ibora bog'lang (kamida 3 ta bo'lgani yaxshi): nomning eshitilish variantlari qancha ko'p bo'lsa, tanish shunchalik ishonchli bo'ladi. Har bir qatorga bitta ibora — kassir «касса» so'zidan keyin AYTADIGAN narsa (miqdor/birliksiz), masalan «кола» / «кокакола» / «чёрный напиток».</x:String>
    <x:String x:Key="loc.owner.voice.aliasProductHint">Mahsulot: nomini yoza boshlang…</x:String>
    <x:String x:Key="loc.owner.voice.aliasAdd">Iboralarni qo'shish</x:String>
    <x:String x:Key="loc.owner.voice.heardLive">Eshitilgan (jonli)</x:String>
    <x:String x:Key="loc.owner.voice.recognized">Tanilgan buyruqlar</x:String>
    <x:String x:Key="loc.settings.monitor.samplePositions">2 pozitsiya</x:String>
    <x:String x:Key="loc.settings.monitor.sampleQty2">×2 dona</x:String>
    <x:String x:Key="loc.settings.monitor.sampleSum320">320.00 so'm</x:String>
    <x:String x:Key="loc.settings.monitor.sampleQty1">×1 dona</x:String>
    <x:String x:Key="loc.settings.monitor.sampleSum95">95.00 so'm</x:String>
    <x:String x:Key="loc.settings.telegram.title">Do'kon egasining Telegram boti</x:String>
    <x:String x:Key="loc.settings.telegram.desc">Yopilgan smena bo'yicha hisobot sizga Telegram'da keladi: tushum, cheklar, o'rtacha chek, naqd va naqdsiz to'lovlar, kirim va chiqim, kamomad yoki ortiqcha. Do'kondan turib ishlaydi — statik IP ham, o'z serveringiz ham kerak emas.</x:String>
    <x:String x:Key="loc.settings.telegram.wizardButton">Botni ulash (bosqichma-bosqich)</x:String>
    <x:String x:Key="loc.settings.telegram.manualHint">Qo'lda ulash: 1) Telegram'da @BotFather'ga /newbot buyrug'ini yozing va token oling; 2) tokenni shu yerga qo'ying; 3) o'z botingizni oching va «Start» tugmasini bosing; 4) «Qabul qiluvchini aniqlash» tugmasini bosing.</x:String>
    <x:String x:Key="loc.settings.telegram.tokenLabel">Bot tokeni</x:String>
    <x:String x:Key="loc.settings.telegram.detectRecipient">Qabul qiluvchini aniqlash</x:String>
    <x:String x:Key="loc.settings.telegram.sendTest">Sinov xabarini yuborish</x:String>
    <x:String x:Key="loc.settings.telegram.summaryOnClose">Smena yopilganda hisobot yuborish</x:String>
    <x:String x:Key="loc.settings.telegram.answerCommands">Telegram'dagi buyruqlarga javob berish</x:String>
    <x:String x:Key="loc.settings.telegram.commandsHelp">Bot buyruqlari: /segodnya — bugungi tushum, /nedelya — haftalik tushum, /top — top mahsulotlar, /abc — ABC-tahlil, /sezon — mavsumiylik, /soveti — tavsiyalar, /zakaz — nimani buyurtma qilish kerak, /ostatki — nima tugayapti, /dolgi — tayyor WhatsApp havolasi bilan qarzdorlar. Bot faqat kassa yoniq bo'lganda javob beradi: dasturning o'z serveri yo'q.</x:String>
    <x:String x:Key="loc.settings.telegram.debtReminders">Qarz haqida eslatmalarni yuborish</x:String>
    <x:String x:Key="loc.settings.telegram.debtRemindersHint">Eslatma Telegram'da faqat botga shaxsiy havola orqali o'zi obuna bo'lgan xaridorlarga boradi (mijoz kartasidagi «Havolani nusxalash» tugmasi). Telegram odamga telefon raqami orqali yozishga ruxsat bermaydi — qolgan qarzdorlar uchun bot sizga WhatsApp havolalari bilan ro'yxat yuboradi.</x:String>
    <x:String x:Key="loc.settings.telegram.ownerPhone">Do'kon egasining telefoni (mijozlarga yuboriladigan xabarlarda aloqa uchun)</x:String>
    <x:String x:Key="loc.settings.dynamicQr.toggle">Xaridorga chek summasi kiritilgan QR-kodni ko'rsatish</x:String>
    <x:String x:Key="loc.settings.dynamicQr.desc">Xaridor ekranida bankning oddiy QR-kodi o'rniga chek summasi allaqachon kiritilgan kod ko'rsatiladi — summani qo'lda terish shart emas. Rekvizitlar yuqorida yuklangan QR-koddan olinadi.</x:String>
    <x:String x:Key="loc.settings.dynamicQr.warning">Yoqishdan oldin sinov chekini ikki-uch bankning ilovasi bilan skanerlab ko'ring: format MBank QR-kodi bilan solishtirilgan, boshqa banklarda tekshirilmagan. To'lovni kassir avvalgidek qo'lda tasdiqlaydi — kassa to'lov haqida o'zi bilmaydi.</x:String>
    <x:String x:Key="loc.settings.bank.showAtCheckout">To'lovda ko'rsatish</x:String>
    <x:String x:Key="loc.settings.lanScale.title">Tarmoq tarozisi (mahsulotlarni yuklash)</x:String>
    <x:String x:Key="loc.settings.lanScale.desc">Manzil, port va parol tarozining o'z tizim menyusidan olinadi. «Tarozi» oynasi ham mahsulotlar ro'yxatini yuklashda aynan shu qiymatlardan foydalanadi.</x:String>
    <x:String x:Key="loc.settings.lanScale.ip">Tarozi IP manzili</x:String>
    <x:String x:Key="loc.settings.lanScale.port">Port</x:String>
    <x:String x:Key="loc.settings.lanScale.passwordHint">Parol — aniq 4 ta raqam, odatda 0030. Agar u noto'g'ri bo'lsa, tarozi bir necha urinishdan keyin kirishni bloklaydi: unda tarozini o'chirib-yoqing va to'g'ri parolni kiriting. Port odatda 1111.</x:String>
    <x:String x:Key="loc.settings.lanScale.openDialog">Ulanish sozlamalari oynasini ochish…</x:String>
    <x:String x:Key="loc.settings.lanScale.test">Tarozi bilan aloqani tekshirish</x:String>
    <!-- 2026-09-28: окно «Настройки весов Штрих-ПРИНТ» и штрих-код этикетки весов. -->
    <x:String x:Key="loc.settings.lanScale.deviceSettings">Tarozi sozlamalari (klaviatura, yorliq, shtrix-kod)…</x:String>
    <x:String x:Key="loc.settings.shtrikhSettings.title">ShTRIX-PRINT tarozi sozlamalari</x:String>
    <x:String x:Key="loc.owner.scales.barcodeSettings">Yorliq shtrix-kodi…</x:String>
    <x:String x:Key="loc.owner.scales.colBarcodeCode">ShKdagi kod</x:String>
    <x:String x:Key="loc.settings.scale.aiScales">AI tarozi</x:String>
    <x:String x:Key="loc.settings.scaleConn.title">Tarozini ulash</x:String>
    <x:String x:Key="loc.settings.scaleConn.desc">Kassa tarozi bilan serversiz, to'g'ridan-to'g'ri lokal tarmoq orqali bog'lanadi. Manzil, port va parolni tarozining o'z tizim menyusidan oling.</x:String>
    <x:String x:Key="loc.settings.scaleConn.password4">Parol (4 ta raqam)</x:String>
    <x:String x:Key="loc.settings.scaleConn.hint">Port odatda 1111, parol — 0030. Parol noto'g'ri bo'lsa, tarozi bir necha urinishdan keyin kirishni bloklaydi: unda uni o'chirib-yoqing va to'g'ri parolni kiriting.</x:String>
    <x:String x:Key="loc.settings.scaleConn.test">Aloqani tekshirish</x:String>
  <!-- История чеков и печать копии (2026-09-27) -->
  <x:String x:Key="csh.menu.receiptHistory">Cheklar tarixi</x:String>
  <x:String x:Key="receiptHistory.subtitle">Shu kassaning cheklari. Chekni bosing — o'ng tomonda uning tarkibi chiqadi, nusxasini o'sha yerdan chop etish mumkin.</x:String>
  <x:String x:Key="receiptHistory.periodShift">Shu smena</x:String>
  <x:String x:Key="receiptHistory.searchWatermark">Chek raqami yoki mahsulot…</x:String>
  <x:String x:Key="receiptHistory.empty">Bu davrda cheklar yo'q.</x:String>
  <x:String x:Key="receiptHistory.noMatch">So'rov bo'yicha hech narsa topilmadi.</x:String>
  <x:String x:Key="receiptHistory.selectHint">Chap tomondagi ro'yxatdan chekni tanlang — uning tarkibi shu yerda ko'rinadi.</x:String>
  <x:String x:Key="receiptHistory.itemsHeader">Chek tarkibi</x:String>
  <x:String x:Key="receiptHistory.printCopy">Nusxasini chop etish</x:String>
