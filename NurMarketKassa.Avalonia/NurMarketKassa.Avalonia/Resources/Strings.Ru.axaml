  <x:String x:Key="scalesPlu.empty">Весовых товаров не найдено.</x:String>
  <x:String x:Key="scalesPlu.sendButton">Отправить на весы</x:String>
  <x:String x:Key="posSettings.scale.poleDisplayPort">Устройство (COM/USB)</x:String>
