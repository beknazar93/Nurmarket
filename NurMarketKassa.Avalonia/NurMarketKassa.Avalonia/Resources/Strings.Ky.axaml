  <x:String x:Key="scalesPlu.brandShtrikh">Штрих-М</x:String>
  <x:String x:Key="scalesPlu.brandRongta">Rongta</x:String>
  <x:String x:Key="scalesPlu.rongtaSourceSite">Сайт аркылуу (.txp)</x:String>
