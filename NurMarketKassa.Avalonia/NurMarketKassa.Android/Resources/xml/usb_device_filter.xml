<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-04: USB-устройства, при подключении которых Android предлагает открыть кассу и сразу
     выдаёт ей доступ — принтеры (класс 7). Остальные USB-принтеры (класс 255, «vendor specific»)
     запрашивают доступ окном Android при первой печати. -->
<resources>
  <usb-device class="7" />
</resources>
