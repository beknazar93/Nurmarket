<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Settings"
             xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Resources>
    <conv:AssetPathToBitmapConverter x:Key="AssetPathToBitmap"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>

    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>

    <Style Selector="Button.btn-secondary">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost" Padding="16">
    <ScrollViewer Classes="SettingsPageScroll">
      <!-- Центрирующий контейнер -->
      <StackPanel Classes="SettingsCardList" Spacing="10" MaxWidth="680" HorizontalAlignment="Center">

        <!-- Хедер по центру -->
        <Border Classes="SettingsHeaderCard" Padding="12">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource BrushAccentSoft}"
                    BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
              <TextBlock Text="🎨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Кастомизация" Classes="SettingsPageTitle" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Внешний вид, фоновое изображение и прозрачность интерфейса" Classes="SettingsPageSubtitle" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Единый блок кастомизации -->
        <Border Classes="SettingsCard" Padding="14">
          <StackPanel Spacing="12">
            <!-- Секция 1: Обои -->
            <StackPanel Spacing="6">
              <TextBlock Text="Фоновые обои" Classes="SettingsCardTitle" FontSize="14"/>
              <TextBlock Text="Выберите изображение (PNG, JPG, JPEG, WEBP). Изменения применяются сразу."
                         Classes="SettingsCardBody" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>

              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <Button Classes="btn-primary"
                        Content="🖼️ Выбрать изображение"
                        Command="{Binding PickBackgroundCommand}"
                        Height="36" Padding="14,6"/>
                <Button Classes="btn-secondary"
                        Content="🗑️ Сбросить"
                        Command="{Binding ClearBackgroundCommand}"
                        IsEnabled="{Binding HasBackgroundImage}"
                        Height="36" Padding="14,6"/>
              </StackPanel>

              <TextBlock Text="{Binding BackgroundImagePath}"
                         FontSize="11" Foreground="{DynamicResource BrushTextSoft}"
                         TextWrapping="Wrap" Margin="0,2,0,0"
                         IsVisible="{Binding HasBackgroundImage}"/>
            </StackPanel>

            <Separator Background="{DynamicResource BrushPanelSoft}" Height="1" Margin="0,2"/>

            <!-- Секция 2: Прозрачность подложки -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Прозрачность подложки" Classes="SettingsCardTitle" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding BackgroundOpacityPercent}"
                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
              </Grid>

              <TextBlock Text="От 5% до 80%. Чем выше значение, тем плотнее белая подложка поверх обоев."
                         Classes="SettingsCardBody" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>

              <Slider Minimum="0.05"
                      Maximum="0.8"
                      Value="{Binding BackgroundOpacity}"
                      TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      Margin="0,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Кнопки действия снизу (по центру) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,6,0,0">
          <Button Content="Сохранить"
                  Classes="btn-primary"
                  Width="130" Height="38"
                  Click="Save_Click"/>
          <Button Content="Закрыть"
                  Classes="btn-secondary"
                  Width="110" Height="38"
                  Click="Close_Click"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>