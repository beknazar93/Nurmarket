<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.PrintSettingsView"
             x:CompileBindings="False"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>

    <Style Selector="RadioButton.PrintModePill">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.PrintModePill:checked">
      <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.PrintGoldButton">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.PrintGoldButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost" Padding="16">
    <ScrollViewer Classes="SettingsPageScroll">
      <!-- Центрирующий контейнер -->
      <StackPanel Classes="SettingsCardList" Spacing="10" MaxWidth="680" HorizontalAlignment="Center">

        <!-- Хедер по центру -->
        <Border Classes="SettingsHeaderCard" Padding="12">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
              <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource BrushWarningSoft}"
                      BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1">
                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Печать чеков" Classes="SettingsPageTitle" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Параметры принтера, порты и режимы вывода" Classes="SettingsPageSubtitle" FontSize="12" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>

            <!-- Главный переключатель печати -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,2,0,0">
              <TextBlock Text="Печатать чек после оплаты" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}"/>
              <CheckBox x:Name="ReceiptEnabledCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Единый блок оборудования -->
        <Border Classes="SettingsCard" Padding="14">
          <StackPanel Spacing="12">
            <TextBlock Text="Оборудование и подключение" Classes="SettingsCardTitle" FontSize="14"/>

            <!-- Строка 1: Порт LPT и Повторы -->
            <Grid ColumnDefinitions="*,16,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="LPT-порт или путь к принтеру" Classes="FieldLabel"/>
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBox Grid.Column="0" x:Name="ReceiptLptBox" x:FieldModifier="public" Classes="ModernTextBox" Height="36"/>
                  <Button Grid.Column="2" x:Name="BtnPhysicalPrint" x:FieldModifier="public"
                          Content="🖨️ Тест" Classes="PrintGoldButton"/>
                </Grid>
                <TextBlock x:Name="StatusPortText" x:FieldModifier="public"
                           Text="○ LPT не найден в системе" FontSize="11" Foreground="{DynamicResource BrushDanger}"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Повторы печати при сбое" Classes="FieldLabel"/>
                <TextBox x:Name="ReceiptRetryBox" x:FieldModifier="public" Classes="ModernTextBox" Height="36"/>
              </StackPanel>
            </Grid>

            <!-- Строка 2: Ширина ленты, Графика и Выбор режима -->
            <Grid ColumnDefinitions="*,12,*,12,1.2*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Ширина ленты" Classes="FieldLabel"/>
                <ComboBox x:Name="ReceiptPaperWidthCombo" x:FieldModifier="public" Classes="TouchComboBox" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="58 мм (32 симв.)" Tag="58"/>
                  <ComboBoxItem Content="80 мм (48 симв.)" Tag="80"/>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Графика (точки)" Classes="FieldLabel"/>
                <TextBox x:Name="GraphicWidthBox" x:FieldModifier="public" Text="384" Classes="ModernTextBox" Height="36" IsReadOnly="True"/>
              </StackPanel>

              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="Режим печати" Classes="FieldLabel"/>
                <Grid ColumnDefinitions="*,6,*">
                  <RadioButton Grid.Column="0" x:Name="TextModeRadio" x:FieldModifier="public"
                               Content="Текст" GroupName="PrintMode"
                               Classes="PrintModePill"
                               IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
                  <RadioButton Grid.Column="2" x:Name="GraphicModeRadio" x:FieldModifier="public"
                               Content="Графика" GroupName="PrintMode"
                               Classes="PrintModePill"
                               IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Блок 1: Настройки ESC/POS (когда выбран Текстовый режим) -->
        <Border Classes="SettingsCard" Padding="14" IsVisible="{Binding #TextModeRadio.IsChecked}">
          <StackPanel Spacing="12">
            <TextBlock Text="Параметры ESC/POS" Classes="SettingsCardTitle" FontSize="14"/>
            <Grid ColumnDefinitions="*,12,*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Кодировка" Classes="FieldLabel"/>
                <ComboBox x:Name="ReceiptEncCombo" x:FieldModifier="public" Classes="TouchComboBox" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="cp866" Tag="cp866"/>
                  <ComboBoxItem Content="cp1251" Tag="cp1251"/>
                  <ComboBoxItem Content="wpc1251" Tag="wpc1251"/>
                  <ComboBoxItem Content="iso-8859-5" Tag="iso-8859-5"/>
                  <ComboBoxItem Content="koi8-r" Tag="koi8-r"/>
                  <ComboBoxItem Content="utf-8" Tag="utf-8"/>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Таблица ESC t" Classes="FieldLabel"/>
                <ComboBox x:Name="ReceiptTableCombo" x:FieldModifier="public" Classes="TouchComboBox" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="Авто" Tag=""/>
                  <ComboBoxItem Content="17 — CP866" Tag="17"/>
                  <ComboBoxItem Content="46 — CP1251" Tag="46"/>
                  <ComboBoxItem Content="73" Tag="73"/>
                  <ComboBoxItem Content="26 — ISO" Tag="26"/>
                  <ComboBoxItem Content="53 — KOI8" Tag="53"/>
                  <ComboBoxItem Content="0 — UTF-8" Tag="0"/>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="ESC R (0–255)" Classes="FieldLabel"/>
                <TextBox x:Name="ReceiptEscRBox" x:FieldModifier="public" Classes="ModernTextBox" Height="36"/>
              </StackPanel>
            </Grid>

            <Button x:Name="TestTextPrintButton" x:FieldModifier="public"
                    Content="👁 Предпросмотр текстового чека"
                    Classes="SettingsFlatButton" HorizontalAlignment="Stretch" Height="36"/>
          </StackPanel>
        </Border>

        <!-- Блок 2: Настройки Графического чека (когда выбран Графический режим) -->
        <Border Classes="SettingsCard" Padding="14" IsVisible="{Binding #GraphicModeRadio.IsChecked}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Параметры графического макета" Classes="SettingsCardTitle" FontSize="14" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Включить макет" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                <CheckBox x:Name="GraphicReceiptEnabledCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
              </StackPanel>
            </Grid>

            <!-- Шрифт и Размер -->
            <Grid ColumnDefinitions="*,16,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Шрифт" Classes="FieldLabel"/>
                <ComboBox x:Name="GraphicFontCombo" x:FieldModifier="public" Classes="TouchComboBox" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                  <ComboBoxItem Content="Lucida Console" Tag="Lucida Console"/>
                  <ComboBoxItem Content="Courier New" Tag="Courier New"/>
                  <ComboBoxItem Content="Arial" Tag="Arial"/>
                  <ComboBoxItem Content="Tahoma" Tag="Tahoma"/>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Размер шрифта (px)" Classes="FieldLabel"/>
                <ComboBox x:Name="GraphicFontSizeCombo" x:FieldModifier="public" Classes="TouchComboBox" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="6" Tag="6"/><ComboBoxItem Content="8" Tag="8"/>
                  <ComboBoxItem Content="10" Tag="10"/><ComboBoxItem Content="12" Tag="12"/>
                  <ComboBoxItem Content="14" Tag="14"/><ComboBoxItem Content="16" Tag="16"/>
                  <ComboBoxItem Content="18" Tag="18"/><ComboBoxItem Content="20" Tag="20"/>
                  <ComboBoxItem Content="22" Tag="22"/><ComboBoxItem Content="24" Tag="24"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <!-- Элементы чека -->
            <TextBlock Text="Отображаемые элементы" Classes="FieldLabel" Margin="0,2,0,0"/>
            <Grid ColumnDefinitions="*,24,*">
              <StackPanel Grid.Column="0" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Название магазина" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <CheckBox Grid.Column="1" x:Name="ShowStoreNameCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Номер чека" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <CheckBox Grid.Column="1" x:Name="ShowReceiptNumberCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Список товаров" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <CheckBox Grid.Column="1" x:Name="ShowItemsCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="QR-код" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <CheckBox Grid.Column="1" x:Name="ShowQrCodeCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Адрес" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <CheckBox Grid.Column="1" x:Name="ShowAddressCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Дата и время" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <CheckBox Grid.Column="1" x:Name="ShowDateCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Итог (сумма)" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource BrushText}"/>
                  <CheckBox Grid.Column="1" x:Name="ShowTotalCheck" x:FieldModifier="public" Classes="ToggleSwitch"/>
                </Grid>
              </StackPanel>
            </Grid>

            <!-- QR и Предпросмотр -->
            <Grid ColumnDefinitions="Auto,8,Auto,*,Auto" Margin="0,4,0,0">
              <Button Grid.Column="0" x:Name="LoadGraphicQrButton" x:FieldModifier="public"
                      Content="📷 Загрузить QR" Classes="SettingsFlatButton" Height="34"/>
              <Button Grid.Column="2" x:Name="DeleteGraphicQrButton" x:FieldModifier="public"
                      Content="🗑️ Удалить" Classes="SettingsFlatButton" Height="34"/>
              <TextBlock Grid.Column="3" x:Name="GraphicQrStatusText" x:FieldModifier="public"
                         Text="QR-код не загружен" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"
                         VerticalAlignment="Center" Margin="8,0"/>
              <Button Grid.Column="4" x:Name="TestGraphicPrintButton" x:FieldModifier="public"
                      Content="👁 Предпросмотр" Classes="SettingsFlatButton" Height="34"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Статус печати -->
        <Border Classes="SettingsCard" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Text="Журнал и статус" Classes="SettingsCardTitle" FontSize="13"/>
            <TextBox x:Name="StatusText" x:FieldModifier="public"
                     Classes="ModernTextBox" Height="48"
                     IsReadOnly="True" TextWrapping="Wrap" FontSize="11"
                     Foreground="{DynamicResource BrushText}" Background="{DynamicResource BrushPanelSoft}"/>

            <Border x:Name="PrintErrorPanel" x:FieldModifier="public"
                    IsVisible="False" CornerRadius="6" Padding="8"
                    Background="{DynamicResource BrushDangerSoft}" BorderBrush="{DynamicResource BrushDanger}" BorderThickness="1">
              <StackPanel Spacing="4">
                <TextBlock Text="Подробности ошибки печати" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushDanger}"/>
                <TextBox x:Name="TxtPrintErrorDetails" x:FieldModifier="public"
                         IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11" MaxHeight="100"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushDanger}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Spacing="8" Margin="0,4,0,0" HorizontalAlignment="Stretch">
          <TextBlock x:Name="SaveStatusText" x:FieldModifier="public"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushSuccess}"
                     FontSize="12"/>
          <Button Content="Сохранить"
                  Classes="btn-primary"
                  MinWidth="150"
                  HorizontalAlignment="Center"
                  Click="Save_Click"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
