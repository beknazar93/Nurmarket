<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.MonitorSettingsView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>
    <Style Selector="RadioButton.LayoutOption">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="MinHeight" Value="92"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RadioButton.LayoutOption:checked">
      <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Classes="SettingsPageScroll">
        <StackPanel Classes="SettingsCardList">
          <Border Classes="SettingsHeaderCard">
            <Grid ColumnDefinitions="48,*">
              <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrushWarningSoft}">
                <Path Width="24" Height="24" Stretch="Uniform" Fill="Transparent"
                      Stroke="{DynamicResource BrushWarning}" StrokeThickness="1.6" StrokeLineCap="Round"
                      Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20 M17,7 H19 V11"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="SettingsPageTitle" Text="Монитор покупателя"/>
                <TextBlock Classes="SettingsPageSubtitle"
                           Text="Настройка второго экрана, состава данных и внешнего вида CustomerDisplayWindow"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="14">
              <TextBlock Classes="SettingsCardTitle" Text="Основные настройки"/>
              <CheckBox Classes="ToggleSwitch"
                        Content="Использовать монитор покупателя"
                        IsChecked="{Binding Settings.IsEnabled}"/>
              <CheckBox Content="Закреплять поверх окон на внешнем мониторе"
                        IsChecked="{Binding Settings.KeepCustomerDisplayOnTop}"/>
              <TextBlock Classes="SettingsCardBody"
                         Text="Окно автоматически открывается вместе с кассой. Предпросмотр доступен и при выключенном переключателе."/>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="14">
              <TextBlock Classes="SettingsCardTitle" Text="Устройство вывода"/>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="FieldLabel" Text="Монитор"/>
                  <ComboBox Classes="TouchComboBox" ItemsSource="{Binding Screens}"
                            SelectedItem="{Binding SelectedScreen}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Button Grid.Column="1" Classes="SettingsFlatButton" Content="Обновить"
                        VerticalAlignment="Bottom" Click="Refresh_Click"/>
              </Grid>
              <StackPanel>
                <TextBlock Classes="FieldLabel" Text="Режим окна"/>
                <ComboBox Classes="TouchComboBox" ItemsSource="{Binding WindowModes}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding Settings.WindowMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="14">
              <TextBlock Classes="SettingsCardTitle" Text="Вид товаров"/>
              <Grid ColumnDefinitions="*,*">
                <RadioButton Classes="LayoutOption" IsChecked="{Binding IsCardLayoutSelected}">
                  <StackPanel Spacing="5">
                    <TextBlock Text="▦  Карточный" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Крупные позиции с количеством и ценой"
                               Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="1" Classes="LayoutOption" IsChecked="{Binding IsTableLayoutSelected}">
                  <StackPanel Spacing="5">
                    <TextBlock Text="☷  Табличный" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Компактный список на всю ширину"
                               Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                  </StackPanel>
                </RadioButton>
              </Grid>

              <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsCardLayoutSelected}">
                <StackPanel>
                  <TextBlock Classes="FieldLabel" Text="Количество колонок"/>
                  <ComboBox Classes="TouchComboBox" ItemsSource="{Binding ColumnModes}"
                            SelectedValueBinding="{Binding Value}"
                            SelectedValue="{Binding Settings.CardColumns}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="FieldLabel" Text="Масштаб карточек"/>
                  <NumericUpDown Minimum="0.75" Maximum="1.5" Increment="0.05"
                                 Value="{Binding Settings.CardSize}" Height="42"/>
                </StackPanel>
              </Grid>
              <WrapPanel IsVisible="{Binding IsCardLayoutSelected}">
                <CheckBox Content="Изображение товара" IsChecked="{Binding Settings.ShowProductImage}" Margin="0,0,18,8"/>
                <CheckBox Content="Штрихкод" IsChecked="{Binding Settings.ShowBarcode}" Margin="0,0,18,8"/>
                <CheckBox Content="Скидка" IsChecked="{Binding Settings.ShowItemDiscount}" Margin="0,0,18,8"/>
                <CheckBox Content="Остаток" IsChecked="{Binding Settings.ShowStock}" Margin="0,0,18,8"/>
              </WrapPanel>

              <Grid IsVisible="{Binding IsTableLayoutSelected}" ColumnDefinitions="*,Auto">
                <ListBox x:Name="TableColumnsList" ItemsSource="{Binding TableColumns}" MinHeight="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Padding="6"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="1" Spacing="8">
                  <Button Classes="SettingsFlatButton" Content="Вверх" Click="ColumnUp_Click"/>
                  <Button Classes="SettingsFlatButton" Content="Вниз" Click="ColumnDown_Click"/>
                </StackPanel>
              </Grid>

              <TextBlock Classes="FieldLabel" Text="Живой мини-предпросмотр"/>
              <Border Height="190" CornerRadius="12" Padding="14"
                      Background="{Binding Settings.BackgroundColor}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="MARKET PLUS" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="2 поз."/>
                  </Grid>
                  <Grid Grid.Row="1" Margin="0,10">
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsCardLayoutSelected}">
                      <Border Background="{DynamicResource BrushPanel}" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                        <StackPanel>
                          <TextBlock Text="Кофе натуральный" FontWeight="SemiBold"/>
                          <TextBlock Text="×2 шт" Foreground="{DynamicResource BrushTextSoft}"/>
                          <TextBlock Text="320.00 сом" Foreground="{Binding Settings.AccentColor}"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="{DynamicResource BrushPanel}" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                        <StackPanel>
                          <TextBlock Text="Молоко 1 л" FontWeight="SemiBold"/>
                          <TextBlock Text="×1 шт" Foreground="{DynamicResource BrushTextSoft}"/>
                          <TextBlock Text="95.00 сом" Foreground="{Binding Settings.AccentColor}"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <StackPanel IsVisible="{Binding IsTableLayoutSelected}">
                      <Grid ColumnDefinitions="2*,*,*" Background="{DynamicResource BrushWarningSoft}">
                        <TextBlock Text="Товар" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Кол-во" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Сумма" FontWeight="SemiBold"/>
                      </Grid>
                      <Grid ColumnDefinitions="2*,*,*" Margin="0,8,0,0">
                        <TextBlock Text="Кофе натуральный"/>
                        <TextBlock Grid.Column="1" Text="2"/>
                        <TextBlock Grid.Column="2" Text="320.00"/>
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <TextBlock Grid.Row="2" Text="К оплате: 400.00 сом" FontWeight="Bold"
                             HorizontalAlignment="Right" Foreground="{Binding Settings.AccentColor}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="14">
              <TextBlock Classes="SettingsCardTitle" Text="Содержимое экрана"/>
              <WrapPanel>
                <CheckBox Content="Логотип компании" IsChecked="{Binding Settings.ShowCompanyLogo}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Название магазина" IsChecked="{Binding Settings.ShowStoreName}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Номер чека" IsChecked="{Binding Settings.ShowReceiptNumber}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Кассир" IsChecked="{Binding Settings.ShowCashier}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Дата и время" IsChecked="{Binding Settings.ShowDateTime}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Количество товаров" IsChecked="{Binding Settings.ShowItemCount}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Промежуточный итог" IsChecked="{Binding Settings.ShowSubtotal}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Скидка" IsChecked="{Binding Settings.ShowDiscount}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Итог к оплате" IsChecked="{Binding Settings.ShowTotal}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Способ оплаты" IsChecked="{Binding Settings.ShowPaymentMethod}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Внесённая сумма" IsChecked="{Binding Settings.ShowPaidAmount}" Width="220" Margin="0,0,8,10"/>
                <CheckBox Content="Сдача" IsChecked="{Binding Settings.ShowChange}" Width="220" Margin="0,0,8,10"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="12">
              <TextBlock Classes="SettingsCardTitle" Text="Пустое состояние"/>
              <TextBlock Classes="FieldLabel" Text="Заголовок"/>
              <TextBox Classes="ModernTextBox" Text="{Binding Settings.EmptyTitle}"/>
              <TextBlock Classes="FieldLabel" Text="Описание"/>
              <TextBox Classes="ModernTextBox" Text="{Binding Settings.EmptyDescription}"/>
              <CheckBox Content="Показывать логотип" IsChecked="{Binding Settings.ShowLogoInEmptyState}"/>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="12">
              <TextBlock Classes="SettingsCardTitle" Text="Рекламный блок"/>
              <CheckBox Classes="ToggleSwitch" Content="Показывать рекламный блок"
                        IsChecked="{Binding Settings.AdvertisementEnabled}"/>
              <Grid ColumnDefinitions="*,*">
                <StackPanel>
                  <TextBlock Classes="FieldLabel" Text="Заголовок"/>
                  <TextBox Classes="ModernTextBox" Text="{Binding Settings.AdvertisementTitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="FieldLabel" Text="Расположение"/>
                  <ComboBox Classes="TouchComboBox" ItemsSource="{Binding AdvertisementPositions}"
                            SelectedValueBinding="{Binding Value}"
                            SelectedValue="{Binding Settings.AdvertisementPosition}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBox Classes="ModernTextBox" Watermark="Описание акции"
                       Text="{Binding Settings.AdvertisementDescription}"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="ModernTextBox" IsReadOnly="True"
                         Text="{Binding Settings.AdvertisementImagePath}" Watermark="Изображение не выбрано"/>
                <Button Grid.Column="1" Classes="SettingsFlatButton" Content="Выбрать…" Click="PickAdImage_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="12">
              <TextBlock Classes="SettingsCardTitle" Text="Оформление"/>
              <Grid ColumnDefinitions="*,*">
                <StackPanel>
                  <TextBlock Classes="FieldLabel" Text="Тема"/>
                  <ComboBox Classes="TouchComboBox" ItemsSource="{Binding Themes}"
                            SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Settings.Theme}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="FieldLabel" Text="Масштаб интерфейса"/>
                  <NumericUpDown Minimum="0.75" Maximum="1.5" Increment="0.05"
                                 Value="{Binding Settings.Scale}" Height="42"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*">
                <StackPanel>
                  <TextBlock Classes="FieldLabel" Text="Акцентный цвет"/>
                  <TextBox Classes="ModernTextBox" Text="{Binding Settings.AccentColor}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="FieldLabel" Text="Цвет фона"/>
                  <TextBox Classes="ModernTextBox" Text="{Binding Settings.BackgroundColor}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="ModernTextBox" IsReadOnly="True"
                         Text="{Binding Settings.BackgroundImagePath}" Watermark="Фоновое изображение"/>
                <Button Grid.Column="1" Classes="SettingsFlatButton" Content="Выбрать фон…" Click="PickBackground_Click"/>
              </Grid>
              <Grid ColumnDefinitions="*,*">
                <StackPanel>
                  <TextBlock Classes="FieldLabel" Text="Скругление"/>
                  <NumericUpDown Minimum="0" Maximum="40" Value="{Binding Settings.CornerRadius}" Height="42"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="FieldLabel" Text="Затемнение фона"/>
                  <NumericUpDown Minimum="0" Maximum="0.9" Increment="0.05"
                                 Value="{Binding Settings.BackgroundOverlayOpacity}" Height="42"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="SettingsCard">
            <StackPanel Spacing="12">
              <TextBlock Classes="SettingsCardTitle" Text="После оплаты"/>
              <TextBlock Classes="FieldLabel" Text="Сообщение об успешной оплате"/>
              <TextBox Classes="ModernTextBox" Text="{Binding Settings.SuccessText}"/>
              <CheckBox Content="Показывать сдачу после оплаты" IsChecked="{Binding Settings.ShowChangeAfterPayment}"/>
              <StackPanel>
                <TextBlock Classes="FieldLabel" Text="Очистить экран через, сек."/>
                <NumericUpDown Minimum="0" Maximum="60" Value="{Binding Settings.ClearDelaySeconds}" Height="42"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,1,1,0"
              Padding="12" Margin="0,12,0,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <Button Classes="SettingsFlatButton" Content="Открыть" Click="OpenDisplay_Click"/>
          <Button Grid.Column="1" Classes="SettingsFlatButton" Content="Показать" Click="ShowDisplay_Click"/>
          <Button Grid.Column="2" Classes="SettingsFlatButton" Content="Закрыть" Click="CloseDisplay_Click"/>
          <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSoft}" TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="4" Height="42" Padding="22,0" Background="{DynamicResource BrushWarning}"
                  Foreground="{DynamicResource BrushText}" CornerRadius="10" Content="Сохранить" Click="Save_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
