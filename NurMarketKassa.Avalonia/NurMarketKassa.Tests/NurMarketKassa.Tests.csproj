<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NurMarketKassa.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- 2026-11-05: xunit 2.9.2 -> 2.9.3 (нужно Verify.Xunit; Verify — MIT, снимки текста чека/X-Z/TSPL в папке Snapshots) -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Verify.Xunit" Version="31.0.0" />
    <!-- 2026-11-05 (аудит №4, волна 0-A): поддельный NurCRM на localhost (Apache-2.0) и тесты денег на случайных данных (Apache-2.0). -->
    <PackageReference Include="WireMock.Net" Version="2.21.0" />
    <PackageReference Include="CsCheck" Version="4.9.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 2026-11-05 (аудит скорости, п. 15 а): тесты ужатия миниатюр. Проект кассы с интерфейсом тестами не подключается, поэтому файл
       ThumbImageCompressor.cs берётся ссылкой; SkiaSharp 2.88.9 — та же версия, что у Avalonia 11.2.5 (уже в кэше пакетов, только для тестов). -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <Compile Include="..\NurMarketKassa.Avalonia\Services\ThumbImageCompressor.cs" Link="Linked\ThumbImageCompressor.cs" />
    <!-- 2026-11-06 (В13, А5-13): чтение картинки QR банка (Skia, предел 40 Мп по заголовку) — файл приложения без Avalonia, тестируется ссылкой. -->
    <Compile Include="..\NurMarketKassa.Avalonia\Services\PortableImageReader.cs" Link="Linked\PortableImageReader.cs" />
    <!-- 2026-11-05: поправки ящика (сервер ceba67c, debt_return_drawer_cash) — файл приложения, зависит только от Infrastructure; тесты используют его напрямую. -->
    <Compile Include="..\NurMarketKassa.Avalonia\Services\ExchangeCashCorrections.cs" Link="Linked\ExchangeCashCorrections.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NurMarketKassa.Core\NurMarketKassa.Core.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Infrastructure\NurMarketKassa.Infrastructure.csproj" />
    <ProjectReference Include="..\NurMarketKassa.ViewModels\NurMarketKassa.ViewModels.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Ui.Shared\NurMarketKassa.Ui.Shared.csproj" />
  </ItemGroup>

</Project>
