<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://NurMarketKassa.Avalonia/Themes/AppTheme.axaml"/>
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="BrushAccent" Color="#2563EB" />
  <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB" />
  <SolidColorBrush x:Key="BrushAccentStrong" Color="#1D4ED8" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="#1E3A8A" />
  <SolidColorBrush x:Key="BrushAccentForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrushLoginHeroTitle" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrushLoginHeroSubtitle" Color="#E2E8F0" />
</ResourceDictionary>
