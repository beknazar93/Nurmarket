<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels"
             x:Class="NurMarketKassa.AvaloniaHost.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="Button.login-primary">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.login-primary:pointerover">
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="Button.login-primary:pressed">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.login-primary:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BrushWindow}"
            Padding="32">
        <Border Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="40"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Вход в кассу"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}"/>
                    <TextBlock Text="Введите email и пароль от Nur CRM"
                               FontSize="14"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Email"
                               FontSize="13"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBox Text="{Binding Username}"
                             Watermark="Email"
                             FontSize="14"
                             Padding="14,12"
                             Background="{DynamicResource BrushInput}"
                             BorderBrush="{DynamicResource BrushBorder}"
                             BorderThickness="1"
                             CornerRadius="10"
                             Foreground="{DynamicResource BrushText}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Пароль"
                               FontSize="13"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBox Text="{Binding Password}"
                             PasswordChar="*"
                             Watermark="Пароль"
                             FontSize="14"
                             Padding="14,12"
                             Background="{DynamicResource BrushInput}"
                             BorderBrush="{DynamicResource BrushBorder}"
                             BorderThickness="1"
                             CornerRadius="10"
                             Foreground="{DynamicResource BrushText}"/>
                </StackPanel>

                <Border Background="{DynamicResource BrushDangerSoft}"
                        BorderBrush="{DynamicResource BrushDanger}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushDanger}"/>
                </Border>

                <Button Classes="login-primary"
                        Content="Войти"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding !IsLoading}"/>

                <TextBlock Text="Загрузка кассы…"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextSoft}"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsLoading}"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
