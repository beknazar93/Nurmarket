<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.MainStatusBarView"
             x:DataType="vm:MainStatusViewModel"
             x:CompileBindings="True">

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource BrushUiStatusOk}"
                     IsVisible="{Binding IsOnline}"/>
            <Ellipse Width="8" Height="8"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource BrushUiStatusWarn}"
                     IsVisible="{Binding !IsOnline}"/>
            <TextBlock Text="{Binding StatusLabel}"
                       FontSize="12"
                       Foreground="{DynamicResource BrushTextSoft}"/>
        </StackPanel>

        <TextBlock Text="{Binding NetworkModeText}"
                   FontSize="12"
                   Foreground="{DynamicResource BrushTextSoft}"
                   TextWrapping="Wrap"
                   MaxWidth="280"/>

        <TextBlock Text="{Binding ShiftBalanceText}"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="{DynamicResource BrushAccent}"/>
    </StackPanel>
</UserControl>
