<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.SideMenuView"
             x:DataType="vm:SideMenuViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <StreamGeometry x:Key="HomeIcon">M3,11 L12,3 L21,11 V21 H15 V15 H9 V21 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="WarehouseIcon">M4,7 L12,3 L20,7 V17 L12,21 L4,17 Z M4,7 L12,11 L20,7 M12,11 V21</StreamGeometry>
        <StreamGeometry x:Key="ShiftIcon">M12,3 A9,9 0 1 1 11.99,3 M12,7 V12 L16,14</StreamGeometry>
        <StreamGeometry x:Key="CashOperationsIcon">M5,4 H19 V9 H5 Z M4,9 H20 V20 H4 Z M7,13 H12 M15,13 H17 M7,17 H17</StreamGeometry>
        <StreamGeometry x:Key="ReturnIcon">M9,7 L4,12 L9,17 M5,12 H14 A6,6 0 0 1 20,18</StreamGeometry>
        <StreamGeometry x:Key="FinanceIcon">M4,20 V11 M10,20 V5 M16,20 V14 M22,20 V8</StreamGeometry>
        <StreamGeometry x:Key="SalesIcon">M3,4 H5 L7,15 H18 L21,8 H6 M9,20 A1.5,1.5 0 1 1 8.99,20 M17,20 A1.5,1.5 0 1 1 16.99,20</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M12,8 A4,4 0 1 1 11.99,8 M19,12 A7,7 0 0 0 18.8,10.4 L21,8 L18,5 L15.6,6.2 A7,7 0 0 0 14,5.5 L13,2 H9 L8,5.5 A7,7 0 0 0 6.4,6.2 L4,5 L1,8 L3.2,10.4 A7,7 0 0 0 3,12 A7,7 0 0 0 3.2,13.6 L1,16 L4,19 L6.4,17.8 A7,7 0 0 0 8,18.5 L9,22 H13 L14,18.5 A7,7 0 0 0 15.6,17.8 L18,19 L21,16 L18.8,13.6 A7,7 0 0 0 19,12</StreamGeometry>
        <StreamGeometry x:Key="LogoutIcon">M13,4 H20 V20 H13 M10,8 L6,12 L10,16 M6,12 H16</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.sidebar-menu-item">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item.active">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item.logout">
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
        </Style>
        <Style Selector="Button.sidebar-menu-item.logout:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
        </Style>
    </UserControl.Styles>

    <Border Width="300"
            Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="16,14"
                    Background="{DynamicResource BrushPanelElevated}">
                <Grid>
                    <TextBlock Text="{Binding CashboxTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}"
                               VerticalAlignment="Center"/>
                    <Button Classes="main-ghost"
                            Content="✕"
                            Width="32" Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseMenuCommand}"/>
                </Grid>
            </Border>

            <ScrollViewer DockPanel.Dock="Bottom"
                          >
                <StackPanel Margin="0,8,0,16" Spacing="2">
                    <Border Margin="12,0,12,10"
                            Padding="14"
                            CornerRadius="10"
                            Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Кассовая смена"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Text="{Binding ShiftBalanceText}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="РАБОТА"
                               Margin="24,4,16,6"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                    <Button Classes="sidebar-menu-item active"
                            Command="{Binding NavigateMainCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource HomeIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Главная"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            Command="{Binding NavigateWarehouseCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeJoin="Round"
                                  Data="{StaticResource WarehouseIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Склад"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            Command="{Binding NavigateShiftsCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="{StaticResource ShiftIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Смена"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            Command="{Binding NavigateCashOperationsCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource CashOperationsIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Кассовые операции"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            Command="{Binding NavigateReturnCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource ReturnIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Возврат"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <TextBlock Text="СИСТЕМА"
                               Margin="24,12,16,6"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                    <Button Classes="sidebar-menu-item"
                            Command="{Binding NavigateFinanceCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="{StaticResource FinanceIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Финансы"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            Command="{Binding NavigateSalesCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource SalesIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Продажи"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="sidebar-menu-item"
                            Command="{Binding NavigateSettingsCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  StrokeJoin="Round"
                                  Data="{StaticResource SettingsIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Настройки"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Classes="sidebar-menu-item logout"
                            Margin="8,16,8,2"
                            Command="{Binding LogoutCommand}">
                        <Grid ColumnDefinitions="24,12,*" HorizontalAlignment="Stretch">
                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource LogoutIcon}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Выход"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
