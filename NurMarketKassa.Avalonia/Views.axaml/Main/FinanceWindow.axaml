<Window x:Class="NurMarketKassa.AvaloniaHost.Views.FinanceWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:NurMarketKassa.AvaloniaHost.Converters"
    xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
	x:CompileBindings="False"
	Title="Финансы"
	Height="750"
	Width="1100"
	WindowStartupLocation="CenterOwner"
	Loaded="Window_Loaded">
    <!-- Styles -->
    <Window.Resources>
        <ResourceDictionary>
            <conv:AmountToColorConverter x:Key="AmountColor" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <Style Selector="TextBox"
				x:Key="{x:Type TextBox}">
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
            </Style>
            <Style Selector="DatePicker"
				x:Key="{x:Type DatePicker}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushInput}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorderStrong}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Padding"
					Value="2" />
            </Style>
            <Style Selector="RadioButton.DatePill"
				x:Key="DatePill">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Padding"
					Value="14,6" />
                <Setter
					Property="Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="RadioButton">
                            <Border
								x:Name="pill"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1"
								CornerRadius="10"
								Padding="{TemplateBinding Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style Selector="Button.PrimaryActionButton"
				x:Key="PrimaryActionButton">
                <Setter
					Property="Height"
					Value="36" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushAccent}" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushTextInverted}" />
                <Setter
					Property="FontWeight"
					Value="SemiBold" />
                <Setter
					Property="Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="Button">
                            <Border
								x:Name="btn"
								Background="{TemplateBinding Background}"
								CornerRadius="8">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="15,0" />
                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style Selector="Border.TimeBadge"
				x:Key="TimeBadge">
                <Setter
					Property="Background"
					Value="{DynamicResource BrushInputAlt}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="CornerRadius"
					Value="8" />
                <Setter
					Property="Padding"
					Value="10,4" />
                <Setter
					Property="Margin"
					Value="0" />
            </Style>
            <Style Selector="Button.SecondaryActionButton"
				x:Key="SecondaryActionButton">
                <Setter
					Property="Height"
					Value="36" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushPanelSoft}" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorderStrong}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="Button">
                            <Border
								x:Name="border"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="12,0" />
                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style Selector="Border.KpiCard"
				x:Key="KpiCard">
                <Setter
					Property="Background"
					Value="{DynamicResource BrushInputAlt}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorderStrong}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="CornerRadius"
					Value="10" />
                <Setter
					Property="Padding"
					Value="16" />
                <Setter
					Property="Margin"
					Value="4" />
</Style>

<Style Selector="DataGrid.ModernGrid" x:Key="ModernGrid">
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="RowHeight" Value="40" />
                <Setter Property="GridLinesVisibility" Value="None" />

                <!-- Плавная вертикальная прокрутка -->

<!-- Touch и растягивание -->

                <Setter Property="VerticalAlignment" Value="Stretch"/>

                <!-- Виртуализация -->

                <!-- Заголовки столбцов -->
</Style>

            <Style Selector="TabItem.PosCatalogTabItem"
				x:Key="PosCatalogTabItem">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushTextMuted}" />
                <Setter
					Property="FontSize"
					Value="13" />
                <Setter
					Property="FontWeight"
					Value="SemiBold" />
                <Setter
					Property="Padding"
					Value="16,10" />
                <Setter
					Property="Margin"
					Value="0,0,6,0" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushPanelSoft}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="TabItem">
                            <Border
								x:Name="TabRoot"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="5"
								Padding="{TemplateBinding Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style Selector="Button.HamburgerMenuItem"
				x:Key="HamburgerMenuItem">
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="HorizontalAlignment"
					Value="Stretch" />
                <Setter
					Property="Height"
					Value="44" />
                <Setter
					Property="Padding"
					Value="16,0" />
                <Setter
					Property="FontSize"
					Value="14" />
                <Setter
					Property="Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="Button">
                            <Border
								Background="{TemplateBinding Background}">
                                <ContentPresenter
									HorizontalAlignment="Left"
									VerticalAlignment="Center" />
                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main content -->
    <Grid Margin="0">
        <!-- Основной контент (занимает всё окно) -->
        <Grid x:Name="MainContent">
            <Grid Margin="16" Background="{DynamicResource BrushPanel}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <!-- 0: заголовок -->
                        <RowDefinition />
                        <!-- 1: KPI первый ряд -->
                        <RowDefinition />
                        <!-- 2: KPI второй ряд -->
                        <RowDefinition />
                        <!-- 3: панель дат -->
                        <RowDefinition />
                        <!-- 4: время -->
                        <RowDefinition />
                        <!-- 5: Popup (не используется) -->
                        <RowDefinition Height="*" />
                        <!-- 6: TabControl (растянется) -->
                        <RowDefinition />
                        <!-- 7: сообщение об ошибке -->
                    </Grid.RowDefinitions>

                    <!-- Заголовок с кнопкой гамбургера -->
                    <Grid Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HamburgerButton" Grid.Column="0"
                        Content="☰" Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        FontSize="22" FontWeight="Bold"
                        Foreground="{DynamicResource BrushText}"
                        Click="HamburgerMenu_Click"
                        ToolTip.Tip="Меню"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                           Text="Финансы"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Обновить" Classes="PrimaryActionButton"
            Margin="0,0,10,0" Click="Refresh_Click" />
                            <Button Content="Выйти" Classes="SecondaryActionButton"
            Click="Exit_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- KPI-карточки -->
                    <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
                        <Border Classes="KpiCard">
                            <StackPanel>
                                <TextBlock Text="Выручка" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="TotalSalesText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="KpiCard">
                            <StackPanel>
                                <TextBlock Text="Возвраты" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="TotalRefundsText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushDanger}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="KpiCard">
                            <StackPanel>
                                <TextBlock Text="Наличные" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="CashText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="KpiCard">
                            <StackPanel>
                                <TextBlock Text="Безнал" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="NonCashText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="KpiCard">
                            <StackPanel>
                                <TextBlock Text="Средний чек" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="AvgReceiptText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="KpiCard">
                            <StackPanel>
                                <TextBlock Text="Чеки" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="ReceiptCountText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Панель выбора дат -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <RadioButton Content="Сегодня" Classes="DatePill" IsChecked="True" Tag="Today" GroupName="QuickDate" Click="QuickDate_Click" />
                            <RadioButton Content="Вчера" Classes="DatePill" Margin="4,0,0,0" Tag="Yesterday" GroupName="QuickDate" Click="QuickDate_Click" />
                            <RadioButton Content="Неделя" Classes="DatePill" Margin="4,0,0,0" Tag="Week" GroupName="QuickDate" Click="QuickDate_Click" />
                            <RadioButton Content="Месяц" Classes="DatePill" Margin="4,0,0,0" Tag="Month" GroupName="QuickDate" Click="QuickDate_Click" />
                            <RadioButton x:Name="CustomDatePill" Content="Спец. дата" Classes="DatePill" Margin="4,0,0,0" Tag="Custom" GroupName="QuickDate" Click="QuickDate_Click" />
                        </StackPanel>
                        <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" IsVisible="False">
                            <TextBlock Text="От:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" />
                            <DatePicker x:Name="FromPicker" Width="120" VerticalAlignment="Center" Margin="0,0,6,0"  />
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushText}" />
                            <TextBlock Text="До:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource BrushText}" />
                            <DatePicker x:Name="ToPicker" Width="120" VerticalAlignment="Center" Margin="0,0,12,0"  />
                        </StackPanel>
                    </StackPanel>

                    <!-- Время -->
                    <Border Grid.Row="3" Classes="TimeBadge" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,6,10,6">
                        <TextBlock x:Name="CurrentTimeText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
                    </Border>

                    <!-- Popup с деталями чека -->
                    <Popup x:Name="ReceiptDetailsPopup"
       Placement="Center">
                        <Border Background="{DynamicResource BrushPanel}" CornerRadius="12" Padding="16"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" MinWidth="400" MaxWidth="600">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="*" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PopupTitle" FontWeight="Bold" FontSize="16"
                       Foreground="{DynamicResource BrushText}" Margin="0,0,0,10" />
                                <ScrollViewer Grid.Row="1" MaxHeight="400" >
                                    <ItemsControl x:Name="PopupItemsControl" Foreground="{DynamicResource BrushText}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Grid.Row="2" Content="Закрыть" Classes="SecondaryActionButton"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Click="CloseReceiptDetails_Click" />
                            </Grid>
                        </Border>
                    </Popup>

                    <!-- Вкладки с таблицами -->
                    <TabControl Grid.Row="6" Background="#00FFFFFF" BorderThickness="0"
                         Margin="0,10,0,0">
                        <TabItem Header="Продажи" Margin="0,0,-12,0">
                            <Border Background="#00FFFFFF" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <!-- таблица растянется -->
                                        <RowDefinition/>
                                        <!-- разделитель, KPI, топ-10 -->
                                    </Grid.RowDefinitions>

                                    <!-- Таблица продаж -->
                                    <DataGrid x:Name="SalesGrid"
                                            Grid.Row="0"
                                            x:CompileBindings="False"
                                            Classes="ModernGrid"
                                            AutoGenerateColumns="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding SalesView}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Дата" MinWidth="60" Binding="{ReflectionBinding CreatedAt, StringFormat=dd.MM}" />
                                            <DataGridTextColumn Header="Время" MinWidth="60" Binding="{ReflectionBinding CreatedAt, StringFormat=HH:mm}" />
                                            <DataGridTextColumn Header="Чек" Width="*" Binding="{ReflectionBinding ReceiptNumber}">
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Сумма" Width="130" Binding="{ReflectionBinding TotalAmount, StringFormat='{}{0:N2} сом'}">
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Оплата" Width="100" Binding="{ReflectionBinding PaymentMethod}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Дополнительный контент (прибыль, топ-10) -->
                                    <StackPanel Grid.Row="1">
                                        <Separator Margin="0,10" Background="{DynamicResource BrushBorder}" />

                                        <!-- Блок с расширенными KPI (прибыль, маржа) -->
                                        <StackPanel Margin="8,8,8,12">
                                            <TextBlock Text="Дополнительные показатели" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource BrushText}"/>
                                            <WrapPanel>
                                                <Border Classes="KpiCard" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock Text="Чистая прибыль" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                                        <TextBlock x:Name="NetProfitText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="KpiCard" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock Text="Маржа %" Foreground="{DynamicResource BrushTextSoft}" FontSize="12" Margin="0,0,0,4" />
                                                        <TextBlock x:Name="MarginPercentText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Блок "Топ-10 товаров" -->
                                        <TextBlock Text="Топ-10 товаров по выручке" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,6" Foreground="{DynamicResource BrushText}"/>
                                        <DataGrid x:Name="TopItemsGrid"
                                            x:CompileBindings="False"
                                            Classes="ModernGrid"
                                            AutoGenerateColumns="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding TopItems}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Товар" Width="*" Binding="{ReflectionBinding ProductName}" />
                                                <DataGridTextColumn Header="Выручка" Width="120" Binding="{ReflectionBinding Revenue, StringFormat='{}{0:N2} сом'}" />
                                                <DataGridTextColumn Header="Кол‑во" Width="80" Binding="{ReflectionBinding Quantity}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="Возвраты" Margin="16,0,-24,0">
                            <Border Background="#00FFFFFF" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="RefundsGrid"
                                        x:CompileBindings="False"
                                        Classes="ModernGrid"
                                              AutoGenerateColumns="False"
                                        ItemsSource="{Binding RefundsView}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Дата" Width="80" Binding="{ReflectionBinding CreatedAt, StringFormat=dd.MM}" />
                                            <DataGridTextColumn Header="Время" Width="70" Binding="{ReflectionBinding CreatedAt, StringFormat=HH:mm}" />
                                            <DataGridTextColumn Header="Чек" Width="180" Binding="{ReflectionBinding ReceiptNumber}" />
                                            <DataGridTextColumn Header="Сумма" Width="120" Binding="{ReflectionBinding TotalAmount, StringFormat='{}{0:N2} сом'}" />
                                            <DataGridTextColumn Header="Причина" Width="250" Binding="{ReflectionBinding Reason}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="История" Margin="27,0,-48,0">
                            <Border Background="#00FFFFFF" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="HistoryGrid"
                      x:CompileBindings="False"
                      Classes="ModernGrid" AutoGenerateColumns="False"
                      ItemsSource="{Binding HistoryView}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Дата" MinWidth="55" Binding="{ReflectionBinding CreatedAt, StringFormat=dd.MM}" />
                                            <DataGridTextColumn Header="Время" MinWidth="55" Binding="{ReflectionBinding CreatedAt, StringFormat=HH:mm}" />
                                            <DataGridTextColumn Header="Тип" Width="1*" Binding="{ReflectionBinding Type}" />
                                            <DataGridTextColumn Header="Чек" Width="3*" Binding="{ReflectionBinding ReceiptNumber}" />
                                            <DataGridTextColumn Header="Сумма" MinWidth="110" Binding="{ReflectionBinding TotalAmount, StringFormat='{}{0:N2} сом'}" />
                                            <DataGridTextColumn Header="Оплата" MinWidth="90" Binding="{ReflectionBinding PaymentMethod}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <!-- Сообщение об ошибке -->
                    <Border Grid.Row="7" Margin="0,8,0,0" Padding="12"
                    Background="{DynamicResource BrushDangerSoft}" CornerRadius="8"
                    IsVisible="{Binding HasError}">
                        <TextBlock Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                    </Border>
                </Grid>

        </Grid>

        <Grid x:Name="UnderConstructionPanel"
          IsVisible="False"
          Panel.ZIndex="100"
          Background="{DynamicResource BrushPanel}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🚧" FontSize="72" HorizontalAlignment="Center" />
                <TextBlock Text="Раздел находится в разработке"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,16"/>
                <Button Content="← Назад"
                    Classes="SecondaryActionButton"
                    HorizontalAlignment="Center" MinWidth="120"
                    Click="UnderConstructionBack_Click"/>
            </StackPanel>
        </Grid>

        <!-- Оверлей и выезжающая панель (как в MainWindow) -->
        <Border x:Name="HamburgerOverlay"
            Background="#80000000" IsVisible="False"
            ZIndex="999"
            PointerPressed="HamburgerOverlay_PointerPressed" />
        <Border x:Name="HamburgerPanel"
            HorizontalAlignment="Left" VerticalAlignment="Stretch"
            Width="320" Margin="-320,0,0,0"
            Background="{DynamicResource BrushPanelElevated}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0" ZIndex="1000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="16,14" Background="{DynamicResource BrushPanel}">
                    <Grid>
                        <TextBlock Text="NUR MARKET" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                        <Button Content="✕" Width="32" Height="32" Padding="0"
                            HorizontalAlignment="Right" FontSize="18"
                            Foreground="{DynamicResource BrushText}" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Click="HamburgerMenuClose_Click" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="🛒 Продажа" Classes="HamburgerMenuItem" Click="NavigateToSale_Click" />
                    <Button Content="📦 Склад" Classes="HamburgerMenuItem" Click="NavigateToStock_Click" />
                    <Button Content="🔑 Смена" Classes="HamburgerMenuItem" Click="ManageShift_Click" />
                    <Button Content="🍎 Товары" Classes="HamburgerMenuItem" Click="NavigateToProducts_Click" />
                    <Button Content="📊 Финансы" Classes="HamburgerMenuItem" IsEnabled="False"
                        Background="{DynamicResource BrushAccentSoft}" />
                    <Separator Margin="12,8" Background="{DynamicResource BrushBorder}" />
                    <Button Content="🚪  Выйти" Classes="HamburgerMenuItem" Click="Exit_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
