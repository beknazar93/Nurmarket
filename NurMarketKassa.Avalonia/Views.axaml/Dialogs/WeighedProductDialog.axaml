<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.WeighedProductDialog"
        Title="Взвесить товар"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI, Inter, sans-serif"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Styles>
        <!-- Базовый стиль кнопок нумпада и предустановок -->
        <Style Selector="Button.NumBtn">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.NumBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>

        <!-- Главная желтая кнопка (В чек) -->
        <Style Selector="Button.btn-yellow">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-yellow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentStrong}"/>
        </Style>

        <!-- Серые кнопки (Отмена, Подставить с весов) -->
        <Style Selector="Button.btn-light">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
        </Style>

        <!-- Поле ввода веса -->
        <Style Selector="TextBox.WeightInput">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <!-- Внешний контейнер карточки (ClipToBounds решает проблему кривых углов!) -->
    <Border Margin="12" CornerRadius="16"
            Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
            ClipToBounds="True"
            BoxShadow="0 10 25 -5 #20000000">
        <Grid RowDefinitions="Auto,*">

            <!-- 1. Шапка окна -->
            <Grid Grid.Row="0" Background="{DynamicResource BrushPanelSoft}" Height="48">
                <TextBlock Text="Взвесить товар"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}"/>
                <Button Click="Cancel_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource BrushDanger}"
                        FontSize="18"
                        Content="✕"
                        Cursor="Hand"/>
            </Grid>

            <Separator Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BrushPanelSoft}"/>

            <!-- 2. Основной контент -->
            <StackPanel Grid.Row="1" Margin="24,20,24,24" Spacing="16">
                <!-- Название товара и цена -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="Взвесить: 1321312"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="PriceBlock"
                               Text="Цена за кг: 110.00 сом"
                               FontSize="14"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                </StackPanel>

                <!-- Блок отображения текущих весов: только когда реально подключены весы -->
                <Border x:Name="LiveScaleBlock"
                        Background="{DynamicResource BrushPanel}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="На весах сейчас" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" FontWeight="Medium"/>
                        <TextBlock x:Name="LiveScaleText" Text="0.00 кг" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                    </StackPanel>
                </Border>

                <!-- Разделитель -->
                <Separator Height="1" Background="{DynamicResource BrushPanelSoft}" Margin="0,2"/>

                <!-- Сетка: Левая часть (Ввод) и Правая часть (Кнопки быстрых значений + Нумпад) -->
                <Grid ColumnDefinitions="*,24,310">

                    <!-- ЛЕВАЯ КОЛОНКА -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top" Spacing="16">
                        <!-- Ручной ввод веса -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Вес, кг" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBox x:Name="WeightBox"
                                     Text="0.00"
                                     Classes="WeightInput"
                                     KeyDown="WeightBox_KeyDown"/>
                        </StackPanel>

                        <!-- Кнопка "Подставить с весов" -->
                        <Button x:Name="FromScaleButton"
                                Classes="btn-light"
                                Content="Подставить с весов"
                                Height="50"
                                HorizontalAlignment="Stretch"
                                Click="FromScale_Click"/>

                        <!-- Нижние кнопки действий -->
                        <Grid ColumnDefinitions="*,12,*" Margin="0,32,0,0">
                            <Button Grid.Column="0"
                                    Classes="btn-light"
                                    Content="Отмена"
                                    Height="58"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Stretch"
                                    Click="Cancel_Click"/>

                            <Button x:Name="OkButton"
                                    Grid.Column="2"
                                    Classes="btn-yellow"
                                    Content="В чек"
                                    Height="58"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Stretch"
                                    IsDefault="True"
                                    Click="Ok_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ПРАВАЯ КОЛОНКА (Кнопки быстрых весов + Цифровая клавиатура) -->
                    <StackPanel Grid.Column="2" Spacing="12">

                        <!-- Быстрые кнопки выбора веса -->
                        <Grid ColumnDefinitions="*,*,*,*,*" Height="40">
                            <Button Grid.Column="0" Classes="NumBtn" Content="0,1 кг" Tag="0,1" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="1" Classes="NumBtn" Content="0,5 кг" Tag="0,5" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="2" Classes="NumBtn" Content="1 кг" Tag="1" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="3" Classes="NumBtn" Content="2 кг" Tag="2" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                            <Button Grid.Column="4" Classes="NumBtn" Content="5 кг" Tag="5" Margin="2" FontSize="12" Click="OnQuickWeight_Click"/>
                        </Grid>

                        <!-- Цифровая клавиатура (Numpad) -->
                        <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*">
                            <Grid.Styles>
                                <Style Selector="Button.NumBtn">
                                    <Setter Property="Height" Value="54"/>
                                    <Setter Property="Margin" Value="4"/>
                                </Style>
                            </Grid.Styles>

                            <Button Grid.Row="0" Grid.Column="0" Classes="NumBtn" Content="1" Tag="1" Click="OnNumKey_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Classes="NumBtn" Content="2" Tag="2" Click="OnNumKey_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Classes="NumBtn" Content="3" Tag="3" Click="OnNumKey_Click"/>

                            <Button Grid.Row="1" Grid.Column="0" Classes="NumBtn" Content="4" Tag="4" Click="OnNumKey_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Classes="NumBtn" Content="5" Tag="5" Click="OnNumKey_Click"/>
                            <Button Grid.Row="1" Grid.Column="2" Classes="NumBtn" Content="6" Tag="6" Click="OnNumKey_Click"/>

                            <Button Grid.Row="2" Grid.Column="0" Classes="NumBtn" Content="7" Tag="7" Click="OnNumKey_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Classes="NumBtn" Content="8" Tag="8" Click="OnNumKey_Click"/>
                            <Button Grid.Row="2" Grid.Column="2" Classes="NumBtn" Content="9" Tag="9" Click="OnNumKey_Click"/>

                            <Button Grid.Row="3" Grid.Column="0" Classes="NumBtn" Content="," Tag="," Click="OnNumKey_Click"/>
                            <Button Grid.Row="3" Grid.Column="1" Classes="NumBtn" Content="0" Tag="0" Click="OnNumKey_Click"/>

                            <!-- Кнопка стереть (Backspace) -->
                            <Button Grid.Row="3" Grid.Column="2" Classes="NumBtn"
                                    Background="{DynamicResource BrushDangerSoft}"
                                    BorderBrush="{DynamicResource BrushDanger}"
                                    Click="OnBackspace_Click">
                                <PathIcon Data="M22,3H7C6.31,3 5.77,3.35 5.41,3.88L0,12L5.41,20.11C5.77,20.64 6.31,21 7,21H22A2,2 0 0,0 24,19V5A2,2 0 0,0 22,3M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12L19,15.59Z"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource BrushDanger}"/>
                            </Button>
                        </Grid>

                    </StackPanel>

                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
