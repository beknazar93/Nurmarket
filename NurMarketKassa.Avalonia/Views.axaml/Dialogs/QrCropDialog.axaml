<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.QrCropDialog"
        x:CompileBindings="False"
        Title="Редактирование QR-кода"
        Width="760" Height="650"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BrushWindow}"
        Foreground="{DynamicResource BrushText}">

  <Window.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Spacing="5" Margin="0,0,0,16">
      <TextBlock Text="Обрезка QR-кода" FontSize="24" FontWeight="Bold"/>
      <TextBlock x:Name="SubtitleText"
                 Text="Уберите лишние поля по краям изображения. Оставьте небольшую белую рамку, чтобы QR надёжно сканировался. Исходный файл изменён не будет."
                 Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="390,20,*">
      <Border Grid.Column="0" CornerRadius="14" Padding="14"
              Background="{DynamicResource BrushPanelSoft}"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Grid RowDefinitions="*,Auto">
          <Border Background="#FFFFFF" CornerRadius="8" Padding="8" ClipToBounds="True">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
          </Border>
          <TextBlock x:Name="SizeText" Grid.Row="1" Margin="0,10,0,0"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource BrushTextSoft}"/>
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" Spacing="13" VerticalAlignment="Center">
        <TextBlock Text="Обрезать края" FontSize="16" FontWeight="SemiBold"/>

        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Слева"/>
            <TextBlock x:Name="LeftValueText" Grid.Column="1"/>
          </Grid>
          <Slider x:Name="LeftSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Справа"/>
            <TextBlock x:Name="RightValueText" Grid.Column="1"/>
          </Grid>
          <Slider x:Name="RightSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Сверху"/>
            <TextBlock x:Name="TopValueText" Grid.Column="1"/>
          </Grid>
          <Slider x:Name="TopSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Снизу"/>
            <TextBlock x:Name="BottomValueText" Grid.Column="1"/>
          </Grid>
          <Slider x:Name="BottomSlider" Minimum="0" Maximum="45" ValueChanged="CropSlider_ValueChanged"/>
        </StackPanel>

        <Button Content="Сбросить обрезку" Classes="SettingsFlatButton"
                HorizontalAlignment="Stretch" Click="Reset_Click"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BrushDanger}"
                   TextWrapping="Wrap" IsVisible="False"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,12,Auto" Margin="0,20,0,0">
      <TextBlock Text="Результат будет сохранён как отдельный PNG-файл."
                 VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSoft}"/>
      <Button Grid.Column="1" Content="Отмена" Classes="SettingsFlatButton"
              MinWidth="120" Click="Cancel_Click"/>
      <Button Grid.Column="3" Content="Обрезать и сохранить" Classes="btn-primary"
              MinWidth="190" Click="Save_Click"/>
    </Grid>
  </Grid>
</Window>
