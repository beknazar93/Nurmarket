<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.HotkeySettingsWindow"
        x:DataType="local:HotkeySettingsWindow"
        Title="Горячие клавиши"
        Width="760" Height="650"
        MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Background="Transparent"
        Foreground="{DynamicResource BrushText}">
  <Window.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Shared/MainViewStyles.axaml"/>
    <Style Selector="Button.chrome-button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="17"/>
    </Style>
    <Style Selector="Button.chrome-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
    </Style>
    <Style Selector="Button.chrome-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
      <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
  </Window.Styles>

  <Border Margin="10" CornerRadius="18"
          Background="{DynamicResource BrushPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 14 36 -10 #70000000" ClipToBounds="True">
    <Grid RowDefinitions="48,*">
      <Border Grid.Row="0" Background="{DynamicResource BrushPanelElevated}"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,6">
          <Border Grid.ColumnSpan="2" Background="Transparent"
                  PointerPressed="TitleBar_PointerPressed"/>
          <Border Width="30" Height="30" CornerRadius="9"
                  Background="{DynamicResource BrushAccentSoft}" VerticalAlignment="Center"
                  IsHitTestVisible="False">
            <TextBlock Text="⌨" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource BrushAccentStrong}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                      IsHitTestVisible="False">
            <TextBlock Text="Nur Market" FontSize="10" Foreground="{DynamicResource BrushTextSoft}"/>
            <TextBlock Text="Настройка горячих клавиш" FontSize="14" FontWeight="SemiBold"/>
          </StackPanel>
          <Button Grid.Column="2" Classes="chrome-button" Content="—"
                  ToolTip.Tip="Свернуть" Click="Minimize_Click"/>
          <Button Grid.Column="3" Classes="chrome-button chrome-close" Content="×"
                  ToolTip.Tip="Закрыть" Click="Cancel_Click"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="28,22,28,24">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
          <StackPanel Spacing="6">
            <TextBlock Text="Горячие клавиши кассы" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Нажмите нужную комбинацию прямо в поле. Изменения сохраняются для текущего пользователя."
                       FontSize="14" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource BrushAccentSoft}"
                  CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
            <TextBlock Text="Шпаргалка кассира" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushAccentStrong}"/>
          </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="16" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:HotkeyRow">
                  <Grid ColumnDefinitions="*,220" Margin="12,8">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Description}" FontSize="12"
                                 Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding Gesture}" Tag="{Binding Action}"
                             IsReadOnly="True" HorizontalContentAlignment="Center"
                             FontSize="16" FontWeight="Bold" Watermark="Нажмите клавиши"
                             KeyDown="OnGestureKeyDown"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,18,0,0">
          <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource BrushDanger}"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button Grid.Column="1" Classes="main-ghost" Content="По умолчанию"
                  Margin="8,0" Click="Reset_Click"/>
          <Button Grid.Column="2" Classes="main-secondary" Content="Отмена"
                  Margin="8,0" Click="Cancel_Click"/>
          <Button Grid.Column="3" Classes="main-primary" Content="Сохранить"
                  Margin="8,0,0,0" Click="Save_Click"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
