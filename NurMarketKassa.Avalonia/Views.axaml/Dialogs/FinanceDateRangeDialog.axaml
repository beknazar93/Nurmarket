<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.FinanceDateRangeDialog"
        Title="Период отчёта"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

  <Window.Styles>
    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
    </Style>
    <Style Selector="Button.btn-secondary">
      <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
    </Style>
    <Style Selector="Button.quick">
      <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.quick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="16"
          Background="{DynamicResource BrushPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="24">
    <StackPanel Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Text="Период отчёта"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}"/>
        <TextBlock Text="Выберите даты «От» и «До» для финансового отчёта"
                   FontSize="13" Foreground="{DynamicResource BrushTextSoft}" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="quick" Content="Сегодня" Tag="Today" Click="Quick_Click"/>
        <Button Classes="quick" Content="Неделя" Tag="Week" Click="Quick_Click"/>
        <Button Classes="quick" Content="Месяц" Tag="Month" Click="Quick_Click"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,16,*">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="От" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
          <CalendarDatePicker x:Name="FromDatePicker"
                              Height="42"
                              HorizontalAlignment="Stretch"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Text="До" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSoft}"/>
          <CalendarDatePicker x:Name="ToDatePicker"
                              Height="42"
                              HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Grid>

      <Border Background="{DynamicResource BrushPanelSoft}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
              CornerRadius="12" Padding="12" HorizontalAlignment="Stretch">
        <Calendar x:Name="RangeCalendar"
                  HorizontalAlignment="Center"
                  SelectedDatesChanged="RangeCalendar_SelectedDatesChanged"/>
      </Border>

      <TextBlock x:Name="ErrorText"
                 FontSize="13"
                 Foreground="{DynamicResource BrushDanger}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <Grid ColumnDefinitions="*,12,*">
        <Button Grid.Column="0"
                Classes="btn-secondary"
                Content="Отмена"
                Height="46"
                IsCancel="True"
                Click="Cancel_Click"/>
        <Button Grid.Column="2"
                Classes="btn-primary"
                Content="Применить"
                Height="46"
                IsDefault="True"
                Click="Apply_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
