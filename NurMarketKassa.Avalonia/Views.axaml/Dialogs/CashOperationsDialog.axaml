<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CashOperationsDialog"
        Title="Кассовые операции"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

  <Border Margin="16" CornerRadius="16"
          Background="{DynamicResource BrushPanel}"
          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

      <!-- Заголовок -->
      <TextBlock Text="Кассовые операции"
                 FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Margin="0,0,0,6"/>

      <!-- Подзаголовок / Описание -->
      <TextBlock Text="Управление сменой и кассовыми операциями"
                 FontSize="14" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSoft}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Margin="0,0,0,22"/>

      <!-- Кнопки управления сменой -->
      <StackPanel Width="320" Spacing="10" HorizontalAlignment="Center">

        <Button Content="Открыть смену"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BrushAccent}"
                Foreground="{DynamicResource BrushText}"
                FontWeight="SemiBold"
                CornerRadius="10"
                Cursor="Hand"
                Click="OpenShift_Click"/>

        <Button Content="Закрыть смену"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BrushInputAlt}"
                Foreground="{DynamicResource BrushText}"
                FontWeight="SemiBold"
                CornerRadius="10"
                Cursor="Hand"
                Click="CloseShift_Click"/>

        <Button Content="Закрыть"
                Height="46"
                Margin="0,6,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource BrushPanel}"
                Foreground="{DynamicResource BrushTextSoft}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1.5"
                FontWeight="SemiBold"
                CornerRadius="10"
                Cursor="Hand"
                Click="Close_Click"/>

      </StackPanel>

    </StackPanel>
  </Border>
</Window>