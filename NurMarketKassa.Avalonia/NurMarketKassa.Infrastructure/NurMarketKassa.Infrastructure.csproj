<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NurMarketKassa.Infrastructure</RootNamespace>
    <AssemblyName>NurMarketKassa.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NurMarketKassa.Core\NurMarketKassa.Core.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Ui.Shared\NurMarketKassa.Ui.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NurMarketKassa.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- 2026-10-01: голосовые ответы телеграм-бота — Opus/OGG на чистом C# (TelegramVoice). -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.6" />
    <PackageReference Include="linq2db" Version="5.4.1" />
    <PackageReference Include="linq2db.PostgreSQL" Version="5.4.1" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <!-- 2026-11-05 (аудит №4, Polly): срок ожидания и предохранитель для GET в TransportTuningHandler (BSD-3) -->
    <PackageReference Include="Polly.Core" Version="8.5.2" />
    <!-- 2026-10-30: Vosk и sherpa-onnx (голос) удалены — в коде их нет; установка легче на ~66 МБ, APK на ~26 МБ. -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <!-- 2026-11-06: В18 — System.Drawing.Common работает только в Windows (печать через драйвер, предпросмотр GDI+). Растр этикеток, ценников,
         листов A4, графических чеков и графиков для Linux/Android рисует SkiaSharp — той же версии 2.88.9, что приходит с Avalonia 11.2.5
         (родные библиотеки для Windows/Linux/Android уже подтягиваются приложениями, новых пакетов нет). -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <!-- 2026-11-05: ZXing.Net 0.16.10 -> 0.16.11 (Apache-2.0, только исправления) -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- 2026-11-05: сопоставление накладных — расстояние Левенштейна (Raffinert.FuzzySharp, MIT) и запасной транслит (AnyAscii, ISC);
         большие выгрузки Excel (MiniExcel, Apache-2.0) -->
    <PackageReference Include="Raffinert.FuzzySharp" Version="6.0.1" />
    <PackageReference Include="AnyAscii" Version="0.3.3" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.8" />
    <PackageReference Include="Velopack" Version="1.0.1" />
    <PackageReference Include="WebSocketSharp-netstandard" Version="1.0.1" />
  </ItemGroup>

</Project>
