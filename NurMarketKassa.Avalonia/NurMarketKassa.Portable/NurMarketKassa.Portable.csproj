<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2026-10-04, владелец: касса для Linux и для Android-кассовых аппаратов («точная копия кассы»).
       Этот проект собирает ТОТ ЖЕ код Windows-кассы (NurMarketKassa.Avalonia — файлы подключаются
       ссылками, не копиями) под net8.0 без Windows. Всё, что работает только в Windows, закрыто
       условием NURPORTABLE в самих файлах или заменено файлами из папки Portable\.
       Имя сборки то же — NurMarketKassa.Avalonia, иначе не найдутся ресурсы avares://NurMarketKassa.Avalonia/…
       Windows-касса этим проектом не затрагивается и собирается как раньше. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>NurMarketKassa.AvaloniaHost</RootNamespace>
    <AssemblyName>NurMarketKassa.Avalonia</AssemblyName>
    <DefineConstants>$(DefineConstants);NURPORTABLE</DefineConstants>
    <Version>1.17.44</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <ApplicationIcon>..\NurMarketKassa.Avalonia\Assets\app-icon.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <HostDir>$(MSBuildThisFileDirectory)..\NurMarketKassa.Avalonia\</HostDir>
    <HostExcludes>$(HostDir)obj\**;$(HostDir)bin\**;$(HostDir)publish*\**;$(HostDir)release*\**;$(HostDir)installer-out\**;$(HostDir)VoiceModel\**;$(HostDir)AnyDesk\**;$(HostDir)**\*.bak;$(HostDir)**\*.wpfbak;$(HostDir)**\*.shellbak;$(HostDir)**\*.Thin.cs;$(HostDir)**\*.Legacy.cs;$(HostDir)**\_wpf_port_backup\**</HostExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Windows" />
  </ItemGroup>

  <!-- Код Windows-кассы — ссылками. Файлы, которые под Linux/Android не нужны вовсе, исключены здесь. -->
  <ItemGroup>
    <Compile Include="$(HostDir)**\*.cs" Exclude="$(HostExcludes)" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="$(HostDir)**\*.axaml" Exclude="$(HostExcludes)" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="$(HostDir)Assets\**" Exclude="$(HostExcludes)" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Обновления Linux-версии — из своего репозитория Nurmarket-Linux (2026-10-04). -->
    <None Include="appsettings.linux.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Compile Include="Portable\**\*.cs" />
    <!-- Заменены своими файлами из Portable\ -->
    <Compile Remove="$(HostDir)Controls\WebView2Host.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NurMarketKassa.ViewModels\NurMarketKassa.ViewModels.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Infrastructure\NurMarketKassa.Infrastructure.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Core\NurMarketKassa.Core.csproj" />
    <ProjectReference Include="..\NurMarketKassa.Ui.Shared\NurMarketKassa.Ui.Shared.csproj" />
  </ItemGroup>
</Project>
