{
  "_comment": "Пример настроек ретранслятора. Настоящие значения — переменными окружения Relay__<Имя> (docker-compose/.env) или файлом relay.json (путь в RELAY_CONFIG). Секретов в репозиторий не класть.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Relay": {
    "DataDir": "/data",
    "TokenSecret": "",
    "TokenLifetimeHours": 12,
    "SessionTtlSeconds": 900,
    "ConsentTimeoutSeconds": 90,
    "MaxPinAttempts": 5,
    "MaxBinaryMessageBytes": 4194304,
    "MaxTextMessageBytes": 262144,
    "SendQueueBytes": 16777216,
    "SendStallSeconds": 30,
    "PingIntervalSeconds": 15,
    "IdleTimeoutSeconds": 45,
    "MaxSessions": 2000,
    "MaxPendingPerIp": 10,
    "LoginPerMinutePerIp": 10,
    "LoginFailuresPer15MinPerLogin": 10,
    "JoinPerMinute": 20,
    "HostConnectsPerMinutePerIp": 30,
    "TrustForwardedHeaders": false,
    "JournalPageSize": 100
  }
}
